<!DOCTYPE html>
<html dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title><%= session.title %></title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:100%; height:100%; overflow:hidden; background:#000; font-family:sans-serif; }
  #zmmtg-root { width:100%; height:100%; position:relative; }
  #zoom-loading { position:fixed; top:0; left:0; right:0; bottom:0; display:flex; align-items:center; justify-content:center; background:#1a1a2e; z-index:10; flex-direction:column; gap:12px; }
  #zoom-loading .spinner { width:40px; height:40px; border:4px solid #333; border-top-color:#0052cc; border-radius:50%; animation:spin 0.8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
  #zoom-loading span { color:#aaa; font-size:14px; }
  <% if (isStudent) { %>
  #leaveBtn { position:fixed; bottom:24px; left:50%; transform:translateX(-50%); z-index:99999; padding:10px 28px; background:#dc2626; color:#fff; border:none; border-radius:8px; font-size:15px; font-weight:700; cursor:pointer; box-shadow:0 4px 20px rgba(220,38,38,0.4); transition:background 0.2s; }
  #leaveBtn:hover { background:#b91c1c; }
  #leaveBtn:active { transform:translateX(-50%) scale(0.97); }
  <% } %>
</style>
</head>
<body>
<div id="zoom-loading">
  <div class="spinner"></div>
  <span>جاري تحميل غرفة الحصة...</span>
</div>
<div id="zmmtg-root"></div>
<% if (isStudent) { %>
<button id="leaveBtn" onclick="leaveSession()">الخروج من الحصة</button>
<% } %>

<script src="https://source.zoom.us/3.11.2/lib/vendor/react.min.js"></script>
<script src="https://source.zoom.us/3.11.2/lib/vendor/react-dom.min.js"></script>
<script src="https://source.zoom.us/3.11.2/lib/vendor/redux.min.js"></script>
<script src="https://source.zoom.us/3.11.2/lib/vendor/redux-thunk.min.js"></script>
<script src="https://source.zoom.us/3.11.2/lib/vendor/lodash.min.js"></script>
<script src="https://source.zoom.us/3.11.2/zoom-meeting-3.11.2.min.js"></script>

<script>
var rawMid = '<%= session.meetingId %>';
var userName = '<%= userName %>';
var signature = '<%= zoomSignature %>';
var sdkKey = '<%= sdkKey %>';
var userEmail = '<%= userEmail || userName + "@zoom.edu" %>';
var passWord = '<%= session.password %>';
var mn = parseInt(rawMid, 10);
var isStudent = <%= isStudent %>;

<% if (isStudent) { %>
function hideZoomControls() {
  var selectors = [
    '[class*="meeting-info"]', '[class*="invite"]', '[class*="participants"]',
    '[class*="chat"]', '[class*="apps"]', '[class*="reaction"]',
    '[class*="more"]', '[class*="security"]', '[class*="fullscreen"]',
    '[class*="copy-link"]', '[class*="passcode"]', '[class*="meeting-id"]',
    '[class*="logo"]', '[class*="floating"]', '[class*="waiting"]',
    '[class*="raise-hand"]',
    '[class*="record"]', '[class*="caption"]',
    '[class*="poll"]', '[class*="whiteboard"]', '[class*="breakout"]',
    '[class*="notification"]', '[class*="alert"]',
    '[class*="banner"]',
    '.footer__btn__leave', '.join-audio-container',
    '.preview-video-container', '.audio-preview-container'
  ];
  selectors.forEach(function(sel) {
    document.querySelectorAll(sel).forEach(function(el) {
      if (el.closest('#leaveBtn')) return;
      el.style.setProperty('display', 'none', 'important');
    });
  });
}

setTimeout(hideZoomControls, 1000);
setTimeout(hideZoomControls, 3000);
setTimeout(hideZoomControls, 5000);
setTimeout(hideZoomControls, 10000);
<% } %>

if (!mn) {
  document.getElementById('zoom-loading').innerHTML = '<div style="color:#dc2626;font-size:18px;">معرف الاجتماع غير متوفر</div>';
} else {
  ZoomMtg.setZoomJSLib('https://source.zoom.us/3.11.2/lib', '/av');
  ZoomMtg.preLoadWasm();
  ZoomMtg.prepareWebSDK();

  var initTimeout = setTimeout(function() {
    document.getElementById('zoom-loading').innerHTML = '<div style="color:#dc2626;font-size:16px;">انتهت مهلة الاتصال بغرفة Zoom. تأكد من أن الحصة مباشرة وأن بيانات الدخول صحيحة.</div>';
  }, 30000);

  ZoomMtg.init({
    leaveUrl: window.location.origin + '/student/live-sessions',
    success: function() {
      clearTimeout(initTimeout);
      document.getElementById('zoom-loading').style.display = 'none';
      <% if (isStudent) { %>hideZoomControls();<% } %>
      ZoomMtg.join({
        meetingNumber: mn,
        userName: userName,
        signature: signature,
        sdkKey: sdkKey,
        userEmail: userEmail,
        passWord: passWord,
        success: function() {
          <% if (isStudent) { %>
          setTimeout(hideZoomControls, 1000);
          setTimeout(hideZoomControls, 3000);
          setTimeout(hideZoomControls, 5000);
          setTimeout(hideZoomControls, 10000);
          <% } %>
        },
        error: function(err) {
          clearTimeout(initTimeout);
          document.getElementById('zoom-loading').innerHTML = '<div style="color:#dc2626;font-size:16px;">فشل الانضمام: ' + (err.errorMessage || err.message || JSON.stringify(err)) + '</div>';
        }
      });
    },
    error: function(err) {
      clearTimeout(initTimeout);
      document.getElementById('zoom-loading').innerHTML = '<div style="color:#dc2626;font-size:16px;">خطأ في تهيئة Zoom: ' + (err.errorMessage || err.message || JSON.stringify(err)) + '</div>';
    }
  });
}

<% if (isStudent) { %>
function leaveSession() {
  try { ZoomMtg.leaveMeeting({}); } catch(e) {}
  window.top.location.href = '/student/live-sessions';
}

window.addEventListener('beforeunload', function() {
  try { ZoomMtg.leaveMeeting({}); } catch(e) {}
});
<% } else { %>
window.addEventListener('beforeunload', function() {
  try { ZoomMtg.leaveMeeting({}); } catch(e) {}
});
<% } %>
</script>
</body>
</html>