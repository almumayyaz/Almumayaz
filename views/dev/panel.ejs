    </main>
  </div>

  <script>
/* ===================== Utilities ===================== */
function escHtml(t){return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function setMsg(id, ok, msg){
  var r=document.getElementById(id);
  r.className='dev-msg show '+(ok?'ok':'err');
  r.textContent=msg;
}

/* ===================== Theme ===================== */
function hexToRgbJs(hex){hex=String(hex).replace('#','').trim();if(hex.length===3)hex=hex.split('').map(function(c){return c+c;}).join('');if(hex.length!==6)return null;return{r:parseInt(hex.slice(0,2),16),g:parseInt(hex.slice(2,4),16),b:parseInt(hex.slice(4,6),16)};}
function rgbToHexJs(c){var h=function(n){var s=Math.max(0,Math.min(255,Math.round(n))).toString(16);return s.length===1?'0'+s:s;};return'#'+h(c.r)+h(c.g)+h(c.b);}
function mixRgbJs(a,b,t){return{r:a.r+(b.r-a.r)*t,g:a.g+(b.g-a.g)*t,b:a.b+(b.b-a.b)*t};}
var DEFAULT_LIGHT_JS={bg:'#FFF9F1',card:'#FFFFFF',border:'#E8E8E8',text:'#111111',textLight:'#666666',textMuted:'#9A8A7A',cardAlt:'#f5f5f5',glassBg:'rgba(255,255,255,0.85)',glassBorder:'rgba(0,0,0,0.06)',glassBlur:'20px',sidebarTextHover:'#000000',sidebarTextActive:'#000000',sidebarIconHover:'#000000',sidebarIconActive:'#000000',sidebarLogout:'#ef4444'};
var DEFAULT_DARK_JS={bg:'#0F172A',card:'#1E293B',border:'rgba(255,255,255,0.08)',text:'#F1F5F9',textLight:'#94A3B8',textMuted:'#64748B',cardAlt:'#111827',glassBg:'rgba(255,255,255,0.06)',glassBorder:'rgba(255,255,255,0.1)',glassBlur:'24px',sidebarTextHover:'var(--accent)',sidebarTextActive:'var(--accent)',sidebarIconHover:'var(--accent)',sidebarIconActive:'var(--accent)',sidebarLogout:'#f87171'};
function buildThemeCssJs(accent,shape,font,lt,dk){
  var rgb=hexToRgbJs(accent)||{r:59,g:130,b:246};
  var light=mixRgbJs(rgb,{r:255,g:255,b:255},0.35);
  var lighter=mixRgbJs(rgb,{r:255,g:255,b:255},0.6);
  var hover=mixRgbJs(rgb,{r:0,g:0,b:0},0.15);
  var radius=shape==='square'?'0px':(shape==='circular'?'999px':'12px');
  var fontCss=font?'font-family:"'+font.replace(/"/g,'')+'",sans-serif;':'';
  function themeBlockJs(prefix,src,def){
    return prefix+'{'+
      '--bg:'+(src.bg||def.bg)+';--card:'+(src.card||def.card)+';--card-alt:'+(src.cardAlt||def.cardAlt)+';'+
      '--border:'+(src.border||def.border)+';--text:'+(src.text||def.text)+';--text-light:'+(src.textLight||def.textLight)+';'+
      '--text-muted:'+(src.textMuted||def.textMuted)+';--glass-bg:'+(src.glassBg||def.glassBg)+';'+
      '--glass-border:'+(src.glassBorder||def.glassBorder)+';--glass-blur:'+(src.glassBlur||def.glassBlur)+';'+
      '--sidebar-text-hover:'+(src.sidebarTextHover||def.sidebarTextHover)+';'+
      '--sidebar-text-active:'+(src.sidebarTextActive||def.sidebarTextActive)+';'+
      '--sidebar-icon-hover:'+(src.sidebarIconHover||def.sidebarIconHover)+';'+
      '--sidebar-icon-active:'+(src.sidebarIconActive||def.sidebarIconActive)+';'+
      '--sidebar-logout:'+(src.sidebarLogout||def.sidebarLogout)+';'+
      '--primary:'+accent+';--primary-light:'+rgbToHexJs(light)+';--primary-lighter:'+rgbToHexJs(lighter)+';'+
      '--accent:'+accent+';--accent-light:'+rgbToHexJs(light)+';--accent-hover:'+rgbToHexJs(hover)+';'+
      '--accent-glow:rgba('+rgb.r+','+rgb.g+','+rgb.b+',0.18);'+
      '--gold-gradient:linear-gradient(135deg,'+accent+' 0%,'+rgbToHexJs(hover)+' 100%);'+
      '--gold-gradient-text:linear-gradient(90deg,'+accent+','+rgbToHexJs(hover)+');'+
      '--shadow-accent:0 8px 25px rgba('+rgb.r+','+rgb.g+','+rgb.b+',0.25);'+
      '--course-c1:'+accent+';--course-c2:'+rgbToHexJs(mixRgbJs(rgb,{r:109,g:74,b:255},0.55))+';'+
      '--course-c3:'+rgbToHexJs(mixRgbJs(rgb,{r:13,g:148,b:136},0.55))+';'+
      '--course-c4:'+rgbToHexJs(mixRgbJs(rgb,{r:184,g:134,b:11},0.5))+';'+
      '--btn-radius:'+radius+';'+
      fontCss+
      '}';
  }
  return themeBlockJs(':root,[data-theme="light"]',lt||{},DEFAULT_LIGHT_JS)+
    themeBlockJs('[data-theme="dark"]',dk||{},DEFAULT_DARK_JS)+
    '.btn,.btn-lg,.btn-sm,.btn-outline,.btn-primary,.btn-danger,.action-btn{border-radius:var(--btn-radius,14px)!important;}'+
    (font?'body,input,textarea,select,button,.navbar,.nav-links a,.sidebar-logo,.btn,.form-input,.sp-info-value,.sp-code{font-family:"'+font.replace(/"/g,'')+'",sans-serif!important;}':'');
}
function currentThemeAccent(){return document.getElementById('themeAccent').value;}
function currentBtnShape(){var els=document.getElementsByName('btnShape');for(var i=0;i<els.length;i++){if(els[i].checked)return els[i].value;}return 'rounded';}
function currentThemeFont(){return document.getElementById('themeFont').value.trim();}
function loadGoogleFont(name){
  if(!name)return;
  var id='gf-'+name.replace(/\s+/g,'');
  if(document.getElementById(id))return;
  var link=document.createElement('link');link.id=id;link.rel='stylesheet';
  link.href='https://fonts.googleapis.com/css2?family='+encodeURIComponent(name)+':wght@400;500;600;700;800&display=swap';
  document.head.appendChild(link);
}
function uploadFont(){
  var file=document.getElementById('fontFileInput').files[0];
  if(!file){setMsg('themeMsg',false,'اختر ملف خط أولاً');return;}
  var fd=new FormData();
  fd.append('fontFile',file);
  fd.append('fontName',currentThemeFont());
  var btn=document.getElementById('fontUploadBtn');
  btn.disabled=true;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i>';
  fetch('/api/admin/upload-font',{method:'POST',body:fd})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success){
        setMsg('themeMsg',true,'تم رفع الخط "'+d.fontName+'"');
        var lbl=document.getElementById('fontFileNameLabel');
        if(lbl){lbl.innerHTML='<i class="fas fa-file"></i> '+d.fileName;lbl.style.display='';}
        previewTheme();
      }else{setMsg('themeMsg',false,d.error||'حدث خطأ');}
      btn.disabled=false;btn.innerHTML='<i class="fas fa-upload"></i> رفع';
    }).catch(function(){setMsg('themeMsg',false,'فشل الاتصال');btn.disabled=false;btn.innerHTML='<i class="fas fa-upload"></i> رفع';});
}
function removeFont(){
  if(!confirm('إزالة ملف الخط المخصص والرجوع إلى Google Fonts؟'))return;
  fetch('/api/admin/remove-font',{method:'POST'})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success){
        setMsg('themeMsg',true,'تم إزالة الخط المخصص');
        var lbl=document.getElementById('fontFileNameLabel');
        if(lbl)lbl.style.display='none';
        previewTheme();
      }else{setMsg('themeMsg',false,d.error||'حدث خطأ');}
    }).catch(function(){setMsg('themeMsg',false,'فشل الاتصال');});
}
function previewTheme(){
  var hex=currentThemeAccent();
  var font=currentThemeFont();
  var colors=currentThemeColors();
  document.getElementById('themeAccentHex').value=hex;
  var styleEl=document.getElementById('theme-override');
  if(!styleEl){styleEl=document.createElement('style');styleEl.id='theme-override';document.head.appendChild(styleEl);}
  styleEl.textContent=buildThemeCssJs(hex,currentBtnShape(),font,colors.light,colors.dark);
  if(font)loadGoogleFont(font);
}
function syncThemeHex(){
  var v=document.getElementById('themeAccentHex').value.trim();
  if(v&&v[0]!=='#')v='#'+v;
  if(/^#[0-9a-fA-F]{3}$/.test(v)||/^#[0-9a-fA-F]{6}$/.test(v)){
    document.getElementById('themeAccent').value=v.length===4?(function(h){h=h.replace('#','');return '#'+h[0]+h[0]+h[1]+h[1]+h[2]+h[2];})(v):v;
    previewTheme();
  }
}
function resetThemePreview(){
  document.getElementById('themeAccent').value='<%= themeAccent %>';
  document.getElementById('themeAccentHex').value='<%= themeAccent %>';
  document.getElementById('themeFont').value='<%= themeFont %>';
  var els=document.getElementsByName('btnShape');
  for(var i=0;i<els.length;i++){els[i].checked=els[i].value==='<%= themeBtnShape %>';}
  document.getElementById('themeLightBg').value='<%= themeLightBg %>';
  document.getElementById('themeLightCard').value='<%= themeLightCard %>';
  document.getElementById('themeLightText').value='<%= themeLightText %>';
  document.getElementById('themeLightSidebarTextHover').value='<%= themeLightSidebarTextHover %>';
  document.getElementById('themeLightSidebarTextActive').value='<%= themeLightSidebarTextActive %>';
  document.getElementById('themeLightSidebarIconHover').value='<%= themeLightSidebarIconHover %>';
  document.getElementById('themeLightSidebarIconActive').value='<%= themeLightSidebarIconActive %>';
  document.getElementById('themeLightSidebarLogout').value='<%= themeLightSidebarLogout %>';
  document.getElementById('themeDarkBg').value='<%= themeDarkBg %>';
  document.getElementById('themeDarkCard').value='<%= themeDarkCard %>';
  document.getElementById('themeDarkText').value='<%= themeDarkText %>';
  document.getElementById('themeDarkSidebarTextHover').value='<%= themeDarkSidebarTextHover %>';
  document.getElementById('themeDarkSidebarTextActive').value='<%= themeDarkSidebarTextActive %>';
  document.getElementById('themeDarkSidebarIconHover').value='<%= themeDarkSidebarIconHover %>';
  document.getElementById('themeDarkSidebarIconActive').value='<%= themeDarkSidebarIconActive %>';
  document.getElementById('themeDarkSidebarLogout').value='<%= themeDarkSidebarLogout %>';
  previewTheme();
}
function currentThemeColors(){
  function g(id){return document.getElementById(id).value;}
  return {
    light:{bg:g('themeLightBg'),card:g('themeLightCard'),text:g('themeLightText'),
      sidebarTextHover:g('themeLightSidebarTextHover'),sidebarTextActive:g('themeLightSidebarTextActive'),
      sidebarIconHover:g('themeLightSidebarIconHover'),sidebarIconActive:g('themeLightSidebarIconActive'),
      sidebarLogout:g('themeLightSidebarLogout')},
    dark:{bg:g('themeDarkBg'),card:g('themeDarkCard'),text:g('themeDarkText'),
      sidebarTextHover:g('themeDarkSidebarTextHover'),sidebarTextActive:g('themeDarkSidebarTextActive'),
      sidebarIconHover:g('themeDarkSidebarIconHover'),sidebarIconActive:g('themeDarkSidebarIconActive'),
      sidebarLogout:g('themeDarkSidebarLogout')}
  };
}
function saveTheme(){
  var btn=document.getElementById('themeSaveBtn');
  var msg=document.getElementById('themeMsg');
  var accent=currentThemeAccent();
  var shape=currentBtnShape();
  var font=currentThemeFont();
  var colors=currentThemeColors();
  btn.disabled=true;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> ...';
  msg.className='dev-msg';
  fetch('/api/admin/theme',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({accent:accent,btnShape:shape,fontName:font,light:colors.light,dark:colors.dark})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success){previewTheme();setMsg('themeMsg',true,'تم حفظ الثيم وتطبيقه على المنصة');}
      else{setMsg('themeMsg',false,d.error||'حدث خطأ');}
      btn.disabled=false;btn.innerHTML='<i class="fas fa-save"></i> حفظ الثيم';
    })
    .catch(function(){setMsg('themeMsg',false,'فشل الاتصال بالخادم');btn.disabled=false;btn.innerHTML='<i class="fas fa-save"></i> حفظ الثيم';});
}
previewTheme();

/* ===================== Status ===================== */
function loadStatus(){
  fetch('/api/dev/status')
    .then(function(r){return r.json();})
    .then(function(s){
      var z=s.zoom||{};
      document.getElementById('zoomClientId').textContent=z.clientIdPrefix||'غير مضبوط';
      document.getElementById('zoomFirebase').textContent=z.hasFirebaseCreds?'مُخزّن في Firebase':'من متغيرات البيئة';
      document.getElementById('zoomSdk').textContent=z.hasSdk?'موجود':'غير مضبوط';
      document.getElementById('zoomRuri').textContent=z.redirectUri||'—';
      var zb=document.getElementById('zoomStatusBadge');
      if(z.configured){zb.className='dev-badge dev-badge-ok';zb.innerHTML='<span class="status-dot green"></span> مضبوط';}
      else{zb.className='dev-badge dev-badge-err';zb.innerHTML='<span class="status-dot red"></span> غير مضبوط';}
      var c=s.cron||{};
      document.getElementById('cronInterval').textContent='كل '+(c.intervalSeconds||'?')+' ثانية';
      var lr=c.lastRun;
      document.getElementById('cronLastRun').textContent=lr&&lr.at?new Date(lr.at).toLocaleString('ar-EG'):'لم يُشغّل بعد';
      document.getElementById('cronProcessed').textContent=lr?((lr.processed||0)+' إشعار'+(lr.error?' (خطأ: '+escHtml(lr.error)+')':'')):'—';
      document.getElementById('cronSecret').textContent=c.secretSet?'مضبوط ✅':'غير مضبوط ⚠️';
      if(c.cronUrl)document.getElementById('cronUrl').value=c.cronUrl;
      var cb=document.getElementById('cronStatusBadge');
      if(lr&&!lr.error){cb.className='dev-badge dev-badge-ok';cb.innerHTML='<span class="status-dot green"></span> يعمل';}
      else if(lr&&lr.error){cb.className='dev-badge dev-badge-err';cb.innerHTML='<span class="status-dot red"></span> خطأ';}
      else{cb.className='dev-badge dev-badge-pending';cb.innerHTML='<span class="status-dot yellow"></span> بانتظار أول تشغيل';}
      var mm=s.maintenance||{};
      document.getElementById('mmMessage').value=mm.message||'';
      var mb=document.getElementById('mmStatusBadge');
      if(mm.enabled){mb.className='dev-badge dev-badge-err';mb.innerHTML='<span class="status-dot red"></span> المنصة متوقفة (صيانة)';}
      else{mb.className='dev-badge dev-badge-ok';mb.innerHTML='<span class="status-dot green"></span> المنصة تعمل';}
      var mmToggle=document.getElementById('mmToggle'); if(mmToggle) mmToggle.checked=!!mm.enabled;
    })
    .catch(function(){
      var fail=function(id){var el=document.getElementById(id);if(el){el.className='dev-badge dev-badge-err';el.innerHTML='<span class="status-dot red"></span> فشل التحميل';}};
      fail('zoomStatusBadge'); fail('cronStatusBadge'); fail('mmStatusBadge');
    });
}
loadStatus();
setInterval(loadStatus, 15000);

/* ===================== Zoom form ===================== */
document.getElementById('zoomForm').addEventListener('submit',function(e){
  e.preventDefault();
  var cid=document.getElementById('zoomClientIdInput').value.trim();
  var csec=document.getElementById('zoomClientSecretInput').value.trim();
  var ruri=document.getElementById('zoomRuriInput').value.trim();
  var sk=document.getElementById('zoomSdkKeyInput').value.trim();
  var ssec=document.getElementById('zoomSdkSecretInput').value.trim();
  if(!cid){setMsg('zoomMsg',false,'يرجى إدخال Client ID');return;}
  if(!csec){setMsg('zoomMsg',false,'يرجى إدخال Client Secret');return;}
  fetch('/admin/zoom-app',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({clientId:cid,clientSecret:csec,redirectUri:ruri,sdkKey:sk,sdkSecret:ssec})})
    .then(function(r){return r.status;})
    .then(function(st){
      if(st>=200&&st<300){setMsg('zoomMsg',true,'تم حفظ إعدادات Zoom بنجاح في Firebase');loadStatus();}
      else{setMsg('zoomMsg',false,'فشل الحفظ (كود '+st+')');}
    })
    .catch(function(){setMsg('zoomMsg',false,'فشل الاتصال بالخادم');});
});

/* ===================== Cron ===================== */
function copyCronUrl(){
  var u=document.getElementById('cronUrl').value;
  if(!u)return;
  navigator.clipboard.writeText(u).then(function(){setMsg('cronMsg',true,'تم نسخ رابط الكرون');}).catch(function(){setMsg('cronMsg',false,'تعذّر النسخ');});
}
function saveCronSecret(){
  var s=document.getElementById('cronSecretInput').value.trim();
  if(!s){setMsg('cronMsg',false,'يرجى إدخال السر');return;}
  fetch('/api/admin/set-cron-secret?secret='+encodeURIComponent(s)).then(function(r){
    if(r.ok){setMsg('cronMsg',true,'تم حفظ CRON_SECRET في Firebase');document.getElementById('cronSecretInput').value='';loadStatus();}
    else{setMsg('cronMsg',false,'فشل حفظ السر');}
  }).catch(function(){setMsg('cronMsg',false,'فشل الاتصال بالخادم');});
}
function runCronNow(){
  setMsg('cronMsg',true,'جاري تشغيل الفحص...');
  fetch('/api/admin/notifications/check-scheduled').then(function(r){return r.json();}).then(function(d){
    setMsg('cronMsg',true,'تم الفحص: '+(d.processed||0)+' إشعار مجدول تم إرساله'+(d.error?(' (خطأ: '+escHtml(d.error)+')'):''));
    loadStatus();
  }).catch(function(){setMsg('cronMsg',false,'فشل الاتصال بالخادم');});
}
/* ===================== Support Key ===================== */
function saveSupportKey(){
  var key=document.getElementById('supportKeyInput').value.trim();
  if(!key){setMsg('supportKeyMsg',false,'يرجى إدخال مفتاح الدعم');return;}
  fetch('/api/dev/support-key',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({key:key})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success){setMsg('supportKeyMsg',true,'تم حفظ مفتاح الدعم الفني');}
      else{setMsg('supportKeyMsg',false,d.error||'فشل الحفظ');}
    }).catch(function(){setMsg('supportKeyMsg',false,'فشل الاتصال بالخادم');});
}
/* ===================== Maintenance ===================== */
function setMaintenance(enabled){
  var msg=document.getElementById('mmMessage').value.trim();
  fetch('/api/dev/maintenance',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:enabled,message:msg})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success){setMsg('mmMsg',true,enabled?'تم تفعيل وضع الصيانة وإيقاف المنصة للطلاب':'تم تشغيل المنصة وعودة العمل');loadStatus();}
      else{setMsg('mmMsg',false,d.error||'فشل الحفظ');}
    })
    .catch(function(){setMsg('mmMsg',false,'فشل الاتصال بالخادم');});
}

/* ===================== Notify Teacher ===================== */
function notifyTeacher(){
  var title=document.getElementById('ntTitle').value.trim();
  var body=document.getElementById('ntBody').value.trim();
  var url=document.getElementById('ntUrl').value.trim()||'/admin';
  if(!title||!body){setMsg('ntMsg',false,'يرجى إدخال العنوان والنص');return;}
  fetch('/api/dev/notify-teacher',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:title,body:body,url:url})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success){setMsg('ntMsg',true,'تم إرسال الإشعار للمدرس ('+ (d.sent||0) +' جهاز)');document.getElementById('ntTitle').value='';document.getElementById('ntBody').value='';}
      else{setMsg('ntMsg',false,d.error||'فشل الإرسال');}
    })
    .catch(function(){setMsg('ntMsg',false,'فشل الاتصال بالخادم');});
}

/* ===================== Logout ===================== */
function logout(){
  fetch('/dev/logout',{method:'POST'})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success) window.location.href='/dev';
    })
    .catch(function(){alert('فشل الخروج');});
}

/* ===================== Prefill Zoom ===================== */
(function(){
  document.getElementById('zoomClientIdInput').value='<%= clientIdFull %>'||'';
  document.getElementById('zoomClientSecretInput').value='<%= clientSecretFull %>'||'';
  document.getElementById('zoomRuriInput').value='<%= redirectUri %>'||'';
  document.getElementById('zoomSdkKeyInput').value='<%= sdkKeyFull %>'||'';
  document.getElementById('zoomSdkSecretInput').value='<%= sdkSecretFull %>'||'';
})();

/* ===================== Usage Statistics ===================== */
function loadUsage(){
  var badge=document.getElementById('usageBadge');
  fetch('/api/dev/usage').then(function(r){return r.json();}).then(function(d){
    var content=document.getElementById('usageContent');
    var empty=document.getElementById('usageEmpty');
    var hasData=false;
    function renderService(svc, totalId, dailyId){
      var s=d.services&&d.services[svc];
      if(s&&s.total){
        hasData=true;
        document.getElementById(totalId).textContent=s.total;
        var html='';
        var days=Object.keys(s.daily||{}).sort().reverse().slice(0,14);
        var vals=Object.values(s.daily||{});
        var maxC=Math.max(1,Math.max.apply(null,vals.length?vals:[1]));
        days.forEach(function(day){
          var cnt=s.daily[day];
          var pct=Math.round((cnt/maxC)*100);
          var color=cnt>maxC*0.75?'#22c55e':cnt>maxC*0.4?'#f59e0b':'#666';
          html+='<div style="display:flex;flex-direction:column;align-items:center;gap:2px;" title="'+day+': '+cnt+'">';
          html+='<div style="width:18px;height:'+Math.max(4,pct*0.6)+'px;background:'+color+';border-radius:3px;min-height:4px;"></div>';
          html+='<span style="font-size:8px;color:#666;">'+day.slice(5)+'</span></div>';
        });
        document.getElementById(dailyId).innerHTML=html||'<span style="font-size:12px;color:#666;">لا توجد بيانات يومية</span>';
      } else {
        document.getElementById(totalId).textContent='0';
        document.getElementById(dailyId).innerHTML='<span style="font-size:12px;color:#666;">لا توجد بيانات</span>';
      }
    }
    renderService('brevo','brevoTotal','brevoDaily');
    // Real Brevo API data
    var b = d._brevo;
    if(b && b.plan){
      hasData = true;
      var credsEl = document.getElementById('brevoCredits');
      var planInfo = b.plan.map(function(p){ return p.creditsType==='sendLimit' ? 'Credits: <strong style="color:#22c55e">'+p.credits+'</strong>' : p.creditsType+': '+p.credits; }).join(' | ');
      var total30 = b.smtp30 ? b.smtp30.requests || 0 : '—';
      credsEl.innerHTML = 'Plan: '+(b.companyName||'')+' | Email: '+(b.email||'')+' | Sent(30d): '+total30+' | '+planInfo;
    }
    if(b && b.daily7 && b.daily7.length){
      var bhtml=''; var bmax=Math.max(1,Math.max.apply(null,b.daily7.map(function(r){return r.requests||0;})));
      b.daily7.forEach(function(r){
        var cnt=r.requests||0; var bpct=Math.round((cnt/bmax)*100);
        var color=cnt>bmax*0.75?'#22c55e':cnt>bmax*0.4?'#f59e0b':'#666';
        bhtml+='<div style="display:flex;flex-direction:column;align-items:center;gap:2px;" title="'+r.date+': '+cnt+' sent, '+ (r.delivered||0)+' delivered">';
        bhtml+='<div style="width:18px;height:'+Math.max(4,bpct*0.6)+'px;background:'+color+';border-radius:3px;min-height:4px;"></div>';
        bhtml+='<span style="font-size:8px;color:#666;">'+(r.date?r.date.slice(5):'')+'</span></div>';
      });
      if(bhtml) document.getElementById('brevoDaily').innerHTML=bhtml;
    }
    if(hasData){
      content.style.display='block';
      empty.style.display='none';
      badge.className='dev-badge dev-badge-ok';
      badge.innerHTML='<i class="fas fa-check-circle"></i> Updated';
    } else {
      content.style.display='none';
      empty.style.display='block';
      badge.className='dev-badge dev-badge-pending';
      badge.innerHTML='<i class="fas fa-clock"></i> No Data';
    }
  }).catch(function(){
    badge.className='dev-badge dev-badge-err';
    badge.innerHTML='<i class="fas fa-times-circle"></i> Failed';
  });
}

loadUsage();
setInterval(loadUsage, 30000);
  </script>
</body>
</html>