<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة المطور — Developer Panel</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Cairo', sans-serif;
      background: #0a0a0f;
      color: #e0e0e0;
      direction: rtl;
      line-height: 1.6;
    }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #111; }
    ::-webkit-scrollbar-thumb { background: #2a2a3a; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #3b82f6; }

    /* Background */
    .dev-bg {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(ellipse at 20% 50%, rgba(59,130,246,0.04) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 50%, rgba(139,92,246,0.04) 0%, transparent 50%);
    }
    .dev-grid-overlay {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(59,130,246,0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,0.02) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Top bar */
    .top-bar {
      position: relative; z-index: 1;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 24px;
      background: rgba(16,16,24,0.9);
      border-bottom: 1px solid rgba(59,130,246,0.15);
      backdrop-filter: blur(12px);
    }
    .top-bar .brand {
      display: flex; align-items: center; gap: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px; font-weight: 700; color: #f0f0f0;
    }
    .top-bar .brand .badge {
      display: inline-block;
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      font-size: 10px; padding: 2px 8px; border-radius: 4px;
      color: #fff; font-weight: 700;
      margin-right: 6px;
      font-family: 'Cairo', sans-serif;
    }
    .top-bar .brand i { color: #3b82f6; }
    .top-bar .actions { display: flex; gap: 8px; align-items: center; }
    .top-bar .actions a, .top-bar .actions button {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; padding: 6px 14px; border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.04);
      color: #aaa; cursor: pointer; text-decoration: none;
      transition: all 0.2s;
    }
    .top-bar .actions a:hover, .top-bar .actions button:hover {
      background: rgba(255,255,255,0.08); color: #fff;
    }
    .top-bar .actions .logout-btn { color: #ef4444; border-color: rgba(239,68,68,0.2); }
    .top-bar .actions .logout-btn:hover { background: rgba(239,68,68,0.1); }

    /* Layout */
    .panel-layout {
      position: relative; z-index: 1;
      display: flex; max-width: 1200px; margin: 0 auto; padding: 24px;
      gap: 24px; align-items: flex-start;
    }
    .panel-sidebar {
      width: 220px; flex-shrink: 0;
      position: sticky; top: 24px;
    }
    .panel-sidebar nav { display: flex; flex-direction: column; gap: 4px; }
    .panel-sidebar nav a {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; border-radius: 8px;
      font-size: 13px; font-weight: 600; color: #888; text-decoration: none;
      transition: all 0.2s; border: 1px solid transparent;
    }
    .panel-sidebar nav a:hover {
      background: rgba(255,255,255,0.04); color: #ccc; border-color: rgba(255,255,255,0.06);
    }
    .panel-sidebar nav a.active {
      background: rgba(59,130,246,0.1); color: #60a5fa; border-color: rgba(59,130,246,0.2);
    }
    .panel-sidebar nav a i { width: 18px; text-align: center; font-size: 14px; }

    .panel-main { flex: 1; min-width: 0; }

    /* Cards */
    .dev-card {
      background: rgba(16,16,24,0.85);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 20px;
      backdrop-filter: blur(8px);
    }
    .dev-card-head {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 18px; flex-wrap: wrap; gap: 8px;
    }
    .dev-card-head h3 {
      font-size: 15px; font-weight: 700; color: #e0e0e0;
      font-family: 'JetBrains Mono', monospace;
    }
    .dev-card-head h3 i { color: #3b82f6; margin-left: 8px; }
    .dev-badge {
      display: inline-block; padding: 3px 10px; border-radius: 6px;
      font-size: 11px; font-weight: 700; font-family: 'JetBrains Mono', monospace;
    }
    .dev-badge-ok { background: rgba(22,163,74,0.12); color: #22c55e; border: 1px solid rgba(22,163,74,0.2); }
    .dev-badge-pending { background: rgba(251,191,36,0.12); color: #f59e0b; border: 1px solid rgba(251,191,36,0.2); }
    .dev-badge-err { background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.2); }
    .dev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width:800px) { .dev-grid { grid-template-columns:1fr; } .panel-layout { flex-direction: column; } .panel-sidebar { width: 100%; position: static; } .panel-sidebar nav { flex-direction: row; flex-wrap: wrap; } }
    .dev-info { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 14px; }
    .dev-info-row { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 12.5px; }
    .dev-info-row:last-child { border-bottom: none; }
    .dev-info-row span { color: #888; }
    .dev-info-row code { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: #60a5fa; word-break: break-all; text-align: left; }
    .dev-form { display: flex; flex-direction: column; gap: 12px; }

    /* Form controls */
    .form-group { display: flex; flex-direction: column; gap: 5px; }
    .form-group label { font-size: 12px; font-weight: 600; color: #aaa; font-family: 'JetBrains Mono', monospace; }
    .form-input {
      padding: 10px 14px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px; color: #e0e0e0; font-size: 13px; font-family: 'JetBrains Mono', monospace; outline: none; transition: border-color 0.2s;
    }
    .form-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.08); }
    .form-input::placeholder { color: #555; }
    textarea.form-input { resize: vertical; min-height: 60px; }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 9px 18px; border-radius: 8px; font-size: 13px; font-weight: 700;
      font-family: 'Cairo', sans-serif; cursor: pointer; transition: all 0.2s; border: none; text-decoration: none; line-height: 1;
    }
    .btn i { font-size: 13px; }
    .btn-primary { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
    .btn-primary:hover { opacity: 0.9; }
    .btn-outline { background: none; border: 1px solid rgba(255,255,255,0.12); color: #aaa; }
    .btn-outline:hover { background: rgba(255,255,255,0.05); color: #fff; }
    .btn-sm { padding: 6px 14px; font-size: 12px; }
    .btn-danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-group { display: flex; gap: 8px; flex-wrap: wrap; }

    /* Messages */
    .dev-msg {
      display: none; margin-top: 12px; padding: 10px 14px; border-radius: 8px;
      font-size: 12.5px; font-weight: 600; text-align: center;
    }
    .dev-msg.show { display: block; }
    .dev-msg.ok { background: rgba(22,163,74,0.1); color: #22c55e; border: 1px solid rgba(22,163,74,0.15); }
    .dev-msg.err { background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.15); }

    /* Theme color picker */
    .theme-preview {
      display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    }
    .theme-preview input[type="color"] {
      width: 42px; height: 36px; border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px; background: none; cursor: pointer; padding: 2px;
    }
    .theme-preview input[type="text"] {
      direction: ltr; max-width: 120px; font-family: 'JetBrains Mono', monospace;
    }
    .shape-options { display: flex; gap: 8px; flex-wrap: wrap; }
    .shape-options label {
      display: flex; align-items: center; gap: 6px;
      padding: 8px 14px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 8px; cursor: pointer; font-size: 13px; color: #aaa; transition: all 0.2s;
    }
    .shape-options label:hover { border-color: rgba(255,255,255,0.12); color: #ddd; }
    .shape-options input:checked + span { color: #60a5fa; }
    .shape-options input[type="radio"] { accent-color: #3b82f6; }

    /* Toggle */
    .dev-toggle {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 8px; padding: 12px 14px; cursor: pointer;
      font-size: 13px; font-weight: 600; color: #ccc;
    }
    .switch { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
      position: absolute; inset: 0; background: #2a2a3a; border-radius: 999px; transition: 0.3s; cursor: pointer;
    }
    .slider::before {
      content: ""; position: absolute; height: 18px; width: 18px;
      right: 3px; top: 3px; background: #555; border-radius: 50%; transition: 0.3s;
    }
    .switch input:checked + .slider { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .switch input:checked + .slider::before {
      background: #fff; transform: translateX(-20px);
    }
    .hint { font-size: 11.5px; color: #666; margin-top: 4px; }
    .usage-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; font-size:14px; font-weight:600; }
    .usage-total { font-size:16px; font-weight:700; color:#f59e0b; }
    .usage-bars { display:flex; flex-wrap:wrap; gap:4px; align-items:flex-end; }

    /* Status badges inline */
    .status-dot {
      display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-left: 6px;
    }
    .status-dot.green { background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,0.4); }
    .status-dot.red { background: #ef4444; box-shadow: 0 0 6px rgba(239,68,68,0.4); }
    .status-dot.yellow { background: #f59e0b; box-shadow: 0 0 6px rgba(251,191,36,0.4); }
  </style>
</head>
<body>
  <div class="dev-bg"></div>
  <div class="dev-grid-overlay"></div>

  <!-- Top Bar -->
  <div class="top-bar">
    <div class="brand">
      <i class="fas fa-terminal"></i>
      Developer Panel <span class="badge">v2.0</span>
    </div>
    <div class="actions">
      <a href="/admin"><i class="fas fa-tachometer-alt"></i> Admin</a>
      <a href="/"><i class="fas fa-globe"></i> Site</a>
      <button class="logout-btn" onclick="logout()"><i class="fas fa-power-off"></i> خروج</button>
    </div>
  </div>

  <div class="panel-layout">
    <!-- Sidebar -->
    <aside class="panel-sidebar">
      <nav>
        <a href="#theme" class="active" id="nav-theme"><i class="fas fa-palette"></i> Platform Theme</a>
        <a href="#zoom" id="nav-zoom"><i class="fab fa-zoom"></i> Zoom Config</a>
        <a href="#cron" id="nav-cron"><i class="fas fa-clock"></i> Cron Control</a>
        <a href="#maintenance" id="nav-maint"><i class="fas fa-power-off"></i> Maintenance</a>
        <a href="#notify" id="nav-notify"><i class="fas fa-bell"></i> Notify Teacher</a>
        <a href="#support" id="nav-support"><i class="fas fa-headset"></i> Support Key</a>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="panel-main">

      <!-- ==================== THEME COLORS ==================== -->
      <div class="dev-card" id="theme">
        <div class="dev-card-head">
          <h3><i class="fas fa-palette"></i> Platform Theme</h3>
          <span class="dev-badge dev-badge-ok" id="themeStatusBadge"><span class="status-dot green"></span>منظومة</span>
        </div>
        <div class="dev-form" style="gap:16px;">
          <div class="form-group">
            <label>اللون الأساسي <span style="color:#666;font-weight:400;">(Accent Color)</span></label>
            <div class="theme-preview">
              <input type="color" id="themeAccent" value="<%= themeAccent %>" oninput="previewTheme()">
              <input type="text" id="themeAccentHex" value="<%= themeAccent %>" oninput="syncThemeHex()" class="form-input" style="direction:ltr;max-width:130px;font-family:'JetBrains Mono',monospace;" placeholder="#3B82F6">
            </div>
          </div>
          <div class="form-group">
            <label>شكل الأزرار <span style="color:#666;font-weight:400;">(Button Shape)</span></label>
            <div class="shape-options">
              <label><input type="radio" name="btnShape" value="square" <%= themeBtnShape === 'square' ? 'checked' : '' %> onchange="previewTheme()"> <span>مربعة</span></label>
              <label><input type="radio" name="btnShape" value="rounded" <%= themeBtnShape === 'rounded' ? 'checked' : '' %> onchange="previewTheme()"> <span>نصف دائرية</span></label>
              <label><input type="radio" name="btnShape" value="circular" <%= themeBtnShape === 'circular' ? 'checked' : '' %> onchange="previewTheme()"> <span>دائرية</span></label>
            </div>
          </div>
          <div class="form-group">
            <label>الخط <span style="color:#666;font-weight:400;">(Font Name)</span></label>
            <div style="display:flex;gap:8px;">
              <input type="text" id="themeFont" value="<%= themeFont %>" oninput="previewTheme()" class="form-input" style="flex:1;direction:ltr;" placeholder="e.g. Cairo, Tajawal">
              <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('themeFont').value='Cairo';previewTheme()" title="إعادة تعيين"><i class="fas fa-undo"></i></button>
            </div>
            <div style="margin-top:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
              <input type="file" id="fontFileInput" accept=".woff2,.woff,.ttf,.otf" style="flex:1;min-width:140px;">
              <button type="button" class="btn btn-primary btn-sm" id="fontUploadBtn" onclick="uploadFont()"><i class="fas fa-upload"></i> رفع</button>
              <% if (typeof themeFontFile !== 'undefined' && themeFontFile) { %>
                <span style="color:#666;font-size:13px;" id="fontFileNameLabel"><i class="fas fa-file"></i> <%= themeFontFile %></span>
                <button type="button" class="btn btn-outline btn-sm" onclick="removeFont()"><i class="fas fa-trash"></i></button>
              <% } else { %>
                <span style="color:#666;font-size:13px;display:none;" id="fontFileNameLabel"></span>
              <% } %>
            </div>
            <p class="hint">أدخل اسم خط من Google Fonts، أو ارفع woff2 لاستخدام خط مخصص.</p>
          </div>
          <div class="form-group">
            <label>ألوان الوضع الفاتح <span style="color:#666;font-weight:400;">(Light)</span></label>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
              <div><label style="font-size:12px;color:#666;">الخلفية</label><input type="color" id="themeLightBg" value="<%= themeLightBg %>" onchange="previewTheme()" style="width:100%;height:36px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:12px;color:#666;">البطاقات</label><input type="color" id="themeLightCard" value="<%= themeLightCard %>" onchange="previewTheme()" style="width:100%;height:36px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:12px;color:#666;">النص</label><input type="color" id="themeLightText" value="<%= themeLightText %>" onchange="previewTheme()" style="width:100%;height:36px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
            </div>
            <p class="hint" style="margin-bottom:6px;">الشريط الجانبي (Sidebar)</p>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:6px;">
              <div><label style="font-size:11px;color:#666;">نص عند التمرير</label><input type="color" id="themeLightSidebarTextHover" value="<%= themeLightSidebarTextHover %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">نص عند النشاط</label><input type="color" id="themeLightSidebarTextActive" value="<%= themeLightSidebarTextActive %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">أيقونة عند التمرير</label><input type="color" id="themeLightSidebarIconHover" value="<%= themeLightSidebarIconHover %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">أيقونة عند النشاط</label><input type="color" id="themeLightSidebarIconActive" value="<%= themeLightSidebarIconActive %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">تسجيل الخروج</label><input type="color" id="themeLightSidebarLogout" value="<%= themeLightSidebarLogout %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
            </div>
          </div>
          <div class="form-group">
            <label>ألوان الوضع الغامق <span style="color:#666;font-weight:400;">(Dark)</span></label>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
              <div><label style="font-size:12px;color:#666;">الخلفية</label><input type="color" id="themeDarkBg" value="<%= themeDarkBg %>" onchange="previewTheme()" style="width:100%;height:36px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:12px;color:#666;">البطاقات</label><input type="color" id="themeDarkCard" value="<%= themeDarkCard %>" onchange="previewTheme()" style="width:100%;height:36px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:12px;color:#666;">النص</label><input type="color" id="themeDarkText" value="<%= themeDarkText %>" onchange="previewTheme()" style="width:100%;height:36px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
            </div>
            <p class="hint" style="margin-bottom:6px;">الشريط الجانبي (Sidebar)</p>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:6px;">
              <div><label style="font-size:11px;color:#666;">نص عند التمرير</label><input type="color" id="themeDarkSidebarTextHover" value="<%= themeDarkSidebarTextHover %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">نص عند النشاط</label><input type="color" id="themeDarkSidebarTextActive" value="<%= themeDarkSidebarTextActive %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">أيقونة عند التمرير</label><input type="color" id="themeDarkSidebarIconHover" value="<%= themeDarkSidebarIconHover %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">أيقونة عند النشاط</label><input type="color" id="themeDarkSidebarIconActive" value="<%= themeDarkSidebarIconActive %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
              <div><label style="font-size:11px;color:#666;">تسجيل الخروج</label><input type="color" id="themeDarkSidebarLogout" value="<%= themeDarkSidebarLogout %>" onchange="previewTheme()" style="width:100%;height:30px;border:1px solid var(--border);border-radius:6px;padding:2px;cursor:pointer;"></div>
            </div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button class="btn btn-primary" onclick="saveTheme()" id="themeSaveBtn"><i class="fas fa-save"></i> حفظ الثيم</button>
            <button class="btn btn-outline" onclick="resetThemePreview()"><i class="fas fa-undo"></i> إعادة تعيين</button>
          </div>
          <div id="themeMsg" class="dev-msg"></div>
        </div>
      </div>

      <!-- ==================== ZOOM CONFIG ==================== -->
      <div class="dev-card" id="zoom">
        <div class="dev-card-head">
          <h3><i class="fab fa-zoom"></i> Zoom Config</h3>
          <span id="zoomStatusBadge" class="dev-badge dev-badge-pending"><i class="fas fa-spinner fa-spin"></i> جاري الفحص...</span>
        </div>
        <div class="dev-grid">
          <div class="dev-info">
            <div class="dev-info-row"><span>Client ID:</span> <code id="zoomClientId">—</code></div>
            <div class="dev-info-row"><span>Firebase:</span> <code id="zoomFirebase">—</code></div>
            <div class="dev-info-row"><span>SDK Key/Secret:</span> <code id="zoomSdk">—</code></div>
            <div class="dev-info-row"><span>Redirect URI:</span> <code id="zoomRuri" style="direction:ltr;">—</code></div>
          </div>
          <form id="zoomForm" class="dev-form">
            <div class="form-group"><label>Client ID</label><input id="zoomClientIdInput" name="clientId" class="form-input" placeholder="Zoom Client ID"></div>
            <div class="form-group"><label>Client Secret</label><input id="zoomClientSecretInput" name="clientSecret" class="form-input" placeholder="اتركه إن لم ترد تغييره"></div>
            <div class="form-group"><label>Redirect URI</label><input id="zoomRuriInput" name="redirectUri" class="form-input" style="direction:ltr;" placeholder="https://almumayaz.online/auth/zoom/callback"></div>
            <div class="form-group"><label>SDK Key <span style="color:#666;font-weight:400;">(اختياري)</span></label><input id="zoomSdkKeyInput" name="sdkKey" class="form-input" placeholder="اتركه فارغاً لاستخدام Client ID"></div>
            <div class="form-group"><label>SDK Secret <span style="color:#666;font-weight:400;">(اختياري)</span></label><input id="zoomSdkSecretInput" name="sdkSecret" class="form-input" placeholder="اتركه فارغاً لاستخدام Client Secret"></div>
            <div class="btn-group">
              <button type="submit" class="btn btn-primary" style="flex:1;"><i class="fas fa-save"></i> حفظ</button>
              <a href="/auth/zoom/reauthorize" class="btn btn-outline"><i class="fas fa-sync-alt"></i> إعادة الربط</a>
              <a href="/admin/zoom-app/reset" class="btn btn-outline" onclick="return confirm('إعادة التعيين إلى الإعدادات الأصلية؟');"><i class="fas fa-undo"></i> تعيين</a>
              <a href="/api/zoom/debug" target="_blank" class="btn btn-outline"><i class="fas fa-stethoscope"></i> تشخيص</a>
            </div>
          </form>
