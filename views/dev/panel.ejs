          <!-- Brevo Email -->
          <div style="margin-bottom:16px;">
            <div class="usage-row">
              <span><i class="fas fa-envelope"></i> Brevo — Email</span>
              <span id="brevoTotal" class="usage-total">0</span>
            </div>
            <div id="brevoCredits" style="font-size:11px;color:#666;margin-bottom:6px;"></div>
            <div id="brevoDaily" class="usage-bars"></div>
