          <div class="form-group"><label>مفتاح الدعم الفني <span style="color:#666;font-weight:400;">(يستخدمه مسؤول الدعم لتسجيل الدخول)</span></label>
            <input id="supportKeyInput" class="form-input" style="direction:ltr;font-family:'JetBrains Mono',monospace;text-align:center;letter-spacing:3px;" value="<%= supportKey %>" placeholder="support2024"></div>
          <button type="button" class="btn btn-primary" onclick="saveSupportKey()"><i class="fas fa-save"></i> حفظ المفتاح</button>
