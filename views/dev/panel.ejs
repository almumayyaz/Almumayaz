          <span id="cronStatusBadge" class="dev-badge dev-badge-pending"><i class="fas fa-spinner fa-spin"></i> جاري الفحص...</span>
        </div>
        <div class="dev-grid">
          <div class="dev-info">
            <div class="dev-info-row"><span>الفحص التلقائي:</span> <code id="cronInterval">—</code></div>
            <div class="dev-info-row"><span>آخر تشغيل:</span> <code id="cronLastRun">—</code></div>
            <div class="dev-info-row"><span>آخر إرسال:</span> <code id="cronProcessed">—</code></div>
            <div class="dev-info-row"><span>CRON_SECRET:</span> <code id="cronSecret">—</code></div>
          </div>
          <div class="dev-form">
            <div class="form-group">
              <label>Cron URL <span style="color:#666;font-weight:400;">(انسخه إلى Vercel)</span></label>
              <input id="cronUrl" class="form-input" style="direction:ltr;" readonly>
              <button type="button" class="btn btn-outline btn-sm" style="margin-top:6px;" onclick="copyCronUrl()"><i class="fas fa-copy"></i> نسخ الرابط</button>
            </div>
            <div class="form-group">
              <label>تحديث CRON_SECRET</label>
              <div style="display:flex;gap:8px;">
                <input id="cronSecretInput" class="form-input" style="direction:ltr;flex:1;" placeholder="السر الجديد">
                <button type="button" class="btn btn-primary btn-sm" onclick="saveCronSecret()"><i class="fas fa-key"></i> حفظ</button>
              </div>
            </div>
            <button type="button" class="btn btn-primary" style="width:100%;" onclick="runCronNow()"><i class="fas fa-play"></i> تشغيل الفحص الآن</button>
