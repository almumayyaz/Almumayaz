        </div>
        <div class="dev-form">
          <div class="form-group"><label>العنوان</label><input id="ntTitle" class="form-input" placeholder="عنوان الإشعار"></div>
          <div class="form-group"><label>النص</label><textarea id="ntBody" class="form-input" rows="3" placeholder="نص الإشعار"></textarea></div>
          <div class="form-group"><label>الرابط عند النقر <span style="color:#666;font-weight:400;">(اختياري)</span></label><input id="ntUrl" class="form-input" style="direction:ltr;" value="/admin"></div>
          <button type="button" class="btn btn-primary" style="width:100%;" onclick="notifyTeacher()"><i class="fas fa-paper-plane"></i> إرسال للمدرس</button>
        </div>
