<%- include('../partials/header', { title: title, navPageTitle: 'بنك الأسئلة', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <h1>بنك الأسئلة</h1>
      <p>اختبر نفسك في جميع فروع اللغة العربية مع التقييم الفوري</p>
    </div>
    <span style="font-size:13px;color:var(--text-light);background:var(--card);padding:8px 16px;border-radius:8px;border:1px solid var(--border);">
      <i class="fas fa-question-circle" style="color:var(--accent);"></i> 
      <% var totalQs = 0; courses.forEach(function(c) { totalQs += allBanks.filter(function(b) { return b.courseId === c.id; }).reduce(function(sum, b) { return sum + (b.questions||[]).length; }, 0); }); %><%= totalQs %> سؤال
    </span>
  </div>

  <div style="margin-bottom:24px;">
    <p style="font-size:14px;color:var(--text-light);margin-bottom:12px;">اختر المادة:</p>
    <div class="qb-categories">
      <% var hasAny = false; courses.forEach(function(course) { %>
      <% var courseBanks = allBanks.filter(function(b) { return b.courseId === course.id; }); %>
      <% if (courseBanks.length) { hasAny = true; %>
      <% var bankQs = courseBanks.reduce(function(sum, b) { return sum + (b.questions||[]).length; }, 0); %>
      <a href="/student/question-bank/<%= course.id %>" class="qb-cat">
        <div class="icon" style="color:<%= course.color %>;"><i class="fas <%= course.icon %>"></i></div>
        <h3><%= course.title %></h3>
        <div style="font-size:12px;color:var(--text-light);"><%= bankQs %> سؤال</div>
      </a>
      <% } %>
      <% }); %>
      <% if (!hasAny) { %>
      <p style="color:var(--text-light);font-size:14px;">لا توجد بنوك أسئلة متاحة حالياً</p>
      <% } %>
    </div>
  </div>

</main>
</body>
</html>
