<%- include('../partials/header', { title: title, navPageTitle: review.title, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/student/reviews" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-chevron-right"></i> العودة إلى المراجعات
      </a>
      <h1><%= review.title %></h1>
      <p style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <span><i class="fas fa-book" style="color:var(--accent);"></i> <%= review.course %></span>
        <span><i class="fas fa-calendar-alt" style="color:var(--accent);"></i> <%= review.date %></span>
      </p>
    </div>
  </div>

  <% if (review.videos && review.videos.length > 0) { %>
  <% review.videos.forEach(function(v, vi) { %>
  <div class="plyr__video-embed" id="yt-review-<%= vi %>" style="margin-bottom:16px;">
    <iframe src="https://www.youtube-nocookie.com/embed/<%= (ytId(v.url) || '') %>?controls=0&rel=0&iv_load_policy=3&playsinline=1&modestbranding=1&enablejsapi=1" allowfullscreen allowtransparency allow="autoplay" loading="lazy"></iframe>
  </div>
  <% }) %>
  <% } else if (review.videoUrl) { %>
  <div class="plyr__video-embed" id="yt-review-0">
    <iframe src="https://www.youtube-nocookie.com/embed/<%= (ytId(review.videoUrl) || '') %>?controls=0&rel=0&iv_load_policy=3&playsinline=1&modestbranding=1&enablejsapi=1" allowfullscreen allowtransparency allow="autoplay" loading="lazy"></iframe>
  </div>
  <% } else { %>
  <div class="welcome-banner" style="text-align:center;padding:60px 40px;">
    <div style="font-size:64px;margin-bottom:16px;color:var(--accent);"><i class="fas <%= review.icon %>"></i></div>
    <h2 style="font-family:'Aref Ruqaa',serif;font-size:24px;color:var(--accent);margin-bottom:8px;"><%= review.title %></h2>
    <p style="font-size:16px;color:var(--text-light);"><%= review.desc %></p>
    <div style="margin-top:16px;font-size:14px;color:var(--text-muted);"><i class="fas fa-video"></i> سيتم إضافة فيديو المراجعة قريباً</div>
  </div>
  <% } %>

  <div class="lesson-content">
    <h1><%= review.title %></h1>
    <p><%= review.desc %></p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;padding:16px;background:var(--bg);border-radius:8px;">
      <div><span style="font-weight:600;color:var(--primary);">المادة:</span> <span style="color:var(--text-light);"><%= review.course %></span></div>
      <div><span style="font-weight:600;color:var(--primary);">التاريخ:</span> <span style="color:var(--text-light);"><%= review.date %></span></div>
      <% if (review.quiz && review.quiz.questions && review.quiz.questions.length) { %><div><span style="font-weight:600;color:var(--primary);">عدد الأسئلة:</span> <span style="color:var(--text-light);"><%= review.quiz.questions.length %> سؤال</span></div><% } %>
    </div>
    <% if (review.pdfFiles && review.pdfFiles.length > 0) { %>
    <div class="lesson-actions" style="display:flex;flex-wrap:wrap;gap:10px;">
      <% review.pdfFiles.forEach(function(pf, pi) { %>
      <a href="/student/review-pdf/<%= review.id %>/<%= pi %>" class="btn"><i class="fas fa-file-pdf" style="color:var(--accent);"></i> <%= pf.title || ('الملف ' + (pi + 1)) %></a>
      <% }) %>
    </div>
    <% } else if (review.pdfUrl) { %>
    <div class="lesson-actions">
      <a href="/student/review-pdf/<%= review.id %>/0" class="btn"><i class="fas fa-file-pdf" style="color:var(--accent);"></i> عرض المذكرة PDF</a>
    </div>
    <% } %>
  </div>

   <% if (review.quiz && review.quiz.questions && review.quiz.questions.length) { %>
  <div class="quiz-section">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
      <h2 style="margin-bottom:0;"><i class="fas fa-question-circle" style="color:var(--accent);"></i> <%= review.quiz.title %></h2>
      <% if (review.quiz.timerMinutes) { %><span style="background:var(--primary);color:#fff;padding:6px 16px;border-radius:6px;font-size:14px;font-weight:600;">
        <i class="fas fa-clock"></i> <span id="timerDisplay"><%= String(review.quiz.timerMinutes).padStart(2,'0') %>:00</span>
      </span><% } %>
    </div>
    <p style="color:var(--text-light);font-size:14px;margin-bottom:24px;"><%= review.quiz.questions.length %> أسئلة - أجب عن جميع الأسئلة ثم اضغط على تقييم</p>

    <% review.quiz.questions.forEach(function(q, qi) { %>
    <div class="quiz-question" data-correct="<%= q.correct %>" data-wrong-msg="<%= (q.wrongAnswerMessage || '').replace(/\n/g,' ').replace(/"/g,'&quot;') %>">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="background:var(--accent);color:var(--primary);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;"><%= qi + 1 %></span>
        <h3 style="margin-bottom:0;font-size:16px;"><%= q.question %></h3>
      </div>
      <div class="quiz-options">
        <% q.options.forEach(function(o, oi) { %>
        <label class="quiz-option">
          <input type="radio" name="rev_q_<%= qi %>" value="<%= oi %>">
          <span><%= o %></span>
        </label>
        <% }) %>
      </div>
    </div>
    <% }) %>

    <div style="margin-top:28px;">
      <button class="btn btn-primary btn-sm btn-submit-review" style="width:100%;">
        <i class="fas fa-check-circle"></i> تقييم الإجابات
      </button>
    </div>
  </div>
  <% } %>
</main>

<script>
let seconds = <%= ((review.quiz && review.quiz.timerMinutes) || 15) * 60 %>;
let timerInterval;
var hasTimer = <%= !!(review.quiz && review.quiz.timerMinutes) %>;

function startReviewTimer() {
  if (!hasTimer) return;
  const display = document.getElementById('timerDisplay');
  if (!display) return;
  timerInterval = setInterval(() => {
    seconds--;
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    display.textContent = m.toString().padStart(2, '0') + ':' + s.toString().padStart(2, '0');
    if (seconds <= 0) {
      clearInterval(timerInterval);
      alert('انتهى الوقت!');
      document.querySelector('.btn-submit-review')?.click();
    }
  }, 1000);
}

startReviewTimer();

document.querySelectorAll('.btn-submit-review').forEach(function (btn) {
  btn.addEventListener('click', function () {
    clearInterval(timerInterval);
    const quiz = this.closest('.quiz-section');
    if (!quiz) return;
    const questions = quiz.querySelectorAll('.quiz-question');
    const total = questions.length;
    if (!total) return;
    let score = 0, allAnswered = true;

    questions.forEach(function (q) {
      const selected = q.querySelector('input[type="radio"]:checked');
      const options = q.querySelectorAll('.quiz-option');
      const correct = parseInt(q.dataset.correct, 10);
      if (!selected) { allAnswered = false; return; }
      const selIdx = parseInt(selected.value, 10);
      options.forEach(function (o, oi) {
        o.style.borderColor = oi === correct ? '#059669' : '';
        o.style.background = oi === correct ? 'rgba(5,150,105,0.08)' : '';
      });
      if (selIdx === correct) {
        score++;
      } else {
        selected.closest('.quiz-option').style.borderColor = '#DC2626';
        var wrongMsg = q.dataset.wrongMsg || 'إجابة غير صحيحة، راجع الدرس ثم حاول مرة أخرى.';
        if (!q.querySelector('.wrong-msg-card')) {
          var card = document.createElement('div');
          card.className = 'wrong-msg-card';
          card.style.cssText = 'margin-top:12px;padding:12px 14px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:10px;font-size:13px;color:#D97706;display:flex;align-items:center;gap:10px;line-height:1.6;';
          card.innerHTML = '<i class="fas fa-exclamation-triangle" style="font-size:16px;flex-shrink:0;"></i><span>' + wrongMsg + '</span>';
          q.appendChild(card);
        }
      }
    });

    if (!allAnswered) { alert('يرجى الإجابة على جميع الأسئلة أولاً'); return; }

    const pct = Math.round((score / total) * 100);
    let grade = 'ضعيف';
    if (pct >= 90) grade = 'ممتاز';
    else if (pct >= 75) grade = 'جيد جداً';
    else if (pct >= 60) grade = 'جيد';
    else if (pct >= 45) grade = 'مقبول';

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const resTextColor = isDark ? '#111' : '#fff';
    const results = '<div class="quiz-results" style="margin-top:20px;padding:24px;background:var(--card);border-radius:12px;border:1px solid var(--border);"><div style="text-align:center;padding:24px;background:var(--gold-gradient);border-radius:12px;color:' + resTextColor + ';margin-bottom:16px;"><div style="font-size:48px;font-weight:900;line-height:1;">' + score + '/' + total + '</div><div style="font-size:20px;opacity:0.85;">' + pct + '%</div><div style="font-size:26px;font-weight:700;margin-top:8px;">' + grade + '</div></div></div>';

    btn.style.display = 'none';
    quiz.querySelector('.quiz-results')?.remove();
    quiz.insertAdjacentHTML('beforeend', results);

    fetch('/api/analytics/quiz/submit', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        courseId: '<%= (review.courseId || "") %>',
        quizId: '<%= review.id %>',
        quizTitle: '<%= (review.title || "").replace(/"/g,"\\\"") %>',
        score: score,
        total: total,
        correct: score,
        wrong: total - score,
        timeTaken: 0
      })
    }).catch(function(){});
  });
});
</script>
<script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.plyr__video-embed').forEach(function(container) {
      var id = container.id;
      if (!id) return;
      var m = container.querySelector('iframe').src.match(/\/embed\/([^?]+)/);
      if (!m) return;
      var videoId = m[1];
      new Plyr('#' + id, {
        controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'fullscreen'],
        youtube: { noCookie: true, rel: 0, iv_load_policy: 3, modestbranding: 1, controls: 0, fs: 0, cc_load_policy: 0 },
        poster: 'https://img.youtube.com/vi/' + videoId + '/maxresdefault.jpg',
        ratio: '16:9',
        clickToPlay: true,
        hideControls: true,
        tooltips: { controls: true, seek: true }
      });
    });
  });
</script>
<%- include("../partials/footer") %>
</body>
</html>