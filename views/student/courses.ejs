<%- include('../partials/header', { title: title, navPageTitle: 'المحاضرات', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <h1>المحاضرات</h1>
      <p><%= userGrade ? 'محتوى ' + userGrade : 'جميع المحاضرات' %></p>
      <% var sem = currentSemester; if (sem && sem !== 'all') { %>
        <span style="display:inline-block;background:rgba(99,102,241,0.1);color:var(--accent);font-size:12px;padding:3px 10px;border-radius:4px;font-weight:600;margin-top:4px;">
          <i class="fas fa-calendar-alt"></i> <%= sem === 'first' ? 'الترم الأول' : 'الترم الثاني' %>
        </span>
      <% } %>
    </div>
  </div>

  <div id="studentCoursesContainer" class="courses-grid">
    <% if (courses.length === 0) { %>
    <div style="grid-column:1/-1;text-align:center;padding:60px 20px;background:var(--glass-bg);border-radius:var(--radius-xl);border:1px solid var(--border);">
      <i class="fas fa-book-open" style="font-size:48px;color:var(--border);display:block;margin-bottom:16px;"></i>
      <h3 style="font-size:20px;color:var(--text-light);margin-bottom:8px;">لا توجد محاضرات متاحة</h3>
      <p style="color:var(--text-muted);">لم يتم إضافة محتوى لصفك بعد</p>
    </div>
    <% } %>
    <% courses.forEach(function(course) { %>
    <a href="/student/course/<%= course.id %>" class="course-card">
      <div class="course-card-header">
        <div class="icon"><i class="fas <%= course.icon %>"></i></div>
        <h3><%= course.title %></h3>
        <p><%= course.subtitle %></p>
        <% if (course.grade) { %>
        <span style="display:inline-block;background:var(--accent-glow);color:var(--accent);font-size:11px;padding:2px 10px;border-radius:10px;font-weight:600;margin-top:4px;"><%= course.grade %></span>
        <% } %>
        <% if (course.semester) { %>
        <span style="display:inline-block;background:<%= course.semester === 'all' ? 'rgba(99,102,241,0.08)' : 'rgba(5,150,105,0.1)' %>;color:<%= course.semester === 'all' ? 'var(--text-light)' : 'var(--success)' %>;font-size:11px;padding:2px 10px;border-radius:10px;font-weight:600;margin-top:4px;margin-right:4px;">
          <%= course.semester === 'first' ? 'الترم الأول' : course.semester === 'second' ? 'الترم الثاني' : 'الترمين' %>
        </span>
        <% } %>
      </div>
    </a>
    <% }) %>
  </div>
</main>
</body>
</html>