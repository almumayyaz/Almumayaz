<%- include('../partials/header', { title: title, navPageTitle: 'الاختبار - ' + course.quiz.title, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/student/course/<%= course.id %>" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-chevron-right"></i> العودة إلى <%= course.title %>
      </a>
      <h1>الاختبار - <%= course.quiz.title %></h1>
      <p><%= (course.quiz.questions||[]).length %> أسئلة - أجب عن جميع الأسئلة ثم اضغط على تقييم</p>
    </div>
  </div>

  <div class="quiz-section">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
      <h2 style="margin-bottom:0;"><i class="fas fa-question-circle" style="color:var(--accent);"></i> <%= course.quiz.title %></h2>
      <% if (course.quiz.timerMinutes) { %><span id="examTimer" style="background:var(--primary);color:#fff;padding:6px 16px;border-radius:6px;font-size:14px;font-weight:600;">
        <i class="fas fa-clock"></i> <span id="timerDisplay"><%= String(course.quiz.timerMinutes).padStart(2,'0') %>:00</span>
      </span><% } %>
    </div>
    <p style="color:var(--text-light);font-size:14px;margin-bottom:24px;">أجب عن جميع الأسئلة التالية ثم اضغط على "تقييم الإجابات" لمعرفة نتيجتك</p>

    <% (course.quiz.questions||[]).forEach(function(q, qi) { %>
    <div class="quiz-question" data-correct="<%= q.correct %>">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="background:var(--accent);color:var(--primary);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;"><%= qi + 1 %></span>
        <h3 style="margin-bottom:0;font-size:16px;"><%= q.question %></h3>
      </div>
      <div class="quiz-options">
        <% q.options.forEach(function(o, oi) { %>
        <label class="quiz-option">
          <input type="radio" name="exam_q_<%= qi %>" value="<%= oi %>">
          <span><%= o %></span>
        </label>
        <% }) %>
      </div>
    </div>
    <% }) %>

    <div style="margin-top:28px;">
      <button class="btn btn-primary btn-sm btn-submit-quiz" style="width:100%;">
        <i class="fas fa-check-circle"></i> تقييم الإجابات
      </button>
    </div>
  </div>
</main>

<script>
let timerInterval;
let seconds = <%= (course.quiz.timerMinutes || 15) * 60 %>;
var hasTimer = <%= !!course.quiz.timerMinutes %>;

function startTimer() {
  if (!hasTimer) return;
  const display = document.getElementById('timerDisplay');
  timerInterval = setInterval(() => {
    seconds--;
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    display.textContent = m.toString().padStart(2, '0') + ':' + s.toString().padStart(2, '0');
    if (seconds <= 120) document.getElementById('examTimer').style.background = 'var(--danger)';
    if (seconds <= 0) {
      clearInterval(timerInterval);
      alert('انتهى الوقت!');
      document.querySelector('.btn-submit-quiz')?.click();
    }
  }, 1000);
}

startTimer();

document.querySelector('.btn-submit-quiz')?.addEventListener('click', function() {
  clearInterval(timerInterval);
});

/* ===== QUIZ SUBMIT ===== */
document.querySelectorAll('.btn-submit-quiz').forEach(btn => {
  btn.addEventListener('click', function () {
    const quiz = this.closest('.quiz-section');
    if (!quiz) return;
    const questions = quiz.querySelectorAll('.quiz-question');
    let score = 0, total = questions.length, allAnswered = true;

    questions.forEach((q, idx) => {
      const selected = q.querySelector('input[type="radio"]:checked');
      const options = q.querySelectorAll('.quiz-option');
      const correct = parseInt(q.dataset.correct);

      if (!selected) { allAnswered = false; return; }

      const selIdx = parseInt(selected.value);
      options.forEach((o, oi) => {
        o.style.borderColor = oi === correct ? '#059669' : '';
        o.style.background = oi === correct ? 'rgba(5,150,105,0.08)' : '';
      });
      if (selIdx === correct) { score++; }
      else { selected.closest('.quiz-option').style.borderColor = '#DC2626'; }
    });

    if (!allAnswered) { alert('يرجى الإجابة على جميع الأسئلة أولاً'); return; }

    const pct = Math.round((score / total) * 100);
    let grade = 'ضعيف';
    if (pct >= 90) { grade = 'ممتاز'; }
    else if (pct >= 75) { grade = 'جيد جداً'; }
    else if (pct >= 60) { grade = 'جيد'; }
    else if (pct >= 45) { grade = 'مقبول'; }

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const resTextColor = isDark ? '#111' : '#fff';
    const results = `
      <div class="quiz-results" style="margin-top:20px;padding:24px;background:var(--card);border-radius:12px;border:1px solid var(--border);">
        <div style="text-align:center;padding:24px;background:var(--gold-gradient);border-radius:12px;color:${resTextColor};margin-bottom:16px;">
          <div style="font-size:48px;font-weight:900;line-height:1;">${score}/${total}</div>
          <div style="font-size:20px;opacity:0.85;">${pct}%</div>
          <div style="font-size:26px;font-weight:700;margin-top:8px;">${grade}</div>
        </div>
      </div>`;

    this.style.display = 'none';
    quiz.querySelector('.quiz-results')?.remove();
    quiz.insertAdjacentHTML('beforeend', results);

    // Save quiz result to server
    fetch('/api/analytics/quiz/submit', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        courseId: '<%= course.id %>',
        quizId: '<%= (course.quiz.id || course.id) %>',
        quizTitle: '<%= (course.quiz.title || "اختبار") %>',
        score: score, total: total, correct: score, wrong: total - score, timeTaken: 0
      })
    }).catch(function(){});
  });
});
</script>
</body>
</html>
