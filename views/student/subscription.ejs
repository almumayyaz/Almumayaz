<%- include('../partials/header', { title: title, navPageTitle: 'الاشتراك', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <h1>الاشتراك</h1>
      <p>اختر خطة الاشتراك المناسبة لك وتمتع بجميع المميزات</p>
    </div>
  </div>

  <% if (isGuest) { %>
  <div style="background:var(--accent-glow);border:1px solid var(--accent);border-radius:var(--radius);padding:20px 24px;margin-bottom:20px;text-align:center;">
    <i class="fas fa-user-friends" style="font-size:32px;color:var(--accent);display:block;margin-bottom:12px;"></i>
    <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;">وضع الزائر</h3>
    <p style="font-size:14px;color:var(--text-light);margin-bottom:16px;">أنت تستخدم المنصة كزائر. أنشئ حساباً للوصول إلى جميع المحاضرات والمذكرات والمراجعات.</p>
    <a href="/register" class="btn btn-primary btn-lg"><i class="fas fa-user-plus"></i> إنشاء حساب مجاني</a>
  </div>
  <% } else { %>
  <div class="welcome-banner" style="padding:20px 24px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
      <i class="fas fa-credit-card" style="color:var(--accent);font-size:18px;"></i>
      <h3 style="font-size:16px;font-weight:700;color:var(--accent);font-family:'Aref Ruqaa',serif;margin:0;">حالة الاشتراك</h3>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <div>
        <div id="subStatusText" style="font-size:13px;font-weight:700;">
          <% if (user.subscriptionStatus === 'active') { %>
            <span style="color:var(--success);">مشترك <i class="fas fa-check-circle"></i><% if (user.planName) { %> — <%= user.planName %><% } %><% if (user.planPeriod) { %> · <%= user.planPeriod %><% } %></span>
          <% } else if (user.subscriptionStatus === 'expired') { %>
            <span style="color:#ca8a04;">منتهي <i class="fas fa-exclamation-circle"></i></span>
          <% } else if (user.subscriptionStatus === 'stopped' || user.subscriptionStatus === 'cancelled') { %>
            <span style="color:var(--danger);">موقوف <i class="fas fa-ban"></i></span>
          <% } else { %>
            غير مشترك
          <% } %>
        </div>
        <div style="font-size:12px;opacity:0.7;margin-top:2px;">
          <% if (user.subscriptionStatus === 'active' && user.subscriptionEnd) { %>
            ينتهي في: <%= new Date(user.subscriptionEnd).toLocaleDateString('ar-EG') %>
          <% } else { %>
            اشترك الآن للوصول إلى جميع المحاضرات والمذكرات
          <% } %>
        </div>
      </div>

    </div>
  </div>
  <% } %>

  <!-- Action Buttons Row -->
  <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap;">
    <button onclick="openChargePopup()" style="flex:1;min-width:130px;display:flex;align-items:center;justify-content:center;gap:6px;background:var(--accent-glow);border:1px solid var(--accent);border-radius:var(--radius);padding:10px 14px;cursor:pointer;transition:var(--transition);font-size:13px;font-weight:600;color:var(--text);font-family:inherit;">
      <i class="fas fa-barcode" style="color:var(--accent);"></i>
      تفعيل بكود شحن
    </button>
    <button onclick="openReferralPopup()" style="flex:1;min-width:130px;display:flex;align-items:center;justify-content:center;gap:6px;background:rgba(22,163,74,0.08);border:1px solid rgba(22,163,74,0.3);border-radius:var(--radius);padding:10px 14px;cursor:pointer;transition:var(--transition);font-size:13px;font-weight:600;color:var(--text);font-family:inherit;">
      <i class="fas fa-user-friends" style="color:var(--success);"></i>
      كود الدعوة — خصم <%= refDiscSetting %>%
    </button>
  </div>

  <!-- Referral Status (always visible) -->
  <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px 20px;margin-bottom:20px;box-shadow:var(--shadow);border:1px solid var(--border);">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <i class="fas fa-gift" style="color:var(--success);font-size:16px;"></i>
        <span style="font-size:13px;color:var(--text-light);">كودك للإحالة:</span>
        <span style="font-family:monospace;font-weight:700;font-size:16px;letter-spacing:2px;direction:ltr;"><%= user.referralCode || '---' %></span>
        <% if (user.referralCode) { %>
        <button class="btn btn-sm" onclick="navigator.clipboard.writeText('<%= user.referralCode %>');this.innerHTML='<i class=\\'fas fa-check\\'></i> تم';setTimeout(()=>this.innerHTML='<i class=\\'fas fa-copy\\'></i> نسخ',2000)" style="font-size:12px;padding:4px 10px;"><i class="fas fa-copy"></i> نسخ</button>
        <% } %>
      </div>
      <% if (user.referralDiscount) { %>
        <div style="display:flex;align-items:center;gap:6px;color:var(--success);font-weight:700;font-size:13px;">
          <i class="fas fa-check-circle"></i> خصم <%= user.referralDiscount %>% مفعل
        </div>
      <% } %>
    </div>
  </div>

  <div class="subscription-plans">
    <% subscriptions.forEach(function(sub, idx) { %>
    <div class="sub-card <%= sub.popular ? 'popular' : '' %>">
      <% if (sub.popular) { %><div class="sub-badge">الأكثر طلباً</div><% } %>
      <div class="sub-header">
        <h3><%= sub.name %></h3>
        <div class="sub-price">
          <% var priceNum = parseInt(sub.price) || 0; %>
          <% if (user.referralDiscount) { var discounted = priceNum - (priceNum * user.referralDiscount / 100); %>
            <span style="text-decoration:line-through;opacity:0.5;font-size:16px;display:block;"><%= sub.price %></span>
            <span class="amount" style="color:var(--success);"><%= discounted %></span>
            <span class="currency"><%= sub.currency %></span>
            <span style="display:block;font-size:11px;color:var(--success);">بعد خصم <%= user.referralDiscount %>%</span>
          <% } else { %>
            <span class="amount"><%= sub.price %></span>
            <span class="currency"><%= sub.currency %></span>
          <% } %>
        </div>
        <div class="sub-period"><%= sub.period %></div>
      </div>
      <div class="sub-features-wrap">
        <ul class="sub-features" id="subFeatures<%= idx %>">
          <% sub.features.forEach(function(f) { %>
          <li><i class="fas fa-check"></i> <%= f %></li>
          <% }) %>
        </ul>
      </div>
      <button class="btn btn-primary" onclick="openSubPopup(<%= idx %>, '<%= sub.name %>', '<%= sub.price %>')">اشترك الآن</button>
      <div class="sub-expand" onclick="toggleFeatures(<%= idx %>)"><span>عرض المزايا</span> <i class="fas fa-chevron-down"></i></div>
    </div>
    <% }) %>
  </div>
</main>

<!-- Subscription Payment Popup -->
<div class="modal-overlay" id="subPopup">
  <div class="modal" style="max-width:460px;">
    <div class="modal-header">
      <h3>اشتراك: <span id="popupPlanName"></span></h3>
      <button class="modal-close" onclick="closeSubPopup()">&times;</button>
    </div>
    <div class="modal-body">
      <div style="background:var(--accent-glow);border:1px solid var(--accent);border-radius:var(--radius);padding:16px;margin-bottom:16px;text-align:center;">
        <div style="font-size:13px;font-weight:700;margin-bottom:8px;">المطلوب: <span id="popupPlanPrice" style="color:var(--accent);font-size:20px;"></span> جنيه</div>
        <div id="popupDiscountInfo" style="display:none;font-size:12px;color:var(--success);font-weight:600;margin-top:4px;"><i class="fas fa-tag"></i> شامل خصم الدعوة</div>
      </div>

      <div style="background:var(--bg);border-radius:var(--radius);padding:16px;margin-bottom:16px;">
        <div style="font-weight:700;font-size:14px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
          <i class="fas fa-info-circle" style="color:var(--accent);"></i> بيانات الدفع
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13px;">
          <div style="display:flex;justify-content:space-between;padding:8px 12px;background:var(--card);border-radius:8px;">
            <span style="color:var(--text-light);">فودافون كاش</span>
            <span dir="ltr" style="font-weight:700;font-family:monospace;font-size:15px;color:var(--accent);"><%= vodafoneCash %></span>
          </div>
          <div style="display:flex;justify-content:space-between;padding:8px 12px;background:var(--card);border-radius:8px;">
            <span style="color:var(--text-light);">إنستا باي</span>
            <span dir="ltr" style="font-weight:700;font-family:monospace;font-size:15px;color:var(--accent);"><%= instaPay %></span>
          </div>
        </div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:12px;text-align:center;">
          <i class="fas fa-check-circle" style="color:var(--success);"></i> حول المبلغ على أي من الرقمين ثم أدخل كود العملية
        </div>
      </div>

      <div id="subFormError" style="display:none;background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.2);border-radius:var(--radius);padding:12px;margin-bottom:12px;text-align:center;font-size:13px;color:var(--danger);">
        <span id="subFormErrorText"></span>
      </div>

      <input type="hidden" id="subPlanName">
      <input type="hidden" id="subPlanPrice">
      <div class="form-group">
        <label>كود العملية (رقم المعاملة)</label>
        <input type="text" id="subTransactionId" class="form-input" placeholder="أدخل كود العملية من المحفظة" style="direction:rtl;">
      </div>
      <input type="hidden" id="subStage" value="<%= user.stage || '' %>">
      <div class="form-group">
        <label>طريقة التحويل</label>
        <select id="subPaymentMethod" class="form-input">
          <option value="vodafone-cash">فودافون كاش</option>
          <option value="instapay">إنستا باي</option>
        </select>
      </div>
      <div class="form-group">
        <label>صورة الإيصال</label>
        <div style="position:relative;">
          <input type="file" id="subReceiptImage" accept="image/*" style="display:none;" onchange="handleSubReceiptUpload(event)">
          <div id="subReceiptUploadArea" style="border:2px dashed var(--border);border-radius:var(--radius);padding:20px;text-align:center;cursor:pointer;transition:var(--transition);" onclick="document.getElementById('subReceiptImage').click()">
            <i class="fas fa-cloud-upload-alt" style="font-size:30px;color:var(--accent);margin-bottom:6px;display:block;"></i>
            <span style="font-size:13px;font-weight:600;color:var(--text);">اضغط لرفع صورة الإيصال</span>
            <span style="display:block;font-size:11px;color:var(--text-muted);margin-top:2px;">PNG, JPG - الحد الأقصى 5 ميجابايت</span>
          </div>
        </div>
        <div id="subReceiptPreview" style="display:none;margin-top:10px;position:relative;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--border);">
          <img id="subReceiptPreviewImg" style="width:100%;max-height:140px;object-fit:contain;background:var(--bg);">
          <button type="button" onclick="removeSubReceipt()" style="position:absolute;top:6px;left:6px;background:rgba(220,38,38,0.9);color:#fff;border:none;border-radius:50%;width:28px;height:28px;cursor:pointer;font-size:13px;display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
      <button class="btn btn-primary btn-lg" onclick="submitSubscription()" id="subSubmitBtn" style="width:100%;">
        <i class="fas fa-check"></i> تأكيد الاشتراك
      </button>
    </div>
  </div>
</div>

<!-- Charge Code Popup -->
<div class="modal-overlay" id="chargePopup">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <h3><i class="fas fa-barcode" style="color:var(--accent);"></i> تفعيل بكود شحن</h3>
      <button class="modal-close" onclick="closeChargePopup()">&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--text-light);margin-bottom:16px;">أدخل كود الشحن الذي حصلت عليه من الأستاذ محمد عفيفي</p>
      <div id="redeemMessage" style="display:none;padding:12px;border-radius:8px;margin-bottom:12px;text-align:center;font-size:13px;font-weight:600;"></div>
      <div class="form-group">
        <input type="text" id="redeemCode" class="form-input" placeholder="أدخل كود الشحن" style="direction:rtl;text-align:center;font-family:monospace;font-size:18px;letter-spacing:2px;">
      </div>
      <button class="btn btn-primary btn-lg" onclick="redeemCode()" id="redeemBtn" style="width:100%;"><i class="fas fa-check"></i> تفعيل</button>
    </div>
  </div>
</div>

<!-- Referral Code Popup -->
<div class="modal-overlay" id="referralPopup">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <h3><i class="fas fa-user-friends" style="color:var(--success);"></i> استخدام كود دعوة</h3>
      <button class="modal-close" onclick="closeReferralPopup()">&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--text-light);margin-bottom:16px;">أدخل كود دعوة صديق للحصول على خصم على جميع خطط الاشتراك</p>
      <div id="referralMessage" style="display:none;padding:12px;border-radius:8px;margin-bottom:12px;text-align:center;font-size:13px;font-weight:600;"></div>
      <div class="form-group">
        <input type="text" id="referralCode" class="form-input" placeholder="أدخل كود دعوة صديق" style="direction:rtl;text-align:center;font-family:monospace;font-size:18px;letter-spacing:2px;">
      </div>
      <button class="btn btn-lg" style="width:100%;background:var(--success);color:#fff;border:none;border-radius:var(--radius);padding:14px;font-size:15px;font-weight:700;cursor:pointer;" onclick="applyReferral()" id="referralBtn"><i class="fas fa-percent"></i> تطبيق الخصم</button>
    </div>
  </div>
</div>

<style>
  .sub-features-wrap { overflow:hidden; max-height:0; transition:max-height 0.4s ease; }
  .sub-features-wrap.open { max-height:600px; }

  .sub-expand { display:flex; align-items:center; justify-content:center; gap:6px; padding:10px; cursor:pointer; color:var(--text); font-size:13px; font-weight:600; transition:var(--transition); background:var(--card-alt); border-radius:0 0 var(--radius-xl) var(--radius-xl); }
  .sub-expand:hover { color:var(--accent); background:var(--accent-glow); }
  .sub-expand i { font-size:13px; transition:transform 0.3s ease; }
  .sub-expand.open i { transform:rotate(180deg); }
  .sub-card.expanded .sub-expand { background:var(--card-alt); }
</style>

<script>
function toggleFeatures(idx) {
  var wrap = document.getElementById('subFeatures' + idx);
  if (!wrap) return;
  var parent = wrap.closest('.sub-features-wrap');
  parent.classList.toggle('open');
  var card = parent.closest('.sub-card');
  card.classList.toggle('expanded', parent.classList.contains('open'));
  var expand = card.querySelector('.sub-expand');
  expand.classList.toggle('open', parent.classList.contains('open'));
}

var subReceiptBase64 = null;
function handleSubReceiptUpload(e) {
  var file = e.target.files[0];
  if (!file) return;
  if (file.size > 5 * 1024 * 1024) { alert('حجم الصورة يجب أن يكون أقل من 5 ميجابايت'); return; }
  var reader = new FileReader();
  reader.onload = function(ev) {
    subReceiptBase64 = ev.target.result;
    document.getElementById('subReceiptPreviewImg').src = subReceiptBase64;
    document.getElementById('subReceiptPreview').style.display = 'block';
    document.getElementById('subReceiptUploadArea').style.display = 'none';
  };
  reader.readAsDataURL(file);
}
function removeSubReceipt() {
  subReceiptBase64 = null;
  document.getElementById('subReceiptPreview').style.display = 'none';
  document.getElementById('subReceiptUploadArea').style.display = 'block';
  document.getElementById('subReceiptImage').value = '';
}

function openSubPopup(idx, name, price) {
  var discount = <%= user.referralDiscount || 0 %>;
  var priceNum = parseInt(price) || 0;
  var finalPrice = discount > 0 ? Math.round(priceNum - (priceNum * discount / 100)) : priceNum;
  document.getElementById('popupPlanName').textContent = name;
  if (discount > 0) {
    document.getElementById('popupPlanPrice').innerHTML = '<span style="text-decoration:line-through;opacity:0.5;margin-left:8px;font-size:14px;">' + price + '</span> <strong style="color:var(--success);font-size:22px;">' + finalPrice + '</strong>';
    document.getElementById('popupDiscountInfo').style.display = 'block';
  } else {
    document.getElementById('popupPlanPrice').textContent = price;
    document.getElementById('popupDiscountInfo').style.display = 'none';
  }
  document.getElementById('subPlanName').value = name;
  document.getElementById('subPlanPrice').value = finalPrice;
  document.getElementById('subFormError').style.display = 'none';
  document.getElementById('subTransactionId').value = '';
  removeSubReceipt();
  document.getElementById('subPopup').classList.add('show');
}
function closeSubPopup() { document.getElementById('subPopup').classList.remove('show'); }
document.getElementById('subPopup').addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });

function openChargePopup() { document.getElementById('chargePopup').classList.add('show'); }
function closeChargePopup() { document.getElementById('chargePopup').classList.remove('show'); }
document.getElementById('chargePopup').addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });

function openReferralPopup() { document.getElementById('referralPopup').classList.add('show'); }
function closeReferralPopup() { document.getElementById('referralPopup').classList.remove('show'); }
document.getElementById('referralPopup').addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });

function redeemCode() {
  var code = document.getElementById('redeemCode').value.trim();
  var msg = document.getElementById('redeemMessage');
  var btn = document.getElementById('redeemBtn');
  if (!code) { msg.style.display = 'block'; msg.style.background = 'rgba(220,38,38,0.1)'; msg.style.color = 'var(--danger)'; msg.textContent = 'يرجى إدخال كود الشحن'; return; }
  msg.style.display = 'none';
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  fetch('/api/student/redeem-code', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({code:code}) })
  .then(function(r){return r.json()})
  .then(function(d){
    if(d.success){
      document.getElementById('chargePopup').innerHTML = '<div style="padding:60px 24px;text-align:center;"><i class="fas fa-check-circle" style="font-size:56px;color:var(--success);display:block;margin-bottom:16px;"></i><h2 style="font-family:\'Aref Ruqaa\',serif;font-size:22px;font-weight:700;margin-bottom:8px;">✅ تم التفعيل بنجاح!</h2><p style="font-size:14px;color:var(--text-light);margin-bottom:20px;">اشتراكك نشط الآن. يمكنك مشاهدة جميع المحاضرات.</p><button class="btn btn-primary" onclick="location.reload()"><i class="fas fa-check"></i> حسناً</button></div>';
      setTimeout(function(){ location.reload(); }, 2000);
    } else {
      msg.style.display='block'; msg.style.background='rgba(220,38,38,0.1)'; msg.style.color='var(--danger)'; msg.textContent = d.error || 'الكود غير صالح';
    }
    btn.disabled=false; btn.innerHTML='<i class="fas fa-check"></i> تفعيل';
  })
  .catch(function(){ msg.style.display='block'; msg.style.background='rgba(220,38,38,0.1)'; msg.style.color='var(--danger)'; msg.textContent='حدث خطأ في الاتصال'; btn.disabled=false; btn.innerHTML='<i class="fas fa-check"></i> تفعيل'; });
}

function submitSubscription() {
  var transactionId = document.getElementById('subTransactionId').value.trim();
  var planName = document.getElementById('subPlanName').value;
  var price = document.getElementById('subPlanPrice').value;
  var paymentMethod = document.getElementById('subPaymentMethod').value;
  var errDiv = document.getElementById('subFormError');
  var errText = document.getElementById('subFormErrorText');
  errDiv.style.display = 'none';
  if (!transactionId) { errDiv.style.display = 'block'; errText.textContent = 'يرجى إدخال كود العملية'; return; }
  if (!subReceiptBase64) { errDiv.style.display = 'block'; errText.textContent = 'يرجى رفع صورة الإيصال'; return; }
  var btn = document.getElementById('subSubmitBtn');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإرسال...';
  fetch('/api/student/subscribe', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ planName: planName, price: Number(price), transactionId: transactionId, paymentMethod: paymentMethod, receiptImage: subReceiptBase64 })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) {
      document.getElementById('subPopup').innerHTML = '<div style="padding:60px 24px;text-align:center;"><i class="fas fa-check-circle" style="font-size:56px;color:var(--success);display:block;margin-bottom:16px;"></i><h2 style="font-family:\'Aref Ruqaa\',serif;font-size:22px;font-weight:700;margin-bottom:8px;">✅ تم إرسال طلب الاشتراك</h2><p style="font-size:14px;color:var(--text-light);margin-bottom:20px;">في انتظار موافقة الأستاذ محمد عفيفي. سيتم تفعيل اشتراكك فور الموافقة.</p><button class="btn btn-primary" onclick="location.reload()"><i class="fas fa-home"></i> العودة</button></div>';
    } else {
      errDiv.style.display = 'block'; errText.textContent = d.error || 'حدث خطأ';
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> تأكيد الاشتراك';
    }
  }).catch(function() {
    errDiv.style.display = 'block'; errText.textContent = 'حدث خطأ في الاتصال';
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> تأكيد الاشتراك';
  });
}

function applyReferral() {
  var code = document.getElementById('referralCode').value.trim();
  var msg = document.getElementById('referralMessage');
  var btn = document.getElementById('referralBtn');
  if (!code) { msg.style.display = 'block'; msg.style.background = 'rgba(220,38,38,0.1)'; msg.style.color = 'var(--danger)'; msg.textContent = 'يرجى إدخال كود الدعوة'; return; }
  msg.style.display = 'none';
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  fetch('/api/student/apply-referral', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({code:code}) })
  .then(function(r){return r.json()})
  .then(function(d){
    if(d.success){
      closeReferralPopup();
      location.reload();
    } else {
      msg.style.display='block'; msg.style.background='rgba(220,38,38,0.1)'; msg.style.color='var(--danger)'; msg.textContent = d.error || 'الكود غير صالح';
    }
    btn.disabled=false; btn.innerHTML='<i class="fas fa-percent"></i> تطبيق الخصم';
  })
  .catch(function(){ msg.style.display='block'; msg.style.background='rgba(220,38,38,0.1)'; msg.style.color='var(--danger)'; msg.textContent='حدث خطأ في الاتصال'; btn.disabled=false; btn.innerHTML='<i class="fas fa-percent"></i> تطبيق الخصم'; });
}
</script>
<%- include("../partials/footer") %>
</body>
</html>
