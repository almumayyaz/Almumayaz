<%- include('../partials/header', { title: title, navPageTitle: 'بنك أسئلة ' + course.title, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/student/question-bank" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-chevron-right"></i> العودة إلى بنك الأسئلة
      </a>
      <h1>بنك أسئلة <%= course.title %></h1>
      <p>بنوك أسئلة تدريبية مع التصحيح الفوري</p>
    </div>
  </div>

  <% courseBanks.forEach(function(bank, bi) { %>
  <div class="quiz-section" data-bank="<%= bi %>" style="margin-bottom:28px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
      <h2 style="margin-bottom:0;"><i class="fas fa-question-circle" style="color:<%= course.color %>;"></i> <%= bank.title %></h2>
      <% if (bank.timerMinutes) { %><span style="background:var(--primary);color:#fff;padding:6px 16px;border-radius:6px;font-size:14px;font-weight:600;">
        <i class="fas fa-clock"></i> <span class="timerDisplay" data-bank="<%= bi %>"><%= String(bank.timerMinutes).padStart(2,'0') %>:00</span>
      </span><% } %>
    </div>
    <% if (bank.description) { %><p style="font-size:14px;color:var(--text-light);margin-bottom:16px;"><%= bank.description %></p><% } %>

    <% (bank.questions||[]).forEach(function(q, qi) { %>
    <div class="quiz-question" data-correct="<%= q.correct %>" data-bank="<%= bi %>">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="background:var(--gold-gradient);color:var(--primary);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;"><%= qi + 1 %></span>
        <h3 style="margin-bottom:0;font-size:16px;"><%= q.question %></h3>
      </div>
      <div class="quiz-options">
        <% q.options.forEach(function(o, oi) { %>
        <label class="quiz-option">
          <input type="radio" name="qb_q_<%= bi %>_<%= qi %>" value="<%= oi %>">
          <span><%= o %></span>
        </label>
        <% }) %>
      </div>
    </div>
    <% }) %>

    <div style="margin-top:28px;">
      <button class="btn btn-primary btn-sm btn-submit-bank" data-bank="<%= bi %>" style="width:100%;">
        <i class="fas fa-check-circle"></i> تقييم الإجابات
      </button>
    </div>
  </div>
  <% }) %>

</main>

<script>
var timerIntervals = {};
var bankTimers = {};
<% courseBanks.forEach(function(bank, bi) { %>
  <% if (bank.timerMinutes) { %>
    bankTimers[<%= bi %>] = { seconds: <%= bank.timerMinutes * 60 %>, running: true };
  <% } %>
<% }); %>

function startBankTimer(bi) {
  var t = bankTimers[bi];
  if (!t) return;
  var display = document.querySelector('.timerDisplay[data-bank="' + bi + '"]');
  if (!display) return;
  timerIntervals[bi] = setInterval(function() {
    t.seconds--;
    var m = Math.floor(t.seconds / 60);
    var s = t.seconds % 60;
    display.textContent = m.toString().padStart(2, '0') + ':' + s.toString().padStart(2, '0');
    if (t.seconds <= 0) {
      clearInterval(timerIntervals[bi]);
      t.running = false;
      alert('انتهى الوقت!');
      document.querySelector('.btn-submit-bank[data-bank="' + bi + '"]')?.click();
    }
  }, 1000);
}

document.querySelectorAll('.btn-submit-bank').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var bi = this.dataset.bank;
    if (bankTimers[bi] && timerIntervals[bi]) {
      clearInterval(timerIntervals[bi]);
      bankTimers[bi].running = false;
    }
    var quiz = this.closest('.quiz-section');
    if (!quiz) return;
    var questions = quiz.querySelectorAll('.quiz-question');
    var score = 0, total = questions.length, allAnswered = true;

    questions.forEach(function(q) {
      var selected = q.querySelector('input[type="radio"]:checked');
      var options = q.querySelectorAll('.quiz-option');
      var correct = parseInt(q.dataset.correct);
      if (!selected) { allAnswered = false; return; }
      var selIdx = parseInt(selected.value);
      options.forEach(function(o, oi) {
        o.style.borderColor = oi === correct ? '#059669' : '';
        o.style.background = oi === correct ? 'rgba(5,150,105,0.08)' : '';
      });
      if (selIdx === correct) { score++; }
      else { selected.closest('.quiz-option').style.borderColor = '#DC2626'; }
    });

    if (!allAnswered) { alert('يرجى الإجابة على جميع الأسئلة أولاً'); return; }

    var pct = Math.round((score / total) * 100);
    var grade = 'ضعيف';
    if (pct >= 90) { grade = 'ممتاز'; }
    else if (pct >= 75) { grade = 'جيد جداً'; }
    else if (pct >= 60) { grade = 'جيد'; }
    else if (pct >= 45) { grade = 'مقبول'; }

    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    var resTextColor = isDark ? '#111' : '#fff';
    var results = '<div class="quiz-results" style="margin-top:20px;padding:24px;background:var(--card);border-radius:12px;border:1px solid var(--border);"><div style="text-align:center;padding:24px;background:var(--gold-gradient);border-radius:12px;color:' + resTextColor + ';margin-bottom:16px;"><div style="font-size:48px;font-weight:900;line-height:1;">' + score + '/' + total + '</div><div style="font-size:20px;opacity:0.85;">' + pct + '%</div><div style="font-size:26px;font-weight:700;margin-top:8px;">' + grade + '</div></div></div>';

    this.style.display = 'none';
    quiz.querySelector('.quiz-results')?.remove();
    quiz.insertAdjacentHTML('beforeend', results);
  });
});

<% courseBanks.forEach(function(bank, bi) { %>
  <% if (bank.timerMinutes) { %>startBankTimer(<%= bi %>);<% } %>
<% }); %>
</script>
</body>
</html>