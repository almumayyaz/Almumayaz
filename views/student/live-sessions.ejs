<%- include('../partials/header', { title: title, navPageTitle: 'المُميز', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <h1><i class="fas fa-video" style="color:var(--accent);"></i> الحصص المباشرة</h1>
  </div>

  <div id="sessionsContainer" style="display:flex;flex-direction:column;gap:12px;">
    <% if (sessions.length === 0) { %>
      <div style="text-align:center;padding:40px;color:var(--text-muted);font-size:14px;">لا توجد حصص مباشرة متاحة حالياً.</div>
    <% } %>
    <% sessions.forEach(function(s) { %>
      <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px 20px;border:1px solid var(--border);" data-id="<%= s.id %>">
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;">
          <div style="flex:1;min-width:200px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
              <% if (s.status === 'Live') { %>
                <span style="display:inline-flex;align-items:center;gap:4px;background:#dc262620;color:#dc2626;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;">
                  <span style="width:6px;height:6px;background:#dc2626;border-radius:50%;display:inline-block;animation:pulse 1.5s infinite;"></span>
                  مباشر الآن
                </span>
              <% } else if (s.status === 'Ended') { %>
                <span style="display:inline-flex;align-items:center;gap:4px;background:#6b728020;color:#6b7280;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;">
                  <i class="fas fa-check-circle" style="font-size:10px;"></i>
                  منتهية
                </span>
              <% } else if (s.status === 'Cancelled') { %>
                <span style="display:inline-flex;align-items:center;gap:4px;background:#dc262620;color:#dc2626;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;">
                  <i class="fas fa-ban" style="font-size:10px;"></i>
                  ملغاة
                </span>
              <% } else { %>
                <span style="display:inline-flex;align-items:center;gap:4px;background:#2563eb20;color:#2563eb;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;">
                  <i class="fas fa-clock" style="font-size:10px;"></i>
                  مجدولة
                </span>
              <% } %>
            </div>
            <div style="font-weight:700;font-size:15px;margin-bottom:4px;"><%= s.title %></div>
            <div style="font-size:12px;color:var(--text-muted);display:flex;flex-wrap:wrap;gap:6px 14px;">
              <% if (s.subject) { %><span><i class="fas fa-book" style="color:var(--accent);"></i> <%= s.subject %></span><% } %>
              <% if (s.grade) { %><span><i class="fas fa-layer-group" style="color:var(--accent);"></i> <%= s.grade %></span><% } %>
              <span><i class="fas fa-calendar" style="color:var(--accent);"></i> <%= new Date(s.startTime).toLocaleDateString('ar-EG', { timeZone:'Africa/Cairo', weekday:'short', year:'numeric', month:'short', day:'numeric' }) %></span>
              <span><i class="fas fa-clock" style="color:var(--accent);"></i> <%= new Date(s.startTime).toLocaleTimeString('ar-EG', { timeZone:'Africa/Cairo', hour:'2-digit', minute:'2-digit' }) %></span>
              <% if (s.duration) { %><span><i class="fas fa-hourglass-half" style="color:var(--accent);"></i> <%= s.duration %> دقيقة</span><% } %>
            </div>
          </div>
          <div>
            <% if (s.status === 'Live') { %>
              <a href="/student/live-session/<%= s.id %>" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;">
                <i class="fas fa-video"></i> انضم الآن
              </a>
            <% } else { %>
              <a href="/student/live-session/<%= s.id %>" class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;">
                <i class="fas fa-info-circle"></i> عرض التفاصيل
              </a>
            <% } %>
          </div>
        </div>
        <% if (s.status === 'Scheduled') { %>
          <div class="countdown" data-start="<%= s.startTime %>" style="margin-top:10px;font-size:12px;color:var(--accent);font-weight:600;"></div>
        <% } %>
      </div>
    <% }) %>
  </div>
</main>

<script>
(function() {
  var counts = document.querySelectorAll('.countdown');
  function tick() {
    var now = Date.now();
    counts.forEach(function(el) {
      var start = new Date(el.getAttribute('data-start')).getTime();
      var diff = start - now;
      if (diff <= 0) { el.textContent = 'بدأت الحصة'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.textContent = 'تبدأ بعد ' + h + 'س ' + m + 'د ' + s + 'ث';
    });
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

<%- include('../partials/footer') %>
