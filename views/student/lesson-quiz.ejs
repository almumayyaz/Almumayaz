<%- include('../partials/header', { title: title, navPageTitle: 'اختبار الدرس', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/student/lesson/<%= course.id %>/<%= lesson.id %>" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-chevron-right"></i> العودة إلى <%= lesson.title %>
      </a>
      <h1>اختبار الدرس</h1>
      <p><%= lesson.title %> - <%= (lesson.quiz.questions||[]).length %> أسئلة</p>
    </div>
  </div>

  <div class="quiz-section">
    <% if (quizDone) { %>
    <div style="text-align:center;padding:40px 20px;background:rgba(22,163,74,0.06);border:1px solid rgba(22,163,74,0.2);border-radius:var(--radius-lg);">
      <i class="fas fa-check-circle" style="font-size:48px;color:var(--success);display:block;margin-bottom:12px;"></i>
      <h3 style="font-size:18px;color:var(--success);margin-bottom:8px;">لقد أجبت على هذا الاختبار من قبل</h3>
      <p style="color:var(--text-muted);font-size:13px;">يمكنك مراجعة الدرس أو الانتقال للدرس التالي</p>
      <div style="display:flex;gap:12px;justify-content:center;margin-top:16px;flex-wrap:wrap;">
        <a href="/student/lesson/<%= course.id %>/<%= lesson.id %>" class="btn" style="background:var(--card);border:1px solid var(--border);"><i class="fas fa-book"></i> العودة للدرس</a>
        <% if (nextLesson) { %><a href="/student/lesson/<%= course.id %>/<%= nextLesson.id %>" class="btn btn-primary"><i class="fas fa-arrow-left"></i> الدرس التالي</a><% } %>
        <a href="/student/course/<%= course.id %>" class="btn" style="background:var(--card);border:1px solid var(--border);"><i class="fas fa-list"></i> كل الدروس</a>
      </div>
    </div>
    <% } else { %>
    <p style="color:var(--text-light);font-size:14px;margin-bottom:24px;">أجب عن جميع الأسئلة التالية ثم اضغط على "تقييم الإجابات"</p>

    <% (lesson.quiz.questions||[]).forEach(function(q, qi) { %>
    <div class="quiz-question" data-correct="<%= q.correct %>">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="background:var(--accent);color:var(--primary);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;"><%= qi + 1 %></span>
        <h3 style="margin-bottom:0;font-size:16px;"><%= q.question %></h3>
      </div>
      <div class="quiz-options">
        <% q.options.forEach(function(o, oi) { %>
        <label class="quiz-option">
          <input type="radio" name="lq_<%= qi %>" value="<%= oi %>">
          <span><%= o %></span>
        </label>
        <% }) %>
      </div>
    </div>
    <% }) %>

    <div style="margin-top:28px;">
      <button class="btn btn-primary btn-sm btn-submit-quiz" style="width:100%;">
        <i class="fas fa-check-circle"></i> تقييم الإجابات
      </button>
    </div>
    <% } %>
  </div>
</main>

<script>
(function() {
  var courseId = '<%= course.id %>';
  var lessonId = '<%= lesson.id %>';
  var passPct = <%= (lesson.quiz && lesson.quiz.passPercentage) || 60 %>;
  var nextLessonUrl = '<%= nextLesson ? "/student/lesson/" + course.id + "/" + nextLesson.id : "" %>';
  var nextLessonTitle = <%- JSON.stringify(nextLesson ? nextLesson.title : '') %>;

  document.querySelector('.btn-submit-quiz').addEventListener('click', async function() {
    var quiz = this.closest('.quiz-section');
    if (!quiz) return;
    var questions = quiz.querySelectorAll('.quiz-question');
    var score = 0, total = questions.length, allAnswered = true;

    questions.forEach(function(q, idx) {
      var selected = q.querySelector('input[type="radio"]:checked');
      var options = q.querySelectorAll('.quiz-option');
      var correct = parseInt(q.dataset.correct);
      if (!selected) { allAnswered = false; return; }
      var selIdx = parseInt(selected.value);
      options.forEach(function(o, oi) {
        o.style.borderColor = oi === correct ? '#059669' : '';
        o.style.background = oi === correct ? 'rgba(5,150,105,0.08)' : '';
      });
      if (selIdx === correct) { score++; }
      else { selected.closest('.quiz-option').style.borderColor = '#DC2626'; }
    });

    if (!allAnswered) { alert('يرجى الإجابة على جميع الأسئلة أولاً'); return; }

    var pct = Math.round((score / total) * 100);
    var passed = pct >= passPct;
    var grade = passed ? 'ناجح ✓' : 'لم تحقق نسبة النجاح';
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    var resTextColor = isDark ? '#111' : '#fff';

    this.style.display = 'none';
    var existing = quiz.querySelector('.quiz-results');
    if (existing) existing.remove();

    // Submit quiz to server (server marks lesson complete if passed)
    try {
      await fetch('/api/analytics/quiz/submit', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ courseId: courseId, quizId: lessonId, quizTitle: '<%= lesson.title %>', score: score, total: total, correct: score, wrong: total - score, timeTaken: 0 })
      });
    } catch(e) {}

    var results =
      '<div class="quiz-results" style="margin-top:20px;padding:24px;background:var(--card);border-radius:12px;border:1px solid var(--border);">' +
        '<div style="text-align:center;padding:24px;background:var(--gold-gradient);border-radius:12px;color:' + resTextColor + ';margin-bottom:16px;">' +
          '<div style="font-size:48px;font-weight:900;line-height:1;">' + score + '/' + total + '</div>' +
          '<div style="font-size:20px;opacity:0.85;">' + pct + '%</div>' +
          '<div style="font-size:26px;font-weight:700;margin-top:8px;">' + grade + '</div>' +
        '</div>';

    // Mark lesson as completed after passing quiz
    if (passed) {
      try {
        await fetch('/api/student/progress', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ courseId: courseId, lessonId: lessonId, completed: true })
        });
      } catch(e) {}
    }

    if (passed && nextLessonUrl) {
      results += '<a href="' + nextLessonUrl + '" class="btn btn-primary" style="width:100%;padding:14px;border-radius:12px;font-size:15px;">' +
        '<i class="fas fa-arrow-left"></i> الانتقال للدرس التالي: ' + nextLessonTitle + '</a>';
    } else if (passed && !nextLessonUrl) {
      results += '<a href="/student/course/' + courseId + '" class="btn" style="width:100%;padding:14px;border-radius:12px;font-size:15px;background:var(--card);border:1px solid var(--border);">' +
        '<i class="fas fa-check-circle"></i> العودة للمادة</a>';
    }
    results += '</div>';

    quiz.insertAdjacentHTML('beforeend', results);
  });
})();
</script>
<%- include("../partials/footer") %>
</body>
</html>
