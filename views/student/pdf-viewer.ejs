<%- include('../partials/header', { title: title, navPageTitle: pdfTitle, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content" oncontextmenu="return false;">
  <div class="page-header">
    <div>
      <a href="/student/course/<%= course.id %>" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-arrow-right"></i> العودة إلى <%= course.title %>
      </a>
      <h1><%= pdfTitle %></h1>
      <p style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <span><i class="fas fa-book" style="color:var(--accent);"></i> <%= course.title %></span>
        <span><i class="fas fa-file-pdf" style="color:var(--accent);"></i> مذكرة الدرس</span>
      </p>
    </div>
  </div>

  <div style="background:var(--card);border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-xl);border:1px solid var(--border);" oncontextmenu="return false;" ondragstart="return false;" onselectstart="return false;">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 20px;background:var(--bg);border-bottom:1px solid var(--border);">
      <div style="display:flex;align-items:center;gap:10px;">
        <i class="fas fa-file-pdf" style="color:var(--danger);font-size:18px;"></i>
        <span style="font-size:14px;font-weight:600;"><%= pdfTitle %></span>
      </div>
      <span style="font-size:12px;color:var(--text-muted);">
        <i class="fas fa-lock"></i> المشاهدة فقط - غير قابل للتحميل
      </span>
    </div>
    <div style="width:100%;height:85vh;min-height:500px;position:relative;background:#f0f0f0;">
      <iframe
        src="https://docs.google.com/gview?url=<%= encodeURIComponent(pdfUrl) %>&embedded=true"
        style="width:100%;height:100%;border:none;"
        allowfullscreen
        webkitallowfullscreen
      ></iframe>
    </div>
  </div>

  <div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap;">
    <a href="/student/course/<%= course.id %>" class="btn" style="background:var(--accent);color:#fff;padding:10px 24px;">
      <i class="fas fa-arrow-right"></i> العودة إلى <%= course.title %>
    </a>
  </div>
</main>

<script>
document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
document.addEventListener('keydown', function(e) {
  if (e.ctrlKey && (e.key === 's' || e.key === 'p' || e.key === 'u')) { e.preventDefault(); }
  if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'J' || e.key === 'C'))) { e.preventDefault(); }
});
</script>
</body>
</html>