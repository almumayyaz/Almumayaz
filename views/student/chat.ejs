<%- include('../partials/header', { title: title, navPageTitle: 'اسأل عفيفي', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<style>.bottom-tabs{display:none!important}#chatContainer{border-radius:var(--radius-xl)!important;border-left:none!important;border-right:none!important;margin:0!important;}</style>
<main class="main-content" style="display:flex;flex-direction:column;height:calc(100vh - 72px);padding:0;overflow:hidden;">
  <div class="page-header" style="flex-shrink:0;margin-bottom:0;padding:4px 12px 2px;">
    <div>
      <h1 style="display:flex;align-items:center;gap:8px;font-size:14px;">
        <i class="fas fa-comments" style="color:var(--accent);font-size:13px;"></i> اسأل عفيفي
      </h1>
    </div>
  </div>
  <div id="chatContainer" style="flex:1;display:flex;flex-direction:column;background:var(--card);overflow:hidden;">
    <div id="chatMessages" style="flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;scroll-behavior:smooth;"></div>
    <div id="chatTyping" style="padding:2px 14px 4px;font-size:11px;color:var(--text-muted);min-height:16px;display:none;">
      <i class="fas fa-pen"></i> الأستاذ يكتب...
    </div>
    <!-- Attachment Preview Card -->
    <div id="attachPreview" style="display:none;padding:8px 14px;border-top:1px solid var(--border);background:var(--card);">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="position:relative;width:46px;height:46px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--bg);border:1px solid var(--border);">
          <img id="attachPreviewImg" src="" style="width:100%;height:100%;object-fit:cover;">
        </div>
        <div style="flex:1;min-width:0;">
          <div id="attachPreviewName" style="font-size:12px;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></div>
          <div id="attachPreviewSize" style="font-size:11px;color:var(--text-muted);"></div>
        </div>
        <button onclick="removeAttachment()" style="background:rgba(220,38,38,0.12);border:none;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:var(--danger);font-size:14px;cursor:pointer;flex-shrink:0;transition:var(--transition);"><i class="fas fa-times"></i></button>
      </div>
    </div>
    <!-- Upload Progress Card -->
    <div id="uploadProgress" style="display:none;padding:8px 14px;border-top:1px solid var(--border);background:var(--card);">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="position:relative;width:46px;height:46px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--bg);border:1px solid var(--border);">
          <img id="uploadProgressImg" src="" style="width:100%;height:100%;object-fit:cover;opacity:0.5;">
          <div id="uploadProgressOverlay" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.3);border-radius:8px;">
            <i class="fas fa-spinner fa-spin" style="color:#fff;font-size:14px;"></i>
          </div>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:12px;font-weight:600;color:var(--text);">جاري رفع الصورة...</div>
          <div style="margin-top:4px;height:4px;background:var(--border);border-radius:2px;overflow:hidden;">
            <div id="uploadProgressBar" style="height:100%;width:0%;background:var(--gold-gradient);border-radius:2px;transition:width .3s ease;"></div>
          </div>
          <div id="uploadProgressPct" style="font-size:10px;color:var(--text-muted);margin-top:2px;text-align:left;direction:ltr;">0%</div>
        </div>
      </div>
    </div>
    <div style="padding:14px 16px;border-top:1px solid var(--border);background:var(--bg);border-radius:var(--radius-xl);">
      <div style="display:flex;gap:10px;align-items:flex-end;">
        <button id="attachBtn" onclick="document.getElementById('imageInput').click()" style="background:var(--card);border:1px solid var(--border);border-radius:50%;width:42px;height:42px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:16px;cursor:pointer;transition:var(--transition);flex-shrink:0;">
          <i class="fas fa-image"></i>
        </button>
        <input type="file" id="imageInput" accept="image/*" style="display:none;" onchange="handleImageSelect(event)">
        <input type="text" id="chatInput" placeholder="اكتب رسالتك هنا..." style="flex:1;padding:10px 14px;border:2px solid var(--border);border-radius:var(--radius);font-size:14px;background:var(--card);color:var(--text);direction:rtl;transition:var(--transition);" onkeydown="if(event.key==='Enter')sendMessage()">
        <button id="sendBtn" onclick="sendMessage()" style="background:var(--gold-gradient);border:none;border-radius:var(--radius);padding:10px 18px;color:#fff;font-size:14px;cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:6px;flex-shrink:0;font-weight:700;">
          <i class="fas fa-paper-plane"></i> إرسال
        </button>
      </div>
    </div>
  </div>
</main>

<script>
(function(){
  var chatDiv = document.getElementById('chatMessages');
  var chatInput = document.getElementById('chatInput');
  var lastDate = '';
  var isSending = false;
  var pendingKeys = {};
  var chatId = '<%= chatId %>';

  function scrollToBottom() {
    setTimeout(function(){ chatDiv.scrollTop = chatDiv.scrollHeight; }, 50);
  }

  function formatTime(ts) {
    var d = new Date(ts);
    return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
  }

  function formatDate(ts) {
    var d = new Date(ts);
    var now = new Date();
    var opts = { weekday:'long', year:'numeric', month:'long', day:'numeric' };
    if (d.toDateString() === now.toDateString()) return 'اليوم';
    var yesterday = new Date(now); yesterday.setDate(yesterday.getDate()-1);
    if (d.toDateString() === yesterday.toDateString()) return 'أمس';
    return d.toLocaleDateString('ar-EG', opts);
  }

  function createMessageElement(data) {
    var isMine = data.senderId !== 'teacher';
    var div = document.createElement('div');
    div.id = 'msg-' + (data._key || data._localId || data.timestamp);
    div.style.cssText = 'display:flex;flex-direction:column;align-items:' + (isMine ? 'flex-start' : 'flex-end') + ';max-width:80%;align-self:' + (isMine ? 'flex-end' : 'flex-start') + ';';
    var bubble = document.createElement('div');
    bubble.style.cssText = 'padding:10px 16px;border-radius:16px;max-width:100%;word-wrap:break-word;font-size:14px;line-height:1.6;' + (isMine ? 'background:var(--gold-gradient);color:#fff;border-bottom-left-radius:4px;' : 'background:var(--bg);color:var(--text);border-bottom-right-radius:4px;');
    if (data.image) { var img = document.createElement('img'); img.src = data.image; img.style.cssText = 'max-width:220px;max-height:220px;border-radius:10px;display:block;margin-bottom:6px;cursor:pointer;'; img.onclick = function(){ openImagePopup(data.image); }; bubble.appendChild(img); }
    if (data.text) { var txt = document.createElement('span'); txt.textContent = data.text; bubble.appendChild(txt); }
    div.appendChild(bubble);
    var meta = document.createElement('div');
    meta.style.cssText = 'display:flex;align-items:center;gap:6px;margin-top:2px;font-size:10px;color:var(--text-muted);padding:0 4px;direction:ltr;';
    if (!isMine) { var name = document.createElement('span'); name.textContent = data.senderName || 'الأستاذ'; name.style.fontWeight = '600'; meta.appendChild(name); meta.appendChild(document.createTextNode('·')); }
    var time = document.createElement('span'); time.textContent = formatTime(data.timestamp); time.dir = 'ltr'; meta.appendChild(time);
    if (isMine) {
      meta.appendChild(document.createTextNode('·'));
      var receipt = document.createElement('span');
      receipt.id = 'rcpt-' + (data._key || data._localId || data.timestamp);
      if (data._status === 'sending') receipt.innerHTML = '<i class="fas fa-clock" style="color:var(--warning);font-size:11px;"></i>';
      else receipt.innerHTML = data.read ? '<i class="fas fa-check-double" style="color:var(--success);font-size:11px;"></i>' : '<i class="fas fa-check" style="color:var(--text-muted);font-size:11px;"></i>';
      meta.appendChild(receipt);
    }
    div.appendChild(meta);
    return div;
  }

  function addMessage(data) {
    var key = data._key || data._localId || data.timestamp;
    if (document.getElementById('msg-' + key)) return;
    var msgDate = new Date(data.timestamp).toDateString();
    if (msgDate !== lastDate) { lastDate = msgDate; var dateSep = document.createElement('div'); dateSep.style.cssText = 'text-align:center;font-size:11px;color:var(--text-muted);padding:8px 0;font-weight:600;'; dateSep.textContent = formatDate(data.timestamp); chatDiv.appendChild(dateSep); }
    chatDiv.appendChild(createMessageElement(data));
    scrollToBottom();
  }

  function msgExists(key) {
    if (document.getElementById('msg-' + key)) return true;
    if (pendingKeys[key]) return true;
    var all = chatDiv.querySelectorAll('[id^="msg-"]');
    for (var i = 0; i < all.length; i++) {
      if (all[i].getAttribute('data-local-key') === key) return true;
    }
    return false;
  }

  function loadMessages() {
    fetch('/api/student/chat/messages').then(function(r){return r.json()}).then(function(d){
      if (!d.success) return;
      d.messages.forEach(function(data) {
        if (msgExists(data._key)) return;
        data._status = '';
        var msgDate = new Date(data.timestamp).toDateString();
        if (msgDate !== lastDate) { lastDate = msgDate; var dateSep = document.createElement('div'); dateSep.style.cssText = 'text-align:center;font-size:11px;color:var(--text-muted);padding:8px 0;font-weight:600;'; dateSep.textContent = formatDate(data.timestamp); chatDiv.appendChild(dateSep); }
        chatDiv.appendChild(createMessageElement(data));
        scrollToBottom();
      });
      if (d.messages.length > 0) fetch('/api/student/chat/read', { method: 'PUT' }).catch(function(){});
    }).catch(function(){});
  }

  // Firebase listener: real-time receipt updates
  var fbRef = (typeof firebase !== 'undefined' && firebase.database) ? firebase.database().ref('chats/' + chatId + '/messages') : null;
  if (fbRef) {
    fbRef.on('child_changed', function(snapshot) {
      var data = snapshot.val();
      var el = document.getElementById('msg-' + snapshot.key);
      if (el && data.read) {
        var rcpt = el.querySelector('[id^="rcpt-"]');
        if (rcpt) rcpt.innerHTML = '<i class="fas fa-check-double" style="color:var(--success);font-size:11px;"></i>';
      }
    });
  }

  // Load initial + poll every 2s for new messages
  loadMessages();
  setInterval(loadMessages, 2000);

  function sendMessage() {
    var text = chatInput.value.trim();
    var imgInput = document.getElementById('imageInput');
    if ((!text && !selectedImageData) || isSending) return;
    isSending = true;

    if (selectedImageData) {
      // Hide preview, show progress card
      document.getElementById('attachPreview').style.display = 'none';
      document.getElementById('uploadProgress').style.display = '';
      document.getElementById('uploadProgressImg').src = selectedImageData;
      document.getElementById('uploadProgressBar').style.width = '0%';
      document.getElementById('uploadProgressPct').textContent = '0%';

      // Optimistic message with image
      var tempId = 'local-' + Date.now();
      pendingKeys[tempId] = true;
      addMessage({ _localId: tempId, senderId: '<%= user && !isGuest ? "student-" + user.id : (chatId || "guest") %>', senderName: '<%= user ? user.name : "زائر" %>', timestamp: Date.now(), text: text || '', image: selectedImageData, read: false, _status: 'sending' });
      chatInput.value = '';

      // XHR for upload progress
      var xhr = new XMLHttpRequest();
      xhr.open('POST', '/api/student/chat/send');
      xhr.setRequestHeader('Content-Type', 'application/json');
      xhr.upload.onprogress = function(e) {
        if (e.lengthComputable) {
          var pct = Math.round(e.loaded / e.total * 100);
          document.getElementById('uploadProgressBar').style.width = pct + '%';
          document.getElementById('uploadProgressPct').textContent = pct + '%';
        }
      };
      xhr.onload = function() {
        document.getElementById('uploadProgress').style.display = 'none';
        isSending = false;
        try {
          var d = JSON.parse(xhr.responseText);
          if (d.success && d.key) {
            pendingKeys[d.key] = true;
            delete pendingKeys[tempId];
            var el = document.getElementById('msg-' + tempId);
            var dup = document.getElementById('msg-' + d.key);
            if (dup && dup !== el) dup.remove();
            if (el) { el.id = 'msg-' + d.key; el.setAttribute('data-local-key', d.key); }
            var rcpt = el ? el.querySelector('[id^="rcpt-"]') : null;
            if (rcpt) { rcpt.id = 'rcpt-' + d.key; rcpt.innerHTML = '<i class="fas fa-check" style="color:var(--text-muted);font-size:11px;"></i>'; }
            delete pendingKeys[d.key];
          }
        } catch(e) {}
        selectedImageData = null;
        selectedFile = null;
        imgInput.value = '';
      };
      xhr.onerror = function() {
        document.getElementById('uploadProgress').style.display = 'none';
        isSending = false;
      };
      xhr.send(JSON.stringify({ text: text || '', image: selectedImageData }));
      return;
    }

    // Optimistic message (text only)
    var tempId = 'local-' + Date.now();
    pendingKeys[tempId] = true;
    addMessage({ _localId: tempId, senderId: '<%= user && !isGuest ? "student-" + user.id : (chatId || "guest") %>', senderName: '<%= user ? user.name : "زائر" %>', timestamp: Date.now(), text: text, read: false, _status: 'sending' });
    chatInput.value = '';
    var btn = document.getElementById('sendBtn');
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    fetch('/api/student/chat/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({text:text}) })
    .then(function(r){return r.json()}).then(function(d){
      if (d.success && d.key) {
        pendingKeys[d.key] = true;
        delete pendingKeys[tempId];
        var el = document.getElementById('msg-' + tempId);
        var dup = document.getElementById('msg-' + d.key);
        if (dup && dup !== el) dup.remove();
        if (el) { el.id = 'msg-' + d.key; el.setAttribute('data-local-key', d.key); }
        var rcpt = el ? el.querySelector('[id^="rcpt-"]') : null;
        if (rcpt) { rcpt.id = 'rcpt-' + d.key; rcpt.innerHTML = '<i class="fas fa-check" style="color:var(--text-muted);font-size:11px;"></i>'; }
        delete pendingKeys[d.key];
      }
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال';
      isSending = false;
    }).catch(function() { btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال'; isSending = false; });
  }

  var selectedFile = null;
  var selectedImageData = null;
  function handleImageSelect(e) {
    var file = e.target.files[0];
    if (!file) return;
    if (!file.type.match('image/.*')) { alert('يرجى اختيار صورة فقط'); return; }
    if (file.size > 5 * 1024 * 1024) { alert('حجم الصورة يجب أن أقل من 5 ميجابايت'); return; }
    selectedFile = file;
    var reader = new FileReader();
    reader.onload = function(ev) {
      selectedImageData = ev.target.result;
      document.getElementById('attachPreviewImg').src = selectedImageData;
      document.getElementById('attachPreviewName').textContent = file.name;
      document.getElementById('attachPreviewSize').textContent = (file.size / 1024).toFixed(1) + ' KB';
      document.getElementById('attachPreview').style.display = '';
      document.getElementById('imageInput').value = '';
    };
    reader.readAsDataURL(file);
  }
  function removeAttachment() {
    selectedFile = null;
    selectedImageData = null;
    document.getElementById('attachPreview').style.display = 'none';
    document.getElementById('attachPreviewImg').src = '';
  }

  window.sendMessage = sendMessage;
  window.handleImageSelect = handleImageSelect;
  window.removeAttachment = removeAttachment;
})();
</script>

<!-- Image Popup Modal -->
<div id="imagePopup" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:9999;justify-content:center;align-items:center;backdrop-filter:blur(4px);" onclick="closeImagePopup(event)">
  <div style="position:relative;max-width:90vw;max-height:90vh;display:flex;flex-direction:column;align-items:center;" onclick="event.stopPropagation()">
    <div style="position:absolute;top:-44px;left:0;right:0;display:flex;justify-content:space-between;padding:0 4px;">
      <button onclick="downloadImage()" style="background:rgba(255,255,255,0.15);border:none;color:#fff;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:14px;display:flex;align-items:center;gap:6px;backdrop-filter:blur(4px);"><i class="fas fa-download"></i> تحميل</button>
      <button onclick="closeImagePopup()" style="background:rgba(255,255,255,0.15);border:none;color:#fff;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);"><i class="fas fa-times"></i></button>
    </div>
    <img id="popupImage" src="" style="max-width:100%;max-height:85vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
  </div>
</div>
<script>
function openImagePopup(src) { document.getElementById('popupImage').src = src; document.getElementById('imagePopup').style.display = 'flex'; document.body.style.overflow = 'hidden'; }
function closeImagePopup(e) { if (e && e.target !== e.currentTarget) return; document.getElementById('imagePopup').style.display = 'none'; document.body.style.overflow = ''; }
function downloadImage() { var src = document.getElementById('popupImage').src; var a = document.createElement('a'); a.href = src; a.download = 'image-' + Date.now() + '.jpg'; document.body.appendChild(a); a.click(); document.body.removeChild(a); }
</script>
<%- include("../partials/footer") %>
</body>
</html>
