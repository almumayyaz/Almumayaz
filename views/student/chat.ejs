<%- include('../partials/header', { title: title, navPageTitle: 'اسأل عفيفي', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content" style="display:flex;flex-direction:column;height:calc(100vh - 72px);padding-bottom:0;">
  <div class="page-header" style="flex-shrink:0;margin-bottom:0;padding:20px 0 16px;">
    <div>
      <h1 style="display:flex;align-items:center;gap:10px;">
        <i class="fas fa-comments" style="color:var(--accent);"></i> اسأل عفيفي
      </h1>
      <p>تواصل مباشر مع الأستاذ مصطفى فرغلي</p>
    </div>
  </div>

  <div id="chatContainer" style="flex:1;display:flex;flex-direction:column;background:var(--card);border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--border);margin-bottom:16px;">
    <div id="chatMessages" style="flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:12px;scroll-behavior:smooth;"></div>

    <div id="chatTyping" style="padding:4px 20px 8px;font-size:12px;color:var(--text-muted);min-height:20px;display:none;">
      <i class="fas fa-pen"></i> الأستاذ يكتب...
    </div>

    <div style="padding:12px 16px;border-top:1px solid var(--border);background:var(--bg);">
      <div style="display:flex;gap:10px;align-items:flex-end;">
        <button id="attachBtn" onclick="document.getElementById('imageInput').click()" style="background:var(--card);border:1px solid var(--border);border-radius:50%;width:42px;height:42px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:18px;cursor:pointer;transition:var(--transition);flex-shrink:0;">
          <i class="fas fa-image"></i>
        </button>
        <input type="file" id="imageInput" accept="image/*" style="display:none;" onchange="handleImageSelect(event)">
        <input type="text" id="chatInput" placeholder="اكتب رسالتك هنا..." style="flex:1;padding:12px 16px;border:2px solid var(--border);border-radius:var(--radius);font-size:14px;background:var(--card);color:var(--text);direction:rtl;transition:var(--transition);" onkeydown="if(event.key==='Enter')sendMessage()">
        <button id="sendBtn" onclick="sendMessage()" style="background:var(--gold-gradient);border:none;border-radius:var(--radius);padding:12px 20px;color:#fff;font-size:16px;cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:8px;flex-shrink:0;font-weight:700;">
          <i class="fas fa-paper-plane"></i> إرسال
        </button>
      </div>
    </div>
  </div>
</main>

<script>
(function(){
  var chatDiv = document.getElementById('chatMessages');
  var chatInput = document.getElementById('chatInput');
  var lastTimestamp = 0;
  var sentKeys = {};

  function scrollToBottom() {
    setTimeout(function(){ chatDiv.scrollTop = chatDiv.scrollHeight; }, 50);
  }

  function formatTime(ts) {
    var d = new Date(ts);
    return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
  }

  function formatDate(ts) {
    var d = new Date(ts);
    var now = new Date();
    var opts = { weekday:'long', year:'numeric', month:'long', day:'numeric' };
    if (d.toDateString() === now.toDateString()) return 'اليوم';
    var yesterday = new Date(now); yesterday.setDate(yesterday.getDate()-1);
    if (d.toDateString() === yesterday.toDateString()) return 'أمس';
    return d.toLocaleDateString('ar-EG', opts);
  }

  function createMessageElement(data) {
    var isMine = data.senderId !== 'teacher';
    var div = document.createElement('div');
    div.id = 'msg-' + (data._key || data.timestamp);
    div.style.cssText = 'display:flex;flex-direction:column;align-items:' + (isMine ? 'flex-start' : 'flex-end') + ';max-width:80%;align-self:' + (isMine ? 'flex-end' : 'flex-start') + ';';

    var bubble = document.createElement('div');
    bubble.style.cssText = 'padding:10px 16px;border-radius:16px;max-width:100%;word-wrap:break-word;font-size:14px;line-height:1.6;' +
      (isMine
        ? 'background:var(--gold-gradient);color:#fff;border-bottom-left-radius:4px;'
        : 'background:var(--bg);color:var(--text);border-bottom-right-radius:4px;');

    if (data.image) {
      var img = document.createElement('img');
      img.src = data.image;
      img.style.cssText = 'max-width:220px;max-height:220px;border-radius:10px;display:block;margin-bottom:6px;cursor:pointer;';
      img.onclick = function(){ window.open(data.image, '_blank'); };
      bubble.appendChild(img);
    }
    if (data.text) {
      var txt = document.createElement('span');
      txt.textContent = data.text;
      bubble.appendChild(txt);
    }

    div.appendChild(bubble);

    var meta = document.createElement('div');
    meta.style.cssText = 'display:flex;align-items:center;gap:6px;margin-top:2px;font-size:10px;color:var(--text-muted);padding:0 4px;direction:ltr;';

    if (!isMine) {
      var name = document.createElement('span');
      name.textContent = data.senderName || 'الأستاذ';
      name.style.fontWeight = '600';
      meta.appendChild(name);
      meta.appendChild(document.createTextNode('·'));
    }

    var time = document.createElement('span');
    time.textContent = formatTime(data.timestamp);
    time.dir = 'ltr';
    meta.appendChild(time);

    if (isMine) {
      meta.appendChild(document.createTextNode('·'));
      var receipt = document.createElement('span');
      receipt.innerHTML = data.read
        ? '<i class="fas fa-check-double" style="color:var(--success);font-size:11px;"></i>'
        : '<i class="fas fa-check" style="color:var(--text-muted);font-size:11px;"></i>';
      meta.appendChild(receipt);
    }

    div.appendChild(meta);
    return div;
  }

  var lastDate = '';

  function loadMessages() {
    fetch('/api/student/chat/messages').then(function(r){return r.json()}).then(function(d){
      if (!d.success) return;
      var msgs = d.messages;
      msgs.forEach(function(data) {
        var key = data._key || data.timestamp;
        if (document.getElementById('msg-' + key)) return;
        var msgDate = new Date(data.timestamp).toDateString();
        if (msgDate !== lastDate) {
          lastDate = msgDate;
          var dateSep = document.createElement('div');
          dateSep.style.cssText = 'text-align:center;font-size:11px;color:var(--text-muted);padding:8px 0;font-weight:600;';
          dateSep.textContent = formatDate(data.timestamp);
          chatDiv.appendChild(dateSep);
        }
        chatDiv.appendChild(createMessageElement(data));
        scrollToBottom();
      });
      if (msgs.length > 0) {
        fetch('/api/student/chat/read', { method: 'PUT' }).catch(function(){});
      }
    }).catch(function(){});
  }

  function sendMessage() {
    var text = chatInput.value.trim();
    var imgInput = document.getElementById('imageInput');
    if (!text && !selectedImage) return;

    if (selectedImage) {
      var msg = { text: text || '', image: selectedImage };
      fetch('/api/student/chat/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(msg) })
      .then(function(r){return r.json()}).then(function(d){
        if (d.success) { chatInput.value = ''; selectedImage = null; updateAttachBtn(); imgInput.value = ''; loadMessages(); }
      });
      return;
    }

    fetch('/api/student/chat/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({text:text}) })
    .then(function(r){return r.json()}).then(function(d){
      if (d.success) { chatInput.value = ''; loadMessages(); }
    });
  }

  var selectedImage = null;
  function handleImageSelect(e) {
    var file = e.target.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { alert('حجم الصورة يجب أن يكون أقل من 5 ميجابايت'); return; }
    var reader = new FileReader();
    reader.onload = function(ev) {
      selectedImage = ev.target.result;
      updateAttachBtn();
    };
    reader.readAsDataURL(file);
  }

  function updateAttachBtn() {
    var btn = document.getElementById('attachBtn');
    if (selectedImage) {
      btn.innerHTML = '<i class="fas fa-check-circle"></i>';
      btn.style.color = 'var(--success)';
      btn.style.borderColor = 'var(--success)';
    } else {
      btn.innerHTML = '<i class="fas fa-image"></i>';
      btn.style.color = 'var(--accent)';
      btn.style.borderColor = 'var(--border)';
    }
    document.getElementById('imageInput').value = '';
  }

  setInterval(loadMessages, 3000);
  loadMessages();

  window.sendMessage = sendMessage;
  window.handleImageSelect = handleImageSelect;
})();
</script>
</body>
</html>