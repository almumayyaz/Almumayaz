<%- include('../partials/header', { title: title, navPageTitle: pdfTitle, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content" oncontextmenu="return false;">
  <div style="margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
    <a href="<%= backUrl %>" style="color:var(--accent);font-size:13px;font-weight:600;display:flex;align-items:center;gap:5px;">
      <i class="fas fa-arrow-right"></i> العودة
    </a>
    <span style="font-size:13px;font-weight:600;color:var(--text);"><%= pdfTitle %></span>
  </div>

  <div id="pdf-toolbar" style="background:#202124;border-radius:var(--radius-xl) var(--radius-xl) 0 0;overflow:hidden;border:1px solid var(--border);border-bottom:none;user-select:none;" oncontextmenu="return false;" ondragstart="return false;">
    <div style="display:flex;align-items:center;justify-content:center;padding:4px 12px;gap:6px;flex-wrap:wrap;min-height:40px;">
      <span style="display:flex;align-items:center;gap:3px;font-size:12px;color:#e8eaed;">
        <input id="pdf-page-input" type="text" value="1" inputmode="numeric" style="width:32px;padding:2px 3px;border:1px solid #5f6368;border-radius:3px;background:#303134;color:#e8eaed;text-align:center;font-size:12px;outline:none;">
        <span style="color:#9aa0a6;">/</span>
        <span id="pdf-page-total" style="color:#e8eaed;min-width:14px;font-size:12px;">?</span>
      </span>
      <span style="width:1px;height:16px;background:#5f6368;display:inline-block;"></span>
      <button id="pdf-zoom-out" class="pdf-btn" title="تصغير"><i class="fas fa-search-minus"></i></button>
      <span id="pdf-zoom-label" style="font-size:11px;color:#e8eaed;min-width:34px;text-align:center;">100%</span>
      <button id="pdf-zoom-in" class="pdf-btn" title="تكبير"><i class="fas fa-search-plus"></i></button>
      <button id="pdf-zoom-reset" class="pdf-btn" title="استعادة الحجم"><i class="fas fa-expand"></i></button>
      <span style="width:1px;height:16px;background:#5f6368;display:inline-block;"></span>
      <button id="pdf-search-toggle" class="pdf-btn" title="بحث"><i class="fas fa-search"></i></button>
    </div>
    <div id="pdf-search-bar" style="display:none;padding:4px 12px 6px;background:#292a2d;gap:6px;align-items:center;">
      <input id="pdf-search-input" type="text" placeholder="بحث في الملف..." style="flex:1;padding:4px 8px;border:1px solid #5f6368;border-radius:3px;background:#303134;color:#e8eaed;font-size:12px;outline:none;max-width:260px;">
      <span id="pdf-search-count" style="font-size:11px;color:#9aa0a6;min-width:40px;"></span>
      <button id="pdf-search-prev" class="pdf-btn" title="السابق"><i class="fas fa-chevron-up"></i></button>
      <button id="pdf-search-next" class="pdf-btn" title="التالي"><i class="fas fa-chevron-down"></i></button>
      <button id="pdf-search-close" class="pdf-btn" title="إغلاق"><i class="fas fa-times"></i></button>
    </div>
  </div>

  <div id="pdf-viewport" style="position:relative;width:100%;height:80vh;min-height:420px;overflow-y:auto;overflow-x:hidden;background:#525659;border-left:1px solid var(--border);border-right:1px solid var(--border);touch-action:pan-y;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;">
    <div id="pdf-pages"></div>
    <div id="pdf-loading" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#9aa0a6;font-size:14px;">جاري التحميل...</div>
  </div>

  <div style="background:#202124;border-radius:0 0 var(--radius-xl) var(--radius-xl);overflow:hidden;border:1px solid var(--border);border-top:none;padding:4px 12px;display:flex;align-items:center;justify-content:center;gap:10px;min-height:32px;">
    <span id="pdf-status" style="font-size:11px;color:#9aa0a6;"></span>
  </div>

  <div id="pdf-error" style="display:none;padding:20px;text-align:center;color:var(--danger);font-size:13px;background:var(--card);border-radius:0 0 var(--radius-xl) var(--radius-xl);border:1px solid var(--border);border-top:none;">
    تعذر تحميل الملف. تأكد من تسجيل الدخول والاشتراك النشط.
  </div>
</main>

<style>
.pdf-btn{background:none;border:none;color:#e8eaed;padding:5px;border-radius:3px;cursor:pointer;font-size:13px;line-height:1;transition:background 0.12s;}
.pdf-btn:hover{background:rgba(255,255,255,0.1);}
.pdf-btn:active{background:rgba(255,255,255,0.2);}
#pdf-page-input::-webkit-inner-spin-button,#pdf-page-input::-webkit-outer-spin-button{-webkit-appearance:none;margin:0;}
#pdf-page-input[type=text]{-moz-appearance:textfield;}
#pdf-viewport{scroll-behavior:auto;}
#pdf-pages{--pw:800px;display:flex;flex-direction:column;align-items:center;gap:12px;padding:14px 0 40px;min-height:100%;width:100%;box-sizing:border-box;}
.pdf-page{position:relative;width:var(--pw);max-width:100%;background: var(--card);box-shadow:0 1px 6px rgba(0,0,0,.35);flex:0 0 auto;overflow:hidden;contain:layout paint;}
.pdf-page-canvas{display:block;width:100%;height:100%;}
.pdf-page-badge{position:absolute;top:6px;left:6px;z-index:3;background:rgba(32,33,36,.72);color:#e8eaed;font-size:10px;line-height:1;padding:3px 6px;border-radius:10px;opacity:0;transition:opacity .15s;pointer-events:none;}
.pdf-page:hover .pdf-page-badge{opacity:1;}
.pdf-page-spin{position:absolute;top:50%;left:50%;width:26px;height:26px;margin:-13px 0 0 -13px;border:3px solid #e0e0e0;border-top-color:#9aa0a6;border-radius:50%;animation:pdfspin .8s linear infinite;}
.pdf-page.rendered .pdf-page-spin{display:none;}
@keyframes pdfspin{to{transform:rotate(360deg);}}
.pdf-text-layer{position:absolute;top:0;left:0;overflow:hidden;line-height:1;opacity:1;pointer-events:none;z-index:2;}
.pdf-text-layer > span{color:transparent;position:absolute;white-space:pre;transform-origin:0% 0%;}
.pdf-text-layer .highlight{background:rgba(255,235,59,.5);border-radius:2px;color:transparent;mix-blend-mode:multiply;}
.pdf-text-layer .highlight.active{background:rgba(255,145,0,.55);}
#pdf-viewport::-webkit-scrollbar{width:9px;height:9px;}
#pdf-viewport::-webkit-scrollbar-track{background:transparent;}
#pdf-viewport::-webkit-scrollbar-thumb{background:#5f6368;border-radius:4px;}
#pdf-viewport::-webkit-scrollbar-thumb:hover{background:#7a7f85;}
</style>

<script src="/js/pdf.min.js"></script>
<script>
  window.__PDF_CONFIG__ = {
    tokenUrl: '<%= tokenUrl %>',
    title: '<%= pdfTitle.replace(/'/g, "\\'") %>',
    courseId: '<%= (typeof courseId !== "undefined" ? courseId : "") %>',
    lessonId: '<%= (typeof lessonId !== "undefined" ? lessonId : "") %>'
  };
  if (window.pdfjsLib) pdfjsLib.GlobalWorkerOptions.workerSrc = '/js/pdf.worker.min.js';
</script>
<script>
fetch('/api/analytics/pdf/open', {
  method: 'POST', headers: {'Content-Type': 'application/json'},
  body: JSON.stringify({ courseId: '<%= (typeof courseId !== "undefined" ? courseId : "") %>', lessonId: '<%= (typeof lessonId !== "undefined" ? lessonId : "") %>', lessonTitle: '<%= pdfTitle %>' })
}).catch(function(){});
</script>
<script src="/js/pdfjs-viewer.js"></script>
<%- include('../partials/footer') %>
