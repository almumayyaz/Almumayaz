<%- include('../partials/header', { title: title, navPageTitle: lesson.title, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/student/course/<%= course.id %>" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-chevron-right"></i> العودة إلى <%= course.title %>
      </a>
      <h1><%= lesson.title %></h1>
      <p style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <span><i class="fas fa-book" style="color:var(--accent);"></i> <%= course.title %></span>
        <span><i class="fas fa-clock" style="color:var(--accent);"></i> <%= lesson.duration %></span>
        <% if (lesson.isFree) { %><span class="bab-free-badge">درس مجاني</span><% } %>
      </p>
    </div>
  </div>

  <!-- Plyr Video Player -->
  <% if (lesson.videos && lesson.videos.length > 0) { %>
    <% if (lesson.videos.length === 1) { %>
    <div class="plyr-container" data-video="<%= lesson.videos[0].url %>"></div>
    <% } else { %>
    <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:28px;">
      <% lesson.videos.forEach(function(video, vi) { %>
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="background:var(--accent);color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;"><%= vi + 1 %></span>
          <span style="font-weight:600;font-size:14px;"><%= video.title || ('الجزء ' + (vi + 1)) %></span>
        </div>
        <div class="plyr-container" data-video="<%= video.url %>"></div>
      </div>
      <% }) %>
    </div>
    <% } %>
  <% } else if (lesson.videoUrl) { %>
    <div class="plyr-container" data-video="<%= lesson.videoUrl %>"></div>
  <% } else { %>
    <div style="text-align:center;padding:40px;background:var(--glass-bg);border-radius:var(--radius-xl);margin-bottom:28px;border:1px solid var(--border);">
      <i class="fas fa-video-slash" style="font-size:36px;color:var(--border);display:block;margin-bottom:12px;"></i>
      <p style="color:var(--text-muted);">لا يوجد فيديو لهذا الدرس بعد</p>
    </div>
  <% } %>

  <!-- Lesson Info Bar (below player) -->
  <% if (lesson.videos || lesson.videoUrl) { %>
  <div id="lessonInfoBar" style="display:none;align-items:center;gap:12px;padding:12px 16px;background:var(--card);border-radius:var(--radius-lg);border:1px solid var(--border);margin-bottom:20px;flex-wrap:wrap;">
    <% if (lesson.pdfFiles && lesson.pdfFiles.length > 0) { %>
    <a href="#pdfSection" style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--danger);text-decoration:none;font-weight:600;padding:6px 10px;background:rgba(239,68,68,0.05);border-radius:8px;">
      <i class="fas fa-file-pdf"></i> <%= lesson.pdfFiles.length %> ملف<%= lesson.pdfFiles.length > 1 ? 'ات' : '' %> PDF
    </a>
    <% } %>
    <% if (course.quiz && !isGuest) { %>
    <a href="/student/exam/<%= course.id %>" style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--accent);text-decoration:none;font-weight:600;padding:6px 10px;background:var(--accent-glow);border-radius:8px;">
      <i class="fas fa-pen"></i> الاختبار
    </a>
    <% } %>
    <div style="margin-right:auto;display:flex;align-items:center;gap:8px;">
      <span id="watchStatus" style="font-size:12px;color:var(--text-muted);">
        <i class="fas fa-circle" style="color:var(--text-muted);font-size:8px;"></i> لم تشاهد بعد
      </span>
    </div>
  </div>
  <% } %>

  <div class="lesson-content">
    <h1><%= lesson.title %></h1>
    <p><%= lesson.description %></p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;padding:16px;background:var(--bg);border-radius:8px;">
      <div><span style="font-weight:600;color:var(--primary);">المادة:</span> <span style="color:var(--text-light);"><%= course.title %></span></div>
      <div><span style="font-weight:600;color:var(--primary);">المدة:</span> <span style="color:var(--text-light);"><%= lesson.duration %></span></div>
      <div><span style="font-weight:600;color:var(--primary);">عدد الدروس:</span> <span style="color:var(--text-light);"><%= (course.lessons||[]).length %></span></div>
      <div><span style="font-weight:600;color:var(--primary);">مشاهدة:</span> <span style="color:var(--text-light);">HD عالية الجودة</span></div>
      <% if (lesson.videos) { %><div><span style="font-weight:600;color:var(--primary);">عدد المقاطع:</span> <span style="color:var(--text-light);"><%= lesson.videos.length %></span></div><% } %>
    </div>

    <!-- PDF Files -->
    <% if (lesson.pdfFiles && lesson.pdfFiles.length > 0) { %>
    <div id="pdfSection" style="margin-bottom:24px;">
      <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
        <i class="fas fa-file-pdf" style="color:var(--accent);"></i> المذكرات
      </h3>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <% lesson.pdfFiles.forEach(function(pdf, pi) { %>
        <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--bg);border-radius:var(--radius-sm);border:1px solid var(--border);">
          <i class="fas fa-file-pdf" style="color:var(--danger);font-size:20px;"></i>
          <span style="flex:1;font-size:14px;font-weight:500;"><%= pdf.title || ('ملف ' + (pi + 1)) %></span>
          <a href="/student/view-pdf/<%= course.id %>/<%= lesson.id %>/<%= pi %>" class="btn btn-sm" style="background:var(--primary);color:#fff;">
            <i class="fas fa-eye"></i> عرض
          </a>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (lesson.pdfUrl) { %>
    <div id="pdfSection" style="margin-bottom:24px;">
      <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
        <i class="fas fa-file-pdf" style="color:var(--accent);"></i> المذكرة
      </h3>
      <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--bg);border-radius:var(--radius-sm);border:1px solid var(--border);">
        <i class="fas fa-file-pdf" style="color:var(--danger);font-size:20px;"></i>
        <span style="flex:1;font-size:14px;font-weight:500;">مذكرة <%= lesson.title %></span>
        <a href="#" class="btn btn-sm" style="background:var(--primary);color:#fff;" onclick="window.open('/student/view-pdf/<%= course.id %>/<%= lesson.id %>/0','_blank')">
          <i class="fas fa-eye"></i> عرض
        </a>
      </div>
    </div>
    <% } %>

    <!-- Progress Tracking -->
    <div style="margin-bottom:20px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
        <span style="font-size:13px;font-weight:600;">التقدم</span>
        <span style="font-size:13px;color:var(--text-light);" id="progressPct">0%</span>
      </div>
      <div style="width:100%;height:8px;background:var(--bg);border-radius:4px;overflow:hidden;">
        <div id="progressBar" style="width:0%;height:100%;background:var(--gold-gradient);border-radius:4px;transition:width 0.5s ease;"></div>
      </div>
    </div>

    <div class="lesson-actions">
      <button class="btn btn-primary" id="markCompleteBtn" onclick="markLessonComplete()">
        <i class="fas fa-check-circle"></i> <span id="completeBtnText">إنهاء الدرس</span>
      </button>
    </div>
  </div>

  <% if (course.quiz && !isGuest) { %>
  <div class="welcome-banner" style="padding:12px 16px;margin-top:20px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      <i class="fas fa-question-circle" style="color:var(--accent);font-size:14px;"></i>
      <span style="font-size:13px;font-weight:700;color:var(--accent);">اختبر نفسك</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
      <p style="font-size:13px;color:var(--text-light);margin:0;">اختبر فهمك لهذه المادة بعد سماع المحاضرة</p>
      <a href="/student/exam/<%= course.id %>" class="btn btn-primary btn-sm" style="cursor:pointer;z-index:999;position:relative;">
        <i class="fas fa-pen"></i> ابدأ الاختبار
      </a>
    </div>
  </div>
  <% } %>

</main>

<script src="https://cdn.plyr.io/3.7.8/plyr.js"></script>
<script>
(function() {
  var courseId = '<%= course.id %>';
  var lessonId = '<%= lesson.id %>';
  var isGuest = <%= isGuest ? 'true' : 'false' %>;
  var players = [];
  var progressInterval = null;
  var savedSecond = 0;
  var autoHideTimer = null;

  // Load saved progress from localStorage
  var storageKey = 'lughati-progress-' + courseId + '-' + lessonId;
  function loadLocalProgress() {
    try {
      var saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
      savedSecond = saved.lastSecond || 0;
      return saved;
    } catch(e) { return {}; }
  }
  function saveLocalProgress(lastSecond, pct, completed) {
    try {
      var data = JSON.parse(localStorage.getItem(storageKey) || '{}');
      if (lastSecond !== undefined) data.lastSecond = lastSecond;
      if (pct !== undefined) data.percentage = pct;
      if (completed !== undefined) data.completed = completed;
      localStorage.setItem(storageKey, JSON.stringify(data));
    } catch(e) {}
  }

  // Load server progress and update UI
  function loadServerProgress() {
    fetch('/api/student/progress/' + courseId)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success && d.progress) {
          var pct = d.progress.percentage || 0;
          var completed = (d.progress.completedLessons || []).includes(lessonId);
          updateUI(pct, completed);
          if (completed) {
            saveLocalProgress(undefined, pct, true);
            updateInfoBar(true);
          }
        }
      });
  }

  // Save progress to server
  function saveServerProgress(pct, completed) {
    fetch('/api/student/progress', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ courseId: courseId, lessonId: lessonId, completed: completed || false, percentage: pct })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success && completed) {
        updateUI(100, true);
        document.getElementById('completeBtnText').textContent = '✅ تم الإنهاء';
      }
    });
  }

  function updateUI(pct, completed) {
    var bar = document.getElementById('progressBar');
    var label = document.getElementById('progressPct');
    var btn = document.getElementById('completeBtnText');
    if (bar) bar.style.width = pct + '%';
    if (label) label.textContent = pct + '%';
    if (btn && completed) btn.textContent = '✅ تم الإنهاء';
    updateInfoBar(completed);
  }

  function updateInfoBar(completed) {
    var bar = document.getElementById('lessonInfoBar');
    if (!bar) return;
    bar.style.display = 'flex';
    var status = document.getElementById('watchStatus');
    if (!status) return;
    if (completed) {
      status.innerHTML = '<i class="fas fa-check-circle" style="color:var(--success);font-size:12px;"></i> <span style="color:var(--success);">مكتمل</span>';
    } else {
      status.innerHTML = '<i class="fas fa-play-circle" style="color:var(--accent);font-size:12px;"></i> قيد المشاهدة';
    }
  }

  window.markLessonComplete = function() {
    saveServerProgress(100, true);
    updateUI(100, true);
  };

  // Initialize Plyr players
  document.querySelectorAll('.plyr-container[data-video]').forEach(function(container) {
    var url = container.getAttribute('data-video');
    var match = url.match(/(?:youtube\.com\/(?:embed\/|watch\?v=)|youtu\.be\/)([a-zA-Z0-9_-]+)/);
    if (!match) return;
    var videoId = match[1];

    // Set required attributes for Plyr to detect YouTube provider
    container.setAttribute('data-plyr-provider', 'youtube');
    container.setAttribute('data-plyr-embed-id', videoId);

    var player = new Plyr(container, {
      controls: ['play-large', 'play', 'progress', 'current-time', 'duration', 'settings', 'pip', 'fullscreen'],
      settings: ['speed'],
      speed: { selected: 1, options: [0.5, 0.75, 1, 1.25, 1.5, 2] },
      youtube: { noCookie: true, rel: 0, modestbranding: 1, iv_load_policy: 3 },
      tooltips: { controls: true, seek: true },
      keyboard: { focused: true, global: false },
      clickToPlay: true,
      hideControls: true,
      resetOnEnd: false
    });
    players.push(player);

      // Add custom rewind/forward buttons after player is ready
    player.on('ready', function() {
      var controlsEl = container.querySelector('.plyr__controls');
      if (!controlsEl) return;

      // Add skip buttons before progress bar
      var rewindBtn = document.createElement('button');
      rewindBtn.className = 'plyr__controls__item plyr__control plyr__skip-btn';
      rewindBtn.setAttribute('type', 'button');
      rewindBtn.setAttribute('title', 'رجوع 10 ثوان');
      rewindBtn.innerHTML = '<i class="fas fa-backward" style="font-size:14px;"></i>';
      rewindBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        player.currentTime = Math.max((player.currentTime || 0) - 10, 0);
      });

      var forwardBtn = document.createElement('button');
      forwardBtn.className = 'plyr__controls__item plyr__control plyr__skip-btn';
      forwardBtn.setAttribute('type', 'button');
      forwardBtn.setAttribute('title', 'تقديم 10 ثوان');
      forwardBtn.innerHTML = '<i class="fas fa-forward" style="font-size:14px;"></i>';
      forwardBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        player.currentTime = Math.min((player.currentTime || 0) + 10, player.duration || 9999);
      });

      var progressBar = controlsEl.querySelector('.plyr__progress');
      if (progressBar) {
        controlsEl.insertBefore(rewindBtn, progressBar);
        controlsEl.insertBefore(forwardBtn, progressBar);
      } else {
        var playBtnContainer = controlsEl.querySelector('[data-plyr="play"]');
        if (playBtnContainer && playBtnContainer.parentNode) {
          playBtnContainer.parentNode.insertBefore(rewindBtn, playBtnContainer.nextSibling);
          playBtnContainer.parentNode.insertBefore(forwardBtn, rewindBtn.nextSibling);
        }
      }

      // Restore previous position from localStorage
      var local = loadLocalProgress();
      if (local.lastSecond > 1 && !local.completed) {
        player.currentTime = local.lastSecond;
        // Brief notice
        var notice = document.createElement('div');
        notice.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.7);color:#fff;padding:10px 18px;border-radius:8px;font-size:13px;z-index:20;pointer-events:none;text-align:center;animation:fadeOut 3s ease forwards;';
        notice.textContent = 'استكمال من ' + Math.floor(local.lastSecond / 60) + ':' + String(Math.floor(local.lastSecond % 60)).padStart(2, '0');
        container.appendChild(notice);
        setTimeout(function() { notice.remove(); }, 3000);
      }

      // Show info bar
      updateInfoBar(local.completed || false);
      updateUI(local.percentage || 0, local.completed || false);
      loadServerProgress();
    });

    // Time update - save local progress every 5 seconds
    player.on('timeupdate', function() {
      var ct = player.currentTime || 0;
      var dur = player.duration || 1;
      var pct = Math.min(Math.round((ct / dur) * 100), 100);

      // Save to localStorage every 5 seconds
      if (Math.floor(ct) % 5 === 0 && Math.floor(ct) !== Math.floor(savedSecond)) {
        savedSecond = Math.floor(ct);
        saveLocalProgress(savedSecond, pct, false);
        // Update progress bar in real-time
        updateUI(pct, false);
      }
    });

    // Save on pause
    player.on('pause', function() {
      var ct = player.currentTime || 0;
      var dur = player.duration || 1;
      var pct = Math.min(Math.round((ct / dur) * 100), 100);
      saveLocalProgress(Math.floor(ct), pct, false);
      saveServerProgress(pct, false);
    });

    // Play started
    player.on('play', function() {
      updateInfoBar(false);
    });

    // Video ended - mark complete
    player.on('ended', function() {
      saveLocalProgress(0, 100, true);
      saveServerProgress(100, true);
      updateUI(100, true);
    });
  });

  // Save on page unload (user closes tab/app)
  window.addEventListener('beforeunload', function() {
    players.forEach(function(p) {
      var ct = p.currentTime || 0;
      var dur = p.duration || 1;
      var pct = Math.min(Math.round((ct / dur) * 100), 100);
      saveLocalProgress(Math.floor(ct), pct, false);
    });
  });

  // Auto-hide controls after 3 seconds of no interaction
  // (Plyr has built-in hideControls, but we add extra touch/click hide)
  document.addEventListener('click', function() {
    players.forEach(function(p) {
      var ctrl = p.elements && p.elements.controls;
      if (ctrl) {
        ctrl.classList.remove('plyr__controls--hidden');
        clearTimeout(autoHideTimer);
        autoHideTimer = setTimeout(function() {
          if (p.playing) ctrl.classList.add('plyr__controls--hidden');
        }, 3000);
      }
    });
  });

  // Initial load
  var local = loadLocalProgress();
  loadServerProgress();

})();
</script>

<style>
/* Plyr container styles */
.plyr-container {
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 20px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  background: #000;
  aspect-ratio: 16/9;
  position: relative;
}
.plyr-container .plyr {
  border-radius: 14px;
  height: 100%;
}
.plyr-container .plyr--video {
  border-radius: 14px;
}
.plyr__control--overlaid {
  background: var(--accent) !important;
  border-radius: 50% !important;
  padding: 18px !important;
  transition: transform 0.3s ease !important;
}
.plyr__control--overlaid:hover {
  transform: scale(1.1);
  background: var(--accent) !important;
}
.plyr__control--overlaid svg {
  width: 24px;
  height: 24px;
}
.plyr__controls {
  background: linear-gradient(transparent, rgba(0,0,0,0.85)) !important;
  padding: 8px 12px !important;
}
.plyr__controls .plyr__controls__item.plyr__skip-btn {
  background: transparent;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 4px 8px;
  opacity: 0.8;
  transition: opacity 0.2s;
}
.plyr__controls .plyr__controls__item.plyr__skip-btn:hover {
  opacity: 1;
}
.plyr--full-ui .plyr__progress__buffer { background: rgba(255,255,255,0.15); }
.plyr--full-ui input[type=range] { color: var(--accent); }
.plyr--video .plyr__control.plyr__tab-focus,
.plyr--video .plyr__control:hover,
.plyr--video .plyr__control[aria-expanded=true] {
  background: var(--accent);
}
.plyr__menu__container .plyr__control[role=menuitemradio][aria-checked=true]::before {
  background: var(--accent);
}
@keyframes fadeOut {
  0% { opacity: 1; }
  70% { opacity: 1; }
  100% { opacity: 0; }
}

@media (max-width: 768px) {
  .plyr-container { border-radius: 10px; margin-bottom: 14px; }
  .plyr__control--overlaid { padding: 14px !important; }
  .plyr__control--overlaid svg { width: 20px; height: 20px; }
}
</style>

</body>
</html>