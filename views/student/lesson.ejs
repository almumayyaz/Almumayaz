<%- include('../partials/header', { title: title, navPageTitle: lesson.title, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/student/course/<%= course.id %>" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-chevron-right"></i> العودة إلى <%= course.title %>
      </a>
      <h1><%= lesson.title %></h1>
      <p style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <span><i class="fas fa-book" style="color:var(--accent);"></i> <%= course.title %></span>
        <span><i class="fas fa-clock" style="color:var(--accent);"></i> <%= lesson.duration %></span>
        <% if (lesson.isFree) { %><span class="bab-free-badge">درس مجاني</span><% } %>
      </p>
    </div>
  </div>

  <!-- Plyr Video Player -->
  <% if (lesson.videos && lesson.videos.length > 0) { %>
    <% if (lesson.videos.length === 1) { %>
    <div class="plyr-container" data-plyr-provider="youtube" data-plyr-embed-id="<%= (ytId(lesson.videos[0].url) || '') %>" oncontextmenu="return false;"></div>
    <% } else { %>
    <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:28px;">
      <% lesson.videos.forEach(function(video, vi) { %>
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="background:var(--accent);color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;"><%= vi + 1 %></span>
          <span style="font-weight:600;font-size:14px;"><%= video.title || ('الجزء ' + (vi + 1)) %></span>
        </div>
        <div class="plyr-container" data-plyr-provider="youtube" data-plyr-embed-id="<%= (ytId(video.url) || '') %>" oncontextmenu="return false;"></div>
      </div>
      <% }) %>
    </div>
    <% } %>
  <% } else if (lesson.videoUrl) { %>
    <div class="plyr-container" data-plyr-provider="youtube" data-plyr-embed-id="<%= (ytId(lesson.videoUrl) || '') %>" oncontextmenu="return false;"></div>
  <% } else { %>
    <div style="text-align:center;padding:40px;background:var(--glass-bg);border-radius:var(--radius-xl);margin-bottom:28px;border:1px solid var(--border);">
      <i class="fas fa-video-slash" style="font-size:36px;color:var(--border);display:block;margin-bottom:12px;"></i>
      <p style="color:var(--text-muted);">لا يوجد فيديو لهذا الدرس بعد</p>
    </div>
  <% } %>

  <!-- Lesson Info Bar (below player) -->
  <% if (lesson.videos || lesson.videoUrl) { %>
  <div id="lessonInfoBar" style="display:none;align-items:center;gap:12px;padding:12px 16px;background:var(--card);border-radius:var(--radius-lg);border:1px solid var(--border);margin-bottom:20px;flex-wrap:wrap;">
    <% if (lesson.pdfFiles && lesson.pdfFiles.length > 0) { %>
    <a href="#pdfSection" style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--danger);text-decoration:none;font-weight:600;padding:6px 10px;background:rgba(239,68,68,0.05);border-radius:8px;">
      <i class="fas fa-file-pdf"></i> <%= lesson.pdfFiles.length %> ملف<%= lesson.pdfFiles.length > 1 ? 'ات' : '' %> PDF
    </a>
    <% } %>
    <% if (course.quiz && !isGuest) { %>
    <a href="/student/exam/<%= course.id %>" style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--accent);text-decoration:none;font-weight:600;padding:6px 10px;background:var(--accent-glow);border-radius:8px;">
      <i class="fas fa-pen"></i> الاختبار
    </a>
    <% } %>
    <div style="margin-right:auto;display:flex;align-items:center;gap:8px;">
      <span id="watchStatus" style="font-size:12px;color:var(--text-muted);">
        <i class="fas fa-circle" style="color:var(--text-muted);font-size:8px;"></i> لم تشاهد بعد
      </span>
    </div>
  </div>
  <% } %>

  <div class="lesson-content">
    <h1><%= lesson.title %></h1>
    <p><%= lesson.description %></p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;padding:16px;background:var(--bg);border-radius:8px;">
      <div><span style="font-weight:600;color:var(--primary);">المادة:</span> <span style="color:var(--text-light);"><%= course.title %></span></div>
      <div><span style="font-weight:600;color:var(--primary);">عدد الدروس:</span> <span style="color:var(--text-light);"><%= (course.lessons||[]).length %></span></div>
      <% if (lesson.videos) { %><div><span style="font-weight:600;color:var(--primary);">عدد المقاطع:</span> <span style="color:var(--text-light);"><%= lesson.videos.length %></span></div><% } %>
    </div>

    <!-- PDF Files -->
    <% if (lesson.pdfFiles && lesson.pdfFiles.length > 0) { %>
    <div id="pdfSection" style="margin-bottom:24px;">
      <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
        <i class="fas fa-file-pdf" style="color:var(--accent);"></i> المذكرات
      </h3>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <% lesson.pdfFiles.forEach(function(pdf, pi) { %>
        <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--bg);border-radius:var(--radius-sm);border:1px solid var(--border);">
          <i class="fas fa-file-pdf" style="color:var(--danger);font-size:20px;"></i>
          <span style="flex:1;font-size:14px;font-weight:500;"><%= pdf.title || ('ملف ' + (pi + 1)) %></span>
          <a href="/student/view-pdf/<%= course.id %>/<%= lesson.id %>/<%= pi %>" class="btn btn-sm" style="background:var(--primary);color:#fff;">
            <i class="fas fa-eye"></i> عرض
          </a>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Progress Tracking -->
    <div style="margin-bottom:20px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
        <span style="font-size:13px;font-weight:600;">التقدم</span>
        <span style="font-size:13px;color:var(--text-light);" id="progressPct">0%</span>
      </div>
      <div style="width:100%;height:8px;background:var(--bg);border-radius:4px;overflow:hidden;">
        <div id="progressBar" style="width:0%;height:100%;background:var(--gold-gradient);border-radius:4px;transition:width 0.5s ease;"></div>
      </div>
    </div>
  </div>

  <% if (lesson.quiz && lesson.quiz.enabled && !isGuest) { %>
  <div id="lessonQuizBanner" class="welcome-banner" style="padding:12px 16px;margin-top:20px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      <i class="fas fa-question-circle" style="color:var(--accent);font-size:14px;"></i>
      <span style="font-size:13px;font-weight:700;color:var(--accent);">اختبار الدرس</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
      <p style="font-size:13px;color:var(--text-light);margin:0;"><%= (lesson.quiz.questions||[]).length %> أسئلة - أجب عن جميع الأسئلة</p>
      <button id="startLessonQuizBtn" class="btn btn-primary btn-sm">
        <i class="fas fa-pen"></i> ابدأ اختبار الدرس
      </button>
    </div>
  </div>
  <div id="lessonQuizSection" style="display:none;margin-top:16px;">
    <div style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);padding:16px;">
      <h3 style="font-size:16px;font-weight:700;margin-bottom:4px;"><i class="fas fa-question-circle" style="color:var(--accent);"></i> اختبار الدرس</h3>
      <p style="font-size:13px;color:var(--text-light);margin-bottom:16px;">أجب عن الأسئلة التالية ثم اضغط على تقييم</p>
      <% (lesson.quiz.questions||[]).forEach(function(q, qi) { %>
      <div class="lesson-quiz-question" data-correct="<%= q.correct %>" style="margin-bottom:16px;padding:12px;background:var(--bg);border-radius:8px;border:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <span style="background:var(--accent);color:var(--primary);width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;"><%= qi + 1 %></span>
          <span style="font-size:14px;font-weight:600;"><%= q.question %></span>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;">
          <% q.options.forEach(function(o, oi) { %>
          <label style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--card);border-radius:6px;border:2px solid var(--border);cursor:pointer;font-size:13px;transition:border-color 0.15s;">
            <input type="radio" name="lq_<%= qi %>" value="<%= oi %>" style="accent-color:var(--accent);">
            <span><%= o %></span>
          </label>
          <% }) %>
        </div>
      </div>
      <% }) %>
      <button id="submitLessonQuizBtn" class="btn btn-primary" style="width:100%;"><i class="fas fa-check-circle"></i> تقييم الإجابات</button>
      <div id="lessonQuizResult" style="display:none;margin-top:16px;padding:20px;background:var(--gold-gradient);border-radius:12px;text-align:center;color:var(--primary);">
        <div id="lessonQuizScore" style="font-size:36px;font-weight:900;"></div>
        <div id="lessonQuizPct" style="font-size:18px;opacity:0.85;"></div>
        <div id="lessonQuizStatus" style="font-size:20px;font-weight:700;margin-top:4px;"></div>
      </div>
    </div>
  </div>
  <% } %>

  <% if (course.quiz && !isGuest) { %>
  <div class="welcome-banner" style="padding:12px 16px;margin-top:20px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      <i class="fas fa-question-circle" style="color:var(--accent);font-size:14px;"></i>
      <span style="font-size:13px;font-weight:700;color:var(--accent);">اختبر نفسك</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
      <p style="font-size:13px;color:var(--text-light);margin:0;">اختبر فهمك لهذه المادة بعد سماع المحاضرة</p>
      <a href="/student/exam/<%= course.id %>" class="btn btn-primary btn-sm" style="cursor:pointer;z-index:999;position:relative;">
        <i class="fas fa-pen"></i> ابدأ الاختبار
      </a>
    </div>
  </div>
  <% } %>

</main>

<script src="/js/plyr.js"></script>
<script>
(function() {
  console.log('[ANALYTICS_DEBUG] Script STARTED. courseId:', '<%= course.id %>', 'lessonId:', '<%= lesson.id %>', 'isGuest:', <%= isGuest ? 'true' : 'false' %>);
  var courseId = '<%= course.id %>';
  var lessonId = '<%= lesson.id %>';
  var isGuest = <%= isGuest ? 'true' : 'false' %>;
  var players = [];
  var savedSecond = 0;
  var autoCompleteSent = false;
  var heartbeatInterval = null;
  var lastHeartbeatPosition = 0;

  function sendHeartbeat(pos, dur, forceComplete) {
    console.log('[ANALYTICS_DEBUG] sendHeartbeat CALLED with:', JSON.stringify({pos, dur, forceComplete, isGuest, lastHeartbeatPosition}));
    if (isGuest) { console.log('[ANALYTICS_DEBUG] sendHeartbeat BLOCKED: isGuest=true'); return; }
    var watchedSinceLast = Math.max(0, Math.floor(pos) - lastHeartbeatPosition);
    console.log('[ANALYTICS_DEBUG] sendHeartbeat watchedSinceLast:', watchedSinceLast);
    if (watchedSinceLast < 1 && !forceComplete) { console.log('[ANALYTICS_DEBUG] sendHeartbeat SKIPPED: watchedSinceLast < 1'); return; }
    lastHeartbeatPosition = Math.floor(pos);
    console.log('[ANALYTICS_DEBUG] sendHeartbeat FETCHING /api/analytics/video/heartbeat with payload:', JSON.stringify({ courseId, lessonId, position: Math.floor(pos || 0), duration: Math.floor(dur || 1), watchedSeconds: forceComplete ? 0 : watchedSinceLast, forceComplete: !!forceComplete }));
    fetch('/api/analytics/video/heartbeat', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ courseId: courseId, lessonId: lessonId, position: Math.floor(pos || 0), duration: Math.floor(dur || 1), watchedSeconds: forceComplete ? 0 : watchedSinceLast, forceComplete: !!forceComplete })
    }).then(function(r) { console.log('[ANALYTICS_DEBUG] fetch response status:', r.status); return r.json(); })
      .then(function(d) { console.log('[ANALYTICS_DEBUG] fetch response body:', JSON.stringify(d)); })
      .catch(function(e) { console.log('[ANALYTICS_DEBUG] fetch ERROR:', e); });
  }

  // Load saved progress from localStorage
  var storageKey = 'lughati-progress-' + courseId + '-' + lessonId;
  function loadLocalProgress() {
    try {
      var saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
      savedSecond = saved.lastSecond || 0;
      return saved;
    } catch(e) { return {}; }
  }
  function saveLocalProgress(lastSecond, pct, completed) {
    try {
      var data = JSON.parse(localStorage.getItem(storageKey) || '{}');
      if (lastSecond !== undefined) data.lastSecond = lastSecond;
      if (pct !== undefined) data.percentage = pct;
      if (completed !== undefined) data.completed = completed;
      localStorage.setItem(storageKey, JSON.stringify(data));
    } catch(e) {}
  }

  // Load server progress and resume position
  function loadServerProgress() {
    fetch('/api/analytics/video/status?courseId=' + courseId + '&lessonId=' + lessonId)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success) {
          var pct = d.completionPercent || 0;
          var completed = d.completed;
          var resumePos = d.resumePosition || 0;
          updateUI(pct, completed);
          if (completed) {
            saveLocalProgress(undefined, pct, true);
            updateInfoBar(true);
          }
          if (resumePos > 1 && !completed) {
            savedSecond = resumePos;
            saveLocalProgress(resumePos, pct, false);
            players.forEach(function(p) {
              try { p.currentTime = resumePos; } catch(e) {}
              var notice = document.createElement('div');
              notice.style.cssText = 'position:absolute;top:18%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.7);color:#fff;padding:10px 18px;border-radius:8px;font-size:13px;z-index:20;pointer-events:none;text-align:center;animation:fadeOut 3s ease forwards;';
              notice.textContent = 'استكمال من ' + Math.floor(resumePos / 60) + ':' + String(Math.floor(resumePos % 60)).padStart(2, '0');
              var container = p.elements && p.elements.container;
              if (container) { container.appendChild(notice); setTimeout(function () { notice.remove(); }, 3000); }
            });
          } else {
            loadLocalProgress();
          }
        } else {
          loadLocalProgress();
        }
      }).catch(function() { loadLocalProgress(); });
  }

  // Save progress to server
  function saveServerProgress(pct, completed) {
    fetch('/api/student/progress', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ courseId: courseId, lessonId: lessonId, completed: completed || false, percentage: pct })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success && completed) {
        updateUI(100, true);
      }
    });
  }

  function updateUI(pct, completed) {
    var bar = document.getElementById('progressBar');
    var label = document.getElementById('progressPct');
    if (bar) bar.style.width = pct + '%';
    if (label) label.textContent = pct + '%';
    updateInfoBar(completed);
  }

  function updateInfoBar(completed) {
    var bar = document.getElementById('lessonInfoBar');
    if (!bar) return;
    bar.style.display = 'flex';
    var status = document.getElementById('watchStatus');
    if (!status) return;
    if (completed) {
      status.innerHTML = '<i class="fas fa-check-circle" style="color:var(--success);font-size:12px;"></i> <span style="color:var(--success);">مكتمل</span>';
    } else {
      status.innerHTML = '<i class="fas fa-play-circle" style="color:var(--accent);font-size:12px;"></i> قيد المشاهدة';
    }
  }

  // Disable dev-tools / save / print / view-source shortcuts on this page.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'F12' || e.keyCode === 123) { e.preventDefault(); return; }
    if (e.ctrlKey || e.metaKey) {
      var k = (e.key || '').toLowerCase();
      if (k === 's' || k === 'p' || k === 'u') e.preventDefault();
    }
  });

  function embedFallback(container) {
    var id = container.getAttribute('data-plyr-embed-id');
    if (!id) return;
    var src = 'https://www.youtube.com/embed/' + encodeURIComponent(id) + '?rel=0&modestbranding=1&iv_load_policy=3&controls=0';
    container.innerHTML = '<iframe src="' + src + '" style="width:100%;aspect-ratio:16/9;border:0;border-radius:12px;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
  }

  function setupYoutubeOverlay(container, player) {
    var wrapper = container.querySelector('.plyr__video-wrapper');
    if (!wrapper) return;
    wrapper.style.position = 'relative';
    var topEl = document.createElement('div');
    topEl.className = 'plyr-youtube-overlay plyr-youtube-overlay-top';
    var botEl = document.createElement('div');
    botEl.className = 'plyr-youtube-overlay plyr-youtube-overlay-bottom';
    wrapper.appendChild(topEl);
    wrapper.appendChild(botEl);
    function show(){ topEl.classList.remove('plyr-youtube-overlay-hidden'); botEl.classList.remove('plyr-youtube-overlay-hidden'); }
    function hide(){ topEl.classList.add('plyr-youtube-overlay-hidden'); botEl.classList.add('plyr-youtube-overlay-hidden'); }
    player.on('ready', function(){ if (player.playing) hide(); else show(); });
    player.on('playing', hide);
    player.on('pause', show);
    player.on('ended', show);
  }

  // Initialise Plyr players (minimal: play/pause only) + wire progress tracking.
  console.log('[ANALYTICS_DEBUG] Plyr constructor available:', typeof Plyr);
  if (typeof Plyr === 'undefined') {
    console.log('[ANALYTICS_DEBUG] Plyr NOT loaded, using embedFallback');
    document.querySelectorAll('.plyr-container[data-plyr-embed-id]').forEach(embedFallback);
  } else {
    document.querySelectorAll('.plyr-container[data-plyr-embed-id]').forEach(function (container) {
      var videoId = container.getAttribute('data-plyr-embed-id');
      if (!videoId) { console.log('[ANALYTICS_DEBUG] NO videoId on container'); return; }
      console.log('[ANALYTICS_DEBUG] Creating Plyr player for videoId:', videoId);

      var player = new Plyr(container, {
        iconUrl: '/img/plyr.svg',
        controls: ['play-large', 'play', 'progress', 'current-time', 'duration'],
        youtube: { noCookie: true, rel: 0, modestbranding: 1, iv_load_policy: 3, playsinline: 1 },
        urls: { youtube: { api: '' } },
        keyboard: { focused: true, global: false },
        clickToPlay: true,
        hideControls: true,
        resetOnEnd: false,
        displayDuration: true
      });
      players.push(player);

      player.on('ready', function () {
        console.log('[ANALYTICS_DEBUG] EVENT: ready fired. player.currentTime:', player.currentTime, 'player.duration:', player.duration);
        updateInfoBar(false);
        updateUI(0, false);
        loadServerProgress();
      });

      player.on('timeupdate', function () {
        var ct = player.currentTime || 0;
        var dur = player.duration || 1;
        var pct = Math.min(Math.round((ct / dur) * 100), 100);
        console.log('[ANALYTICS_DEBUG] EVENT: timeupdate ct:', ct, 'dur:', dur, 'pct:', pct);
        if (pct >= 95 && !autoCompleteSent) {
          console.log('[ANALYTICS_DEBUG] timeupdate: completion threshold reached');
          autoCompleteSent = true;
          saveLocalProgress(0, 100, true);
          saveServerProgress(100, true);
          updateUI(100, true);
          sendHeartbeat(ct, dur, true);
        }
        if (Math.floor(ct) !== Math.floor(savedSecond)) {
          savedSecond = Math.floor(ct);
          saveLocalProgress(savedSecond, pct, false);
          updateUI(pct, false);
        }
      });

      player.on('pause', function () {
        var ct = player.currentTime || 0;
        var dur = player.duration || 1;
        var pct = Math.min(Math.round((ct / dur) * 100), 100);
        console.log('[ANALYTICS_DEBUG] EVENT: pause ct:', ct, 'dur:', dur, 'pct:', pct, 'autoCompleteSent:', autoCompleteSent);
        if (heartbeatInterval) { clearInterval(heartbeatInterval); heartbeatInterval = null; console.log('[ANALYTICS_DEBUG] pause: cleared heartbeatInterval'); }
        if (pct >= 95 && !autoCompleteSent) {
          console.log('[ANALYTICS_DEBUG] pause: completion at >= 95%, calling saveServerProgress only');
          autoCompleteSent = true;
          saveLocalProgress(0, 100, true);
          saveServerProgress(100, true);
          updateUI(100, true);
          return;
        }
        saveLocalProgress(Math.floor(ct), pct, false);
        saveServerProgress(pct, false);
        if (Math.floor(ct) !== lastHeartbeatPosition) {
          sendHeartbeat(ct, dur, false);
          lastHeartbeatPosition = Math.floor(ct);
        }
      });

      player.on('play', function () {
        var ct = player.currentTime || 0;
        console.log('[ANALYTICS_DEBUG] EVENT: play ct:', ct, 'player.duration:', player.duration);
        updateInfoBar(false);
        lastHeartbeatPosition = Math.floor(ct);
        if (heartbeatInterval) { clearInterval(heartbeatInterval); console.log('[ANALYTICS_DEBUG] play: cleared existing interval'); }
        heartbeatInterval = setInterval(function() {
          var ct2 = player.currentTime || 0;
          console.log('[ANALYTICS_DEBUG] INTERVAL: 15s fired. currentTime:', ct2, 'lastHeartbeatPosition:', lastHeartbeatPosition);
          if (Math.floor(ct2) !== lastHeartbeatPosition) {
            sendHeartbeat(ct2, player.duration || 1, false);
            lastHeartbeatPosition = Math.floor(ct2);
          } else {
            console.log('[ANALYTICS_DEBUG] INTERVAL: position unchanged, skipping heartbeat');
          }
        }, 15000);
      });

      player.on('ended', function () {
        console.log('[ANALYTICS_DEBUG] EVENT: ended');
        saveLocalProgress(0, 100, true);
        saveServerProgress(100, true);
        updateUI(100, true);
      });

      setupYoutubeOverlay(container, player);
    });
  }

  // Log currentTime every second for active players
  setInterval(function() {
    if (players.length > 0) {
      players.forEach(function(p, i) {
        try {
          var ct = p.currentTime || 0;
          var dur = p.duration || 0;
          console.log('[ANALYTICS_DEBUG] 1s tick player[' + i + '] currentTime:', ct, 'duration:', dur);
        } catch(e) {
          console.log('[ANALYTICS_DEBUG] 1s tick ERROR:', e.message);
        }
      });
    }
  }, 1000);

  // Save on page unload (user closes tab/app)
  window.addEventListener('beforeunload', function() {
    if (heartbeatInterval) clearInterval(heartbeatInterval);
    players.forEach(function(p) {
      var ct = p.currentTime || 0;
      var dur = p.duration || 1;
      var pct = Math.min(Math.round((ct / dur) * 100), 100);
      saveLocalProgress(Math.floor(ct), pct, false);
      if (!isGuest && ct > 0) {
        navigator.sendBeacon('/api/analytics/video/heartbeat', JSON.stringify({ courseId: courseId, lessonId: lessonId, position: Math.floor(ct), duration: Math.floor(dur), watchedSeconds: 0, forceComplete: false }));
      }
    });
  });

  // Lesson quiz logic
  var quizBanner = document.getElementById('lessonQuizBanner');
  var startQuizBtn = document.getElementById('startLessonQuizBtn');
  var quizSection = document.getElementById('lessonQuizSection');
  var submitQuizBtn = document.getElementById('submitLessonQuizBtn');
  var quizResult = document.getElementById('lessonQuizResult');

  if (startQuizBtn) {
    startQuizBtn.addEventListener('click', function() {
      if (quizBanner) quizBanner.style.display = 'none';
      if (quizSection) quizSection.style.display = '';
    });
  }

  if (submitQuizBtn) {
    submitQuizBtn.addEventListener('click', function() {
      var questions = document.querySelectorAll('.lesson-quiz-question');
      var score = 0, total = questions.length, allAnswered = true;
      questions.forEach(function(q, idx) {
        var selected = q.querySelector('input[type="radio"]:checked');
        var options = q.querySelectorAll('label');
        var correct = parseInt(q.dataset.correct);
        if (!selected) { allAnswered = false; return; }
        var selIdx = parseInt(selected.value);
        options.forEach(function(o, oi) {
          o.style.borderColor = oi === correct ? '#059669' : '';
          o.style.background = oi === correct ? 'rgba(5,150,105,0.08)' : '';
        });
        if (selIdx === correct) { score++; }
        else { selected.closest('label').style.borderColor = '#DC2626'; }
      });
      if (!allAnswered) { alert('يرجى الإجابة على جميع الأسئلة أولاً'); return; }
      var pct = Math.round((score / total) * 100);
      submitQuizBtn.style.display = 'none';
      if (quizResult) {
        quizResult.style.display = '';
        document.getElementById('lessonQuizScore').textContent = score + '/' + total;
        document.getElementById('lessonQuizPct').textContent = pct + '%';
        document.getElementById('lessonQuizStatus').textContent = pct >= (<%= (lesson.quiz && lesson.quiz.passPercentage) || 60 %>) ? 'ناجح ✓' : 'لم تحقق نسبة النجاح';
      }
      fetch('/api/analytics/quiz/submit', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ courseId: courseId, quizId: lessonId, quizTitle: '<%= lesson.title %>', score: score, total: total, correct: score, wrong: total - score, timeTaken: 0 })
      }).catch(function(){});
    });
  }

  // Initial load
  loadServerProgress();

})();
</script>

</body>
</html>