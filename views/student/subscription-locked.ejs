<%- include('../partials/header', { title: title, navPageTitle: 'المحتوى مقفل', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content" style="display:flex;align-items:center;justify-content:center;min-height:calc(100vh - 72px - 64px);">
  <div style="text-align:center;max-width:480px;width:100%;">
    <div style="font-size:80px;color:var(--accent);margin-bottom:24px;animation:float 3s ease-in-out infinite;">
      <i class="fas fa-lock"></i>
    </div>
    <h1 style="font-family:'Aref Ruqaa',serif;font-size:32px;font-weight:700;margin-bottom:12px;color:var(--text);">هذا المحتوى يتطلب اشتراك</h1>
    <p style="font-size:16px;color:var(--text-light);margin-bottom:28px;line-height:1.8;">
      عذراً، هذا المحتوى متاح فقط للمشتركين في منصة المُميز.<br>
      اشترك الآن واستمتع بجميع المحاضرات والمذكرات والمراجعات.
    </p>
    <div style="display:flex;flex-direction:column;gap:12px;align-items:center;">
      <div style="background:var(--card);border-radius:var(--radius);padding:16px 24px;border:1px solid var(--border);width:100%;max-width:320px;">
        <div style="font-size:13px;color:var(--text-muted);margin-bottom:4px;">حالة اشتراكك</div>
        <div style="font-size:18px;font-weight:700;color:var(--danger);">
          <i class="fas fa-times-circle" style="font-size:16px;"></i> غير مشترك
        </div>
      </div>
      <% if (isGuest) { %>
      <a href="/register" class="btn btn-primary btn-lg" style="width:100%;max-width:320px;">
        <i class="fas fa-user-plus"></i> إنشاء حساب للوصول الكامل
      </a>
      <% } else { %>
      <a href="/student/subscription" class="btn btn-primary btn-lg" style="width:100%;max-width:320px;">
        <i class="fas fa-credit-card"></i> اشترك الآن
      </a>
      <% } %>
      <a href="/student" style="color:var(--accent);font-size:14px;font-weight:600;margin-top:8px;display:inline-flex;align-items:center;gap:6px;transition:all 0.3s;">
        <i class="fas fa-arrow-right"></i> العودة إلى الرئيسية
      </a>
    </div>
  </div>
</main>
<style>
@keyframes float {
  0%,100% { transform:translateY(0); }
  50% { transform:translateY(-12px); }
}
</style>
</body>
</html>