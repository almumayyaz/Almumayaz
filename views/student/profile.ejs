<%- include('../partials/header', { title: title, navPageTitle: 'حسابي', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <h1>حسابي</h1>
      <p>معلومات الحساب الشخصية</p>
    </div>
  </div>
  <div class="profile-card">
    <div class="profile-header">
      <div class="profile-avatar"><%= user.name.charAt(0) %></div>
      <h2 id="profileNameDisplay"><%= user.name %></h2>
    </div>

    <!-- Edit mode inputs (hidden by default) -->
    <div id="profileEditForm" style="display:none;">
      <div class="info-row">
        <span class="label">اسم الطالب</span>
        <input id="editName" class="value" value="<%= user.name %>" style="padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;width:100%;">
      </div>
      <div class="info-row">
        <span class="label">رقم الهاتف</span>
        <input id="editPhone" class="value" value="<%= user.phone||'' %>" style="padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;width:100%;">
      </div>
      <div class="info-row">
        <span class="label">رقم ولي الأمر</span>
        <input id="editParentPhone" class="value" value="<%= user.parentPhone||'' %>" style="padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;width:100%;">
      </div>
      <div class="info-row">
        <span class="label">المرحلة</span>
        <select id="editStage" class="value" style="padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;width:100%;">
          <option value="">اختر المرحلة</option>
          <option value="إعدادية" <%= user.stage==='إعدادية'?'selected':'' %>>إعدادية</option>
          <option value="ثانوية" <%= user.stage==='ثانوية'?'selected':'' %>>ثانوية</option>
        </select>
      </div>
      <div class="info-row">
        <span class="label">الصف الدراسي</span>
        <select id="editGrade" class="value" style="padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;width:100%;">
          <option value="">اختر الصف</option>
          <option value="الأول الإعدادي" <%= user.grade==='الأول الإعدادي'?'selected':'' %>>الأول الإعدادي</option>
          <option value="الثاني الإعدادي" <%= user.grade==='الثاني الإعدادي'?'selected':'' %>>الثاني الإعدادي</option>
          <option value="الثالث الإعدادي" <%= user.grade==='الثالث الإعدادي'?'selected':'' %>>الثالث الإعدادي</option>
          <option value="الأول الثانوي" <%= user.grade==='الأول الثانوي'?'selected':'' %>>الأول الثانوي</option>
          <option value="الثاني الثانوي" <%= user.grade==='الثاني الثانوي'?'selected':'' %>>الثاني الثانوي</option>
          <option value="الثالث الثانوي" <%= user.grade==='الثالث الثانوي'?'selected':'' %>>الثالث الثانوي</option>
        </select>
      </div>
      <div class="info-row">
        <span class="label">المحافظة</span>
        <select id="editGovernorate" class="value" style="padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;width:100%;">
          <option value="">اختر المحافظة</option>
          <% ['القاهرة','الجيزة','الإسكندرية','الدقهلية','الشرقية','القليوبية','الغربية','المنوفية','كفر الشيخ','البحيرة','دمياط','بورسعيد','السويس','الإسماعيلية','الفيوم','بني سويف','المنيا','أسيوط','سوهاج','قنا','الأقصر','أسوان'].forEach(function(g) { %>
          <option value="<%= g %>" <%= user.governorate===g?'selected':'' %>><%= g %></option>
          <% }) %>
        </select>
      </div>
      <div class="info-row">
        <span class="label">البريد الإلكتروني</span>
        <span class="value" dir="ltr" style="color:var(--text-muted);"><%= user.email || '---' %></span>
      </div>
      <div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap;">
        <button class="btn btn-primary" onclick="saveProfile()"><i class="fas fa-save"></i> حفظ التغييرات</button>
        <button class="btn" style="background:var(--bg);color:var(--text);" onclick="toggleEdit()"><i class="fas fa-times"></i> إلغاء</button>
      </div>
    </div>

    <!-- View mode (default) -->
    <div id="profileView">
      <div class="info-row">
        <span class="label">اسم الطالب</span>
        <span class="value" id="viewName"><%= user.name %></span>
      </div>
      <div class="info-row">
        <span class="label">البريد الإلكتروني</span>
        <span class="value" dir="ltr"><%= user.email || '---' %></span>
      </div>
      <div class="info-row">
        <span class="label">رقم الهاتف</span>
        <span class="value" id="viewPhone"><%= user.phone || '---' %></span>
      </div>
      <div class="info-row">
        <span class="label">رقم ولي الأمر</span>
        <span class="value" id="viewParentPhone"><%= user.parentPhone || '---' %></span>
      </div>
      <div class="info-row">
        <span class="label">المرحلة</span>
        <span class="value" id="viewStage"><%= user.stage || '---' %></span>
      </div>
      <div class="info-row">
        <span class="label">الصف الدراسي</span>
        <span class="value" id="viewGrade"><%= user.grade || '---' %></span>
      </div>
      <div class="info-row">
        <span class="label">المحافظة</span>
        <span class="value" id="viewGovernorate"><%= user.governorate || '---' %></span>
      </div>
      <div class="info-row">
        <span class="label">حالة الاشتراك</span>
        <% var subStatus = user.subscriptionStatus; %>
        <% if (subStatus === 'active') { %>
        <span class="value" style="color:var(--success);font-weight:700;">نشط <span style="font-size:12px;font-weight:400;color:var(--text-light);">(حتى <%= new Date(user.subscriptionEnd).toLocaleDateString('ar-EG') %>)</span></span>
        <% } else if (subStatus === 'expired') { %>
        <span class="value" style="color:var(--danger);font-weight:700;">منتهي</span>
        <% } else if (subStatus === 'cancelled') { %>
        <span class="value" style="color:var(--warning);font-weight:700;">ملغي</span>
        <% } else { %>
        <span class="value" style="color:var(--text-light);">غير مشترك</span>
        <% } %>
      </div>
      <% if (user.referralCode) { %>
      <div class="info-row">
        <span class="label">كود الإحالة</span>
        <span class="value" dir="ltr" style="font-family:monospace;background:var(--bg);padding:2px 10px;border-radius:4px;font-weight:700;letter-spacing:1px;"><%= user.referralCode %></span>
        <button class="btn btn-sm" onclick="navigator.clipboard.writeText('<%= user.referralCode %>');this.innerHTML='<i class=\\'fas fa-check\\'></i>';setTimeout(()=>this.innerHTML='<i class=\\'fas fa-copy\\'></i>',1500)" style="font-size:12px;padding:4px 10px;"><i class="fas fa-copy"></i></button>
      </div>
      <% } %>
      <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
        <button class="btn btn-primary" onclick="toggleEdit()"><i class="fas fa-edit"></i> تعديل البيانات</button>
        <a href="/student/subscription" class="btn" style="background:var(--accent);color:#fff;"><i class="fas fa-credit-card"></i> إدارة الاشتراك</a>
      </div>
    </div>
  </div>
</main>

<script>
function toggleEdit() {
  var form = document.getElementById('profileEditForm');
  var view = document.getElementById('profileView');
  if (form.style.display === 'none') {
    form.style.display = 'block';
    view.style.display = 'none';
  } else {
    form.style.display = 'none';
    view.style.display = 'block';
  }
}
function saveProfile() {
  var btn = document.querySelector('#profileEditForm .btn-primary');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
  fetch('/api/student/profile', {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({
      name: document.getElementById('editName').value,
      phone: document.getElementById('editPhone').value,
      parentPhone: document.getElementById('editParentPhone').value,
      stage: document.getElementById('editStage').value,
      grade: document.getElementById('editGrade').value,
      governorate: document.getElementById('editGovernorate').value
    })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) {
      document.getElementById('viewName').textContent = d.user.name;
      document.getElementById('viewPhone').textContent = d.user.phone || '---';
      document.getElementById('viewParentPhone').textContent = d.user.parentPhone || '---';
      document.getElementById('viewStage').textContent = d.user.stage || '---';
      document.getElementById('viewGrade').textContent = d.user.grade || '---';
      document.getElementById('viewGovernorate').textContent = d.user.governorate || '---';
      document.getElementById('profileNameDisplay').textContent = d.user.name;
      toggleEdit();
      alert('تم حفظ التغييرات بنجاح');
    } else alert(d.error || 'فشل الحفظ');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> حفظ التغييرات';
  }).catch(function() {
    alert('فشل الاتصال بالخادم');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> حفظ التغييرات';
  });
}
</script>
<%- include('../partials/footer') %>
