  <!-- Guest visible courses/lessons -->
  <% var guestCourses = courses.filter(function(c) { return c.lessons.some(function(l) { return l.guestVisible; }); }); %>
  <% if (guestCourses.length > 0) { %>
  <div style="background:var(--card);border-radius:var(--radius-lg);padding:20px;box-shadow:var(--shadow);border:1px solid var(--border);margin-bottom:16px;">
    <h3 style="font-size:16px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
      <i class="fas fa-eye" style="color:var(--accent);"></i> المحتوى التجريبي (مشاهدة مجانية)
    </h3>
    <% guestCourses.forEach(function(c) { %>
      <% var guestLessons = c.lessons.filter(function(l) { return l.guestVisible; }); %>
      <% if (guestLessons.length > 0) { %>
      <div style="margin-bottom:12px;">
        <div style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
          <span style="width:6px;height:6px;background:var(--accent);border-radius:50%;display:inline-block;"></span>
          <%= c.title %>
