        </div>
      </div>
      <% } %>
    <% }) %>
    <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);text-align:center;">
      <a href="/register" class="btn btn-primary" style="font-size:13px;">سجل الآن للوصول إلى جميع المحاضرات</a>
    </div>
  </div>
  <% } %>
  <% } %>

