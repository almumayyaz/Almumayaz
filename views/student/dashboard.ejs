        </div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-right:14px;">
          <% guestLessons.forEach(function(l) { %>
          <a href="/student/lesson/<%= c.id %>/<%= l.id %>" style="background:var(--bg);padding:6px 14px;border-radius:6px;font-size:12px;color:var(--text);transition:all 0.2s;display:flex;align-items:center;gap:6px;">
