    <div style="flex:1;">
      <div id="quoteText" style="font-size:14px;font-weight:600;color:var(--text);line-height:1.6;"></div>
      <div id="quoteAuthor" style="font-size:12px;color:var(--text-light);margin-top:4px;"></div>
    </div>
  </div>
  <script>
  fetch('/api/student/quote').then(function(r){return r.json()}).then(function(q){
    document.getElementById('quoteText').textContent = '📖 ' + q.text;
    document.getElementById('quoteAuthor').textContent = '— ' + q.author;
  }).catch(function(){document.getElementById('quoteBanner').style.display='none'});
  </script>

  <% if (!isGuest) { %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
    <a href="/student/live-sessions" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#fff;border-radius:var(--radius-lg);padding:16px;font-size:13px;font-weight:700;text-decoration:none;">
      <i class="fas fa-video" style="font-size:22px;"></i> الحصص المباشرة
    </a>
    <a href="/student/chat" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,#1a73e8,#0d47a1);color:#fff;border-radius:var(--radius-lg);padding:16px;font-size:13px;font-weight:700;text-decoration:none;">
      <i class="fas fa-comment-dots" style="font-size:22px;"></i> اسأل عفيفي
    </a>
  </div>
  <% } %>

  <!-- الحصص المباشرة - بطاقة ديناميكية (API polling لتفادي Firebase security rules) -->
  <script>
  (function() {
    var card = document.getElementById('liveSessionCard');
    if (!card) return;
    var sessions = [];
    var currentSession = null;

    function renderCard() {
      var live = sessions.filter(function(s) { return s.status === 'Live'; }).sort(function(a,b) { return new Date(a.startTime) - new Date(b.startTime); });
      var upcoming = sessions.filter(function(s) { return s.status === 'Scheduled'; }).sort(function(a,b) { return new Date(a.startTime) - new Date(b.startTime); });
      currentSession = live.length > 0 ? live[0] : (upcoming.length > 0 ? upcoming[0] : null);
      if (!currentSession) { card.style.display = 'none'; card.innerHTML = ''; return; }
      var isLive = currentSession.status === 'Live';
      var startDate = new Date(currentSession.startTime);
      card.style.display = 'block';
      card.innerHTML =
        '<div style="background:var(--card);border:2px solid ' + (isLive ? '#dc2626' : 'var(--accent)') + ';border-radius:var(--radius-lg);padding:16px 20px;box-shadow:0 4px 16px rgba(245,158,11,0.15);">' +
          '<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">' +
            '<i class="fas fa-video" style="color:' + (isLive ? '#dc2626' : 'var(--accent)') + ';font-size:20px;"></i>' +
            '<span style="font-weight:700;font-size:15px;">🎥 الحصص المباشرة</span>' +
            (isLive ? '<span style="background:#dc262620;color:#dc2626;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;display:flex;align-items:center;gap:4px;"><span style="width:6px;height:6px;background:#dc2626;border-radius:50%;display:inline-block;animation:pulse 1.5s infinite;"></span> مباشر الآن</span>' : '') +
          '</div>' +
          '<div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;">' +
            '<div style="flex:1;min-width:150px;">' +
              '<div style="font-weight:700;font-size:14px;margin-bottom:4px;">' + (currentSession.title || '') + '</div>' +
              '<div style="font-size:12px;color:var(--text-muted);display:flex;flex-wrap:wrap;gap:4px 12px;">' +
                (currentSession.subject ? '<span><i class="fas fa-book" style="color:var(--accent);font-size:10px;"></i> ' + currentSession.subject + '</span>' : '') +
                (currentSession.grade ? '<span><i class="fas fa-layer-group" style="color:var(--accent);font-size:10px;"></i> ' + currentSession.grade + '</span>' : '') +
                '<span><i class="fas fa-calendar" style="color:var(--accent);font-size:10px;"></i> ' + startDate.toLocaleDateString('ar-EG', { weekday:'short', month:'short', day:'numeric' }) + '</span>' +
                '<span><i class="fas fa-clock" style="color:var(--accent);font-size:10px;"></i> ' + startDate.toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' }) + '</span>' +
                (currentSession.duration ? '<span><i class="fas fa-hourglass-half" style="color:var(--accent);font-size:10px;"></i> ' + currentSession.duration + ' دقيقة</span>' : '') +
              '</div>' +
            '</div>' +
            '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">' +
              '<a href="/student/live-session/' + currentSession.id + '" style="display:inline-flex;align-items:center;gap:6px;background:' + (isLive ? '#dc2626' : 'var(--accent)') + ';color:#fff;padding:8px 16px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;">' +
                (isLive ? '<i class="fas fa-video"></i> انضم الآن' : '<i class="fas fa-info-circle"></i> عرض التفاصيل') +
              '</a>' +
            '</div>' +
          '</div>' +
          (!isLive ? '<div class="ls-countdown" data-start="' + currentSession.startTime + '" style="margin-top:8px;font-size:12px;color:var(--accent);font-weight:600;"></div>' : '') +
        '</div>';
      if (!isLive) startCountdown();
    }

    function startCountdown() {
      var cd = card.querySelector('.ls-countdown');
      if (!cd) return;
      function tick() {
        if (!cd) return;
        var start = new Date(cd.getAttribute('data-start')).getTime();
        var diff = start - Date.now();
        if (diff <= 0) { cd.textContent = 'الحصة بدأت الآن!'; return; }
        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        cd.textContent = 'تبدأ بعد ' + h + 'س ' + m + 'د ' + s + 'ث';
      }
      tick();
      setInterval(tick, 1000);
    }

    function checkSessions() {
      fetch('/api/live-sessions/upcoming')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d && Array.isArray(d.sessions)) sessions = d.sessions;
          renderCard();
        })
        .catch(function() {});
    }

    checkSessions();
    setInterval(checkSessions, 15000);
  })();
  </script>

