<%- include('../partials/header', { title: title, navPageTitle: 'الرئيسية', bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <h1 style="font-size:20px;">مرحباً، <%= user.name %></h1>
      <p>منصة المُميز التعليمية</p>
    </div>
  </div>

  <div id="quoteBanner" style="background:linear-gradient(135deg,var(--accent-glow),transparent);border:1px solid color-mix(in srgb, var(--accent) 25%, transparent);border-radius:var(--radius-lg);padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px;">
    <i class="fas fa-quote-right" style="color:var(--accent);font-size:20px;flex-shrink:0;"></i>
    <div style="flex:1;">
      <div id="quoteText" style="font-size:14px;font-weight:600;color:var(--text);line-height:1.6;"></div>
      <div id="quoteAuthor" style="font-size:12px;color:var(--text-light);margin-top:4px;"></div>
    </div>
  </div>
  <script>
  fetch('/api/student/quote').then(function(r){return r.json()}).then(function(q){
    document.getElementById('quoteText').textContent = '📖 ' + q.text;
    document.getElementById('quoteAuthor').textContent = '— ' + q.author;
  }).catch(function(){document.getElementById('quoteBanner').style.display='none'});
  </script>

  <% if (!isGuest) { %>
  <% if (user.subscriptionStatus === 'active') { %>
  <div style="background:linear-gradient(135deg,var(--success-glow),transparent);border:1px solid var(--success);border-radius:var(--radius-lg);padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px;">
    <i class="fas fa-check-circle" style="color:var(--success);font-size:22px;"></i>
    <div>
      <div style="font-weight:700;font-size:14px;color:var(--success);">اشتراكك نشط</div>
      <div style="font-size:12px;color:var(--text-light);">مشترك حتى <%= new Date(user.subscriptionEnd).toLocaleDateString('ar-EG') %></div>
    </div>
  </div>
  <% } else if (user.subscriptionStatus === 'expired') { %>
  <div style="background:linear-gradient(135deg,var(--danger-glow),transparent);border:1px solid var(--danger);border-radius:var(--radius-lg);padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px;">
    <i class="fas fa-exclamation-triangle" style="color:var(--danger);font-size:22px;"></i>
    <div>
      <div style="font-weight:700;font-size:14px;color:var(--danger);">انتهى اشتراكك</div>
      <div style="font-size:12px;color:var(--text-light);">جدد اشتراكك الآن للوصول إلى المحاضرات</div>
    </div>
    <a href="/student/subscription" style="margin-right:auto;background:var(--danger);color:#fff;padding:8px 16px;border-radius:var(--radius);font-size:13px;font-weight:700;">تجديد</a>
  </div>
  <% } %>
  <% } %>

  <div class="welcome-banner" style="overflow:hidden;padding:8px 12px;">
    <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
      <i class="fas fa-bullhorn" style="color:var(--accent);font-size:12px;"></i>
      <span style="font-size:11px;font-weight:600;color:var(--accent);">آخر الإعلانات</span>
    </div>
    <div style="overflow:hidden;height:100px;position:relative;">
      <div id="announcementTrack" style="position:absolute;width:100%;">
        <% 
        var items = (announcements && announcements.length > 0) ? announcements : [
          { title: 'مرحباً بك في منصة المُميز', content: 'نتمنى لك عاماً دراسياً مليئاً بالنجاح والتفوق', important: false },
          { title: 'عرض الحجز المبكر', content: 'احجز الآن واستفد من خصومات الحجز المبكر للعام الدراسي', important: true },
          { title: 'متابعة المحاضرات', content: 'تأكد من متابعة أحدث المحاضرات أولاً بأول', important: false }
        ];
        items.slice(0, 5).forEach(function(a) { 
        %>
        <div class="carousel-item" data-title="<%= a.title.replace(/"/g, '&quot;') %>" data-content="<%= a.content.replace(/"/g, '&quot;') %>" style="cursor:pointer;display:flex;flex-direction:column;justify-content:center;height:100px;">
          <div style="font-size:12px;font-weight:700;color:var(--text);"><%= a.title %><% if (a.important) { %><span style="background:var(--danger);color:#fff;font-size:9px;padding:1px 6px;border-radius:3px;font-weight:700;margin-right:6px;">مهم</span><% } %></div>
          <div style="font-size:11px;color:var(--text-light);margin-top:2px;"><%= a.content %></div>
        </div>
        <% }) %>
      </div>
    </div>
    <style>
      .carousel-item { transition: background 0.3s; border-radius: 6px; padding: 6px 14px; box-sizing:border-box; }
      .carousel-item:hover { background: var(--accent-glow); }
    </style>
    <script>
    (function(){
      var track = document.getElementById('announcementTrack');
      if (!track) return;
      var items = Array.from(track.children);
      if (items.length > 0) items.forEach(function(el) {
        el.addEventListener('click', function() {
          alert(this.dataset.title + '\n\n' + this.dataset.content);
        });
      });
      if (items.length < 2) return;
      var firstClone = items[0].cloneNode(true);
      firstClone.addEventListener('click', function() {
        alert(this.dataset.title + '\n\n' + this.dataset.content);
      });
      track.appendChild(firstClone);
      var total = items.length + 1, idx = 0, itemH = 100;
      setInterval(function(){
        idx++;
        track.style.transition = 'transform 0.6s ease';
        track.style.transform = 'translateY(-' + (idx * itemH) + 'px)';
        if (idx === total - 1) {
          setTimeout(function(){
            track.style.transition = 'none';
            track.style.transform = 'translateY(0)';
            idx = 0;
          }, 700);
        }
      }, 3500);
    })();
    </script>
  </div>

  <div class="dashboard-grid">
    <div class="stat-card" style="padding:12px;">
      <div style="display:grid;gap:6px;">
        <a href="/student/courses" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text);transition:all 0.2s;">
          <i class="fas fa-video" style="color:var(--accent);font-size:16px;width:20px;text-align:center;"></i> المحاضرات
        </a>
        <% if (!isGuest) { %>
        <a href="/student/question-bank" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text);transition:all 0.2s;">
          <i class="fas fa-question-circle" style="color:var(--accent);font-size:16px;width:20px;text-align:center;"></i> بنك الأسئلة
        </a>
        <a href="/student/notes" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text);transition:all 0.2s;">
          <i class="fas fa-file-pdf" style="color:var(--accent);font-size:16px;width:20px;text-align:center;"></i> المذكرات
        </a>
        <a href="/student/reviews" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text);transition:all 0.2s;">
          <i class="fas fa-sync-alt" style="color:var(--accent);font-size:16px;width:20px;text-align:center;"></i> المراجعات
        </a>
        <% } %>
      </div>
      <style>.dashboard-grid .stat-card a:hover{background:var(--accent-glow);padding-right:18px;}</style>
    </div>
    <div class="stat-card" style="padding:12px;">
      <div style="display:grid;gap:6px;">
        <% if (!isGuest) { %>
        <a href="/student/subscription" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text);transition:all 0.2s;">
          <i class="fas fa-credit-card" style="color:var(--accent);font-size:16px;width:20px;text-align:center;"></i> الاشتراك
        </a>
        <a href="/student/profile" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text);transition:all 0.2s;">
          <i class="fas fa-user" style="color:var(--accent);font-size:16px;width:20px;text-align:center;"></i> حسابي
        </a>
        <% } %>
        <a href="/logout" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;color:var(--text);transition:all 0.2s;">
          <i class="fas fa-sign-out-alt" style="color:var(--danger);font-size:16px;width:20px;text-align:center;"></i> تسجيل الخروج
        </a>
      </div>
    </div>
  </div>

  <% if (progress && Object.keys(progress).length > 0) { %>
  <div style="background:var(--card);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow);border:1px solid var(--border);margin-bottom:16px;">
    <h3 style="font-size:16px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
      <i class="fas fa-chart-line" style="color:var(--accent);"></i> تقدمك في المحاضرات
    </h3>
    <% var pCourses = courses.filter(function(c) { return progress[c.id]; }); %>
    <% pCourses.slice(0, 4).forEach(function(c) { %>
    <% var p = progress[c.id] || {}; %>
    <% var total = c.lessons ? c.lessons.length : 1; %>
    <% var done = (p.completedLessons && Array.isArray(p.completedLessons)) ? p.completedLessons.length : 0; %>
    <% var pct = Math.round((done / total) * 100); %>
    <div style="margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;font-size:12px;font-weight:600;margin-bottom:4px;">
        <span><%= c.title %></span>
        <span><%= done %>/<%= total %></span>
      </div>
      <div style="background:var(--bg);border-radius:10px;height:8px;overflow:hidden;">
        <div style="background:linear-gradient(90deg,var(--accent),var(--primary));border-radius:10px;height:100%;width:<%= pct %>%"></div>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <% if (isGuest) { %>
  <div style="background:linear-gradient(135deg,var(--accent-glow),transparent);border:1px solid var(--accent);border-radius:var(--radius-lg);padding:16px 20px;margin-bottom:16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
    <i class="fas fa-user-friends" style="color:var(--accent);font-size:22px;"></i>
    <div style="flex:1;">
      <div style="font-weight:700;font-size:15px;">وضع الزائر</div>
      <div style="font-size:12px;color:var(--text-light);">يمكنك مشاهدة الدروس التجريبية فقط. سجل الآن للوصول الكامل.</div>
    </div>
    <a href="/register" class="btn btn-primary" style="flex-shrink:0;">إنشاء حساب مجاني</a>
  </div>

  <!-- Guest visible courses/lessons -->
  <% var guestCourses = courses.filter(function(c) { return c.lessons.some(function(l) { return l.guestVisible; }); }); %>
  <% if (guestCourses.length > 0) { %>
  <div style="background:var(--card);border-radius:var(--radius-lg);padding:20px;box-shadow:var(--shadow);border:1px solid var(--border);margin-bottom:16px;">
    <h3 style="font-size:16px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
      <i class="fas fa-eye" style="color:var(--accent);"></i> المحتوى التجريبي (مشاهدة مجانية)
    </h3>
    <% guestCourses.forEach(function(c) { %>
      <% var guestLessons = c.lessons.filter(function(l) { return l.guestVisible; }); %>
      <% if (guestLessons.length > 0) { %>
      <div style="margin-bottom:12px;">
        <div style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:6px;display:flex;align-items:center;gap:8px;">
          <span style="width:6px;height:6px;background:var(--accent);border-radius:50%;display:inline-block;"></span>
          <%= c.title %>
          <span style="font-size:11px;color:var(--text-light);font-weight:400;">(<%= guestLessons.length %> دروس)</span>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-right:14px;">
          <% guestLessons.forEach(function(l) { %>
          <a href="/student/lesson/<%= c.id %>/<%= l.id %>" style="background:var(--bg);padding:6px 14px;border-radius:6px;font-size:12px;color:var(--text);transition:all 0.2s;display:flex;align-items:center;gap:6px;">
            <i class="fas fa-play-circle" style="color:var(--accent);font-size:12px;"></i>
            <%= l.title %>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>
    <% }) %>
    <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);text-align:center;">
      <a href="/register" class="btn btn-primary" style="font-size:13px;">سجل الآن للوصول إلى جميع المحاضرات</a>
    </div>
  </div>
  <% } %>
  <% } %>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
    <% if (isGuest) { %>
    <a href="/register" style="background:linear-gradient(135deg,var(--accent),#4338ca);color:#fff;border-radius:var(--radius-lg);padding:16px;text-align:center;">
      <i class="fas fa-user-plus" style="font-size:24px;"></i>
      <div style="font-size:13px;font-weight:700;margin-top:4px;">إنشاء حساب</div>
    </a>
    <a href="/register" style="background:linear-gradient(135deg,var(--success),#1b6b36);color:#fff;border-radius:var(--radius-lg);padding:16px;text-align:center;">
      <i class="fas fa-gem" style="font-size:24px;"></i>
      <div style="font-size:13px;font-weight:700;margin-top:4px;">اشترك وتمتع بالكامل</div>
    </a>
    <% } else { %>
    <a href="/student/chat" style="background:linear-gradient(135deg,#1a73e8,#0d47a1);color:#fff;border-radius:var(--radius-lg);padding:16px;text-align:center;">
      <i class="fas fa-comment-dots" style="font-size:24px;"></i>
      <div style="font-size:13px;font-weight:700;margin-top:4px;">اسأل عفيفي</div>
    </a>
    <a href="/student/subscription" style="background:linear-gradient(135deg,var(--success),#1b6b36);color:#fff;border-radius:var(--radius-lg);padding:16px;text-align:center;">
      <i class="fas fa-credit-card" style="font-size:24px;"></i>
      <div style="font-size:13px;font-weight:700;margin-top:4px;">الاشتراك</div>
    </a>
    <% } %>
  </div>

  <div style="background:var(--card);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow);border:1px solid var(--border);">
    <h3 style="font-size:18px;font-weight:700;color:var(--primary);margin-bottom:16px;display:flex;align-items:center;gap:10px;">
      <i class="fas fa-star" style="color:var(--accent);"></i> اقتراحات سريعة
    </h3>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;">
      <a href="/student/courses" style="display:flex;align-items:center;gap:12px;padding:14px 18px;background:var(--bg);border-radius:10px;transition:all 0.3s;font-size:14px;font-weight:600;color:var(--text);border-right:3px solid var(--accent);">
        <i class="fas fa-play-circle" style="color:var(--accent);font-size:20px;"></i>
        متابعة المحاضرات
      </a>
      <% if (!isGuest) { %>
      <a href="/student/question-bank" style="display:flex;align-items:center;gap:12px;padding:14px 18px;background:var(--bg);border-radius:10px;transition:all 0.3s;font-size:14px;font-weight:600;color:var(--text);">
        <i class="fas fa-question-circle" style="color:var(--purple);font-size:20px;"></i>
        حل الأسئلة
      </a>
      <a href="/student/notes" style="display:flex;align-items:center;gap:12px;padding:14px 18px;background:var(--bg);border-radius:10px;transition:all 0.3s;font-size:14px;font-weight:600;color:var(--text);">
        <i class="fas fa-file-pdf" style="color:var(--accent);font-size:20px;"></i>
        المذكرات
      </a>
      <a href="/student/reviews" style="display:flex;align-items:center;gap:12px;padding:14px 18px;background:var(--bg);border-radius:10px;transition:all 0.3s;font-size:14px;font-weight:600;color:var(--text);">
        <i class="fas fa-sync-alt" style="color:var(--accent);font-size:20px;"></i>
        المراجعات
      </a>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
