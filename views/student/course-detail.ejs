<%- include('../partials/header', { title: title, navPageTitle: course.title, bodyClass: 'student-body' }) %>
<%- include('../partials/student-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <div>
      <a href="/student/courses" style="color:var(--accent);font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px;transition:all 0.3s;">
        <i class="fas fa-chevron-right"></i> العودة إلى المحاضرات
      </a>
      <h1><%= course.title %></h1>
      <p><%= course.subtitle %></p>
    </div>
  </div>

  <% if (isGuest) { %>
  <div style="background:var(--accent-glow);border:1px solid var(--accent);border-radius:var(--radius);padding:16px 20px;margin-bottom:24px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
    <i class="fas fa-user-friends" style="color:var(--accent);font-size:20px;"></i>
    <div>
      <div style="font-weight:700;font-size:14px;">وضع الضيف</div>
      <div style="font-size:13px;color:var(--text-light);">يمكنك مشاهدة الدروس التجريبية التي يحددها المدرس فقط. سجل الآن للوصول الكامل.</div>
    </div>
    <a href="/register" class="btn btn-primary btn-sm" style="margin-right:auto;">إنشاء حساب مجاني</a>
  </div>
  <% } %>

  <% if (!isGuest && !isSubscribed) { %>
  <div style="background:var(--danger);color:#fff;border-radius:var(--radius);padding:14px 20px;margin-bottom:24px;display:flex;align-items:center;gap:12px;">
    <i class="fas fa-lock" style="font-size:18px;"></i>
    <div style="flex:1;">
      <div style="font-weight:700;font-size:14px;">اشتراك مطلوب</div>
      <div style="font-size:13px;opacity:0.9;">اشترك الآن للوصول إلى جميع المحاضرات والمذكرات</div>
    </div>
    <a href="/student/subscription" class="btn" style="background:#fff;color:var(--danger);font-weight:700;padding:8px 20px;border-radius:var(--radius-sm);">اشترك الآن</a>
  </div>
  <% } %>

  <% if (course.lessons.length > 0) { %>
      <%
        // Build tree branches: prefer sections > units > flat
        var treeBranches = [];
        var treeStyle = 'sections';
        if (course.sections && course.sections.length > 0) {
          course.sections.forEach(function(section) {
            var sectionLessons = (section.lessons || []).map(function(lid) { return course.lessons.find(function(l) { return l.id === lid; }); }).filter(function(l) { return l; });
            if (sectionLessons.length > 0) {
              treeBranches.push({ name: section.name, lessons: sectionLessons, type: 'section' });
            }
          });
        } else {
          treeStyle = 'units';
          var unitMap = {};
          var units = course.units || [];
          units.forEach(function(u) { unitMap[u.id] = u; });
          course.lessons.forEach(function(l) {
            var key = l.unitId || '_ungrouped';
            if (!unitMap[key]) unitMap[key] = { id: key, name: l.title.replace(/^باب:\s*/, '') || key };
            if (!unitMap[key]._lessons) unitMap[key]._lessons = [];
            unitMap[key]._lessons.push(l);
          });
          Object.keys(unitMap).forEach(function(key) {
            var u = unitMap[key];
            var ls = u._lessons || [];
            if (ls.length > 0) {
              treeBranches.push({ name: u.name, lessons: ls, type: 'unit' });
            } else if (u.name) {
              treeBranches.push({ name: u.name, lessons: [], type: 'unit' });
            }
          });
        }
        // If no branches built, fallback to flat
        if (treeBranches.length === 0) {
          treeStyle = 'flat';
          treeBranches.push({ name: 'المنهج', lessons: course.lessons, type: 'flat' });
        }
      %>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:12px;">
        <h2 style="font-size:20px;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:10px;">
          <i class="fas fa-sitemap" style="color:var(--accent);"></i> شجرة المنهج
        </h2>
        <span style="font-size:13px;color:var(--text-light);"><%= course.lessons.length %> درس</span>
      </div>

      <div class="tree-view">
        <% treeBranches.forEach(function(branch) { %>
          <% if (branch.lessons.length === 0) return; %>
          <div class="tree-section">
            <div class="tree-section-header" onclick="this.parentElement.classList.toggle('expanded')">
              <div class="tree-section-icon"><i class="fas fa-folder"></i></div>
              <div class="tree-section-info">
                <h4><%= branch.name %></h4>
                <span class="tree-section-count"><%= branch.lessons.length %> درس</span>
              </div>
              <i class="fas fa-chevron-left tree-arrow"></i>
            </div>
            <div class="tree-section-children">
              <% branch.lessons.forEach(function(lesson, idx) {
                var canAccess = isSubscribed || lesson.isFree || (isGuest && lesson.guestVisible);
                var progressData = (user && user.progress && user.progress[course.id]) || null;
                var isCompleted = progressData && progressData.completedLessons && progressData.completedLessons.includes(lesson.id);
              %>
              <a href="<%= canAccess ? '/student/lesson/' + course.id + '/' + lesson.id : '#' %>" class="tree-lesson-item <%= !canAccess ? 'locked' : '' %> <%= isCompleted ? 'completed' : '' %>" <%= !canAccess ? 'onclick="alert(\'هذا الدرس تجريبي للضيوف فقط. سجل للوصول الكامل.\');return false;"' : '' %>>
                <span class="tree-lesson-num"><%- isCompleted ? '<i class="fas fa-check-circle" style="color:var(--success);font-size:14px;"></i>' : (idx + 1) %></span>
                <span class="tree-lesson-title"><%= lesson.title %></span>
                <span class="tree-lesson-duration"><i class="fas fa-clock"></i> <%= lesson.duration %></span>
                <% if (lesson.isFree) { %><span class="tree-free-badge">مجاني</span><% } %>
                <% if (isGuest && lesson.guestVisible) { %><span class="tree-free-badge" style="background:rgba(99,102,241,0.1);color:var(--accent);">تجريبي</span><% } %>
                <% if (!canAccess) { %><i class="fas fa-lock" style="color:var(--text-muted);font-size:10px;margin-right:4px;"></i><% } %>
              </a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
      <style>
        .tree-view { display:flex; flex-direction:column; gap:8px; }
        .tree-section { background:var(--glass-bg); backdrop-filter:blur(var(--glass-blur)); border-radius:var(--radius); border:1px solid var(--glass-border); overflow:hidden; transition:var(--transition); }
        .tree-section.expanded { box-shadow:var(--shadow); }
        .tree-section-header { display:flex; align-items:center; gap:12px; padding:14px 18px; cursor:pointer; transition:var(--transition); }
        .tree-section-header:hover { background:var(--accent-glow); }
        .tree-section-icon { width:36px; height:36px; background:var(--bg); border-radius:10px; display:flex; align-items:center; justify-content:center; color:var(--accent); font-size:16px; flex-shrink:0; }
        .tree-section-info { flex:1; min-width:0; }
        .tree-section-info h4 { font-size:15px; font-weight:600; margin:0; }
        .tree-section-count { font-size:11px; color:var(--text-light); }
        .tree-arrow { transition:transform 0.3s ease; color:var(--text-muted); font-size:14px; }
        .tree-section.expanded .tree-arrow { transform:rotate(-180deg); }
        .tree-section-children { max-height:0; overflow:hidden; transition:max-height 0.4s ease; }
        .tree-section.expanded .tree-section-children { max-height:2000px; }
        .tree-lesson-item { display:flex; align-items:center; gap:10px; padding:8px 18px 8px 18px; border-top:1px solid var(--border); transition:all 0.2s; color:var(--text); font-size:13px; }
        .tree-lesson-item:hover { background:var(--accent-glow); padding-right:22px; }
        .tree-lesson-item.locked { opacity:0.6; cursor:not-allowed; }
        .tree-lesson-item.completed { background:rgba(5,150,105,0.04); }
        .tree-lesson-num { width:24px; height:24px; background:var(--bg); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:var(--primary); flex-shrink:0; }
        .tree-lesson-title { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .tree-lesson-duration { font-size:11px; color:var(--text-light); white-space:nowrap; }
        .tree-free-badge { background:rgba(5,150,105,0.1); color:var(--success); font-size:10px; padding:1px 6px; border-radius:3px; font-weight:600; }
      </style>
  <% } else { %>
    <div style="text-align:center;padding:60px 20px;background:var(--glass-bg);border-radius:var(--radius-xl);border:1px solid var(--border);">
      <i class="fas fa-book-open" style="font-size:48px;color:var(--border);display:block;margin-bottom:16px;"></i>
      <h3 style="font-size:20px;color:var(--text-light);margin-bottom:8px;">لا توجد دروس بعد</h3>
      <p style="color:var(--text-muted);">سيتم إضافة الدروس قريباً</p>
    </div>
  <% } %>

  <% if (course.quiz) { %>
  <div style="margin-top:28px;display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <a href="/student/exam/<%= course.id %>" class="btn btn-primary" style="border-radius:var(--radius-lg);padding:18px 16px;display:flex;align-items:center;gap:12px;width:100%;">
      <div style="width:38px;height:38px;background:rgba(255,255,255,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;color:inherit;">
        <i class="fas fa-pen"></i>
      </div>
      <div>
        <div style="font-size:14px;font-weight:700;">الاختبار الشامل</div>
        <div style="font-size:11px;opacity:0.8;"><%= course.quiz.questions.length %> أسئلة <% if (course.quiz.timerMinutes) { %>| <%= course.quiz.timerMinutes %> دقيقة<% } %></div>
      </div>
      <i class="fas fa-chevron-left" style="margin-right:auto;font-size:14px;opacity:0.6;"></i>
    </a>
    <a href="/student/question-bank" style="background:var(--card);color:var(--text);border-radius:var(--radius-lg);padding:18px 16px;display:flex;align-items:center;gap:12px;transition:all 0.3s;font-weight:700;border:2px solid var(--border);box-shadow:var(--shadow);">
      <div style="width:38px;height:38px;background:var(--bg);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">
        <i class="fas fa-question-circle" style="color:var(--accent);"></i>
      </div>
      <div>
        <div style="font-size:14px;font-weight:700;">بنك الأسئلة</div>
        <div style="font-size:11px;color:var(--text-light);">اختبارات تفاعلية</div>
      </div>
      <i class="fas fa-chevron-left" style="margin-right:auto;font-size:14px;color:var(--text-light);"></i>
    </a>
  </div>
  <% } %>
</main>
</body>
</html>
