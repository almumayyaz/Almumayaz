<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="admin-content">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-sitemap" style="color:var(--accent);"></i> إدارة المحتوى</h1>
      <p>إدارة المحتوى حسب المرحلة والصف الدراسي — كل التعديلات تظهر فورًا للطلاب</p>
    </div>
  </div>

  <!-- Stage Selection -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
    <% var allStages = ['إعدادية', 'ثانوية']; %>
    <% allStages.forEach(function(s) { %>
      <% var total = 0; Object.keys(stages[s] || {}).forEach(function(g) { total += (stages[s][g].courses.length + stages[s][g].reviews.length); }); %>
      <a href="/admin/content?stage=<%= encodeURIComponent(s) %><%= activeGrade ? '&grade=' + encodeURIComponent(activeGrade) : '' %>" class="stage-card <%= activeStage === s ? 'active' : '' %>">
        <i class="fas <%= s === 'إعدادية' ? 'fa-school' : 'fa-graduation-cap' %>" style="font-size:32px;color:<%= s === 'إعدادية' ? 'var(--success)' : '#F6C453' %>;display:block;margin-bottom:8px;"></i>
        <h3 style="font-size:18px;font-weight:700;margin:0 0 2px;font-family:'Aref Ruqaa',serif;">المرحلة <%= s %></h3>
        <span style="font-size:12px;color:var(--text-light);"><%= total %> عنصر</span>
      </a>
    <% }) %>
  </div>

  <% if (activeStage) { %>
    <div style="margin-bottom:20px;">
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <% var gradeList = activeStage === 'إعدادية' ? ['الأول الإعدادي', 'الثاني الإعدادي', 'الثالث الإعدادي'] : ['الأول الثانوي', 'الثاني الثانوي', 'الثالث الثانوي']; %>
        <% gradeList.forEach(function(g) { %>
          <% var d = stages[activeStage][g]; %>
          <% var t = d.courses.length + d.reviews.length; %>
          <a href="/admin/content?stage=<%= encodeURIComponent(activeStage) %>&grade=<%= encodeURIComponent(g) %>" class="grade-chip <%= activeGrade === g ? 'active' : '' %>"><%= g %> <span style="font-size:11px;opacity:0.7;">(<%= t %>)</span></a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (activeData) { %>
    <% var courses = activeData.courses; var reviews = activeData.reviews; %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:20px;">
      <div class="stat-mini"><i class="fas fa-book" style="color:var(--accent);"></i><span><%= courses.length %></span> فرع</div>
      <div class="stat-mini"><i class="fas fa-star" style="color:#F6C453;"></i><span><%= reviews.length %></span> مراجعة</div>
      <div class="stat-mini"><i class="fas fa-video" style="color:var(--purple);"></i><span><%= courses.reduce(function(s,c){return s + c.lessons.reduce(function(a,l){return a + (l.videos?l.videos.length:0);},0);},0) %></span> فيديو</div>
      <div class="stat-mini"><i class="fas fa-file-pdf" style="color:#ef4444;"></i><span><%= courses.reduce(function(s,c){return s + c.lessons.reduce(function(a,l){return a + (l.pdfFiles?l.pdfFiles.length:0);},0);},0) %></span> PDF</div>
      <div class="stat-mini"><i class="fas fa-question-circle" style="color:var(--success);"></i><span><%= courses.reduce(function(s,c){return s + (c.quiz&&c.quiz.questions?c.quiz.questions.length:0);},0) %></span> سؤال</div>
      <div class="stat-mini"><i class="fas fa-gift" style="color:#f97316;"></i><span><%= courses.reduce(function(s,c){return s + c.lessons.filter(function(l){return l.isFree;}).length;},0) %></span> مجاني</div>
    </div>

    <div class="resource-sections">
      <!-- Courses (المواد) -->
      <div class="resource-section expanded" id="rs-courses">
        <div class="rs-header" onclick="toggleRS('courses')">
          <i class="fas fa-book" style="color:var(--primary);"></i> المواد
          <span class="rs-count"><%= courses.length %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <div class="rs-search"><i class="fas fa-search"></i> <input type="text" oninput="filterRS('courses',this.value)" placeholder="بحث في المواد..."></div>
          <% if (courses.length > 0) { %>
            <% courses.forEach(function(c) { %>
              <div class="rs-item" data-id="course-<%= c.id %>">
                <span style="width:28px;height:28px;background:<%= c.color||'var(--accent)' %>;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;flex-shrink:0;"><i class="fas <%= c.icon||'fa-book' %>"></i></span>
                <span class="rs-name"><%= c.title %></span>
                <span class="rs-sub"><%= (c.lessons||[]).length %> درس</span>
                <span class="rs-actions">
                  <button class="rs-btn edit" onclick="openCourseModal('<%= c.id %>')"><i class="fas fa-edit"></i></button>
                  <button class="rs-btn delete" onclick="deleteCourse('<%= c.id %>')"><i class="fas fa-trash"></i></button>
                </span>
              </div>
            <% }) %>
          <% } %>
          <button class="rs-add" onclick="openCourseModal(null)"><i class="fas fa-plus"></i> إضافة مادة</button>
        </div>
      </div>

      <!-- Sections (ثانوية) -->
      <% if (activeStage === 'ثانوية') { %>
      <div class="resource-section expanded" id="rs-sections">
        <div class="rs-header" onclick="toggleRS('sections')">
          <i class="fas fa-folder-tree" style="color:var(--accent);"></i> الفروع
          <span class="rs-count"><%= courses.reduce(function(s,c){return s + (c.sections?c.sections.length:0);},0) %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <% courses.forEach(function(c) { %>
            <div class="rs-course-group">
              <strong><%= c.title %></strong>
              <% if (c.sections && c.sections.length > 0) { %>
                <% c.sections.forEach(function(sec, si) { %>
                  <div class="rs-item" data-id="sec-<%= sec.id %>">
                    <span class="rs-drag"><i class="fas fa-grip-vertical"></i></span>
                    <span class="rs-name"><%= sec.name %></span>
                    <span class="rs-sub"><%= (sec.lessons||[]).length %> درس</span>
                    <span class="rs-actions">
                      <button class="rs-btn edit" onclick="editSection('<%= c.id %>','<%= sec.id %>','<%= sec.name.replace(/'/g,"\\'") %>')"><i class="fas fa-edit"></i></button>
                      <button class="rs-btn delete" onclick="deleteSection('<%= c.id %>','<%= sec.id %>')"><i class="fas fa-trash"></i></button>
                    </span>
                  </div>
                <% }) %>
              <% } %>
              <button class="rs-add" onclick="addSection('<%= c.id %>')"><i class="fas fa-plus"></i> إضافة فرع</button>
            </div>
          <% }) %>
          <% if (courses.every(function(c){return !c.sections||c.sections.length===0;})) { %>
            <div class="empty-msg">لا توجد فروع. أضف فرعًا جديدًا من الزر أعلاه.</div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- Units (إعدادية) -->
      <% if (activeStage === 'إعدادية') { %>
      <div class="resource-section expanded" id="rs-units">
        <div class="rs-header" onclick="toggleRS('units')">
          <i class="fas fa-layer-group" style="color:var(--success);"></i> الوحدات
          <span class="rs-count"><%= courses.reduce(function(s,c){return s + (c.units?c.units.length:0);},0) %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <% courses.forEach(function(c) { %>
            <div class="rs-course-group">
              <strong><%= c.title %></strong>
              <% if (c.units && c.units.length > 0) { %>
                <% c.units.forEach(function(u) { %>
                  <div class="rs-item" data-id="unit-<%= u.id %>">
                    <span class="rs-drag"><i class="fas fa-grip-vertical"></i></span>
                    <span class="rs-name"><%= u.name %></span>
                    <span class="rs-actions">
                      <button class="rs-btn edit" onclick="editUnit('<%= c.id %>','<%= u.id %>','<%= u.name.replace(/'/g,"\\'") %>')"><i class="fas fa-edit"></i></button>
                      <button class="rs-btn delete" onclick="deleteUnit('<%= c.id %>','<%= u.id %>')"><i class="fas fa-trash"></i></button>
                    </span>
                  </div>
                <% }) %>
              <% } %>
              <button class="rs-add" onclick="addUnit('<%= c.id %>')"><i class="fas fa-plus"></i> إضافة وحدة</button>
            </div>
          <% }) %>
          <% if (courses.every(function(c){return !c.units||c.units.length===0;})) { %>
            <div class="empty-msg">لا توجد وحدات.</div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- Lessons -->
      <div class="resource-section expanded" id="rs-lessons">
        <div class="rs-header" onclick="toggleRS('lessons')">
          <i class="fas fa-video" style="color:var(--purple);"></i> الدروس
          <span class="rs-count"><%= courses.reduce(function(s,c){return s + (c.lessons?c.lessons.length:0);},0) %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <div class="rs-search"><i class="fas fa-search"></i> <input type="text" oninput="filterRS('lessons',this.value)" placeholder="بحث في الدروس..."></div>
          <% courses.forEach(function(c) { %>
            <% if (c.lessons && c.lessons.length > 0) { %>
              <div class="rs-course-group">
                <strong><%= c.title %> (<%= c.lessons.length %>)</strong>
                <% c.lessons.forEach(function(l) { %>
                  <div class="rs-item" data-id="lesson-<%= l.id %>">
                    <span class="rs-drag"><i class="fas fa-grip-vertical"></i></span>
                    <span class="rs-name"><%= l.title %></span>
                    <span class="rs-sub"><%= l.duration %> <% if(l.isFree){ %><span class="free-badge">مجاني</span><% } %></span>
                    <span class="rs-actions">
                      <button class="rs-btn toggle" onclick="toggleFree('<%= c.id %>','<%= l.id %>',<%= l.isFree ? 'false' : 'true' %>)" title="تبديل مجاني/مدفوع"><i class="fas <%= l.isFree ? 'fa-unlock' : 'fa-lock' %>"></i></button>
                      <button class="rs-btn edit" onclick="openLessonModal('<%= c.id %>','<%= l.id %>')"><i class="fas fa-edit"></i></button>
                      <button class="rs-btn delete" onclick="deleteLesson('<%= c.id %>','<%= l.id %>')"><i class="fas fa-trash"></i></button>
                    </span>
                  </div>
                <% }) %>
              </div>
            <% } %>
          <% }) %>
          <button class="rs-add" onclick="openLessonModal('','')"><i class="fas fa-plus"></i> إضافة درس</button>
        </div>
      </div>

      <!-- Videos -->
      <div class="resource-section expanded" id="rs-videos">
        <div class="rs-header" onclick="toggleRS('videos')">
          <i class="fas fa-play-circle" style="color:var(--accent);"></i> الفيديوهات
          <span class="rs-count"><%= courses.reduce(function(s,c){return s + c.lessons.reduce(function(a,l){return a + (l.videos?l.videos.length:0);},0);},0) %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <div class="rs-search"><i class="fas fa-search"></i> <input type="text" oninput="filterRS('videos',this.value)" placeholder="بحث في الفيديوهات..."></div>
          <% courses.forEach(function(c) { %>
            <% c.lessons.forEach(function(l) { %>
              <% if (l.videos && l.videos.length > 0) { %>
                <div class="rs-course-group">
                  <strong><%= c.title %> → <%= l.title %></strong>
                  <% l.videos.forEach(function(v, vi) { %>
                    <div class="rs-item" data-id="video-<%= c.id %>-<%= l.id %>-<%= vi %>">
                      <span class="rs-drag"><i class="fas fa-grip-vertical"></i></span>
                      <span class="rs-name"><%= v.title %></span>
                      <span class="rs-sub"><a href="<%= v.url %>" target="_blank" style="color:var(--accent);font-size:11px;"><i class="fas fa-external-link-alt"></i></a></span>
                      <span class="rs-actions">
                        <button class="rs-btn edit" onclick="editVideo('<%= c.id %>','<%= l.id %>',<%= vi %>,'<%= (v.title||'').replace(/'/g,"\\'") %>','<%= (v.url||'').replace(/'/g,"\\'") %>')"><i class="fas fa-edit"></i></button>
                        <button class="rs-btn delete" onclick="deleteVideo('<%= c.id %>','<%= l.id %>',<%= vi %>)"><i class="fas fa-trash"></i></button>
                      </span>
                    </div>
                  <% }) %>
                  <button class="rs-add" onclick="addVideo('<%= c.id %>','<%= l.id %>')"><i class="fas fa-plus"></i> إضافة فيديو</button>
                </div>
              <% } %>
            <% }) %>
          <% }) %>
          <% if (courses.every(function(c){return c.lessons.every(function(l){return !l.videos||l.videos.length===0;});})) { %>
            <div class="empty-msg">لا توجد فيديوهات.</div>
          <% } %>
        </div>
      </div>

      <!-- PDFs -->
      <div class="resource-section expanded" id="rs-pdfs">
        <div class="rs-header" onclick="toggleRS('pdfs')">
          <i class="fas fa-file-pdf" style="color:#ef4444;"></i> ملفات PDF
          <span class="rs-count"><%= courses.reduce(function(s,c){return s + c.lessons.reduce(function(a,l){return a + (l.pdfFiles?l.pdfFiles.length:0);},0);},0) %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <div class="rs-search"><i class="fas fa-search"></i> <input type="text" oninput="filterRS('pdfs',this.value)" placeholder="بحث في ملفات PDF..."></div>
          <% courses.forEach(function(c) { %>
            <% c.lessons.forEach(function(l) { %>
              <% if (l.pdfFiles && l.pdfFiles.length > 0) { %>
                <div class="rs-course-group">
                  <strong><%= c.title %> → <%= l.title %></strong>
                  <% l.pdfFiles.forEach(function(p, pi) { %>
                    <div class="rs-item" data-id="pdf-<%= c.id %>-<%= l.id %>-<%= pi %>">
                      <span class="rs-drag"><i class="fas fa-grip-vertical"></i></span>
                      <span class="rs-name"><%= p.title %></span>
                      <span class="rs-sub"><a href="<%= p.url %>" target="_blank" style="color:var(--accent);font-size:11px;"><i class="fas fa-external-link-alt"></i></a></span>
                      <span class="rs-actions">
                        <button class="rs-btn edit" onclick="editPdf('<%= c.id %>','<%= l.id %>',<%= pi %>,'<%= (p.title||'').replace(/'/g,"\\'") %>','<%= (p.url||'').replace(/'/g,"\\'") %>')"><i class="fas fa-edit"></i></button>
                        <button class="rs-btn delete" onclick="deletePdf('<%= c.id %>','<%= l.id %>',<%= pi %>)"><i class="fas fa-trash"></i></button>
                      </span>
                    </div>
                  <% }) %>
                  <button class="rs-add" onclick="addPdf('<%= c.id %>','<%= l.id %>')"><i class="fas fa-plus"></i> إضافة PDF</button>
                </div>
              <% } %>
            <% }) %>
          <% }) %>
          <% if (courses.every(function(c){return c.lessons.every(function(l){return !l.pdfFiles||l.pdfFiles.length===0;});})) { %>
            <div class="empty-msg">لا توجد ملفات PDF.</div>
          <% } %>
        </div>
      </div>

      <!-- Reviews -->
      <div class="resource-section expanded" id="rs-reviews">
        <div class="rs-header" onclick="toggleRS('reviews')">
          <i class="fas fa-star" style="color:#F6C453;"></i> المراجعات
          <span class="rs-count"><%= reviews.length %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <div class="rs-search"><i class="fas fa-search"></i> <input type="text" oninput="filterRS('reviews',this.value)" placeholder="بحث في المراجعات..."></div>
          <% if (reviews.length > 0) { %>
            <% reviews.forEach(function(r) { %>
              <div class="rs-item" data-id="review-<%= r.id %>">
                <span class="rs-drag"><i class="fas fa-grip-vertical"></i></span>
                <span class="rs-name"><%= r.title %></span>
                <span class="rs-sub"><%= r.course||'---' %> | <%= r.quiz?r.quiz.questions.length+' سؤال':'بدون اختبار' %></span>
                <span class="rs-actions">
                  <button class="rs-btn edit" onclick="openReviewModal('<%= r.id %>')"><i class="fas fa-edit"></i></button>
                  <button class="rs-btn delete" onclick="deleteReview('<%= r.id %>')"><i class="fas fa-trash"></i></button>
                  <button class="rs-btn move" onclick="moveResource('review','<%= r.id %>')"><i class="fas fa-arrows-alt-h"></i></button>
                </span>
              </div>
            <% }) %>
          <% } %>
          <button class="rs-add" onclick="openReviewModal('')"><i class="fas fa-plus"></i> إضافة مراجعة</button>
        </div>
      </div>

      <!-- Questions & Quizzes -->
      <div class="resource-section expanded" id="rs-quiz">
        <div class="rs-header" onclick="toggleRS('quiz')">
          <i class="fas fa-question-circle" style="color:var(--success);"></i> بنك الأسئلة والاختبارات
          <span class="rs-count"><%= courses.reduce(function(s,c){return s + (c.quiz&&c.quiz.questions?c.quiz.questions.length:0);},0) %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <% courses.forEach(function(c) { %>
            <div class="rs-course-group">
              <strong><%= c.title %></strong>
              <% if (c.quiz && c.quiz.questions && c.quiz.questions.length > 0) { %>
                <% c.quiz.questions.forEach(function(q, qi) { %>
                  <div class="rs-item" data-id="q-<%= c.id %>-<%= qi %>">
                    <span class="rs-drag"><i class="fas fa-grip-vertical"></i></span>
                    <span class="rs-name" style="font-size:12px;"><%= q.question.substring(0,100) %></span>
                    <span class="rs-sub">✅ <%= q.options[q.correct] %></span>
                    <span class="rs-actions">
                      <button class="rs-btn edit" onclick="editQuestion('<%= c.id %>',<%= qi %>)"><i class="fas fa-edit"></i></button>
                      <button class="rs-btn delete" onclick="deleteQuestion('<%= c.id %>',<%= qi %>)"><i class="fas fa-trash"></i></button>
                    </span>
                  </div>
                <% }) %>
              <% } %>
              <button class="rs-add" onclick="addQuestion('<%= c.id %>')"><i class="fas fa-plus"></i> إضافة سؤال</button>
            </div>
          <% }) %>
          <% if (courses.every(function(c){return !c.quiz||!c.quiz.questions||c.quiz.questions.length===0;})) { %>
            <div class="empty-msg">لا توجد أسئلة. أضف سؤالاً جديداً من الزر أعلاه.</div>
          <% } %>
        </div>
      </div>

      <!-- Free Lessons -->
      <div class="resource-section expanded" id="rs-free">
        <div class="rs-header" onclick="toggleRS('free')">
          <i class="fas fa-gift" style="color:#f97316;"></i> الدروس المجانية
          <span class="rs-count"><%= courses.reduce(function(s,c){return s + c.lessons.filter(function(l){return l.isFree;}).length;},0) %></span>
          <i class="fas fa-chevron-down rs-arrow"></i>
        </div>
        <div class="rs-body">
          <% courses.forEach(function(c) { %>
            <% var free = c.lessons.filter(function(l){return l.isFree;}); %>
            <% if (free.length > 0) { %>
              <div class="rs-course-group">
                <strong><%= c.title %> (<%= free.length %>)</strong>
                <% free.forEach(function(l) { %>
                  <div class="rs-item">
                    <span class="rs-name"><%= l.title %></span>
                    <span class="rs-sub"><%= l.duration %></span>
                    <span class="rs-actions">
                      <button class="rs-btn toggle" onclick="toggleFree('<%= c.id %>','<%= l.id %>',false)" title="إزالة المجانية"><i class="fas fa-times-circle"></i></button>
                    </span>
                  </div>
                <% }) %>
              </div>
            <% } %>
          <% }) %>
          <% if (courses.every(function(c){return c.lessons.every(function(l){return !l.isFree;});})) { %>
            <div class="empty-msg">لا توجد دروس مجانية. فعّل الدرس المجاني من قسم الدروس.</div>
          <% } %>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="resource-section expanded" style="margin-top:16px;">
      <div class="rs-header" style="cursor:default;">
        <i class="fas fa-book" style="color:var(--primary);"></i> جميع المواد (<%= (allCoursesFull||[]).length %>)
      </div>
      <div class="rs-body" style="max-height:6000px;">
        <div class="rs-search"><i class="fas fa-search"></i> <input type="text" oninput="filterAllCourses(this.value)" placeholder="بحث في جميع المواد..."></div>
        <div id="allCoursesContainer">
          <% (allCoursesFull||[]).forEach(function(c) { %>
            <div class="rs-item all-course-item" data-id="course-<%= c.id %>">
              <span style="width:28px;height:28px;background:<%= c.color||'var(--accent)' %>;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;flex-shrink:0;"><i class="fas <%= c.icon||'fa-book' %>"></i></span>
              <span class="rs-name"><%= c.title %></span>
              <span class="rs-sub"><%= c.stage||'' %> — <%= c.grade||'الكل' %> | <%= (c.lessons||[]).length %> درس</span>
              <span class="rs-actions">
                <button class="rs-btn edit" onclick="openCourseModal('<%= c.id %>')"><i class="fas fa-edit"></i></button>
                <button class="rs-btn delete" onclick="deleteCourse('<%= c.id %>')"><i class="fas fa-trash"></i></button>
              </span>
            </div>
          <% }) %>
          <% if (!allCoursesFull || allCoursesFull.length === 0) { %>
            <div class="empty-msg">لا توجد مواد بعد. أضف أول مادة.</div>
          <% } %>
        </div>
        <button class="rs-add" onclick="openCourseModal(null)"><i class="fas fa-plus"></i> إضافة مادة جديدة</button>
      </div>
    </div>
  <% } %>
</main>

<!-- Course Modal -->
<div class="modal-overlay" id="courseModal"><div class="modal"><div class="modal-header"><h3 id="courseModalTitle">إضافة/تعديل مادة</h3><button class="modal-close" onclick="closeModal('courseModal')">&times;</button></div><div class="modal-body">
<input type="hidden" id="cmId">
<div class="form-group"><label>اسم المادة</label><input id="cmTitle" placeholder="مثال: النحو"></div>
<div class="form-group"><label>العنوان الفرعي</label><input id="cmSubtitle" placeholder="مثال: قواعد اللغة العربية"></div>
<div class="form-group"><label>الوصف</label><textarea id="cmDesc" rows="2"></textarea></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
<div class="form-group"><label>المرحلة</label><select id="cmStage"><option value="إعدادية">إعدادية</option><option value="ثانوية">ثانوية</option></select></div>
<div class="form-group"><label>الصف</label><select id="cmGrade"><option value="">الكل</option><option value="الأول الإعدادي">الأول الإعدادي</option><option value="الثاني الإعدادي">الثاني الإعدادي</option><option value="الثالث الإعدادي">الثالث الإعدادي</option><option value="الأول الثانوي">الأول الثانوي</option><option value="الثاني الثانوي">الثاني الثانوي</option><option value="الثالث الثانوي">الثالث الثانوي</option></select></div>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
<div class="form-group"><label>أيقونة</label><input id="cmIcon" value="fa-book"></div>
<div class="form-group"><label>اللون</label><input type="color" id="cmColor" value="#A07200"></div>
</div>
<button class="btn btn-primary" onclick="saveCourse()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
</div></div></div>

<!-- Lesson Modal -->
<div class="modal-overlay" id="lessonModal"><div class="modal modal-lg"><div class="modal-header"><h3 id="lessonModalTitle">إضافة/تعديل درس</h3><button class="modal-close" onclick="closeModal('lessonModal')">&times;</button></div><div class="modal-body">
<input type="hidden" id="lmCourseId"><input type="hidden" id="lmLessonId">
<div class="form-group"><label>المادة</label><select id="lmCourseSelect" style="padding:8px;border:2px solid var(--border);border-radius:var(--radius);background:var(--card);color:var(--text);width:100%;"><option value="">اختر المادة</option><% (courses||[]).forEach(function(c){ %><option value="<%= c.id %>"><%= c.title %></option><% }); %></select></div>
<div class="form-group"><label>عنوان الدرس</label><input id="lmTitle" placeholder="عنوان الدرس"></div>
<div class="form-group"><label>المدة (دقائق:ثواني)</label><input id="lmDuration" placeholder="مثال: 30:00"></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
<div class="form-group"><label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" id="lmIsFree"> درس مجاني</label></div>
<div class="form-group"><label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" id="lmGuestVisible"> متاح للضيوف</label></div>
</div>
<div class="form-group"><label>رابط الفيديو (YouTube Embed)</label><input id="lmVideoUrl" placeholder="https://www.youtube.com/embed/..."></div>
<div class="form-group"><label>رابط PDF</label><input id="lmPdfUrl" placeholder="/files/..."></div>
<button class="btn btn-primary" onclick="saveLesson()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
</div></div></div>

<!-- Video/PDF Modal -->
<div class="modal-overlay" id="mediaModal"><div class="modal"><div class="modal-header"><h3 id="mediaModalTitle">إضافة/تعديل وسائط</h3><button class="modal-close" onclick="closeModal('mediaModal')">&times;</button></div><div class="modal-body">
<input type="hidden" id="mmType"><input type="hidden" id="mmCourseId"><input type="hidden" id="mmLessonId"><input type="hidden" id="mmIndex">
<div class="form-group"><label>العنوان</label><input id="mmTitle" placeholder="عنوان الملف"></div>
<div class="form-group"><label>الرابط</label><input id="mmUrl" placeholder="https://... أو /files/..."></div>
<button class="btn btn-primary" onclick="saveMedia()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
</div></div></div>

<!-- Question Modal -->
<div class="modal-overlay" id="questionModal"><div class="modal modal-lg"><div class="modal-header"><h3 id="questionModalTitle">إضافة/تعديل سؤال</h3><button class="modal-close" onclick="closeModal('questionModal')">&times;</button></div><div class="modal-body">
<input type="hidden" id="qmCourseId"><input type="hidden" id="qmIndex">
<div class="form-group"><label>السؤال</label><input id="qmText" placeholder="نص السؤال"></div>
<% ['أ','ب','ج','ד'].forEach(function(letter,oi){ %>
<div class="form-group"><label>الخيار <%= letter %></label><input id="qmOpt<%= oi %>" placeholder="الخيار <%= letter %>"></div>
<% }); %>
<div class="form-group"><label>الإجابة الصحيحة</label><select id="qmCorrect"><% for(var i=0;i<4;i++){ %><option value="<%= i %>">الخيار <%= ['أ','ب','ج','ד'][i] %></option><% } %></select></div>
<button class="btn btn-primary" onclick="saveQuestion()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
</div></div></div>

<!-- Review Modal -->
<div class="modal-overlay" id="reviewModal"><div class="modal"><div class="modal-header"><h3 id="reviewModalTitle">إضافة/تعديل مراجعة</h3><button class="modal-close" onclick="closeModal('reviewModal')">&times;</button></div><div class="modal-body">
<input type="hidden" id="rmId">
<div class="form-group"><label>عنوان المراجعة</label><input id="rmTitle" placeholder="مثال: مراجعة النحو"></div>
<div class="form-group"><label>المادة</label><input id="rmCourse" placeholder="نحو - بلاغة - أدب"></div>
<div class="form-group"><label>الوصف</label><textarea id="rmDesc" rows="2"></textarea></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
<div class="form-group"><label>المرحلة</label><select id="rmStage"><option value="all">الكل</option><option value="إعدادية">إعدادية</option><option value="ثانوية">ثانوية</option></select></div>
<div class="form-group"><label>الصف</label><select id="rmGrade"><option value="">الكل</option><option value="الأول الإعدادي">الأول الإعدادي</option><option value="الثاني الإعدادي">الثاني الإعدادي</option><option value="الثالث الإعدادي">الثالث الإعدادي</option><option value="الأول الثانوي">الأول الثانوي</option><option value="الثاني الثانوي">الثاني الثانوي</option><option value="الثالث الثانوي">الثالث الثانوي</option></select></div>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
<div class="form-group"><label>أيقونة</label><input id="rmIcon" value="fa-book-open"></div>
<div class="form-group"><label>اللون</label><input type="color" id="rmColor" value="#A07200"></div>
</div>
<button class="btn btn-primary" onclick="saveReview()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
</div></div></div>

<!-- Move Modal -->
<div class="modal-overlay" id="moveModal"><div class="modal" style="max-width:400px;"><div class="modal-header"><h3>نقل عنصر</h3><button class="modal-close" onclick="closeModal('moveModal')">&times;</button></div><div class="modal-body">
<p style="font-size:13px;color:var(--text-light);margin-bottom:12px;">اختر الصف الدراسي لنقل العنصر إليه:</p>
<input type="hidden" id="moveType"><input type="hidden" id="moveId">
<div class="form-group"><label>المرحلة</label><select id="moveStage" onchange="updateMoveGrades()"><option value="إعدادية">إعدادية</option><option value="ثانوية">ثانوية</option></select></div>
<div class="form-group"><label>الصف</label><select id="moveGrade"></select></div>
<button class="btn btn-primary" onclick="confirmMove()" style="width:100%;"><i class="fas fa-check"></i> تأكيد النقل</button>
</div></div></div>

<style>
.stage-card { display:block;text-decoration:none;padding:24px 16px;background:var(--glass-bg);backdrop-filter:blur(var(--glass-blur));border-radius:var(--radius-xl);border:2px solid var(--glass-border);text-align:center;color:var(--text);transition:all .3s; }
.stage-card:hover { transform:translateY(-3px);box-shadow:var(--shadow-lg); }
.stage-card.active { border-color:var(--accent);box-shadow:0 0 0 2px var(--accent); }
.grade-chip { display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:13px;font-weight:600;transition:all .2s; }
.grade-chip:hover { border-color:var(--accent); }
.grade-chip.active { background:var(--accent);color:#fff;border-color:var(--accent); }
.stat-mini { background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:12px;text-align:center;font-size:12px;font-weight:600; }
.stat-mini i { font-size:16px;display:block;margin-bottom:4px; }
.stat-mini span { font-size:15px; }
.resource-sections { display:flex;flex-direction:column;gap:6px; }
.resource-section { background:var(--glass-bg);backdrop-filter:blur(var(--glass-blur));border-radius:var(--radius-lg);border:1px solid var(--glass-border);overflow:hidden; }
.rs-header { display:flex;align-items:center;gap:10px;padding:12px 16px;cursor:pointer;transition:var(--transition);font-weight:700;font-size:14px;user-select:none; }
.rs-header:hover { background:var(--accent-glow); }
.rs-count { margin-right:auto;background:var(--bg);padding:2px 10px;border-radius:10px;font-size:11px;font-weight:600;color:var(--text-light); }
.rs-arrow { transition:transform .3s;color:var(--text-muted);font-size:12px; }
.resource-section.expanded .rs-arrow { transform:rotate(180deg); }
.rs-body { max-height:0;overflow:auto;transition:max-height .4s ease; }
.resource-section.expanded .rs-body { max-height:6000px; }
.rs-course-group { padding:10px 16px 6px;border-top:1px solid var(--border); }
.rs-course-group > strong { display:block;font-size:13px;color:var(--accent);margin-bottom:4px; }
.rs-item { display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:6px;transition:var(--transition);font-size:13px; }
.rs-item:hover { background:var(--bg); }
.rs-drag { color:var(--text-muted);font-size:12px;cursor:grab; }
.rs-name { flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.rs-sub { font-size:11px;color:var(--text-light);white-space:nowrap; }
.rs-sub .free-badge { background:rgba(5,150,105,0.1);color:var(--success);padding:1px 6px;border-radius:3px;font-weight:600;font-size:10px; }
.rs-actions { display:flex;gap:3px;flex-shrink:0; }
.rs-btn { background:none;border:none;width:26px;height:26px;border-radius:5px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:11px;transition:all .2s; }
.rs-btn.edit { color:var(--accent); } .rs-btn.edit:hover { background:var(--accent-glow); }
.rs-btn.delete { color:#ef4444; } .rs-btn.delete:hover { background:rgba(239,68,68,0.1); }
.rs-btn.move { color:var(--text-muted); } .rs-btn.move:hover { background:var(--bg); }
.rs-btn.toggle { color:#f97316; } .rs-btn.toggle:hover { background:rgba(249,115,22,0.1); }
.rs-add { display:block;width:100%;padding:8px;background:none;border:none;border-top:1px solid var(--border);color:var(--accent);font-size:12px;font-weight:600;cursor:pointer;transition:var(--transition);text-align:center; }
.rs-add:hover { background:var(--accent-glow); }
.rs-search { padding:8px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px; }
.rs-search input { flex:1;border:none;background:var(--bg);padding:6px 10px;border-radius:6px;color:var(--text);font-size:12px;outline:none; }
.rs-search i { color:var(--text-muted);font-size:12px; }
.empty-msg { text-align:center;padding:16px;color:var(--text-muted);font-size:13px; }
.empty-state { text-align:center;padding:60px 20px;color:var(--text-muted); }
.empty-state h3 { font-size:18px;color:var(--text-light);margin-bottom:4px; }
.empty-state p { font-size:14px; }
</style>

<script>
var allCourses = <%- JSON.stringify(allCoursesFull || courses || []).replace(/<\//g,'<\\/') %>;
var allReviews = <%- JSON.stringify(reviews || []).replace(/<\//g,'<\\/') %>;

function toggleRS(id) { var el = document.getElementById('rs-'+id); if(el) el.classList.toggle('expanded'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
document.querySelectorAll('.modal-overlay').forEach(function(m){
  m.addEventListener('click',function(e){if(e.target===this)this.classList.remove('show');});
});

// --- Courses ---
function openCourseModal(id) {
  var course = id ? allCourses.find(function(c){return c.id===id;}) : null;
  document.getElementById('courseModalTitle').textContent = course ? 'تعديل المادة' : 'إضافة مادة جديدة';
  document.getElementById('cmId').value = course ? course.id : '';
  if (course) {
    document.getElementById('cmTitle').value = course.title||'';
    document.getElementById('cmSubtitle').value = course.subtitle||'';
    document.getElementById('cmDesc').value = course.description||'';
    document.getElementById('cmIcon').value = course.icon||'fa-book';
    document.getElementById('cmColor').value = course.color||'#A07200';
    document.getElementById('cmStage').value = course.stage||'<%= activeStage||"ثانوية" %>';
    document.getElementById('cmGrade').value = course.grade||'';
  } else {
    document.getElementById('cmTitle').value = '';
    document.getElementById('cmSubtitle').value = '';
    document.getElementById('cmDesc').value = '';
    document.getElementById('cmIcon').value = 'fa-book';
    document.getElementById('cmColor').value = '#A07200';
    document.getElementById('cmStage').value = '<%= activeStage||"ثانوية" %>';
    document.getElementById('cmGrade').value = '<%= grade||"" %>';
  }
  document.getElementById('courseModal').classList.add('show');
}
function saveCourse() {
  var id = document.getElementById('cmId').value;
  var data = {
    title: document.getElementById('cmTitle').value,
    subtitle: document.getElementById('cmSubtitle').value,
    description: document.getElementById('cmDesc').value,
    icon: document.getElementById('cmIcon').value,
    color: document.getElementById('cmColor').value,
    stage: document.getElementById('cmStage').value,
    grade: document.getElementById('cmGrade').value
  };
  if (!data.title) { alert('أدخل اسم المادة'); return; }
  var url = id ? '/api/admin/courses/'+id : '/api/admin/courses';
  var method = id ? 'PUT' : 'POST';
  fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function deleteCourse(id) {
  if(!confirm('حذف هذه المادة مع كل محتواها؟')) return;
  fetch('/api/admin/courses/'+id,{method:'DELETE'})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// Filter all courses on landing page
function filterAllCourses(q) {
  document.querySelectorAll('.all-course-item').forEach(function(el){
    var name = (el.querySelector('.rs-name')||{}).textContent||'';
    el.style.display = name.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
  });
}

// Filter/Search
function filterRS(section, q) {
  var c = document.getElementById('rs-'+section); if(!c) return;
  c.querySelectorAll('.rs-item').forEach(function(el){
    var name = (el.querySelector('.rs-name')||{}).textContent||'';
    el.style.display = name.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
  });
}

// --- Sections ---
function addSection(cid) {
  var n = prompt('اسم الفرع الجديد:'); if(!n) return;
  fetch('/api/admin/courses/'+cid+'/sections',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:n})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function editSection(cid,sid,n) {
  var nn = prompt('تعديل اسم الفرع:',n); if(!nn||nn===n) return;
  fetch('/api/admin/courses/'+cid+'/sections/'+sid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:nn})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function deleteSection(cid,sid) {
  if(!confirm('حذف هذا الفرع؟')) return;
  fetch('/api/admin/courses/'+cid+'/sections/'+sid,{method:'DELETE'})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// --- Units ---
function addUnit(cid) {
  var n = prompt('اسم الوحدة الجديدة:'); if(!n) return;
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c) return;
  var units = c.units||[]; units.push({id:'unit-'+Date.now(),name:n});
  fetch('/api/admin/courses/'+cid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({units:units})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function editUnit(cid,uid,n) {
  var nn = prompt('تعديل اسم الوحدة:',n); if(!nn||nn===n) return;
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c) return;
  var units = c.units||[]; var u = units.find(function(x){return x.id===uid;}); if(u) u.name=nn;
  fetch('/api/admin/courses/'+cid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({units:units})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function deleteUnit(cid,uid) {
  if(!confirm('حذف هذه الوحدة؟')) return;
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c) return;
  var units = (c.units||[]).filter(function(x){return x.id!==uid;});
  fetch('/api/admin/courses/'+cid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({units:units})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// --- Lessons ---
function openLessonModal(cid,lid) {
  document.getElementById('lessonModalTitle').textContent = lid ? 'تعديل الدرس' : 'إضافة درس جديد';
  document.getElementById('lmCourseId').value = lid ? cid : '';
  document.getElementById('lmLessonId').value = lid||'';
  document.getElementById('lmCourseSelect').value = cid||'';
  if(lid) {
    var c = allCourses.find(function(x){return x.id===cid;});
    var l = c ? c.lessons.find(function(x){return x.id===lid;}) : null;
    if(l) {
      document.getElementById('lmTitle').value = l.title||'';
      document.getElementById('lmDuration').value = l.duration||'';
      document.getElementById('lmIsFree').checked = !!l.isFree;
      document.getElementById('lmGuestVisible').checked = !!l.guestVisible;
      document.getElementById('lmVideoUrl').value = (l.videos&&l.videos[0])?l.videos[0].url:'';
      document.getElementById('lmPdfUrl').value = (l.pdfFiles&&l.pdfFiles[0])?l.pdfFiles[0].url:'';
      return;
    }
  }
  ['lmTitle','lmDuration','lmVideoUrl','lmPdfUrl'].forEach(function(id){document.getElementById(id).value='';});
  document.getElementById('lmIsFree').checked=false; document.getElementById('lmGuestVisible').checked=false;
  document.getElementById('lessonModal').classList.add('show');
}
function saveLesson() {
  var cid = document.getElementById('lmCourseId').value || document.getElementById('lmCourseSelect').value;
  var lid = document.getElementById('lmLessonId').value;
  if(!cid) { alert('اختر المادة أولاً'); return; }
  var data = {
    title: document.getElementById('lmTitle').value,
    duration: document.getElementById('lmDuration').value,
    isFree: document.getElementById('lmIsFree').checked,
    guestVisible: document.getElementById('lmGuestVisible').checked,
    videos: document.getElementById('lmVideoUrl').value ? [{title:document.getElementById('lmTitle').value,url:document.getElementById('lmVideoUrl').value}] : [],
    pdfFiles: document.getElementById('lmPdfUrl').value ? [{title:'ملف '+document.getElementById('lmTitle').value,url:document.getElementById('lmPdfUrl').value}] : []
  };
  var url = lid ? '/api/admin/courses/'+cid+'/lessons/'+lid : '/api/admin/courses/'+cid+'/lessons';
  var method = lid ? 'PUT' : 'POST';
  fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function deleteLesson(cid,lid) {
  if(!confirm('حذف هذا الدرس؟')) return;
  fetch('/api/admin/courses/'+cid+'/lessons/'+lid,{method:'DELETE'})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function toggleFree(cid,lid,val) {
  fetch('/api/admin/courses/'+cid+'/lessons/'+lid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({isFree:val})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// --- Videos ---
function addVideo(cid,lid) {
  document.getElementById('mediaModalTitle').textContent = 'إضافة فيديو';
  document.getElementById('mmType').value = 'video';
  document.getElementById('mmCourseId').value = cid;
  document.getElementById('mmLessonId').value = lid;
  document.getElementById('mmIndex').value = '-1';
  document.getElementById('mmTitle').value = '';
  document.getElementById('mmUrl').value = '';
  document.getElementById('mediaModal').classList.add('show');
}
function editVideo(cid,lid,idx,title,url) {
  document.getElementById('mediaModalTitle').textContent = 'تعديل الفيديو';
  document.getElementById('mmType').value = 'video';
  document.getElementById('mmCourseId').value = cid;
  document.getElementById('mmLessonId').value = lid;
  document.getElementById('mmIndex').value = idx;
  document.getElementById('mmTitle').value = title;
  document.getElementById('mmUrl').value = url;
  document.getElementById('mediaModal').classList.add('show');
}
function deleteVideo(cid,lid,idx) {
  if(!confirm('حذف هذا الفيديو؟')) return;
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c) return;
  var l = c.lessons.find(function(x){return x.id===lid;}); if(!l) return;
  var v = l.videos||[]; v.splice(idx,1);
  fetch('/api/admin/courses/'+cid+'/lessons/'+lid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({videos:v})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function saveMedia() {
  var type = document.getElementById('mmType').value;
  var cid = document.getElementById('mmCourseId').value;
  var lid = document.getElementById('mmLessonId').value;
  var idx = parseInt(document.getElementById('mmIndex').value);
  var title = document.getElementById('mmTitle').value;
  var url = document.getElementById('mmUrl').value;
  if(!title||!url) { alert('املأ جميع الحقول'); return; }
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c) return;
  var l = c.lessons.find(function(x){return x.id===lid;}); if(!l) return;
  var arr = type==='video' ? (l.videos||[]) : (l.pdfFiles||[]);
  if(idx>=0) { arr[idx] = {title:title,url:url}; }
  else { arr.push({title:title,url:url}); }
  var body = {}; body[type==='video'?'videos':'pdfFiles'] = arr;
  fetch('/api/admin/courses/'+cid+'/lessons/'+lid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// --- PDFs ---
function addPdf(cid,lid) {
  document.getElementById('mediaModalTitle').textContent = 'إضافة ملف PDF';
  document.getElementById('mmType').value = 'pdf';
  document.getElementById('mmCourseId').value = cid;
  document.getElementById('mmLessonId').value = lid;
  document.getElementById('mmIndex').value = '-1';
  document.getElementById('mmTitle').value = '';
  document.getElementById('mmUrl').value = '';
  document.getElementById('mediaModal').classList.add('show');
}
function editPdf(cid,lid,idx,title,url) {
  document.getElementById('mediaModalTitle').textContent = 'تعديل ملف PDF';
  document.getElementById('mmType').value = 'pdf';
  document.getElementById('mmCourseId').value = cid;
  document.getElementById('mmLessonId').value = lid;
  document.getElementById('mmIndex').value = idx;
  document.getElementById('mmTitle').value = title;
  document.getElementById('mmUrl').value = url;
  document.getElementById('mediaModal').classList.add('show');
}
function deletePdf(cid,lid,idx) {
  if(!confirm('حذف هذا الملف؟')) return;
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c) return;
  var l = c.lessons.find(function(x){return x.id===lid;}); if(!l) return;
  var p = l.pdfFiles||[]; p.splice(idx,1);
  fetch('/api/admin/courses/'+cid+'/lessons/'+lid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({pdfFiles:p})})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// --- Questions ---
function addQuestion(cid) {
  document.getElementById('questionModalTitle').textContent = 'إضافة سؤال';
  document.getElementById('qmCourseId').value = cid;
  document.getElementById('qmIndex').value = '-1';
  document.getElementById('qmText').value = '';
  for(var i=0;i<4;i++) document.getElementById('qmOpt'+i).value='';
  document.getElementById('qmCorrect').value = '0';
  document.getElementById('questionModal').classList.add('show');
}
function editQuestion(cid,qi) {
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c||!c.quiz||!c.quiz.questions) return;
  var q = c.quiz.questions[qi]; if(!q) return;
  document.getElementById('questionModalTitle').textContent = 'تعديل سؤال';
  document.getElementById('qmCourseId').value = cid;
  document.getElementById('qmIndex').value = qi;
  document.getElementById('qmText').value = q.question||'';
  for(var i=0;i<4;i++) document.getElementById('qmOpt'+i).value = (q.options&&q.options[i])||'';
  document.getElementById('qmCorrect').value = q.correct||0;
  document.getElementById('questionModal').classList.add('show');
}
function saveQuestion() {
  var cid = document.getElementById('qmCourseId').value;
  var idx = parseInt(document.getElementById('qmIndex').value);
  var qtext = document.getElementById('qmText').value;
  var opts = [0,1,2,3].map(function(i){return document.getElementById('qmOpt'+i).value;});
  var correct = parseInt(document.getElementById('qmCorrect').value);
  if(!qtext||opts.every(function(o){return !o;})) { alert('املأ السؤال والخيارات'); return; }
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c) return;
  var quiz = c.quiz || {id:'q-'+Date.now(),title:'اختبار '+c.title,questions:[]};
  var q = {question:qtext,options:opts,correct:correct};
  if(idx>=0) quiz.questions[idx]=q; else quiz.questions.push(q);
  fetch('/api/admin/courses/'+cid+'/quiz',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(quiz)})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function deleteQuestion(cid,qi) {
  if(!confirm('حذف هذا السؤال؟')) return;
  var c = allCourses.find(function(x){return x.id===cid;}); if(!c||!c.quiz||!c.quiz.questions) return;
  c.quiz.questions.splice(qi,1);
  fetch('/api/admin/courses/'+cid+'/quiz',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(c.quiz)})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// --- Reviews ---
function openReviewModal(id) {
  document.getElementById('reviewModalTitle').textContent = id?'تعديل المراجعة':'مراجعة جديدة';
  document.getElementById('rmId').value = id||'';
  if(id) {
    var r = allReviews.find(function(x){return x.id===id;});
    if(r) {
      document.getElementById('rmTitle').value=r.title||'';
      document.getElementById('rmCourse').value=r.course||'';
      document.getElementById('rmDesc').value=r.desc||'';
      document.getElementById('rmIcon').value=r.icon||'fa-book-open';
      document.getElementById('rmColor').value=r.color||'#A07200';
      document.getElementById('rmStage').value=r.stage||'all';
      document.getElementById('rmGrade').value=r.grade||'';
      document.getElementById('reviewModal').classList.add('show'); return;
    }
  }
  document.getElementById('rmTitle').value=''; document.getElementById('rmCourse').value='';
  document.getElementById('rmDesc').value=''; document.getElementById('rmIcon').value='fa-book-open';
  document.getElementById('rmColor').value='#A07200';
  document.getElementById('rmStage').value='<%= activeStage||"all" %>';
  document.getElementById('rmGrade').value='<%= grade||"" %>';
  document.getElementById('reviewModal').classList.add('show');
}
function saveReview() {
  var id = document.getElementById('rmId').value;
  var data = {
    title: document.getElementById('rmTitle').value,
    course: document.getElementById('rmCourse').value,
    desc: document.getElementById('rmDesc').value,
    icon: document.getElementById('rmIcon').value,
    color: document.getElementById('rmColor').value,
    stage: document.getElementById('rmStage').value,
    grade: document.getElementById('rmGrade').value
  };
  fetch((id?'/api/admin/reviews/':'/api/admin/reviews')+id,{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
    .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}
function deleteReview(id) {
  if(!confirm('حذف هذه المراجعة؟')) return;
  fetch('/api/admin/reviews/'+id,{method:'DELETE'}).then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
}

// --- Move ---
function moveResource(type,id) {
  document.getElementById('moveType').value=type; document.getElementById('moveId').value=id;
  updateMoveGrades(); document.getElementById('moveModal').classList.add('show');
}
function updateMoveGrades() {
  var s = document.getElementById('moveStage').value;
  var opts = s==='إعدادية'?['الأول الإعدادي','الثاني الإعدادي','الثالث الإعدادي']:['الأول الثانوي','الثاني الثانوي','الثالث الثانوي'];
  document.getElementById('moveGrade').innerHTML = opts.map(function(g){return '<option value="'+g+'">'+g+'</option>';}).join('');
}
function confirmMove() {
  var type = document.getElementById('moveType').value;
  var id = document.getElementById('moveId').value;
  var stage = document.getElementById('moveStage').value;
  var grade = document.getElementById('moveGrade').value;
  if(!confirm('تأكيد النقل إلى '+stage+' - '+grade+'؟')) return;
  if(type==='review') {
    fetch('/api/admin/reviews/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({stage:stage,grade:grade})})
      .then(function(r){return r.json()}).then(function(d){if(d.success)location.reload();else alert(d.error);});
  }
}
</script>
</body>
</html>