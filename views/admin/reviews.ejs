<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<script src="/js/pdf-upload.js"></script>
<main class="admin-content">
  <div class="page-header">
    <div>
      <h1>المراجعات</h1>
      <p>إدارة المراجعات والفيديوهات التعليمية والاختبارات</p>
    </div>
    <button class="btn btn-primary" onclick="openReviewModal()"><i class="fas fa-plus"></i> مراجعة جديدة</button>
  </div>
  <div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
    <select id="filterStage" onchange="applyFilter()" style="padding:8px 14px;border:2px solid var(--border);border-radius:var(--radius);background:var(--card);color:var(--text);font-size:13px;">
      <option value="">كل المراحل</option>
      <option value="إعدادية" <%= stage === 'إعدادية' ? 'selected' : '' %>>إعدادية</option>
      <option value="ثانوية" <%= stage === 'ثانوية' ? 'selected' : '' %>>ثانوية</option>
    </select>
    <select id="filterGrade" onchange="applyFilter()" style="padding:8px 14px;border:2px solid var(--border);border-radius:var(--radius);background:var(--card);color:var(--text);font-size:13px;">
      <option value="">كل الصفوف</option>
      <option value="الأول الإعدادي" <%= grade === 'الأول الإعدادي' ? 'selected' : '' %>>الأول الإعدادي</option>
      <option value="الثاني الإعدادي" <%= grade === 'الثاني الإعدادي' ? 'selected' : '' %>>الثاني الإعدادي</option>
      <option value="الثالث الإعدادي" <%= grade === 'الثالث الإعدادي' ? 'selected' : '' %>>الثالث الإعدادي</option>
      <option value="الأول الثانوي" <%= grade === 'الأول الثانوي' ? 'selected' : '' %>>الأول الثانوي</option>
      <option value="الثاني الثانوي" <%= grade === 'الثاني الثانوي' ? 'selected' : '' %>>الثاني الثانوي</option>
      <option value="الثالث الثانوي" <%= grade === 'الثالث الثانوي' ? 'selected' : '' %>>الثالث الثانوي</option>
    </select>
  </div>
  <div class="admin-table">
    <table>
      <thead>
        <tr><th>#</th><th>العنوان</th><th>المادة</th><th>المرحلة</th><th>الصف</th><th>المادة (ID)</th><th>التاريخ</th><th>اختبار</th><th>الإجراءات</th></tr>
      </thead>
      <tbody>
        <% if (reviews.length > 0) { %>
          <% reviews.forEach(function(r, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><strong><%= r.title %></strong></td>
              <td><%= r.course || '---' %></td>
              <td><%= r.stage || 'الكل' %></td>
              <td><%= r.grade || 'الكل' %></td>
              <td><%= r.courseId || '---' %></td>
              <td><%= r.date %></td>
            <td><% if (r.quiz && r.quiz.questions && r.quiz.questions.length) { %><span class="status-badge active"><%= r.quiz.questions.length %> سؤال</span><% } else { %><span class="status-badge pending">لا يوجد</span><% } %></td>
            <td>
              <div class="admin-actions">
                <button class="edit" onclick='openReviewModal(<%= JSON.stringify(r) %>)'><i class="fas fa-edit"></i></button>
                <button class="view" onclick='openReviewQuizModal(<%= JSON.stringify(r) %>)'><i class="fas fa-tasks"></i></button>
                <button class="delete" onclick="deleteReview('<%= r.id %>')"><i class="fas fa-trash"></i></button>
              </div>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="9" style="text-align:center;color:var(--text-light);">لا توجد مراجعات</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>

<!-- Review Modal -->
<div class="modal-overlay" id="reviewModal">
  <div class="modal">
    <div class="modal-header">
      <h3 id="reviewModalTitle">مراجعة جديدة</h3>
      <button class="modal-close" onclick="closeRM()">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="reviewId">
      <div class="form-group"><label>عنوان المراجعة</label><input id="reviewTitle" placeholder="مثال: مراجعة النحو الشاملة"></div>
      <div class="form-group"><label>المادة</label><input id="reviewCourse" placeholder="نحو - بلاغة - أدب - نصوص"></div>
      <div class="form-group"><label>معرف المادة (courseId)</label><input id="reviewCourseId" placeholder="معرف المادة لربط المراجعة"></div>
      <div class="form-group"><label>الوصف</label><textarea id="reviewDesc" rows="2" placeholder="وصف المراجعة"></textarea></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="form-group"><label>أيقونة</label><input id="reviewIcon" value="fa-book-open"></div>
        <div class="form-group"><label>اللون</label><input type="color" id="reviewColor" value="#A07200"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="form-group"><label>المرحلة</label><select id="reviewStage"><option value="all">الكل</option><option value="إعدادية">إعدادية</option><option value="ثانوية">ثانوية</option></select></div>
        <div class="form-group"><label>الصف</label><select id="reviewGrade"><option value="">الكل</option><option value="الأول الإعدادي">الأول الإعدادي</option><option value="الثاني الإعدادي">الثاني الإعدادي</option><option value="الثالث الإعدادي">الثالث الإعدادي</option><option value="الأول الثانوي">الأول الثانوي</option><option value="الثاني الثانوي">الثاني الثانوي</option><option value="الثالث الثانوي">الثالث الثانوي</option></select></div>
      </div>
      <div id="reviewVideosSection" style="margin-top:12px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <label style="font-size:13px;font-weight:600;color:var(--text-light);">الفيديوهات</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addReviewVideoField()"><i class="fas fa-plus"></i> إضافة فيديو</button>
        </div>
        <div id="reviewVideosContainer"></div>
      </div>
      <div id="reviewPdfsSection" style="margin-top:12px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <label style="font-size:13px;font-weight:600;color:var(--text-light);">ملفات PDF</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addReviewPdfField()"><i class="fas fa-plus"></i> إضافة PDF</button>
        </div>
        <div id="reviewPdfsContainer"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px;">
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:8px;">
            <input type="checkbox" id="reviewIsFree"> مجاني
          </label>
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveReview()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
    </div>
  </div>
</div>

<!-- Review Quiz Modal -->
<div class="modal-overlay" id="reviewQuizModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3 id="reviewQuizModalTitle">اختبار المراجعة</h3>
      <button class="modal-close" onclick="closeRQM()">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="rqReviewId">
      <div class="form-group"><label>عنوان الاختبار</label><input id="rqTitle" placeholder="مثال: اختبار مراجعة النحو"></div>
      <div id="rqQuestionsContainer">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
          <label>الأسئلة</label>
          <div style="display:flex;gap:8px;">
            <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addRqQuestion()"><i class="fas fa-plus"></i> إضافة سؤال</button>
            <button class="btn btn-sm" style="background:var(--primary);color:#fff;" onclick="toggleRqWordUpload()"><i class="fas fa-file-word"></i> رفع ملف وورد</button>
          </div>
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveReviewQuiz()" style="width:100%;margin-top:16px;"><i class="fas fa-save"></i> حفظ الاختبار</button>
    </div>
  </div>
</div>

<!-- Word Upload Popup (Review Quiz) -->
<div class="modal-overlay" id="rqWordUploadModal" style="z-index:3000;">
  <div class="modal" style="max-width:500px;">
    <div class="modal-header">
      <h3>رفع ملف Word لاختبار المراجعة</h3>
      <button class="modal-close" onclick="closeModal('rqWordUploadModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>اختيار ملف Word يحتوي على الأسئلة</label>
        <input id="rqWordFilePopup" type="file" accept=".docx,.doc" style="padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;width:100%;">
      </div>
      <button class="btn btn-sm" style="background:var(--success);color:#fff;width:100%;" onclick="extractRqQuestionsFromPopup()"><i class="fas fa-magic"></i> استخراج</button>
    </div>
  </div>
</div>

<script>
function escAttr(s) { return String(s).replace(/"/g,'&quot;').replace(/&/g,'&amp;'); }
function normalizeYouTube(src) {
  if (!src) return src;
  var m;
  if ((m = String(src).match(/youtube\.com\/embed\/([A-Za-z0-9_\-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  if ((m = String(src).match(/youtu\.be\/([A-Za-z0-9_\-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  if ((m = String(src).match(/youtube\.com\/watch\?(?:[^&]*&)*v=([A-Za-z0-9_\-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  if ((m = String(src).match(/youtube\.com\/shorts\/([A-Za-z0-9_\-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  return src;
}
function extractSrcFromIframe(v) { var m = String(v).match(/src=["']([^"']+)["']/); return normalizeYouTube(m ? m[1] : v); }
function openReviewModal(r) {
  document.getElementById('reviewModalTitle').textContent = r ? 'تعديل المراجعة' : 'مراجعة جديدة';
  document.getElementById('reviewId').value = r ? r.id : '';
  document.getElementById('reviewTitle').value = r ? r.title : '';
  document.getElementById('reviewCourse').value = r ? (r.course || '') : '';
  document.getElementById('reviewCourseId').value = r ? (r.courseId || '') : '';
  document.getElementById('reviewDesc').value = r ? (r.desc || '') : '';
  document.getElementById('reviewIcon').value = r ? (r.icon || 'fa-book-open') : 'fa-book-open';
  document.getElementById('reviewColor').value = r ? (r.color || '#A07200') : '#A07200';
  document.getElementById('reviewStage').value = r ? (r.stage || 'all') : 'all';
  document.getElementById('reviewGrade').value = r ? (r.grade || '') : '';
  document.getElementById('reviewIsFree').checked = r ? !!r.isFree : false;
  var vc = document.getElementById('reviewVideosContainer');
  vc.innerHTML = '';
  var videos = (r && r.videos) || [];
  videos.forEach(function(v){ addReviewVideoField(v.title, v.url); });
  var pc = document.getElementById('reviewPdfsContainer');
  pc.innerHTML = '';
  var pdfs = (r && r.pdfFiles) || [];
  pdfs.forEach(function(p){ addReviewPdfField(p); });
  document.getElementById('reviewModal').classList.add('show');
}
function closeRM() { document.getElementById('reviewModal').classList.remove('show'); }
function addReviewVideoField(title, url) {
  var container = document.getElementById('reviewVideosContainer');
  var div = document.createElement('div');
  div.style.cssText = 'display:flex;gap:8px;margin-bottom:8px;align-items:flex-end;';
  div.innerHTML = '<div class="form-group" style="flex:1;margin-bottom:0;"><label style="font-size:11px;">عنوان الفيديو</label><input class="rv-video-title" placeholder="مثال: شرح المراجعة" value="' + escAttr(title||'') + '"></div><div class="form-group" style="flex:2;margin-bottom:0;"><label style="font-size:11px;">رابط YouTube Embed</label><input class="rv-video-url" placeholder="https://www.youtube.com/embed/..." value="' + escAttr(url||'') + '"></div><button class="btn btn-sm" style="background:#ef4444;color:#fff;height:36px;width:36px;padding:0;display:flex;align-items:center;justify-content:center;flex-shrink:0;" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>';
  container.appendChild(div);
}
function addReviewPdfField(entry) {
  entry = entry || {};
  var container = document.getElementById('reviewPdfsContainer');
  var div = document.createElement('div');
  div.style.cssText = 'display:flex;gap:8px;margin-bottom:8px;align-items:center;flex-wrap:wrap;';
  div.innerHTML =
    '<div class="form-group" style="flex:1;min-width:140px;margin-bottom:0;"><label style="font-size:11px;">عنوان الملف</label><input class="rv-pdf-title" placeholder="مثال: مذكرة المراجعة" value="' + escAttr(entry.title||'') + '"></div>' +
    '<div class="form-group" style="flex:2;min-width:200px;margin-bottom:0;"><label style="font-size:11px;">ملف PDF (يُرفع للتخزين الآمن)</label><input type="file" class="rv-pdf-file" accept="application/pdf" style="padding:6px;"></div>' +
    '<input type="hidden" class="rv-pdf-path" value="' + escAttr(entry.path||'') + '">' +
    '<input type="hidden" class="rv-pdf-url" value="' + escAttr(entry.url||'') + '">' +
    (entry.path ? ' <span style="font-size:11px;color:var(--accent);"><i class="fas fa-check"></i> ملف مرفوع</span>' : '') +
    '<button class="btn btn-sm" style="background:#ef4444;color:#fff;height:36px;width:36px;padding:0;display:flex;align-items:center;justify-content:center;flex-shrink:0;" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>';
  container.appendChild(div);
}
function saveReview() {
  const id = document.getElementById('reviewId').value;
  var videoInputs = document.querySelectorAll('#reviewVideosContainer > div');
  var videos = [];
  videoInputs.forEach(function(v) {
    var t = v.querySelector('.rv-video-title').value;
    var u = extractSrcFromIframe(v.querySelector('.rv-video-url').value);
    if (u) videos.push({ title: t || 'فيديو', url: u });
  });
  var pdfInputs = document.querySelectorAll('#reviewPdfsContainer > div');
  var pdfFiles = [];
  var uploadFails = [];
  var filePromises = [];
  pdfInputs.forEach(function(p) {
    var t = p.querySelector('.rv-pdf-title').value;
    var file = p.querySelector('.rv-pdf-file').files[0];
    var exPath = p.querySelector('.rv-pdf-path').value;
    var exUrl = p.querySelector('.rv-pdf-url').value;
    if (file) {
      filePromises.push(
        uploadPdfFile(file, 'reviews')
          .then(function(path){ if (path) pdfFiles.push({ title: t || 'ملف', path: path }); else uploadFails.push(t || 'ملف'); })
          .catch(function(){ uploadFails.push(t || 'ملف'); })
      );
    } else if (exPath) {
      pdfFiles.push({ title: t || 'ملف', path: exPath });
    } else if (exUrl) {
      pdfFiles.push({ title: t || 'ملف', url: exUrl });
    }
  });
  // Always save the review (videos + whatever PDFs succeeded). Never let a
  // PDF upload failure silently discard the teacher's video/title changes.
  Promise.all(filePromises).then(function() {
    const data = {
      title: document.getElementById('reviewTitle').value,
      course: document.getElementById('reviewCourse').value,
      courseId: document.getElementById('reviewCourseId').value,
      desc: document.getElementById('reviewDesc').value,
      icon: document.getElementById('reviewIcon').value,
      color: document.getElementById('reviewColor').value,
      videos: videos,
      pdfFiles: pdfFiles,
      stage: document.getElementById('reviewStage').value,
      grade: document.getElementById('reviewGrade').value,
      isFree: document.getElementById('reviewIsFree').checked,
      order: 0
    };
    const url = id ? '/api/admin/reviews/' + id : '/api/admin/reviews';
    const method = id ? 'PUT' : 'POST';
    if (window.uploadStepSave) window.uploadStepSave();
    fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
      .then(r => r.json()).then(function(d) {
        if (d.success) {
          if (window.uploadDone) window.uploadDone();
          var msg = 'تم حفظ بيانات المراجعة بنجاح.';
          if (uploadFails.length) msg += ' (تعذر رفع بعض ملفات PDF: ' + uploadFails.join('، ') + ')';
          alert(msg);
          location.reload();
        } else {
          if (window.uploadError) window.uploadError(d.error);
          alert(d.error || 'تعذر الحفظ');
        }
      })
      .catch(function(e) { if (window.uploadError) window.uploadError((e && e.message) ? e.message : e); alert('تعذر الاتصال بالخادم'); });
  });
}
function deleteReview(id) {
  if (!confirm('هل أنت متأكد من حذف هذه المراجعة؟')) return;
  fetch('/api/admin/reviews/' + id, { method: 'DELETE' })
    .then(r => r.json()).then(d => { if (d.success) location.reload(); else alert(d.error); });
}
document.getElementById('reviewModal').addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });
function applyFilter() {
  var s = document.getElementById('filterStage').value;
  var g = document.getElementById('filterGrade').value;
  var params = [];
  if (s) params.push('stage=' + encodeURIComponent(s));
  if (g) params.push('grade=' + encodeURIComponent(g));
  window.location.href = '/admin/reviews' + (params.length ? '?' + params.join('&') : '');
}

function closeModal(id) { var m = document.getElementById(id); if (m) m.classList.remove('show'); }
function openReviewQuizModal(r) {
  document.getElementById('reviewQuizModalTitle').textContent = 'اختبار - ' + r.title;
  document.getElementById('rqReviewId').value = r.id;
  document.getElementById('rqTitle').value = r.quiz ? r.quiz.title : 'اختبار المراجعة';
  const container = document.getElementById('rqQuestionsContainer');
  const existing = container.querySelectorAll('.question-block');
  existing.forEach(el => el.remove());
  if (r.quiz && r.quiz.questions && r.quiz.questions.length) {
    r.quiz.questions.forEach((q, i) => addRqQuestion(q, i));
  }
  document.getElementById('rqWordFilePopup').value = '';
  document.getElementById('reviewQuizModal').classList.add('show');
}
function closeRQM() { document.getElementById('reviewQuizModal').classList.remove('show'); }
function addRqQuestion(q, idx) {
  const container = document.getElementById('rqQuestionsContainer');
  const div = document.createElement('div');
  div.className = 'question-block';
  div.style.cssText = 'background:var(--bg);border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid var(--border);';
  const qi = idx !== undefined ? idx : container.querySelectorAll('.question-block').length;
  div.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><strong style="color:var(--primary);">السؤال ' + (qi + 1) + '</strong><button class="btn btn-sm" style="background:#ef4444;color:#fff;font-size:11px;padding:4px 10px;" onclick="this.closest(\'.question-block\').remove()">حذف</button></div><div class="form-group"><input class="rq-q-text" placeholder="نص السؤال" value="' + escAttr(q ? q.question : '') + '"></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">' + ['أ','ب','ج','د'].map((letter, oi) => '<div class="form-group" style="margin-bottom:4px;"><label style="font-size:11px;margin-bottom:2px;">الخيار ' + letter + '</label><input class="rq-q-opt-' + oi + '" placeholder="الخيار ' + letter + '" value="' + escAttr(q && q.options && q.options[oi] ? q.options[oi] : '') + '"></div>').join('') + '</div><div class="form-group" style="margin-bottom:0;"><label style="font-size:12px;">الإجابة الصحيحة</label><select class="rq-q-correct" style="width:80px;padding:6px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;">' + ['أ','ب','ج','د'].map((letter, oi) => '<option value="' + oi + '"' + ((q ? q.correct + '' : '0') === '' + oi ? ' selected' : '') + '>' + letter + '</option>').join('') + '</select></div><div class="form-group" style="margin-bottom:0;margin-top:8px;"><label style="font-size:12px;">الرسالة عند الإجابة الخاطئة (اختياري)</label><textarea class="rq-q-wrong-msg" placeholder="رسالة تظهر للطالب عند اختيار إجابة خاطئة" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:12px;resize:vertical;" rows="2">' + escAttr(q && q.wrongAnswerMessage ? q.wrongAnswerMessage : '') + '</textarea></div>';
  container.appendChild(div);
}
function toggleRqWordUpload() {
  document.getElementById('rqWordFilePopup').value = '';
  document.getElementById('rqWordUploadModal').classList.add('show');
}
function extractRqQuestionsFromPopup() {
  var btn = document.querySelector('#rqWordUploadModal .modal-body button');
  var fileInput = document.getElementById('rqWordFilePopup');
  if (!fileInput.files || !fileInput.files[0]) { alert('يرجى اختيار ملف Word أولاً'); return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الاستخراج...';
  var formData = new FormData();
  formData.append('file', fileInput.files[0]);
  fetch('/api/admin/upload-word-file', {
    method: 'POST',
    body: formData
  }).then(function(r){ return r.json(); }).then(function(d){
    if (d.success && d.questions && d.questions.length) {
      d.questions.forEach(function(q){ addRqQuestion(q); });
      closeModal('rqWordUploadModal');
      fileInput.value = '';
      alert('تم استخراج ' + d.questions.length + ' سؤال');
    } else {
      alert(d.error || 'فشل استخراج الأسئلة');
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-magic"></i> استخراج';
    }
  }).catch(function(){
    alert('فشل الاتصال بالخادم');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-magic"></i> استخراج';
  });
}
function saveReviewQuiz() {  const reviewId = document.getElementById('rqReviewId').value;
  const title = document.getElementById('rqTitle').value;
  const blocks = document.querySelectorAll('#rqQuestionsContainer .question-block');
  const questions = [];
  blocks.forEach(b => {
    const qtext = b.querySelector('.rq-q-text').value;
    const opts = [0,1,2,3].map(i => b.querySelector('.rq-q-opt-' + i).value);
    const correct = parseInt(b.querySelector('.rq-q-correct').value) || 0;
    const wm = b.querySelector('.rq-q-wrong-msg').value;
    if (qtext && opts.some(o => o)) questions.push({ question: qtext, options: opts, correct: correct, wrongAnswerMessage: wm });
  });
  fetch('/api/admin/reviews/' + reviewId + '/quiz', {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ title, questions })
  }).then(r => r.json()).then(d => { if (d.success) location.reload(); else alert(d.error); });
}
document.getElementById('reviewQuizModal').addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });
</script>
<%- include("../partials/footer") %>
</body>
</html>