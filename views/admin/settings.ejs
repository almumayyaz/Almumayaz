.form-card.compact:nth-child(7) { animation-delay:.28s; }
.form-card.compact .fc-head { display:flex; align-items:center; justify-content:space-between; width:100%; background:none; border:none; cursor:pointer; padding:2px 0; font-size:14px; font-weight:700; color:var(--text); font-family:inherit; }
.form-card.compact .fc-head > span { display:flex; align-items:center; gap:8px; }
.form-card.compact .fc-head > span > i { color:var(--accent); font-size:15px; }
.fc-chev { color:var(--text-muted); font-size:12px; transition:transform .25s ease; }
.form-card.compact:not(.collapsed) .fc-chev { transform:rotate(180deg); }
.form-card.compact .fc-body { overflow:hidden; max-height:560px; opacity:1; transform:translateY(0); transition:max-height .34s ease, opacity .28s ease, transform .28s ease, padding-top .34s ease; }
.form-card.compact.collapsed .fc-body { max-height:0; opacity:0; transform:translateY(-6px); padding-top:0; }
.fc-body { padding-top:10px; }
.fc-desc { font-size:12px; color:var(--text-light); margin:0 0 10px; line-height:1.5; }
.fc-check { display:flex; align-items:center; gap:6px; font-size:13px; font-weight:600; cursor:pointer; margin:0 0 10px; }
.fc-check input { width:15px; height:15px; accent-color:var(--accent); }
.form-card.compact .form-group { margin-bottom:10px; }
.form-card.compact .form-group label { display:block; font-size:12px; font-weight:600; margin-bottom:4px; color:var(--text); }
.form-card.compact .form-input { padding:8px 10px; font-size:13px; }
.form-card.compact .btn { font-size:13px; padding:8px 16px; }
.fc-msg { display:none; margin-top:8px; padding:8px 10px; border-radius:6px; font-size:12px; font-weight:600; text-align:center; }
.btn-warning { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; text-decoration:none; background:#f59e0b; color:#fff; }
.btn-warning:hover { background:#d97706; }
.btn-sm { padding:8px 16px; font-size:13px; }
</style>
