<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="admin-content">
  <div class="page-header">
    <div>
      <h1>لوحة التحكم</h1>
      <p>مرحباً بك في لوحة إدارة منصة المُميز</p>
    </div>
  </div>

  <!-- بطاقات التنقل السريع -->
  <div style="margin-bottom:40px;">
    <h2 style="font-size:20px;font-weight:700;color:var(--primary);margin-bottom:20px;display:flex;align-items:center;gap:8px;">
      <i class="fas fa-th-large" style="color:var(--accent);"></i> التنقل السريع
    </h2>

    <% var pendingPayments = payments ? payments.filter(function(p) { return p.status === 'pending'; }).length : 0; %>
    <% var notifBadge = (typeof unreadCount !== 'undefined' && unreadCount > 0) ? ((unreadCount > 99 ? '99+' : unreadCount) + ' جديد') : ''; %>

    <div class="dash-cards-grid">
      <% [
        { href: '/admin/analytics', icon: 'fa-chart-bar', color: '#8B5CF6', title: 'تحليلات', desc: 'إحصائيات المنصة ونشاط الطلاب والمحاضرات' },
        { href: '/admin/student-progress', icon: 'fa-user-graduate', color: '#06B6D4', title: 'تقدم الطلاب', desc: 'بحث وتتبع تقدم كل طالب في المواد' },
        { href: '/admin/students', icon: 'fa-users', color: '#10B981', title: 'الطلاب', desc: 'إدارة الطلاب المسجلين وبياناتهم' },
        { href: '/admin/courses', icon: 'fa-book', color: '#F59E0B', title: 'المحاضرات', desc: 'إضافة وتعديل المحاضرات والاختبارات', badge: courses.reduce(function(a, c) { return a + (c.lessons||[]).length; }, 0) + ' درس' },
        { href: '/admin/notes', icon: 'fa-sticky-note', color: '#EC4899', title: 'المذكرات', desc: 'رفع وإدارة المذكرات والملفات التعليمية' },
        { href: '/admin/sub-requests', icon: 'fa-file-invoice', color: '#F97316', title: 'طلبات الاشتراك', desc: 'متابعة طلبات انضمام الطلاب الجدد' },
        { href: '/admin/charge-codes', icon: 'fa-barcode', color: '#6366F1', title: 'أكواد الشحن', desc: 'إنشاء وإدارة أكواد الشحن والتسجيل' },
        { href: '/admin/subscriptions', icon: 'fa-credit-card', color: '#14B8A6', title: 'الاشتراكات', desc: 'إدارة باقات الاشتراك والأسعار' },
        { href: '/admin/payments', icon: 'fa-money-bill', color: '#CA8A04', title: 'المدفوعات', desc: 'متابعة المدفوعات وطلبات الدفع المعلقة', badge: pendingPayments ? pendingPayments + ' معلقة' : '' },
        { href: '/admin/announcements', icon: 'fa-bullhorn', color: '#DC2626', title: 'الإعلانات', desc: 'إرسال وإدارة الإعلانات والتحديثات' },
        { href: '/admin/quotes', icon: 'fa-quote-right', color: '#D946EF', title: 'جمل تحفيزية', desc: 'إضافة جمل تحفيزية للطلاب' },
        { href: '/admin/send-notification', icon: 'fa-bell', color: '#0EA5E9', title: 'إرسال إشعار', desc: 'إرسال إشعارات فورية أو مجدولة للطلاب' },
        { href: '/admin/notifications', icon: 'fa-inbox', color: '#8B5CF6', title: 'مركز الإشعارات', desc: 'سجل الإشعارات المرسلة', badge: notifBadge },
        { href: '/admin/reviews', icon: 'fa-star', color: '#F59E0B', title: 'المراجعات', desc: 'إدارة اختبارات المراجعة والدروس' },
        { href: '/admin/live-sessions', icon: 'fa-video', color: '#EF4444', title: 'الحصص المباشرة', desc: 'جدولة وإدارة الحصص المباشرة عبر Zoom' },
        { href: '/admin/settings', icon: 'fa-cog', color: '#6B7280', title: 'الإعدادات', desc: 'إعدادات المنصة والمظهر والبيانات' },
        { href: '/admin/chat', icon: 'fa-comments', color: '#10B981', title: 'تواصل مع الطلاب', desc: 'الدردشة المباشرة مع الطلاب' },

      ].forEach(function(card) { %>
      <a href="<%= card.href %>" class="dash-card">
        <div class="dash-card-icon" style="background:color-mix(in srgb, <%= card.color %> 15%, transparent);color:<%= card.color %>;">
          <i class="fas <%= card.icon %>"></i>
        </div>
        <div class="dash-card-body">
          <div class="dash-card-title">
            <%= card.title %>
            <% if (card.badge) { %><span class="dash-card-badge"><%= card.badge %></span><% } %>
          </div>
          <div class="dash-card-desc"><%= card.desc %></div>
        </div>
        <div class="dash-card-arrow"><i class="fas fa-chevron-left"></i></div>
      </a>
      <% }) %>
    </div>
  </div>

  <style>
    .dash-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 14px;
    }
    .dash-card {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 18px;
      text-decoration: none;
      transition: all 0.25s ease;
      position: relative;
    }
    .dash-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }
    .dash-card-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }
    .dash-card-body { flex: 1; min-width: 0; }
    .dash-card-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 3px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .dash-card-badge {
      display: inline-block;
      padding: 1px 8px;
      border-radius: 10px;
      background: var(--accent-glow);
      color: var(--accent);
      font-size: 10px;
      font-weight: 700;
    }
    .dash-card-desc {
      font-size: 12px;
      color: var(--text-light);
      line-height: 1.5;
    }
    .dash-card-arrow {
      font-size: 12px;
      color: var(--text-muted);
      opacity: 0;
      transition: opacity 0.2s, transform 0.2s;
      flex-shrink: 0;
    }
    .dash-card:hover .dash-card-arrow {
      opacity: 1;
      transform: translateX(-3px);
    }
  </style>

</main>
<%- include("../partials/footer") %>
</body>
</html>