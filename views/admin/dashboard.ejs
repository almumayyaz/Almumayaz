<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="admin-content">
  <div class="page-header">
    <div>
      <h1>لوحة التحكم</h1>
      <p>مرحباً بك في لوحة إدارة منصة المُميز</p>
    </div>
  </div>

  <div class="admin-stats">
    <div class="admin-stat-card">
      <h3>الطلاب المسجلين</h3>
      <div class="value"><%= students.length %></div>
      <div style="font-size:12px;color:var(--text-light);margin-top:4px;">
        <a href="/admin/students" style="color:var(--accent);"><i class="fas fa-arrow-left"></i> إدارة الطلاب</a>
      </div>
    </div>
    <div class="admin-stat-card">
      <h3>المحاضرات</h3>
      <div class="value"><%= courses.reduce(function(a, c) { return a + (c.lessons||[]).length; }, 0) %></div>
      <div style="font-size:12px;color:var(--text-light);margin-top:4px;">
        <a href="/admin/courses" style="color:var(--accent);"><i class="fas fa-arrow-left"></i> إدارة المحاضرات</a>
      </div>
    </div>
    <div class="admin-stat-card">
      <h3>بنك الأسئلة</h3>
      <div class="value"><%= courses.reduce(function(a, c) { return a + (c.quiz ? (c.quiz.questions||[]).length : 0); }, 0) %></div>
      <div style="font-size:12px;color:var(--text-light);margin-top:4px;"><%= courses.filter(function(c) { return c.quiz; }).length %> مواد لديها اختبارات</div>
    </div>
    <div class="admin-stat-card">
      <h3>طلبات الدفع</h3>
      <div class="value" style="color:#ca8a04;"><%= payments ? payments.filter(function(p) { return p.status === 'pending'; }).length : 0 %></div>
      <div style="font-size:12px;color:var(--text-light);margin-top:4px;">
        <a href="/admin/payments" style="color:var(--accent);"><i class="fas fa-arrow-left"></i> إدارة المدفوعات</a>
      </div>
    </div>
  </div>

  <div class="admin-dashboard-grid">
    <div class="admin-table" style="padding:24px;">
      <h3 style="font-size:18px;font-weight:700;color:var(--primary);margin-bottom:16px;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <span><i class="fas fa-users" style="color:var(--accent);"></i> آخر الطلاب المسجلين</span>
        <a href="/admin/students" style="font-size:12px;color:var(--accent);">إدارة <i class="fas fa-arrow-left"></i></a>
      </h3>
      <% if (students.length > 0) { %>
      <table>
        <thead>
          <tr><th>الاسم</th><th>البريد الإلكتروني</th><th>الصف</th><th>الاشتراك</th></tr>
        </thead>
        <tbody>
          <% students.slice(-5).reverse().forEach(function(s) { %>
          <tr>
            <td><strong><%= s.name %></strong></td>
            <td dir="ltr"><%= s.email || '---' %></td>
            <td><%= s.grade || '---' %></td>
            <td>
              <% if (s.subscriptionStatus === 'active') { %>
                <span class="status-badge active">نشط</span>
              <% } else { %>
                <span class="status-badge pending">غير مشترك</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <div style="text-align:center;padding:30px;color:var(--text-light);">
        <i class="fas fa-user-plus" style="font-size:32px;display:block;margin-bottom:8px;color:var(--border);"></i>
        لا يوجد طلاب مسجلين بعد
      </div>
      <% } %>
    </div>
    <div class="admin-table" style="padding:24px;">
      <h3 style="font-size:18px;font-weight:700;color:var(--primary);margin-bottom:16px;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <span><i class="fas fa-bullhorn" style="color:var(--accent);"></i> الإعلانات</span>
        <a href="/admin/announcements" style="font-size:12px;color:var(--accent);">إدارة <i class="fas fa-arrow-left"></i></a>
      </h3>
      <% if (announcements.length > 0) { %>
        <% announcements.slice(0, 4).forEach(function(a) { %>
        <div class="announcement-item">
          <h4><%= a.title %><% if (a.important) { %><span class="badge" style="margin-right:8px;">مهم</span><% } %></h4>
          <p><%= a.content.substring(0, 80) %><%= a.content.length > 80 ? '...' : '' %></p>
          <div class="date"><%= a.date %></div>
        </div>
        <% }) %>
      <% } else { %>
      <div style="text-align:center;padding:30px;color:var(--text-light);">
        <i class="fas fa-bullhorn" style="font-size:32px;display:block;margin-bottom:8px;color:var(--border);"></i>
        لا توجد إعلانات
      </div>
      <% } %>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:24px;">
    <div class="admin-table" style="padding:24px;">
      <h3 style="font-size:18px;font-weight:700;color:var(--primary);margin-bottom:16px;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <span><i class="fas fa-book" style="color:var(--accent);"></i> المواد الدراسية</span>
        <a href="/admin/courses" style="font-size:12px;color:var(--accent);">إدارة <i class="fas fa-arrow-left"></i></a>
      </h3>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;">
        <% (courses||[]).forEach(function(c) { %>
        <div style="background:var(--bg);border-radius:10px;padding:16px;text-align:center;border:1px solid var(--border);">
          <div style="font-size:24px;color:<%= c.color %>;margin-bottom:6px;"><i class="fas <%= c.icon %>"></i></div>
          <div style="font-size:13px;font-weight:700;color:var(--primary);"><%= c.title %></div>
          <div style="font-size:11px;color:var(--text-light);"><%= (c.lessons||[]).length %> محاضرة</div>
        </div>
        <% }) %>
      </div>
    </div>
    <div class="admin-table" style="padding:24px;">
      <h3 style="font-size:18px;font-weight:700;color:var(--primary);margin-bottom:16px;display:flex;align-items:center;gap:8px;justify-content:space-between;">
        <span><i class="fas fa-credit-card" style="color:var(--accent);"></i> الاشتراكات</span>
        <a href="/admin/subscriptions" style="font-size:12px;color:var(--accent);">إدارة <i class="fas fa-arrow-left"></i></a>
      </h3>
      <% if (subscriptions && subscriptions.length > 0) { %>
        <% subscriptions.forEach(function(s) { %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);">
          <span style="font-weight:600;"><%= s.name %></span>
          <span style="font-size:13px;color:var(--text-light);"><%= s.price %> <%= s.currency %> / <%= s.period %></span>
        </div>
        <% }) %>
      <% } else { %>
      <div style="text-align:center;padding:20px;color:var(--text-light);font-size:13px;">لا توجد اشتراكات</div>
      <% } %>
    </div>
  </div>
</main>
</body>
</html>
