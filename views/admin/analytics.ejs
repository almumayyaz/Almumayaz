<%- include('../partials/header', { title: title, navPageTitle: 'المُميز', bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="main-content">
  <div class="page-header"><h1><i class="fas fa-chart-bar"></i> تحليلات المنصة</h1></div>

  <div id="overviewCards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:20px;"></div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
    <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px;border:1px solid var(--border);">
      <h3 style="font-size:14px;margin-bottom:12px;"><i class="fas fa-trophy" style="color:var(--accent);"></i> الأكثر نشاطاً</h3>
      <div id="mostActiveTable"><div style="text-align:center;padding:20px;color:var(--text-muted);">جاري التحميل...</div></div>
    </div>
    <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px;border:1px solid var(--border);">
      <h3 style="font-size:14px;margin-bottom:12px;"><i class="fas fa-exclamation-triangle" style="color:#dc2626;"></i> الأقل نشاطاً</h3>
      <div id="leastActiveTable"><div style="text-align:center;padding:20px;color:var(--text-muted);">جاري التحميل...</div></div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
    <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px;border:1px solid var(--border);">
      <h3 style="font-size:14px;margin-bottom:12px;"><i class="fas fa-book" style="color:var(--accent);"></i> تحليل المحاضرات</h3>
      <div id="lessonsTable"><div style="text-align:center;padding:20px;color:var(--text-muted);">جاري التحميل...</div></div>
    </div>
    <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px;border:1px solid var(--border);">
      <h3 style="font-size:14px;margin-bottom:12px;"><i class="fas fa-question-circle" style="color:var(--accent);"></i> تحليل الاختبارات</h3>
      <div id="quizzesTable"><div style="text-align:center;padding:20px;color:var(--text-muted);">جاري التحميل...</div></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px;">
        <div style="background:var(--bg);border-radius:8px;padding:10px;text-align:center;" id="hardestExam"><div style="color:var(--text-muted);font-size:12px;">جاري التحميل...</div></div>
        <div style="background:var(--bg);border-radius:8px;padding:10px;text-align:center;" id="easiestExam"><div style="color:var(--text-muted);font-size:12px;">جاري التحميل...</div></div>
        <div style="background:var(--bg);border-radius:8px;padding:10px;text-align:center;" id="mostSolvedExam"><div style="color:var(--text-muted);font-size:12px;">جاري التحميل...</div></div>
        <div style="background:var(--bg);border-radius:8px;padding:10px;text-align:center;" id="leastSolvedExam"><div style="color:var(--text-muted);font-size:12px;">جاري التحميل...</div></div>
      </div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
    <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px;border:1px solid var(--border);">
      <h3 style="font-size:14px;margin-bottom:12px;"><i class="fas fa-fire" style="color:#dc2626;"></i> أكثر المحاضرات نشاطاً</h3>
      <div id="mostActiveLesson"><div style="text-align:center;padding:20px;color:var(--text-muted);">جاري التحميل...</div></div>
    </div>
    <div style="background:var(--card);border-radius:var(--radius-lg);padding:16px;border:1px solid var(--border);">
      <h3 style="font-size:14px;margin-bottom:12px;"><i class="fas fa-chart-line" style="color:#7c3aed;"></i> أقل المحاضرات نشاطاً</h3>
      <div id="leastActiveLesson"><div style="text-align:center;padding:20px;color:var(--text-muted);">جاري التحميل...</div></div>
    </div>
  </div>
</main>

<script>
(async function() {
  // Load overview from v2 engine
  var resp = await fetch('/api/admin/analytics/v2/overview');
  var v2 = await resp.json();
  if (!resp.ok || v2.error) { document.getElementById('overviewCards').innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:#dc2626;">خطأ: ' + (v2.error || 'فشل تحميل البيانات') + '</div>'; return; }
  var ov = v2;
  var cards = [
    { label: 'إجمالي الطلاب', value: ov.totalStudents, icon: 'fa-users', color: '#3b82f6' },
    { label: 'نشط اليوم', value: ov.activeToday, icon: 'fa-clock', color: '#059669' },
    { label: 'نشط هذا الأسبوع', value: ov.activeThisWeek, icon: 'fa-calendar-week', color: '#7c3aed' },
    { label: 'نشط هذا الشهر', value: ov.activeThisMonth, icon: 'fa-calendar', color: '#d97706' },
    { label: 'بدون نشاط', value: ov.noActivity, icon: 'fa-user-slash', color: '#dc2626' },
    { label: 'متوسط المشاهدة', value: Math.floor(ov.avgWatchTime / 60) + ':' + String(ov.avgWatchTime % 60).padStart(2,'0'), icon: 'fa-clock', color: '#2563eb' },
    { label: 'نسبة إكمال الدروس', value: ov.completionPercentage + '%', icon: 'fa-percent', color: '#059669' },
    { label: 'متوسط الإنجاز', value: Math.round((ov.completedStudents / (ov.totalStudents || 1)) * 100) + '%', icon: 'fa-tasks', color: '#0ea5e9' },
    { label: 'متوسط الاختبارات', value: ov.avgQuizScore + '%', icon: 'fa-chart-line', color: '#7c3aed' }
  ];
  document.getElementById('overviewCards').innerHTML = cards.map(function(c) {
    return '<div style="background:var(--card);border-radius:var(--radius-lg);padding:14px;border:1px solid var(--border);text-align:center;">' +
      '<i class="fas ' + c.icon + '" style="color:' + c.color + ';font-size:22px;margin-bottom:6px;"></i>' +
      '<div style="font-size:22px;font-weight:800;line-height:1.2;">' + c.value + '</div>' +
      '<div style="font-size:11px;color:var(--text-muted);">' + c.label + '</div></div>';
  }).join('');

  // Load most active from v2
  var most = (ov.topActive || []).map(function(s) {
    return { id: s.uid, name: s.name, activityScore: s.summary.activityScore, completedLessons: s.summary.completedLessons, totalLessons: 0, totalWatchMinutes: Math.floor((s.summary.totalWatchTime || 0) / 60), avgQuizScore: s.summary.averageQuizScore };
  });
  document.getElementById('mostActiveTable').innerHTML = most.length ? renderStudentTable(most) : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات</div>';

  // Load least active from v2
  var least = (ov.leastActive || []).map(function(s) {
    return { id: s.uid, name: s.name, activityScore: s.summary.activityScore, completedLessons: s.summary.completedLessons, totalLessons: 0, totalWatchMinutes: Math.floor((s.summary.totalWatchTime || 0) / 60), avgQuizScore: s.summary.averageQuizScore };
  });
  document.getElementById('leastActiveTable').innerHTML = least.length ? renderStudentTable(least) : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات</div>';

  // Load lessons from v2
  var analytics = (ov.lessonAnalytics || []);
  document.getElementById('lessonsTable').innerHTML = analytics.length ? renderLessonAnalytics(analytics) : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات بعد</div>';

  // Most / least active lesson
  var sorted = analytics.slice().sort(function(a, b) { return b.activityScore - a.activityScore; });
  var mostActive = sorted[0] || null;
  var leastActive = sorted.length > 1 ? sorted[sorted.length - 1] : null;
  document.getElementById('mostActiveLesson').innerHTML = mostActive ? renderLessonCard(mostActive, 'fire') : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات بعد</div>';
  document.getElementById('leastActiveLesson').innerHTML = leastActive ? renderLessonCard(leastActive, 'chart-line') : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات بعد</div>';

  // Load exams from v2
  var exams = (ov.examAnalytics || []);
  document.getElementById('quizzesTable').innerHTML = exams.length ? renderExamAnalytics(exams) : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات حتى الآن</div>';

  // Hardest / easiest / most attempted / least attempted
  var byAvg = exams.slice().sort(function(a, b) { return a.averageScore - b.averageScore; });
  var hardest = byAvg[0] || null;
  var easiest = byAvg.length > 1 ? byAvg[byAvg.length - 1] : null;
  var byStudents = exams.slice().sort(function(a, b) { return b.students - a.students; });
  var mostSolved = byStudents[0] || null;
  var leastSolved = byStudents.length > 1 ? byStudents[byStudents.length - 1] : null;
  document.getElementById('hardestExam').innerHTML = hardest ? renderExamCard(hardest, '🔥') : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات حتى الآن</div>';
  document.getElementById('easiestExam').innerHTML = easiest ? renderExamCard(easiest, '🏆') : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات حتى الآن</div>';
  document.getElementById('mostSolvedExam').innerHTML = mostSolved ? renderExamCard(mostSolved, '📈') : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات حتى الآن</div>';
  document.getElementById('leastSolvedExam').innerHTML = leastSolved ? renderExamCard(leastSolved, '📉') : '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات حتى الآن</div>';
})();

function renderStudentTable(data) {
  var h = '<table style="width:100%;font-size:12px;border-collapse:collapse;"><thead><tr style="background:var(--bg);">' +
    '<th style="padding:6px 4px;text-align:right;">الاسم</th><th style="padding:6px 4px;text-align:center;">النشاط</th>' +
    '<th style="padding:6px 4px;text-align:center;">مُنجز</th><th style="padding:6px 4px;text-align:center;">وقت</th>' +
    '<th style="padding:6px 4px;text-align:center;">اختبارات</th></tr></thead><tbody>';
  data.forEach(function(s) {
    var scoreColor = s.activityScore >= 70 ? '#059669' : s.activityScore >= 40 ? '#d97706' : '#dc2626';
    h += '<tr style="border-bottom:1px solid var(--border);">' +
      '<td style="padding:6px 4px;"><a href="/admin/student-progress?sid=' + s.id + '" style="color:var(--accent);text-decoration:none;font-weight:600;">' + (s.name || '—') + '</a></td>' +
      '<td style="padding:6px 4px;text-align:center;"><span style="background:' + scoreColor + ';color:#fff;padding:2px 8px;border-radius:10px;font-weight:700;font-size:11px;">' + s.activityScore + '</span></td>' +
      '<td style="padding:6px 4px;text-align:center;">' + s.completedLessons + '/' + s.totalLessons + '</td>' +
      '<td style="padding:6px 4px;text-align:center;">' + (s.totalWatchMinutes >= 60 ? Math.round(s.totalWatchMinutes/60) + 'س' : s.totalWatchMinutes + 'د') + '</td>' +
      '<td style="padding:6px 4px;text-align:center;">' + s.avgQuizScore + '%</td></tr>';
  });
  return h + '</tbody></table>';
}

function fmtTime(secs) {
  if (!secs) return '0:00';
  var m = Math.floor(secs / 60), s = secs % 60;
  return m + 'د ' + s + 'ث';
}

function renderLessonAnalytics(data) {
  var courses = {};
  data.forEach(function(l) {
    if (!courses[l.courseId]) courses[l.courseId] = { title: l.courseTitle, lessons: [] };
    courses[l.courseId].lessons.push(l);
  });
  var h = '<div style="display:flex;align-items:center;padding:4px 0;font-size:11px;color:var(--text-muted);border-bottom:1px solid var(--border);">' +
    '<div style="flex:2;">المحاضرة</div><div style="flex:1;text-align:center;">الفتح</div>' +
    '<div style="flex:2;text-align:center;">الإكمال</div><div style="flex:1;text-align:center;">المشاهدة</div></div>';
  Object.keys(courses).forEach(function(cid) {
    var c = courses[cid];
    h += '<div style="font-weight:700;font-size:13px;padding:8px 0 4px;color:var(--accent);border-bottom:1px solid var(--border);margin-top:10px;"><i class="fas fa-book" style="font-size:12px;"></i> ' + c.title + '</div>';
    c.lessons.forEach(function(l) {
      var barColor = l.completionRate >= 70 ? '#059669' : l.completionRate >= 40 ? '#d97706' : '#dc2626';
      h += '<div style="display:flex;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);font-size:12px;">' +
        '<div style="flex:2;font-weight:600;">' + (l.lessonTitle || '—') + '</div>' +
        '<div style="flex:1;text-align:center;color:var(--text-muted);">' + l.opens + '</div>' +
        '<div style="flex:2;text-align:center;"><div style="display:flex;align-items:center;gap:4px;"><div style="flex:1;height:5px;background:var(--bg);border-radius:3px;overflow:hidden;"><div style="height:100%;width:' + l.completionRate + '%;background:' + barColor + ';border-radius:3px;"></div></div><span style="font-weight:700;font-size:10px;color:' + barColor + ';">' + l.completionRate + '%</span></div></div>' +
        '<div style="flex:1;text-align:center;font-size:11px;color:var(--text-muted);">' + fmtTime(l.averageWatchTimeSeconds) + '</div></div>';
    });
  });
  return h || '<div style="text-align:center;padding:20px;color:var(--text-muted);">لا توجد بيانات بعد</div>';
}

function renderLessonCard(l, icon) {
  return '<div style="text-align:center;padding:12px;">' +
    '<i class="fas fa-' + icon + '" style="font-size:28px;color:var(--accent);margin-bottom:8px;"></i>' +
    '<div style="font-weight:700;font-size:14px;margin-bottom:4px;">' + (l.lessonTitle || '—') + '</div>' +
    '<div style="font-size:11px;color:var(--text-muted);margin-bottom:8px;">' + (l.courseTitle || '') + '</div>' +
    '<div style="display:flex;justify-content:center;gap:16px;font-size:12px;">' +
    '<div><span style="color:var(--text-muted);">الإكمال</span> <strong>' + l.completionRate + '%</strong></div>' +
    '<div><span style="color:var(--text-muted);">الفتح</span> <strong>' + l.opens + '</strong></div></div></div>';
}

function renderExamAnalytics(data) {
  var h = '<table style="width:100%;font-size:12px;border-collapse:collapse;"><thead><tr style="background:var(--bg);">' +
    '<th style="padding:6px 4px;text-align:right;">الاختبار</th>' +
    '<th style="padding:6px 4px;text-align:center;">الطلاب</th>' +
    '<th style="padding:6px 4px;text-align:center;">متوسط الدرجات</th>' +
    '<th style="padding:6px 4px;text-align:center;">النجاح</th>' +
    '<th style="padding:6px 4px;text-align:center;">متوسط المحاولات</th></tr></thead><tbody>';
  data.forEach(function(e) {
    var barColor = e.passRate >= 70 ? '#059669' : e.passRate >= 40 ? '#d97706' : '#dc2626';
    var avgColor = e.averageScore >= 70 ? '#059669' : e.averageScore >= 40 ? '#d97706' : '#dc2626';
    h += '<tr style="border-bottom:1px solid var(--border);">' +
      '<td style="padding:6px 4px;font-weight:600;font-size:12px;">' + (e.examTitle || '—') + '</td>' +
      '<td style="padding:6px 4px;text-align:center;">' + e.students + '</td>' +
      '<td style="padding:6px 4px;text-align:center;font-weight:700;color:' + avgColor + ';">' + e.averageScore + '%</td>' +
      '<td style="padding:6px 4px;text-align:center;"><div style="display:flex;align-items:center;gap:4px;"><div style="flex:1;height:5px;background:var(--bg);border-radius:3px;overflow:hidden;"><div style="height:100%;width:' + e.passRate + '%;background:' + barColor + ';border-radius:3px;"></div></div><span style="font-weight:700;font-size:10px;color:' + barColor + ';">' + e.passRate + '%</span></div></td>' +
      '<td style="padding:6px 4px;text-align:center;font-size:11px;">' + e.averageAttempts + '</td></tr>';
  });
  return h + '</tbody></table>';
}

function renderExamCard(e, icon) {
  return '<div style="font-size:13px;">' +
    '<div style="font-size:18px;margin-bottom:4px;">' + icon + '</div>' +
    '<div style="font-weight:700;font-size:12px;margin-bottom:2px;">' + (e.examTitle || '—') + '</div>' +
    '<div style="font-size:11px;color:var(--text-muted);">المعدل: <strong>' + e.averageScore + '%</strong> | الطلاب: <strong>' + e.students + '</strong></div></div>';
}
</script>
<%- include('../partials/footer') %>