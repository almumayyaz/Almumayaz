<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<style>#chatContainer{border-radius:0!important;border-left:none!important;border-right:none!important;margin:0!important;}</style>
<main class="admin-content" style="display:flex;flex-direction:column;height:calc(100vh - 72px);padding:0;overflow:hidden;">
  <div class="page-header" style="flex-shrink:0;margin-bottom:0;padding:4px 12px 2px;">
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/admin/chat" style="color:var(--text-light);font-size:16px;text-decoration:none;display:flex;align-items:center;"><i class="fas fa-arrow-right"></i></a>
      <div><h1 style="font-size:14px;display:flex;align-items:center;gap:6px;margin:0;"><i class="fas fa-comments" style="color:var(--accent);font-size:12px;"></i> محادثة مع طالب</h1><p id="chatStudentName" style="font-size:11px;margin:0;">جاري التحميل...</p></div>
      <button id="deleteChatBtn" onclick="deleteChat()" style="background:none;border:none;color:var(--danger);font-size:14px;cursor:pointer;padding:6px;margin-right:auto;display:none;" title="حذف المحادثة"><i class="fas fa-trash"></i></button>
    </div>
  </div>
  <div id="chatContainer" style="flex:1;display:flex;flex-direction:column;background:var(--card);overflow:hidden;">
    <div id="chatMessages" style="flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;scroll-behavior:smooth;"></div>
    <div id="chatTyping" style="padding:2px 14px 4px;font-size:11px;color:var(--text-muted);min-height:16px;display:none;">الطالب يكتب...</div>
    <div style="padding:14px 16px;border-top:1px solid var(--border);background:var(--bg);border-radius:0 0 var(--radius-xl) var(--radius-xl);">
      <div style="display:flex;gap:10px;align-items:flex-end;">
        <button id="attachBtn" onclick="document.getElementById('imageInput').click()" style="background:var(--card);border:1px solid var(--border);border-radius:50%;width:42px;height:42px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:16px;cursor:pointer;transition:var(--transition);flex-shrink:0;"><i class="fas fa-image"></i></button>
        <input type="file" id="imageInput" accept="image/*" style="display:none;" onchange="handleImageSelect(event)">
        <input type="text" id="chatInput" placeholder="اكتب ردك هنا..." style="flex:1;padding:10px 14px;border:2px solid var(--border);border-radius:var(--radius);font-size:14px;background:var(--card);color:var(--text);direction:rtl;transition:var(--transition);" onkeydown="if(event.key==='Enter')sendMessage()">
        <button id="sendBtn" onclick="sendMessage()" style="background:var(--gold-gradient);border:none;border-radius:var(--radius);padding:10px 18px;color:#fff;font-size:14px;cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:6px;flex-shrink:0;font-weight:700;"><i class="fas fa-paper-plane"></i> إرسال</button>
      </div>
    </div>
  </div>
</main>

<script>
(function(){
  var studentId = '<%= chatId.replace("student-", "") %>';
  var fullChatId = '<%= chatId %>';
  var chatDiv = document.getElementById('chatMessages');
  var chatInput = document.getElementById('chatInput');
  var studentNameEl = document.getElementById('chatStudentName');
  var lastDate = '';
  var nameSet = false;
  var isSending = false;
  var pendingKeys = {};

  document.getElementById('deleteChatBtn').style.display = '';

  function scrollToBottom() { setTimeout(function(){ chatDiv.scrollTop = chatDiv.scrollHeight; }, 50); }
  function formatTime(ts) { var d = new Date(ts); return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0'); }
  function formatDate(ts) { var d = new Date(ts); var now = new Date(); var opts = { weekday:'long', year:'numeric', month:'long', day:'numeric' }; if (d.toDateString() === now.toDateString()) return 'اليوم'; var yesterday = new Date(now); yesterday.setDate(yesterday.getDate()-1); if (d.toDateString() === yesterday.toDateString()) return 'أمس'; return d.toLocaleDateString('ar-EG', opts); }

  function createMessageElement(data) {
    var isMine = data.senderId === 'teacher';
    var div = document.createElement('div');
    div.id = 'msg-' + (data._key || data._localId || data.timestamp);
    div.style.cssText = 'display:flex;flex-direction:column;align-items:' + (isMine ? 'flex-start' : 'flex-end') + ';max-width:80%;align-self:' + (isMine ? 'flex-end' : 'flex-start') + ';';
    var bubble = document.createElement('div');
    bubble.style.cssText = 'padding:10px 16px;border-radius:16px;max-width:100%;word-wrap:break-word;font-size:14px;line-height:1.6;' + (isMine ? 'background:var(--gold-gradient);color:#fff;border-bottom-left-radius:4px;' : 'background:var(--bg);color:var(--text);border-bottom-right-radius:4px;');
    if (data.image) { var img = document.createElement('img'); img.src = data.image; img.style.cssText = 'max-width:220px;max-height:220px;border-radius:10px;display:block;margin-bottom:6px;cursor:pointer;'; img.onclick = function(){ openImagePopup(data.image); }; bubble.appendChild(img); }
    if (data.text) { var txt = document.createElement('span'); txt.textContent = data.text; bubble.appendChild(txt); }
    div.appendChild(bubble);
    var meta = document.createElement('div');
    meta.style.cssText = 'display:flex;align-items:center;gap:6px;margin-top:2px;font-size:10px;color:var(--text-muted);padding:0 4px;direction:ltr;';
    if (!isMine) { var name = document.createElement('span'); name.textContent = data.senderName || 'طالب'; name.style.fontWeight = '600'; meta.appendChild(name); meta.appendChild(document.createTextNode('·')); }
    var time = document.createElement('span'); time.textContent = formatTime(data.timestamp); time.dir = 'ltr'; meta.appendChild(time);
    if (isMine) { meta.appendChild(document.createTextNode('·'));
      var receipt = document.createElement('span');
      receipt.id = 'rcpt-' + (data._key || data._localId || data.timestamp);
      if (data._status === 'sending') receipt.innerHTML = '<i class="fas fa-clock" style="color:var(--warning);font-size:11px;"></i>';
      else receipt.innerHTML = data.read ? '<i class="fas fa-check-double" style="color:var(--success);font-size:11px;"></i>' : '<i class="fas fa-check" style="color:var(--text-muted);font-size:11px;"></i>';
      meta.appendChild(receipt);
    }
    div.appendChild(meta);
    return div;
  }

  function msgExists(key) {
    if (document.getElementById('msg-' + key)) return true;
    if (pendingKeys[key]) return true;
    var all = chatDiv.querySelectorAll('[id^="msg-"]');
    for (var i = 0; i < all.length; i++) {
      if (all[i].getAttribute('data-local-key') === key) return true;
    }
    return false;
  }

  function addMessage(data) {
    var key = data._key || data._localId || data.timestamp;
    if (document.getElementById('msg-' + key)) return;
    if (!nameSet && data.senderId !== 'teacher' && data.senderName) { studentNameEl.textContent = data.senderName; nameSet = true; }
    var msgDate = new Date(data.timestamp).toDateString();
    if (msgDate !== lastDate) { lastDate = msgDate; var dateSep = document.createElement('div'); dateSep.style.cssText = 'text-align:center;font-size:11px;color:var(--text-muted);padding:8px 0;font-weight:600;'; dateSep.textContent = formatDate(data.timestamp); chatDiv.appendChild(dateSep); }
    chatDiv.appendChild(createMessageElement(data));
    scrollToBottom();
  }

  function loadMessages() {
    fetch('/api/admin/chat/' + encodeURIComponent(studentId) + '/messages').then(function(r){return r.json()}).then(function(d){
      if (!d.success) return;
      d.messages.forEach(function(data) {
        if (msgExists(data._key)) return;
        if (!nameSet && data.senderId !== 'teacher' && data.senderName) { studentNameEl.textContent = data.senderName; nameSet = true; }
        data._status = '';
        var msgDate = new Date(data.timestamp).toDateString();
        if (msgDate !== lastDate) { lastDate = msgDate; var dateSep = document.createElement('div'); dateSep.style.cssText = 'text-align:center;font-size:11px;color:var(--text-muted);padding:8px 0;font-weight:600;'; dateSep.textContent = formatDate(data.timestamp); chatDiv.appendChild(dateSep); }
        chatDiv.appendChild(createMessageElement(data));
        scrollToBottom();
      });
      if (d.messages.length > 0) fetch('/api/admin/chat/' + encodeURIComponent(studentId) + '/read', { method: 'PUT' }).catch(function(){});
    }).catch(function(){});
  }

  // Firebase real-time receipt updates
  if (typeof firebase !== 'undefined' && firebase.database) {
    firebase.database().ref('chats/' + fullChatId + '/messages').on('child_changed', function(snapshot) {
      var data = snapshot.val();
      var el = document.getElementById('msg-' + snapshot.key);
      if (el && data.read) { var rcpt = el.querySelector('[id^="rcpt-"]'); if (rcpt) rcpt.innerHTML = '<i class="fas fa-check-double" style="color:var(--success);font-size:11px;"></i>'; }
    });
  }

  loadMessages();
  setInterval(loadMessages, 2000);

  function sendMessage() {
    var text = chatInput.value.trim();
    if ((!text && !selectedImage) || isSending) return;
    isSending = true;
    if (selectedImage) {
      fetch('/api/admin/chat/' + encodeURIComponent(studentId) + '/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ text: text || '', image: selectedImage }) })
      .then(function(r){return r.json()}).then(function(d){ if (d.success) { chatInput.value = ''; selectedImage = null; updateAttachBtn(); document.getElementById('imageInput').value = ''; } isSending = false; }).catch(function(){ isSending = false; });
      return;
    }
    var tempId = 'local-' + Date.now();
    pendingKeys[tempId] = true;
    addMessage({ _localId: tempId, senderId: 'teacher', senderName: 'محمد عفيفي', timestamp: Date.now(), text: text, read: false, _status: 'sending' });
    chatInput.value = '';
    var btn = document.getElementById('sendBtn');
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    fetch('/api/admin/chat/' + encodeURIComponent(studentId) + '/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({text:text}) })
    .then(function(r){return r.json()}).then(function(d){
      if (d.success && d.key) {
        pendingKeys[d.key] = true;
        delete pendingKeys[tempId];
        var el = document.getElementById('msg-' + tempId);
        var dup = document.getElementById('msg-' + d.key);
        if (dup && dup !== el) dup.remove();
        if (el) { el.id = 'msg-' + d.key; el.setAttribute('data-local-key', d.key); }
        var rcpt = el ? el.querySelector('[id^="rcpt-"]') : null;
        if (rcpt) { rcpt.id = 'rcpt-' + d.key; rcpt.innerHTML = '<i class="fas fa-check" style="color:var(--text-muted);font-size:11px;"></i>'; }
        delete pendingKeys[d.key];
      }
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال';
      isSending = false;
    }).catch(function() { btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال'; isSending = false; });
  }

  var selectedImage = null;
  function handleImageSelect(e) {
    var file = e.target.files[0]; if (!file) return;
    if (file.size > 5 * 1024 * 1024) { alert('حجم الصورة يجب أن يكون أقل من 5 ميجابايت'); return; }
    var reader = new FileReader(); reader.onload = function(ev) { selectedImage = ev.target.result; updateAttachBtn(); }; reader.readAsDataURL(file);
  }
  function updateAttachBtn() {
    var btn = document.getElementById('attachBtn');
    if (selectedImage) { btn.innerHTML = '<i class="fas fa-check-circle"></i>'; btn.style.color = 'var(--success)'; btn.style.borderColor = 'var(--success)'; }
    else { btn.innerHTML = '<i class="fas fa-image"></i>'; btn.style.color = 'var(--accent)'; btn.style.borderColor = 'var(--border)'; }
    document.getElementById('imageInput').value = '';
  }

  window.deleteChat = function() {
    if (!confirm('هل أنت متأكد من حذف المحادثة بالكامل؟')) return;
    fetch('/api/admin/chat/' + encodeURIComponent(studentId), { method: 'DELETE' }).then(function(r){return r.json()}).then(function(d){ if (d.success) window.location.href = '/admin/chat'; else alert('فشل حذف المحادثة'); }).catch(function(){ alert('فشل حذف المحادثة'); });
  };

  window.sendMessage = sendMessage;
  window.handleImageSelect = handleImageSelect;
})();
</script>

<div id="imagePopup" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:9999;justify-content:center;align-items:center;backdrop-filter:blur(4px);" onclick="closeImagePopup(event)">
  <div style="position:relative;max-width:90vw;max-height:90vh;display:flex;flex-direction:column;align-items:center;" onclick="event.stopPropagation()">
    <div style="position:absolute;top:-44px;left:0;right:0;display:flex;justify-content:space-between;padding:0 4px;">
      <button onclick="downloadImage()" style="background:rgba(255,255,255,0.15);border:none;color:#fff;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:14px;display:flex;align-items:center;gap:6px;backdrop-filter:blur(4px);"><i class="fas fa-download"></i> تحميل</button>
      <button onclick="closeImagePopup()" style="background:rgba(255,255,255,0.15);border:none;color:#fff;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);"><i class="fas fa-times"></i></button>
    </div>
    <img id="popupImage" src="" style="max-width:100%;max-height:85vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
  </div>
</div>
<script>
function openImagePopup(src) { document.getElementById('popupImage').src = src; document.getElementById('imagePopup').style.display = 'flex'; document.body.style.overflow = 'hidden'; }
function closeImagePopup(e) { if (e && e.target !== e.currentTarget) return; document.getElementById('imagePopup').style.display = 'none'; document.body.style.overflow = ''; }
function downloadImage() { var src = document.getElementById('popupImage').src; var a = document.createElement('a'); a.href = src; a.download = 'image-' + Date.now() + '.jpg'; document.body.appendChild(a); a.click(); document.body.removeChild(a); }
</script>
</body>
</html>
