<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="admin-content">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-comments" style="color:var(--accent);"></i> تواصل مع الطلاب</h1>
      <p>عرض المحادثات الفردية مع الطلاب - يتم التحديث تلقائياً</p>
    </div>
  </div>

  <div id="chatList" style="display:flex;flex-direction:column;gap:0;background:var(--card);border-radius:var(--radius-xl);box-shadow:var(--shadow);border:1px solid var(--border);overflow:hidden;">
    <div style="padding:16px 20px;border-bottom:1px solid var(--border);background:var(--bg);display:flex;align-items:center;gap:12px;">
      <i class="fas fa-search" style="color:var(--text-muted);"></i>
      <input type="text" id="searchInput" placeholder="ابحث عن طالب..." style="flex:1;border:none;background:transparent;font-size:14px;color:var(--text);outline:none;" oninput="filterChats(this.value)">
    </div>
    <div id="chatListItems" style="flex:1;">
      <div style="text-align:center;padding:60px 20px;color:var(--text-muted);">
        <i class="fas fa-spinner fa-spin" style="font-size:32px;display:block;margin-bottom:12px;"></i>
        جاري تحميل المحادثات...
      </div>
    </div>
  </div>
</main>

<script>
function escHtml(t) { return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
(function(){
  var listDiv = document.getElementById('chatListItems');
  var chatData = [];
  var currentFilter = '';

  function formatTime(ts) {
    if (!ts) return '';
    var d = new Date(ts);
    var now = new Date();
    if (d.toDateString() === now.toDateString()) return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
    return d.toLocaleDateString('ar-EG', { day:'numeric', month:'short' });
  }

  function renderChats() {
    var items = chatData;
    if (currentFilter) {
      var f = currentFilter.toLowerCase();
      items = items.filter(function(c) { return c.name.toLowerCase().includes(f) || c.id.toLowerCase().includes(f); });
    }
    if (items.length === 0) {
      listDiv.innerHTML = '<div style="text-align:center;padding:60px 20px;color:var(--text-muted);">' +
        '<i class="fas fa-comments" style="font-size:40px;display:block;margin-bottom:12px;opacity:0.4;"></i>' +
        (currentFilter ? 'لا توجد محادثات تطابق البحث' : 'لا توجد محادثات بعد') +
        '</div>';
      return;
    }
    var html = '';
    items.forEach(function(c) {
      var isUnread = c.unread > 0;
      html += '<a href="/admin/chat/' + encodeURIComponent(c.studentId) + '" style="display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--border);text-decoration:none;color:var(--text);transition:var(--transition);' + (isUnread ? 'background:rgba(26,115,232,0.04);' : '') + '" onmouseover="this.style.background=\'var(--bg)\'" onmouseout="this.style.background=\'' + (isUnread ? 'rgba(26,115,232,0.04)' : 'transparent') + '\'">' +
        '<div style="width:44px;height:44px;border-radius:50%;background:var(--gold-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:17px;flex-shrink:0;">' + escHtml(c.initial) + '</div>' +
        '<div style="flex:1;min-width:0;">' +
          '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px;">' +
            '<span style="font-weight:' + (isUnread ? '700' : '600') + ';font-size:14px;">' + escHtml(c.name) + '</span>' +
            '<span style="font-size:11px;color:var(--text-muted);">' + formatTime(c.lastTime) + '</span>' +
          '</div>' +
          '<div style="display:flex;justify-content:space-between;align-items:center;">' +
            '<span style="font-size:13px;color:var(--text-light);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px;">' + escHtml(c.lastText || 'بدون رسائل') + '</span>' +
            (isUnread ? '<span style="background:var(--accent);color:#fff;border-radius:50%;min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;padding:0 6px;border-radius:10px;">' + c.unread + '</span>' : '') +
          '</div>' +
        '</div>' +
      '</a>';
    });
    listDiv.innerHTML = html;
  }

  function loadChats() {
    fetch('/api/admin/chats').then(function(r){return r.json()}).then(function(d){
      if (d.success) { chatData = d.chats; renderChats(); }
    }).catch(function(){});
  }

  setInterval(loadChats, 5000);
  loadChats();

  window.filterChats = function(val) { currentFilter = val.trim(); renderChats(); };
})();
</script>
<%- include("../partials/footer") %>
</body>
</html>