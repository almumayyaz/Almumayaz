<%- include('../partials/header', { title: title, navPageTitle: 'الإدارة', bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="main-content">
  <div class="page-header">
    <h1><i class="fas fa-video"></i> الحصص المباشرة</h1>
    <button class="btn btn-primary" onclick="openCreateModal()"><i class="fas fa-plus"></i> حصة جديدة</button>
  </div>

  <div id="sessionsList" style="display:flex;flex-direction:column;gap:12px;"></div>
</main>

<!-- Create/Edit Modal -->
<div id="sessionModal" class="modal-overlay" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:10000;align-items:center;justify-content:center;overflow-y:auto;padding:20px;">
  <div style="background:var(--card);border-radius:var(--radius-lg);padding:28px;max-width:600px;width:100%;margin:auto;">
    <h3 id="modalTitle" style="font-size:18px;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:10px;">
      <i class="fas fa-video" style="color:var(--accent);"></i> <span>حصة جديدة</span>
    </h3>
    <input id="sessionId" type="hidden">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <div style="grid-column:1/-1;">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">عنوان الحصة</label>
        <input id="fTitle" class="form-input" placeholder="مثال: مراجعة النحو" style="width:100%;">
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">المادة</label>
        <input id="fSubject" class="form-input" placeholder="النحو" style="width:100%;">
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">المرحلة</label>
        <select id="fStage" class="form-input" style="width:100%;" onchange="updateGrades()">
          <option value="">الكل</option>
          <option value="إعدادي">إعدادي</option>
          <option value="ثانوي">ثانوي</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">الصف</label>
        <select id="fGrade" class="form-input" style="width:100%;">
          <option value="">الكل</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">التاريخ</label>
        <input id="fDate" type="date" class="form-input" style="width:100%;">
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">وقت البداية</label>
        <input id="fTime" type="time" class="form-input" style="width:100%;">
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">المدة (دقائق)</label>
        <input id="fDuration" type="number" class="form-input" value="60" min="5" style="width:100%;">
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">كلمة المرور (اختياري)</label>
        <input id="fPassword" type="text" class="form-input" placeholder="تركه فارغاً" style="width:100%;">
      </div>
      <div>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;">
          <input id="fEnableNotify" type="checkbox" onchange="toggleNotifyTime()"> إرسال إشعار مجدول للطلاب
        </label>
      </div>
      <div id="notifyTimeGroup" style="display:none;">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;">وقت الإشعار</label>
        <input id="fNotifyAt" type="datetime-local" class="form-input" style="width:100%;">
      </div>
    </div>
    <div style="display:flex;gap:16px;margin-top:14px;flex-wrap:wrap;">
      <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;">
        <input id="fAllowJoin" type="checkbox" checked> الدخول قبل المدرس
      </label>
      <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;">
        <input id="fWaitingRoom" type="checkbox"> غرفة الانتظار
      </label>
      <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;">
        <input id="fRecording" type="checkbox"> تسجيل الحصة
      </label>
    </div>
    <div style="display:flex;gap:10px;margin-top:20px;justify-content:flex-end;">
      <button class="btn btn-secondary" onclick="closeModal()">إلغاء</button>
      <button class="btn btn-primary" onclick="saveSession()"><i class="fas fa-save"></i> حفظ</button>
    </div>
  </div>
</div>

<script>
var sessions = [];
var editingId = null;

var gradesByStage = {
  'إعدادي': ['الأول الإعدادي', 'الثاني الإعدادي', 'الثالث الإعدادي'],
  'ثانوي': ['الأول الثانوي', 'الثاني الثانوي', 'الثالث الثانوي']
};

function updateGrades() {
  var stage = document.getElementById('fStage').value;
  var sel = document.getElementById('fGrade');
  sel.innerHTML = '<option value="">الكل</option>';
  var grades = gradesByStage[stage] || [];
  for (var i = 0; i < grades.length; i++) {
    sel.innerHTML += '<option value="' + grades[i] + '">' + grades[i] + '</option>';
  }
}

function toggleNotifyTime() {
  var enabled = document.getElementById('fEnableNotify').checked;
  document.getElementById('notifyTimeGroup').style.display = enabled ? 'block' : 'none';
}

function openCreateModal() {
  editingId = null;
  document.getElementById('modalTitle').querySelector('span').textContent = 'حصة جديدة';
  document.getElementById('sessionId').value = '';
  document.getElementById('fTitle').value = '';
  document.getElementById('fSubject').value = '';
  document.getElementById('fGrade').value = '';
  document.getElementById('fStage').value = '';
  document.getElementById('fGrade').innerHTML = '<option value="">الكل</option>';
  document.getElementById('fDate').value = '';
  document.getElementById('fTime').value = '';
  document.getElementById('fDuration').value = '60';
  document.getElementById('fPassword').value = '';
  document.getElementById('fEnableNotify').checked = false;
  document.getElementById('notifyTimeGroup').style.display = 'none';
  document.getElementById('fNotifyAt').value = '';
  document.getElementById('fAllowJoin').checked = true;
  document.getElementById('fWaitingRoom').checked = false;
  document.getElementById('fRecording').checked = false;
  document.getElementById('sessionModal').style.display = 'flex';
}

function openEditModal(s) {
  editingId = s.id;
  document.getElementById('modalTitle').querySelector('span').textContent = 'تعديل الحصة';
  document.getElementById('sessionId').value = s.id;
  document.getElementById('fTitle').value = s.title || '';
  document.getElementById('fSubject').value = s.subject || '';
  document.getElementById('fGrade').value = s.grade || '';
  document.getElementById('fStage').value = s.stage || '';
  function toLocalDate(iso) {
    var d2 = new Date(iso);
    return d2.getFullYear() + '-' + String(d2.getMonth()+1).padStart(2,'0') + '-' + String(d2.getDate()).padStart(2,'0');
  }
  function toLocalDatetime(iso) {
    var d2 = new Date(iso);
    return d2.getFullYear() + '-' + String(d2.getMonth()+1).padStart(2,'0') + '-' + String(d2.getDate()).padStart(2,'0') + 'T' + String(d2.getHours()).padStart(2,'0') + ':' + String(d2.getMinutes()).padStart(2,'0');
  }
  if (s.startTime) {
    var d = new Date(s.startTime);
    document.getElementById('fDate').value = toLocalDate(s.startTime);
    document.getElementById('fTime').value = d.toTimeString().slice(0, 5);
  }
  document.getElementById('fDuration').value = s.duration || 60;
  document.getElementById('fPassword').value = s.password || '';
  if (s.notifyAt) {
    document.getElementById('fEnableNotify').checked = true;
    document.getElementById('notifyTimeGroup').style.display = 'block';
    document.getElementById('fNotifyAt').value = toLocalDatetime(s.notifyAt);
  } else {
    document.getElementById('fEnableNotify').checked = false;
    document.getElementById('notifyTimeGroup').style.display = 'none';
  }
  if (s.stage) { document.getElementById('fStage').value = s.stage; updateGrades(); }
  if (s.grade) { document.getElementById('fGrade').value = s.grade; }
  document.getElementById('fAllowJoin').checked = !!s.allowJoinBeforeTeacher;
  document.getElementById('fWaitingRoom').checked = !!s.waitingRoom;
  document.getElementById('fRecording').checked = !!s.recording;
  document.getElementById('sessionModal').style.display = 'flex';
}

function closeModal() {
  document.getElementById('sessionModal').style.display = 'none';
}

document.getElementById('sessionModal').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});

function getFormData() {
  var date = document.getElementById('fDate').value;
  var time = document.getElementById('fTime').value;
  var startTime = (date && time) ? new Date(date + 'T' + time).toISOString() : '';
  var enableNotify = document.getElementById('fEnableNotify').checked;
  var notifyVal = document.getElementById('fNotifyAt').value;
  var notifyAt = (enableNotify && notifyVal) ? new Date(notifyVal).toISOString() : '';
  return {
    title: document.getElementById('fTitle').value.trim(),
    subject: document.getElementById('fSubject').value.trim(),
    grade: document.getElementById('fGrade').value,
    stage: document.getElementById('fStage').value,
    startTime: startTime,
    duration: parseInt(document.getElementById('fDuration').value) || 60,
    password: document.getElementById('fPassword').value.trim(),
    notifyAt: notifyAt,
    allowJoinBeforeTeacher: document.getElementById('fAllowJoin').checked,
    waitingRoom: document.getElementById('fWaitingRoom').checked,
    recording: document.getElementById('fRecording').checked
  };
}

function saveSession() {
  var data = getFormData();
  if (!data.title) return alert('يرجى إدخال عنوان الحصة');
  if (!data.startTime) return alert('يرجى إدخال التاريخ ووقت البداية');

  var url = editingId ? ('/api/admin/live-sessions/' + editingId) : '/api/admin/live-sessions';
  var method = editingId ? 'PUT' : 'POST';

  fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success) { closeModal(); loadSessions(); }
      else alert(d.error || 'حدث خطأ');
    })
    .catch(function() { alert('خطأ في الاتصال'); });
}

function deleteSession(id) {
  if (!confirm('هل أنت متأكد من حذف هذه الحصة؟')) return;
  fetch('/api/admin/live-sessions/' + id, { method: 'DELETE' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success) loadSessions();
      else alert(d.error || 'حدث خطأ');
    });
}

function startSession(id) {
  if (!confirm('هل تريد بدء هذه الحصة الآن؟')) return;
  fetch('/api/admin/live-sessions/' + id + '/start', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success) {
        loadSessions();
        if (d.session && d.session.startUrl) {
          window.open(d.session.startUrl, '_blank');
        }
      }
      else alert(d.error || 'حدث خطأ');
    });
}

function endSession(id) {
  if (!confirm('هل تريد إنهاء هذه الحصة؟')) return;
  fetch('/api/admin/live-sessions/' + id + '/end', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success) loadSessions();
      else alert(d.error || 'حدث خطأ');
    });
}

function cancelSession(id) {
  if (!confirm('هل تريد إلغاء هذه الحصة؟')) return;
  fetch('/api/admin/live-sessions/' + id + '/cancel', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success) loadSessions();
      else alert(d.error || 'حدث خطأ');
    });
}

function statusBadge(status) {
  var map = { Scheduled: 'info', Live: 'success', Ended: 'secondary', Cancelled: 'danger' };
  var labels = { Scheduled: 'مجدولة', Live: 'مباشر', Ended: 'منتهية', Cancelled: 'ملغاة' };
  var cls = map[status] || 'info';
  return '<span class="badge badge-' + cls + '">' + (labels[status] || status) + '</span>';
}

function formatDate(iso) {
  if (!iso) return '-';
  var d = new Date(iso);
  return d.toLocaleDateString('ar-EG', { weekday:'short', year:'numeric', month:'short', day:'numeric' }) + ' ' + d.toLocaleTimeString('ar-EG', { hour:'2-digit', minute:'2-digit' });
}

function loadSessions() {
  fetch('/api/admin/live-sessions')
    .then(function(r) { return r.json(); })
    .then(function(list) {
      sessions = list;
      var html = '';
      if (!list.length) {
        html = '<div style="text-align:center;padding:40px;color:var(--text-muted);font-size:14px;">لا توجد حصص مسجلة. اضف حصة جديدة الآن!</div>';
      } else {
        for (var i = 0; i < list.length; i++) {
          var s = list[i];
          html += '<div style="background:var(--card);border-radius:var(--radius-lg);padding:16px 20px;border:1px solid var(--border);display:flex;flex-wrap:wrap;align-items:center;gap:12px;">';
          html += '<div style="flex:1;min-width:200px;">';
          html += '<div style="font-weight:700;font-size:15px;margin-bottom:4px;">' + (s.title || 'بدون عنوان') + '</div>';
          html += '<div style="font-size:12px;color:var(--text-muted);display:flex;flex-wrap:wrap;gap:6px 14px;">';
          if (s.subject) html += '<span><i class="fas fa-book" style="color:var(--accent);"></i> ' + s.subject + '</span>';
          if (s.grade) html += '<span><i class="fas fa-layer-group" style="color:var(--accent);"></i> ' + s.grade + '</span>';
          html += '<span><i class="fas fa-calendar" style="color:var(--accent);"></i> ' + formatDate(s.startTime) + '</span>';
          html += '<span><i class="fas fa-clock" style="color:var(--accent);"></i> ' + (s.duration || '-') + ' دقيقة</span>';
          html += '</div></div>';
          html += '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">';
          html += statusBadge(s.status);
          if (s.status === 'Scheduled') {
            html += '<button class="btn btn-sm btn-primary" onclick="startSession(\'' + s.id + '\')"><i class="fas fa-play"></i></button>';
            html += '<button class="btn btn-sm btn-secondary" onclick="openEditModal(sessions.find(function(x){return x.id===\'' + s.id + '\'}))"><i class="fas fa-edit"></i></button>';
            html += '<button class="btn btn-sm btn-danger" onclick="deleteSession(\'' + s.id + '\')"><i class="fas fa-trash"></i></button>';
            html += '<button class="btn btn-sm btn-warning" onclick="cancelSession(\'' + s.id + '\')"><i class="fas fa-ban"></i></button>';
          } else if (s.status === 'Live') {
            html += '<button class="btn btn-sm btn-danger" onclick="endSession(\'' + s.id + '\')"><i class="fas fa-stop"></i></button>';
          } else {
            html += '<button class="btn btn-sm btn-danger" onclick="deleteSession(\'' + s.id + '\')"><i class="fas fa-trash"></i></button>';
          }
          html += '</div></div>';
        }
      }
      document.getElementById('sessionsList').innerHTML = html;
    })
    .catch(function() { document.getElementById('sessionsList').innerHTML = '<div style="color:var(--danger);">خطأ في تحميل الحصص</div>'; });
}

loadSessions();
</script>

<style>
.badge { display:inline-block;padding:3px 10px;border-radius:6px;font-size:11px;font-weight:700; }
.badge-success { background:#05966920;color:#059669; }
.badge-info { background:#2563eb20;color:#2563eb; }
.badge-secondary { background:#6b728020;color:#6b7280; }
.badge-danger { background:#dc262620;color:#dc2626; }
.btn-sm { padding:6px 12px;font-size:12px; }
.btn-warning { background:#f59e0b;color:#fff; }
.btn-warning:hover { background:#d97706; }
.form-input { padding:8px 12px;border:1px solid var(--border);border-radius:var(--radius);background:var(--bg);color:var(--text);font-size:13px;font-family:inherit; }
.form-input:focus { outline:none;border-color:var(--accent); }
[data-theme="dark"] .modal-overlay { background:rgba(0,0,0,0.7); }
</style>

<%- include('../partials/footer') %>
