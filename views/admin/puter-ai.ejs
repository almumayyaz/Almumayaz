<%- include('../partials/header', { title: 'مساعد الذكاء الاصطناعي', navPageTitle: 'AI Assistant', bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="main-content">
  <style>
    .ai-card {
      max-width: 900px;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .ai-header {
      background: linear-gradient(135deg, #7c3aed, #4f46e5);
      color: #fff;
      padding: 18px 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .ai-header i { font-size: 22px; }
    .ai-header h2 { margin: 0; font-size: 18px; font-weight: 700; }
    .ai-status { margin-right: auto; font-size: 12px; opacity: .85; }
    .ai-chat {
      height: 450px;
      overflow-y: auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: var(--bg);
    }
    .ai-msg {
      max-width: 75%;
      padding: 12px 16px;
      border-radius: 14px;
      font-size: 14px;
      line-height: 1.6;
      animation: ai-fade .3s ease both;
    }
    @keyframes ai-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .ai-msg-user {
      align-self: flex-start;
      background: var(--accent);
      color: #fff;
      border-bottom-left-radius: 4px;
    }
    .ai-msg-bot {
      align-self: flex-end;
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text);
      border-bottom-right-radius: 4px;
    }
    .ai-msg-bot p { margin: 0 0 8px; }
    .ai-msg-bot p:last-child { margin-bottom: 0; }
    .ai-msg-bot code {
      background: var(--bg);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 12px;
      direction: ltr;
      display: inline-block;
    }
    .ai-msg-bot pre {
      background: var(--bg);
      padding: 10px 14px;
      border-radius: 8px;
      overflow-x: auto;
      direction: ltr;
      font-size: 12px;
      margin: 8px 0;
    }
    .ai-msg-bot pre code { background: none; padding: 0; }
    .ai-typing {
      align-self: flex-end;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 12px 18px;
      border-radius: 14px;
      border-bottom-right-radius: 4px;
      display: flex;
      gap: 5px;
    }
    .ai-typing span {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--text-light);
      animation: ai-bounce 1.2s infinite;
    }
    .ai-typing span:nth-child(2) { animation-delay: .2s; }
    .ai-typing span:nth-child(3) { animation-delay: .4s; }
    @keyframes ai-bounce { 0%, 60%, 100% { transform: translateY(0); opacity: .4; } 30% { transform: translateY(-6px); opacity: 1; } }
    .ai-input-bar {
      display: flex;
      gap: 10px;
      padding: 16px 20px;
      border-top: 1px solid var(--border);
      background: var(--card);
    }
    .ai-input-bar input {
      flex: 1;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--bg);
      color: var(--text);
      font-size: 14px;
      font-family: inherit;
    }
    .ai-input-bar input:focus { outline: none; border-color: var(--accent); }
    .ai-input-bar button {
      padding: 12px 22px;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
      font-size: 14px;
      transition: transform .15s, opacity .2s;
    }
    .ai-input-bar button:hover { transform: translateY(-2px); }
    .ai-input-bar button:disabled { opacity: .5; cursor: not-allowed; }
    .ai-models {
      display: flex;
      gap: 8px;
      padding: 12px 20px;
      border-top: 1px solid var(--border);
      background: var(--card);
      flex-wrap: wrap;
    }
    .ai-model-btn {
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text-light);
      transition: all .2s;
    }
    .ai-model-btn.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .ai-empty {
      text-align: center;
      padding: 40px 20px;
      color: var(--text-light);
    }
    .ai-empty i { font-size: 42px; margin-bottom: 12px; display: block; }
  </style>

  <div class="ai-card">
    <div class="ai-header">
      <i class="fas fa-robot"></i>
      <h2>مساعد الذكاء الاصطناعي</h2>
      <span class="ai-status" id="aiStatus">غير متصل</span>
    </div>

    <div class="ai-models">
      <span class="ai-model-btn active" data-model="deepseek/deepseek-v4-pro" onclick="selectModel(this)">DeepSeek v4 Pro</span>
      <span class="ai-model-btn" data-model="gpt-4o" onclick="selectModel(this)">GPT-4o</span>
      <span class="ai-model-btn" data-model="claude-3-opus" onclick="selectModel(this)">Claude 3 Opus</span>
      <span class="ai-model-btn" data-model="gemini-1.5-flash" onclick="selectModel(this)">Gemini 1.5 Flash</span>
    </div>

    <div class="ai-chat" id="aiChat">
      <div class="ai-empty" id="aiEmpty">
        <i class="fas fa-comments"></i>
        <div>ابدأ محادثة مع الذكاء الاصطناعي</div>
        <div style="font-size:12px;margin-top:6px;opacity:.7;">اطرح أي سؤال وسيساعدك المساعد</div>
      </div>
    </div>

    <div class="ai-input-bar">
      <label style="cursor:pointer;padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;gap:6px;font-size:14px;color:var(--text-light);transition:all .2s;" title="إرفاق صورة">
        <i class="fas fa-image"></i>
        <input type="file" id="aiFileInput" accept="image/*" style="display:none;" onchange="onFilePicked(event)">
      </label>
      <div id="aiImagePreview" style="display:none;align-items:center;gap:8px;padding:6px 10px;background:var(--bg);border:1px solid var(--border);border-radius:10px;">
        <img id="aiPreviewImg" style="width:40px;height:40px;object-fit:cover;border-radius:6px;">
        <span id="aiFileName" style="font-size:12px;color:var(--text-light);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span>
        <button onclick="clearFile()" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:16px;padding:0 4px;">&times;</button>
      </div>
      <input type="text" id="aiInput" placeholder="اكتب رسالتك هنا..." onkeypress="if(event.key==='Enter')sendAI()" autocomplete="off">
      <button id="aiSendBtn" onclick="sendAI()"><i class="fas fa-paper-plane"></i> إرسال</button>
    </div>
  </div>
</main>

<script src="https://js.puter.com/v2/"></script>
<script>
  var currentModel = 'deepseek/deepseek-v4-pro';
  var isSending = false;
  var attachedImageData = null;

  function selectModel(btn) {
    document.querySelectorAll('.ai-model-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    currentModel = btn.getAttribute('data-model');
  }

  function onFilePicked(e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) { alert('الرجاء اختيار صورة فقط'); return; }
    if (file.size > 10 * 1024 * 1024) { alert('حجم الصورة كبير جداً (الحد 10MB)'); return; }
    var reader = new FileReader();
    reader.onload = function(ev) {
      attachedImageData = ev.target.result;
      var preview = document.getElementById('aiImagePreview');
      var img = document.getElementById('aiPreviewImg');
      var name = document.getElementById('aiFileName');
      img.src = attachedImageData;
      name.textContent = file.name;
      preview.style.display = 'flex';
    };
    reader.readAsDataURL(file);
  }

  function clearFile() {
    attachedImageData = null;
    var preview = document.getElementById('aiImagePreview');
    preview.style.display = 'none';
    var input = document.getElementById('aiFileInput');
    if (input) input.value = '';
  }

  function formatResponse(text) {
    var esc = String(text).replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>');
    esc = esc.replace(/```([\s\S]*?)```/g, function(m, code) {
      return '<pre><code>' + code.trim() + '</code></pre>';
    });
    esc = esc.replace(/`([^`]+)`/g, '<code>$1</code>');
    esc = esc.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    esc = esc.replace(/\n/g, '<br>');
    return esc;
  }

  function sendAI() {
    var input = document.getElementById('aiInput');
    var chat = document.getElementById('aiChat');
    var btn = document.getElementById('aiSendBtn');
    var empty = document.getElementById('aiEmpty');
    if (empty) empty.style.display = 'none';
    
    var msg = input.value.trim();
    if ((!msg && !attachedImageData) || isSending) return;
    if (typeof puter === 'undefined' || !puter.ai || !puter.ai.chat) {
      chat.innerHTML += '<div class="ai-msg ai-msg-bot" style="color:var(--danger);">مكتبة Puter غير محملة. تأكد من اتصال الإنترنت.</div>';
      chat.scrollTop = chat.scrollHeight;
      return;
    }

    isSending = true;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    var displayMsg = msg || '(صورة)';
    var msgHtml = String(displayMsg).replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>');
    if (attachedImageData) {
      msgHtml = '<img src="' + attachedImageData + '" style="max-width:200px;max-height:150px;border-radius:8px;display:block;margin-bottom:6px;">' + msgHtml;
    }
    chat.innerHTML += '<div class="ai-msg ai-msg-user">' + msgHtml + '</div>';
    input.value = '';
    chat.innerHTML += '<div class="ai-typing" id="aiTyping"><span></span><span></span><span></span></div>';
    chat.scrollTop = chat.scrollHeight;

    var chatInput = msg || 'صف هذه الصورة بالتفصيل';
    var chatPromise;
    if (attachedImageData) {
      chatPromise = puter.ai.chat(chatInput, { model: currentModel, image: attachedImageData });
    } else {
      chatPromise = puter.ai.chat(chatInput, { model: currentModel });
    }
    chatPromise
      .then(function(response) {
        var typing = document.getElementById('aiTyping');
        if (typing) typing.remove();
        var text = '';
        if (typeof response === 'string') {
          text = response;
        } else if (response.text) {
          text = response.text;
        } else if (response.message && typeof response.message === 'string') {
          text = response.message;
        } else if (response.message && response.message.content) {
          text = response.message.content;
        } else if (response.response) {
          text = response.response;
        } else if (response.choices && response.choices[0]) {
          text = response.choices[0].text || response.choices[0].message.content || '';
        } else {
          try { text = JSON.stringify(response); } catch(e) { text = String(response); }
        }
        chat.innerHTML += '<div class="ai-msg ai-msg-bot">' + formatResponse(text) + '</div>';
        chat.scrollTop = chat.scrollHeight;
        clearFile();
      })
      .catch(function(err) {
        var typing = document.getElementById('aiTyping');
        if (typing) typing.remove();
        var errMsg = err.message || err.toString();
        chat.innerHTML += '<div class="ai-msg ai-msg-bot" style="color:var(--danger);">خطأ: ' + escHtml(errMsg) + '</div>';
        chat.scrollTop = chat.scrollHeight;
      })
      .finally(function() {
        isSending = false;
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال';
      });
  }

  function escHtml(t) {
    return String(t).replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>');
  }

  window.addEventListener('load', function() {
    var status = document.getElementById('aiStatus');
    if (typeof puter !== 'undefined' && puter.ai && puter.ai.chat) {
      status.textContent = 'متصل ✓';
      status.style.color = '#86efac';
    } else {
      status.textContent = 'غير متصل';
      status.style.color = '#fca5a5';
    }
  });
</script>
<%- include('../partials/footer') %>
