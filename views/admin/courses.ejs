function saveCourseReviewQuiz() {
  var reviewId = document.getElementById('crqReviewId').value;
  var title = document.getElementById('crqTitle').value;
  var blocks = document.querySelectorAll('#crqQuestionsContainer .question-block');
  var questions = [];
  blocks.forEach(function(b) {
    var q = b.querySelector('.crq-text').value;
    var opts = [0,1,2,3].map(function(i){ return b.querySelector('.crq-opt-' + i).value; });
    var c = parseInt(b.querySelector('.crq-correct').value) || 0;
    var wm = b.querySelector('.crq-wrong-msg').value;
    if (q && opts.some(function(o){ return o; })) questions.push({ question: q, options: opts, correct: c, wrongAnswerMessage: wm });
  });
  var timerMinutes = document.getElementById('crqTimerEnabled').checked ? (parseInt(document.getElementById('crqTimer').value) || null) : null;
  fetch('/api/admin/reviews/' + reviewId + '/quiz', {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ title: title, questions: questions, timerMinutes: timerMinutes })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

// ===== QUESTION BANKS CRUD =====
function openQuestionBankModal(courseId, bank) {
  document.getElementById('questionBankModalTitle').textContent = bank ? 'تعديل بنك الأسئلة' : 'إضافة بنك أسئلة';
  document.getElementById('qbId').value = bank ? bank.id : '';
  document.getElementById('qbCourseId').value = courseId;
  document.getElementById('qbTitle').value = bank ? bank.title : '';
  document.getElementById('qbDescription').value = bank ? (bank.description || '') : '';
  document.getElementById('qbTimer').value = bank ? (bank.timerMinutes || '') : '';
  var hasTimer = bank && bank.timerMinutes;
  document.getElementById('qbTimerEnabled').checked = !!hasTimer;
  document.getElementById('qbTimer').style.display = hasTimer ? '' : 'none';
  var container = document.getElementById('qbQuestionsContainer');
  var existing = container.querySelectorAll('.question-block');
  existing.forEach(function(el){ el.remove(); });
  if (bank && bank.questions) {
    bank.questions.forEach(function(q, i){ addQbQuestion(q, i); });
  }
  document.getElementById('qbuWordFilePopup').value = '';
  document.getElementById('questionBankModal').classList.add('show');
}
function addQbQuestion(q, idx) {
  var container = document.getElementById('qbQuestionsContainer');
  var div = document.createElement('div');
  div.className = 'question-block';
  div.style.cssText = 'background:var(--bg);border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid var(--border);';
  var qi = idx !== undefined ? idx : container.querySelectorAll('.question-block').length;
  div.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><strong style="color:var(--primary);">السؤال ' + (qi + 1) + '</strong><button class="btn btn-sm" style="background:#ef4444;color:#fff;font-size:11px;padding:4px 10px;" onclick="this.closest(\'.question-block\').remove()">حذف</button></div><div class="form-group"><input class="qbq-text" placeholder="نص السؤال" value="' + escAttr(q ? q.question : '') + '"></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">' + ['أ','ب','ج','د'].map(function(letter, oi){ return '<div class="form-group" style="margin-bottom:4px;"><label style="font-size:11px;margin-bottom:2px;">الخيار ' + letter + '</label><input class="qbq-opt-' + oi + '" placeholder="الخيار ' + letter + '" value="' + escAttr(q && q.options && q.options[oi] ? q.options[oi] : '') + '"></div>'; }).join('') + '</div><div class="form-group" style="margin-bottom:0;"><label style="font-size:12px;">الإجابة الصحيحة</label><select class="qbq-correct" style="width:80px;padding:6px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;">' + ['أ','ب','ج','د'].map(function(letter, oi){ return '<option value="' + oi + '"' + ((q ? q.correct + '' : '0') === '' + oi ? ' selected' : '') + '>' + letter + '</option>'; }).join('') + '</select></div><div class="form-group" style="margin-bottom:0;margin-top:8px;"><label style="font-size:12px;">الرسالة عند الإجابة الخاطئة (اختياري)</label><textarea class="qbq-wrong-msg" placeholder="رسالة تظهر للطالب عند اختيار إجابة خاطئة" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:12px;resize:vertical;" rows="2">' + escAttr(q && q.wrongAnswerMessage ? q.wrongAnswerMessage : '') + '</textarea></div>';
  container.appendChild(div);
}
function saveQuestionBank() {
  var id = document.getElementById('qbId').value;
  var courseId = document.getElementById('qbCourseId').value;
  var blocks = document.querySelectorAll('#qbQuestionsContainer .question-block');
  var questions = [];
  blocks.forEach(function(b) {
    var q = b.querySelector('.qbq-text').value;
    var opts = [0,1,2,3].map(function(i){ return b.querySelector('.qbq-opt-' + i).value; });
    var c = parseInt(b.querySelector('.qbq-correct').value) || 0;
    var wm = b.querySelector('.qbq-wrong-msg').value;
    if (q && opts.some(function(o){ return o; })) questions.push({ question: q, options: opts, correct: c, wrongAnswerMessage: wm });
  });
  var data = {
    courseId: courseId,
    title: document.getElementById('qbTitle').value,
    description: document.getElementById('qbDescription').value,
    timerMinutes: document.getElementById('qbTimerEnabled').checked ? (parseInt(document.getElementById('qbTimer').value) || null) : null,
    order: 0,
    questions: questions
  };
  var url = id ? '/api/admin/question-banks/' + id : '/api/admin/question-banks';
  var method = id ? 'PUT' : 'POST';
  fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
function deleteQuestionBank(id) {
  if (!confirm('هل أنت متأكد من حذف بنك الأسئلة هذا؟')) return;
  fetch('/api/admin/question-banks/' + id, { method: 'DELETE' })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
function toggleQbWordUpload() {
  document.getElementById('qbuWordFilePopup').value = '';
  document.getElementById('qbuWordUploadModal').classList.add('show');
}
function extractQbQuestionsFromPopup() {
  var btn = document.querySelector('#qbuWordUploadModal .modal-body button');
  var fileInput = document.getElementById('qbuWordFilePopup');
  if (!fileInput.files || !fileInput.files[0]) { alert('يرجى اختيار ملف Word أولاً'); return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الاستخراج...';
  var formData = new FormData();
  formData.append('file', fileInput.files[0]);
  fetch('/api/admin/upload-word-file', {
    method: 'POST',
    body: formData
  }).then(function(r){ return r.json(); }).then(function(d){
    if (d.success && d.questions) {
      d.questions.forEach(function(q){ addQbQuestion(q); });
      closeModal('qbuWordUploadModal');
      fileInput.value = '';
      alert('تم استخراج ' + d.questions.length + ' سؤال');
    } else {
      alert(d.error || 'فشل استخراج الأسئلة');
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-magic"></i> استخراج';
    }
  }).catch(function(){
    alert('فشل الاتصال بالخادم');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-magic"></i> استخراج';
  });
}

