<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<script src="/js/pdf-upload.js"></script>
<main class="admin-content">
<style>
/* ===== MODERN COURSES UI ===== */
:root{--card-radius:20px;--card-shadow:0 1px 3px rgba(0,0,0,.04),0 5px 20px rgba(0,0,0,.04);--card-shadow-hover:0 8px 32px rgba(0,0,0,.08);--transition-smooth:all 0.25s cubic-bezier(.22,1,.36,1)}
.page-header{text-align:center;margin-bottom:28px}
.page-header h1{font-size:28px;font-weight:800;font-family:'Aref Ruqaa',serif;color:var(--text);margin:0}
.page-header p{font-size:14px;color:var(--text-muted);margin:4px 0 0}
/* ===== BACK LINK ===== */
.back-link{display:inline-flex;align-items:center;gap:6px;color:var(--text-light);text-decoration:none;font-size:13px;padding:8px 14px;border-radius:10px;transition:var(--transition-smooth);margin-bottom:16px}
.back-link:hover{background:var(--accent-glow);color:var(--accent)}
/* ===== STAGE SELECTION ===== */
.stage-grid-modern{display:flex;flex-wrap:wrap;gap:24px;justify-content:center;padding:0 4px;margin-bottom:16px}
.stage-card-modern{display:flex;flex-direction:column;text-decoration:none;background:var(--card);border:1px solid var(--border);border-radius:24px;overflow:hidden;transition:var(--transition-smooth);flex:1;min-width:260px;max-width:380px;position:relative}
.stage-card-modern:hover{transform:translateY(-6px);box-shadow:0 24px 60px -12px rgba(0,0,0,.12);border-color:var(--accent)}
.stage-card-modern .sc-head{padding:36px 28px 20px;display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
.stage-card-modern .sc-icon-wrap{width:80px;height:80px;border-radius:24px;display:flex;align-items:center;justify-content:center;font-size:32px;color:#fff;transition:var(--transition-smooth)}
.stage-card-modern:hover .sc-icon-wrap{transform:scale(1.08)}
.stage-card-modern .sc-title{font-size:24px;font-weight:700;font-family:'Aref Ruqaa',serif;color:var(--text);margin:0}
.stage-card-modern .sc-desc{font-size:13px;color:var(--text-light);margin:0;line-height:1.6}
.stage-card-modern .sc-action{display:flex;align-items:center;justify-content:center;gap:8px;padding:18px 28px;font-size:14px;font-weight:700;color:#fff;border:none;cursor:pointer;transition:var(--transition-smooth);margin:0;text-decoration:none}
.stage-card-modern:hover .sc-action i{transform:translateX(4px)}
/* ===== GRADE SELECTION ===== */
.grade-wrap-modern{background:var(--card);border-radius:24px;padding:32px 28px;border:1px solid var(--border);box-shadow:var(--card-shadow);margin-bottom:24px}
.grade-head-modern{display:flex;align-items:center;gap:12px;margin-bottom:24px;justify-content:center}
.grade-head-icon{width:48px;height:48px;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;box-shadow:0 4px 16px color-mix(in srgb,var(--primary) 30%,transparent)}
.grade-head-title{font-size:22px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;color:var(--text)}
.grade-grid-modern{display:flex;flex-wrap:wrap;gap:16px;justify-content:center}
.grade-card-modern{display:flex;align-items:center;gap:14px;text-decoration:none;padding:18px 22px;background:var(--bg);border-radius:18px;border:2px solid var(--border);transition:var(--transition-smooth);flex:1;min-width:180px;max-width:260px;position:relative;overflow:hidden}
.grade-card-modern::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--accent-light));opacity:0;transition:opacity .35s}
.grade-card-modern:hover::before{opacity:1}
.grade-card-modern:hover{transform:translateY(-4px);box-shadow:0 12px 36px rgba(0,0,0,.08);border-color:var(--accent)}
.grade-card-num{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;flex-shrink:0}
.grade-card-body{min-width:0}
.grade-card-name{font-size:15px;font-weight:700;color:var(--text)}
.grade-card-stats{font-size:12px;color:var(--text-muted);margin-top:2px}
/* ===== COURSE TOOLBAR ===== */
.course-toolbar{display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap;padding:16px 20px;background:var(--card);border:1px solid var(--border);border-radius:var(--card-radius)}
.course-toolbar-info{display:flex;align-items:center;gap:12px;flex:1}
.course-toolbar-icon{width:42px;height:42px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;flex-shrink:0}
.course-toolbar-text h2{font-size:17px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;color:var(--text)}
.course-toolbar-text p{font-size:12px;color:var(--text-light);margin:2px 0 0}
.course-toolbar-actions{display:flex;gap:8px;align-items:center}
/* ===== COURSE LIST ===== */
.course-list{display:flex;flex-direction:column;gap:16px}
.course-card{background:var(--card);border:1px solid var(--border);border-radius:var(--card-radius);overflow:hidden;transition:var(--transition-smooth)}
.course-card:hover{box-shadow:var(--card-shadow-hover)}
.course-card-header{display:flex;align-items:center;gap:14px;padding:18px 20px;cursor:pointer;transition:var(--transition-smooth);user-select:none;position:relative}
.course-card-header:hover{background:var(--accent-glow)}
.course-card-header::after{content:'';position:absolute;bottom:0;left:20px;right:20px;height:1px;background:var(--border);opacity:0;transition:opacity .3s}
.course-card.expanded .course-card-header::after{opacity:1}
.course-card-icon{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;flex-shrink:0;transition:var(--transition-smooth)}
.course-card.expanded .course-card-icon{transform:scale(1.05)}
.course-card-info{flex:1;min-width:0}
.course-card-title{font-size:15px;font-weight:700;color:var(--text)}
.course-card-meta{display:flex;align-items:center;gap:10px;margin-top:3px;flex-wrap:wrap}
.course-card-meta span{font-size:11px;color:var(--text-light);display:flex;align-items:center;gap:4px}
.course-card-grade{background:var(--accent-glow);color:var(--accent);font-size:10px;padding:2px 10px;border-radius:8px;font-weight:600}
.course-card-actions{display:flex;gap:4px;flex-shrink:0}
.course-card-actions button{width:32px;height:32px;border:none;border-radius:10px;background:transparent;color:var(--text-muted);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--transition-smooth);font-size:14px}
.course-card-actions button:hover{background:var(--bg);color:var(--text)}
.course-card-actions .edit-btn:hover{color:var(--accent);background:var(--accent-glow)}
.course-card-actions .delete-btn:hover{color:var(--danger);background:rgba(239,68,68,0.1)}
.course-card-actions .toggle-btn{transition:transform .3s}
.course-card.expanded .course-card-actions .toggle-btn{transform:rotate(180deg)}
/* ===== COURSE BODY (inside expanded card) ===== */
.course-body{padding:0;border-top:1px solid var(--border)}
/* ===== MODERN TABS ===== */
.modern-tabs{display:flex;gap:4px;padding:4px 16px;background:var(--bg);overflow-x:auto}
.modern-tab{padding:10px 18px;border:none;border-radius:10px;background:transparent;color:var(--text-muted);cursor:pointer;font-size:12px;font-weight:600;transition:var(--transition-smooth);white-space:nowrap;display:flex;align-items:center;gap:6px;font-family:inherit}
.modern-tab:hover{color:var(--text);background:var(--card)}
.modern-tab.active{background:var(--card);color:var(--accent);box-shadow:0 1px 4px rgba(0,0,0,.06)}
/* ===== TAB CONTENT ===== */
.tab-content{padding:16px 20px}
.tab-toolbar{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.tab-toolbar .btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border:none;border-radius:10px;font-size:12px;font-weight:600;cursor:pointer;transition:var(--transition-smooth);font-family:inherit}
.tab-toolbar .btn-primary{background:linear-gradient(135deg,var(--primary),var(--accent-hover));color:#fff}
.tab-toolbar .btn-primary:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(162,114,0,.25)}
.tab-toolbar .btn-outline{background:transparent;color:var(--accent);border:1px solid var(--accent)}
.tab-toolbar .btn-outline:hover{background:var(--accent-glow)}
/* ===== SECTION CHIPS ===== */
.section-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;padding:10px 14px;background:var(--accent-glow);border-radius:12px}
.section-chips-label{font-size:12px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:6px;margin-left:8px}
.section-chip{background:var(--card);padding:4px 12px;border-radius:8px;font-size:11px;display:flex;align-items:center;gap:6px;border:1px solid var(--border)}
.section-chip span{color:var(--text-light);font-size:10px}
/* ===== LESSON CARDS ===== */
.lesson-cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.lesson-card-item{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px 16px;transition:var(--transition-smooth);position:relative}
.lesson-card-item:hover{border-color:var(--accent-light);box-shadow:var(--card-shadow-hover)}
.lesson-card-item::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--accent-light));opacity:0;transition:opacity .3s;border-radius:14px 14px 0 0}
.lesson-card-item:hover::before{opacity:1}
.lesson-card-item-header{display:flex;align-items:flex-start;gap:10px}
.lesson-card-item-num{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,var(--primary),var(--accent-light));color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.lesson-card-item-info{flex:1;min-width:0}
.lesson-card-item-title{font-size:13px;font-weight:700;color:var(--text)}
.lesson-card-item-desc{font-size:11px;color:var(--text-light);margin-top:2px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.lesson-card-item-badges{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px}
.lesson-card-item-badge{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:6px;font-size:9px;font-weight:700}
.lesson-card-item-badge.free{background:rgba(22,163,74,0.12);color:var(--success)}
.lesson-card-item-badge.paid{background:rgba(245,158,11,0.12);color:#d97706}
.lesson-card-item-badge.guest{background:rgba(99,102,241,0.12);color:#6366f1}
.lesson-card-item-badge.video{background:rgba(59,130,246,0.12);color:#3b82f6}
.lesson-card-item-badge.pdf{background:rgba(239,68,68,0.12);color:var(--danger)}
.lesson-card-item-badge.quiz{background:rgba(139,92,246,0.12);color:#8b5cf6}
.lesson-card-item-actions{display:flex;gap:2px;justify-content:flex-end;margin-top:8px;padding-top:8px;border-top:1px solid var(--border)}
.lesson-card-item-actions button{width:28px;height:28px;border:none;border-radius:7px;background:transparent;color:var(--text-muted);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--transition-smooth);font-size:12px}
.lesson-card-item-actions button:hover{background:var(--bg);color:var(--text)}
.lesson-card-item-actions .la-edit:hover{color:#3b82f6;background:rgba(59,130,246,0.12)}
.lesson-card-item-actions .la-delete:hover{color:var(--danger);background:rgba(239,68,68,0.12)}
/* ===== VIDEO/PDF LINKS INSIDE LESSON ===== */
.lesson-media-links{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.lesson-media-link{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:6px;font-size:10px;text-decoration:none;transition:var(--transition-smooth)}
.lesson-media-link.video-link{background:rgba(59,130,246,0.1);color:#3b82f6}
.lesson-media-link.pdf-link{background:rgba(239,68,68,0.1);color:var(--danger)}
.lesson-media-link:hover{transform:translateY(-1px)}
/* ===== INFO CARDS FOR SECTIONS/REVIEWS/QBANKS ===== */
.info-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.info-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px 16px;transition:var(--transition-smooth)}
.info-card:hover{border-color:var(--accent-light);box-shadow:var(--card-shadow-hover)}
.info-card-header{display:flex;align-items:flex-start;gap:10px}
.info-card-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;flex-shrink:0}
.info-card-body{flex:1;min-width:0}
.info-card-title{font-size:13px;font-weight:700;color:var(--text)}
.info-card-desc{font-size:11px;color:var(--text-light);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px}
.info-card-meta{display:flex;gap:8px;margin-top:6px;flex-wrap:wrap}
.info-card-meta span{font-size:10px;color:var(--text-light);display:flex;align-items:center;gap:3px}
.info-card-actions{display:flex;gap:4px;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);justify-content:flex-end}
.info-card-actions button{width:28px;height:28px;border:none;border-radius:7px;background:transparent;color:var(--text-muted);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--transition-smooth);font-size:12px}
.info-card-actions button:hover{background:var(--bg);color:var(--text)}
.info-card-actions .ica-edit:hover{color:var(--accent);background:var(--accent-glow)}
.info-card-actions .ica-delete:hover{color:var(--danger);background:rgba(239,68,68,0.1)}
.info-card-actions .ica-quiz:hover{color:#8b5cf6;background:rgba(139,92,246,0.1)}
/* ===== EMPTY STATE ===== */
.empty-state-modern{text-align:center;padding:50px 20px;background:var(--card);border-radius:var(--card-radius);border:1px solid var(--border)}
.empty-state-modern i{font-size:44px;color:var(--border);display:block;margin-bottom:14px}
.empty-state-modern h3{font-size:17px;color:var(--text-light);margin-bottom:6px}
.empty-state-modern p{color:var(--text-muted);font-size:13px;margin-bottom:14px}
/* ===== SECTION LIST IN MODAL ===== */
.section-block{background:var(--bg);border-radius:10px;padding:12px 16px;margin-bottom:8px;border:1px solid var(--border);display:flex;align-items:center;gap:10px}
/* ===== ANIMATIONS ===== */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
/* ===== RESPONSIVE ===== */
@media(max-width:768px){.stage-grid-modern{flex-direction:column;align-items:stretch}.stage-card-modern{max-width:100%}.grade-grid-modern{flex-direction:column}.grade-card-modern{max-width:100%}.course-toolbar{flex-direction:column;align-items:stretch}.course-toolbar-actions{justify-content:space-between}.lesson-cards-grid{grid-template-columns:1fr}.info-grid{grid-template-columns:1fr}.modern-tabs{overflow-x:auto}}
@media(max-width:480px){.course-card-header{flex-wrap:wrap;gap:10px}.course-card-actions{margin-right:auto}.tab-content{padding:12px 14px}}
</style>

<% if (!stage) { %>
  <!-- ===== STEP 1: Select Stage ===== -->
  <div class="page-header">
    <h1>المحتوى التعليمي</h1>
    <p>إدارة المحاضرات والدروس حسب المرحلة والصف</p>
  </div>
  <% var prepCourses = (allCourses || []).filter(function(c){return c.stage==='إعدادية';}); %>
  <% var secCourses = (allCourses || []).filter(function(c){return c.stage==='ثانوية';}); %>
  <div class="stage-grid-modern">
    <a href="/admin/courses?stage=%D8%A5%D8%B9%D8%AF%D8%A7%D8%AF%D9%8A%D8%A9" class="stage-card-modern">
      <div class="sc-head">
        <div class="sc-icon-wrap" style="background:linear-gradient(135deg,#059669,#34d399);box-shadow:0 8px 24px rgba(5,150,105,0.25);">
          <i class="fas fa-school"></i>
        </div>
        <h2 class="sc-title">المرحلة الإعدادية</h2>
        <p class="sc-desc"><%= prepCourses.reduce(function(a,c){return a+(c.lessons||[]).length;},0) %> محاضرة — <%= prepCourses.length %> فرع</p>
      </div>
      <div class="sc-action" style="background:linear-gradient(135deg,#059669,#34d399);">
        <span>إدارة المرحلة</span>
        <i class="fas fa-arrow-left"></i>
      </div>
    </a>
    <a href="/admin/courses?stage=%D8%AB%D8%A7%D9%86%D9%88%D9%8A%D8%A9" class="stage-card-modern">
      <div class="sc-head">
        <div class="sc-icon-wrap" style="background:linear-gradient(135deg,#A07200,#F6C453);box-shadow:0 8px 24px rgba(160,114,0,0.25);">
          <i class="fas fa-graduation-cap"></i>
        </div>
        <h2 class="sc-title">المرحلة الثانوية</h2>
        <p class="sc-desc"><%= secCourses.reduce(function(a,c){return a+(c.lessons||[]).length;},0) %> محاضرة — <%= secCourses.length %> فرع</p>
      </div>
      <div class="sc-action" style="background:linear-gradient(135deg,#A07200,#F6C453);">
        <span>إدارة المرحلة</span>
        <i class="fas fa-arrow-left"></i>
      </div>
    </a>
  </div>

<% } else if (!grade) { %>
  <!-- ===== STEP 2: Select Grade ===== -->
  <div class="page-header">
    <h1><%= stage === 'إعدادية' ? 'المرحلة الإعدادية' : 'المرحلة الثانوية' %></h1>
    <p>اختر الصف لإدارة المحتوى</p>
  </div>
  <a href="/admin/courses" class="back-link"><i class="fas fa-arrow-right"></i> العودة لاختيار المرحلة</a>
  <div class="grade-wrap-modern">
    <div class="grade-head-modern">
      <div class="grade-head-icon" style="background:<%= stage === 'إعدادية' ? 'linear-gradient(135deg,#059669,#34d399)' : 'linear-gradient(135deg,#A07200,#F6C453)' %>;">
        <i class="fas <%= stage === 'إعدادية' ? 'fa-school' : 'fa-graduation-cap' %>"></i>
      </div>
      <h2 class="grade-head-title"><%= stage === 'إعدادية' ? 'المرحلة الإعدادية' : 'المرحلة الثانوية' %></h2>
    </div>
    <div class="grade-grid-modern">
      <% var grades = stage === 'إعدادية' ? ['الأول الإعدادي','الثاني الإعدادي','الثالث الإعدادي'] : ['الأول الثانوي','الثاني الثانوي','الثالث الثانوي']; %>
      <% grades.forEach(function(g) { 
        var gradeCourses = allCourses.filter(function(c){return c.stage===stage && c.grade===g;});
        var count = gradeCourses.length;
        var lessonCount = gradeCourses.reduce(function(sum, c){ return sum + (c.lessons||[]).length; }, 0);
        var encodedStage = encodeURIComponent(stage);
        var encodedGrade = encodeURIComponent(g);
        var shortName = g.split(' ')[0];
        var gradePart = g.split(' ').slice(1).join(' ');
      %>
      <a href="/admin/courses?stage=<%= encodedStage %>&grade=<%= encodedGrade %>" class="grade-card-modern">
        <div class="grade-card-num" style="background:linear-gradient(135deg,var(--primary),var(--accent-light));"><%= shortName %></div>
        <div class="grade-card-body">
          <div class="grade-card-name"><%= gradePart %></div>
          <div class="grade-card-stats"><%= lessonCount %> محاضرة — <%= count %> فرع</div>
        </div>
      </a>
      <% }) %>
    </div>
  </div>

<% } else { %>
  <!-- ===== STEP 3: Course Management ===== -->
  <div class="course-toolbar">
    <div class="course-toolbar-info">
      <a href="/admin/courses" class="back-link" style="margin:0;padding:0;font-size:13px;"><i class="fas fa-arrow-right"></i> المراحل</a>
      <% if (stage !== 'all') { %>
      <span style="color:var(--text-muted);font-size:11px;">/</span>
      <a href="/admin/courses?stage=<%= encodeURIComponent(stage) %>" style="color:var(--text-light);text-decoration:none;font-size:13px;"><%= stage === 'إعدادية' ? 'إعدادية' : 'ثانوية' %></a>
      <span style="color:var(--text-muted);font-size:11px;">/</span>
      <span style="color:var(--accent);font-size:13px;font-weight:600;"><%= grade %></span>
      <% } %>
    </div>
    <div class="course-toolbar-actions">
      <button class="btn btn-sm" style="font-size:11px;color:var(--danger);border:1px solid var(--danger);background:transparent;padding:8px 12px;border-radius:10px;cursor:pointer;transition:var(--transition-smooth);font-family:inherit;" onclick="migrateSeed()" title="فرض ترحيل كل المحتوى"><i class="fas fa-database"></i></button>
      <button class="btn btn-sm" style="background:linear-gradient(135deg,var(--primary),var(--accent-hover));color:#fff;border:none;padding:8px 16px;border-radius:10px;cursor:pointer;font-weight:600;font-size:12px;transition:var(--transition-smooth);font-family:inherit;display:inline-flex;align-items:center;gap:6px;" onclick="openCourseModal()"><i class="fas fa-plus"></i> إضافة فرع</button>
    </div>
  </div>

  <div id="coursesContainer" class="course-list">
    <% if (courses.length === 0) { %>
    <div class="empty-state-modern">
      <i class="fas fa-folder-open"></i>
      <h3>لا توجد فروع بعد</h3>
      <p><%= stage === 'all' ? 'لم يتم إضافة أي محتوى بعد' : 'أضف أول فرع للصف <strong>' + grade + '</strong>' %></p>
      <button class="btn btn-sm" style="background:linear-gradient(135deg,var(--primary),var(--accent-hover));color:#fff;border:none;padding:10px 20px;border-radius:12px;cursor:pointer;font-weight:600;font-size:13px;font-family:inherit;" onclick="openCourseModal()"><i class="fas fa-plus"></i> إضافة فرع</button>
    </div>
    <% } %>
    <% courses.forEach(function(course, ci) { %>
    <div class="course-card" id="courseCard-<%= course.id %>">
      <div class="course-card-header" onclick="toggleCourse('<%= course.id %>')">
        <div class="course-card-icon" style="background:<%= course.color %>;">
          <i class="fas <%= course.icon %>"></i>
        </div>
        <div class="course-card-info">
          <div class="course-card-title"><%= course.title %></div>
          <div class="course-card-meta">
            <span><i class="fas fa-video"></i> <%= (course.lessons||[]).length %> درس</span>
            <span><i class="fas fa-layer-group"></i> <%= (course.sections||[]).length %> <%= stage === 'إعدادية' ? 'وحدة' : 'باب' %></span>
            <% if (course.grade) { %><span class="course-card-grade"><%= course.grade %></span><% } %>
          </div>
        </div>
        <div class="course-card-actions">
          <button class="edit-btn" onclick="event.stopPropagation();expandCourse('<%= course.id %>'); openCourseModal(<%= JSON.stringify(course) %>)" title="تعديل الفرع"><i class="fas fa-edit"></i></button>
          <button class="delete-btn" onclick="event.stopPropagation();deleteCourse('<%= course.id %>')" title="حذف"><i class="fas fa-trash"></i></button>
          <button class="toggle-btn" onclick="event.stopPropagation();toggleCourse('<%= course.id %>')" title="عرض المحتوى"><i class="fas fa-chevron-down" id="courseCaret-<%= course.id %>"></i></button>
        </div>
      </div>

      <div class="course-body" id="courseBody-<%= course.id %>" style="display:none;">
        <!-- Modern Tabs -->
        <div class="modern-tabs">
          <button class="modern-tab active" data-course="<%= course.id %>" data-tab="lessons" onclick="switchCourseTab('<%= course.id %>','lessons')"><i class="fas fa-video"></i> الدروس</button>
          <button class="modern-tab" data-course="<%= course.id %>" data-tab="notes" onclick="switchCourseTab('<%= course.id %>','notes')"><i class="fas fa-sticky-note"></i> المذكرات</button>
          <button class="modern-tab" data-course="<%= course.id %>" data-tab="reviews" onclick="switchCourseTab('<%= course.id %>','reviews')"><i class="fas fa-star"></i> المراجعات</button>
          <button class="modern-tab" data-course="<%= course.id %>" data-tab="questionbanks" onclick="switchCourseTab('<%= course.id %>','questionbanks')"><i class="fas fa-question-circle"></i> بنوك الأسئلة</button>
          <button class="modern-tab" data-course="<%= course.id %>" data-tab="quiz" onclick="switchCourseTab('<%= course.id %>','quiz')"><i class="fas fa-tasks"></i> الاختبار الشامل</button>
        </div>

        <!-- Tab: Lessons -->
        <div class="tab-panel" id="tab-lessons-<%= course.id %>">
          <div class="tab-content">
            <div class="tab-toolbar">
              <% if (course.sections && course.sections.length > 0) { %>
              <button class="btn btn-outline" onclick='openSectionModal(<%= JSON.stringify(course) %>)'><i class="fas fa-cog"></i> إدارة <%= stage === 'إعدادية' ? 'الوحدات' : 'الأبواب' %></button>
              <% } else { %>
              <button class="btn btn-outline" onclick='openSectionModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة <%= stage === 'إعدادية' ? 'وحدات' : 'أبواب' %></button>
              <% } %>
              <button class="btn btn-primary" onclick='openLessonModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة درس</button>
              <% if (course.quiz) { %>
              <button class="btn btn-outline" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-tasks"></i> إدارة الاختبار</button>
              <% } else { %>
              <button class="btn btn-outline" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> اختبار شامل</button>
              <% } %>
            </div>

            <% if (course.sections && course.sections.length > 0) { %>
            <div class="section-chips">
              <span class="section-chips-label"><i class="fas fa-sitemap"></i> <%= stage === 'إعدادية' ? 'الوحدات' : 'الأبواب' %>:</span>
              <% (course.sections||[]).forEach(function(section) { %>
              <span class="section-chip"><%= section.name %> <span>(<%= (section.lessons||[]).length %>)</span></span>
              <% }) %>
            </div>
            <% } %>

            <% if ((course.lessons||[]).length > 0) { %>
            <div class="lesson-cards-grid">
              <% (course.lessons||[]).forEach(function(l, li) { %>
              <div class="lesson-card-item">
                <div class="lesson-card-item-header">
                  <div class="lesson-card-item-num"><%= li + 1 %></div>
                  <div class="lesson-card-item-info">
                    <div class="lesson-card-item-title"><%= l.title %></div>
                    <% if (l.description) { %><div class="lesson-card-item-desc"><%= l.description %></div><% } %>
                    <div class="lesson-card-item-badges">
                      <span class="lesson-card-item-badge <%= l.isFree ? 'free' : 'paid' %>"><%= l.isFree ? 'مجاني' : 'مدفوع' %></span>
                      <% if (l.guestVisible) { %><span class="lesson-card-item-badge guest">زائر</span><% } %>
                      <% if (l.videos && l.videos.length > 0) { %><span class="lesson-card-item-badge video"><i class="fas fa-video"></i> <%= l.videos.length %></span><% } %>
                      <% if (l.pdfFiles && l.pdfFiles.length > 0) { %><span class="lesson-card-item-badge pdf"><i class="fas fa-file-pdf"></i></span><% } %>
                      <% if (l.quiz && l.quiz.enabled && l.quiz.questions && l.quiz.questions.length > 0) { %><span class="lesson-card-item-badge quiz"><i class="fas fa-tasks"></i></span><% } %>
                    </div>
                    <% if (l.videos && l.videos.length > 0) { %>
                    <div class="lesson-media-links">
                      <% l.videos.forEach(function(v) { %>
                      <a href="<%= v.url %>" target="_blank" class="lesson-media-link video-link"><i class="fas fa-video"></i> <%= v.title %></a>
                      <% }) %>
                    </div>
                    <% } %>
                    <% if (l.pdfFiles && l.pdfFiles.length > 0) { %>
                    <div class="lesson-media-links">
                      <% l.pdfFiles.forEach(function(p) { %>
                      <a href="<%= p.url %>" target="_blank" class="lesson-media-link pdf-link"><i class="fas fa-file-pdf"></i> <%= p.title %></a>
                      <% }) %>
                    </div>
                    <% } %>
                    <% if (l.sectionId) { %>
                    <div style="font-size:10px;color:var(--text-muted);margin-top:4px;"><i class="fas fa-folder"></i> <%= (function(){ var s = (course.sections || []).find(function(sec){ return sec.id === l.sectionId; }); return s ? s.name : ''; })() %></div>
                    <% } %>
                  </div>
                </div>
                <div class="lesson-card-item-actions">
                  <button class="la-edit" onclick='openLessonModal(<%= JSON.stringify(course) %>, <%= JSON.stringify(l) %>)' title="تعديل"><i class="fas fa-edit"></i></button>
                  <button class="la-delete" onclick="deleteLesson('<%= course.id %>','<%= l.id %>')" title="حذف"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state-modern">
              <i class="fas fa-video-slash"></i>
              <h3>لا توجد دروس بعد</h3>
              <button class="btn btn-sm" style="background:linear-gradient(135deg,var(--primary),var(--accent-hover));color:#fff;border:none;padding:8px 16px;border-radius:10px;cursor:pointer;font-weight:600;font-size:12px;font-family:inherit;" onclick='openLessonModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة درس</button>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Tab: Notes -->
        <div class="tab-panel" id="tab-notes-<%= course.id %>" style="display:none;">
          <div class="tab-content">
            <div class="tab-toolbar">
              <button class="btn btn-primary" onclick='openNoteModal("<%= course.id %>","<%= course.stage %>","<%= course.grade || '' %>")'><i class="fas fa-plus"></i> إضافة مذكرة</button>
            </div>
            <% var courseNotes = (allNotes||[]).filter(function(n){return n.courseId===course.id;}); %>
            <% courseNotes.sort(function(a,b){return (a.order||0)-(b.order||0);}); %>
            <% if (courseNotes.length > 0) { %>
            <div class="info-grid">
              <% courseNotes.forEach(function(n, ni) { %>
              <div class="info-card">
                <div class="info-card-header">
                  <div class="info-card-icon" style="background:linear-gradient(135deg,var(--primary),var(--accent-light));"><i class="fas fa-sticky-note"></i></div>
                  <div class="info-card-body">
                    <div class="info-card-title"><%= n.title %></div>
                    <div class="info-card-desc"><%= n.description||'---' %></div>
                    <div class="info-card-meta">
                      <% if (n.isFree) { %><span style="color:var(--success);font-weight:600;">مجاني</span><% } %>
                      <% if (n.fileUrl) { %><span><a href="<%= n.fileUrl %>" target="_blank" style="color:var(--accent);"><i class="fas fa-file-pdf"></i> عرض</a></span><% } %>
                    </div>
                  </div>
                </div>
                <div class="info-card-actions">
                  <button class="ica-edit" onclick='openNoteModal("<%= course.id %>","<%= course.stage %>","<%= course.grade || '' %>",<%= JSON.stringify(n) %>)'><i class="fas fa-edit"></i></button>
                  <button class="ica-delete" onclick="deleteNote('<%= n.id %>')"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state-modern">
              <i class="fas fa-sticky-note"></i>
              <h3>لا توجد مذكرات بعد</h3>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Tab: Reviews -->
        <div class="tab-panel" id="tab-reviews-<%= course.id %>" style="display:none;">
          <div class="tab-content">
            <div class="tab-toolbar">
              <button class="btn btn-primary" onclick='openCourseReviewModal("<%= course.id %>")'><i class="fas fa-plus"></i> إضافة مراجعة</button>
            </div>
            <% var courseReviews = (allReviews||[]).filter(function(r){return r.courseId===course.id || (!r.courseId && (r.stage===course.stage||r.stage==='all'||!r.stage) && r.grade===course.grade);}); %>
            <% if (courseReviews.length > 0) { %>
            <% courseReviews.sort(function(a,b){return (a.order||0)-(b.order||0);}); %>
            <div class="info-grid">
              <% courseReviews.forEach(function(r, ri) { %>
              <div class="info-card">
                <div class="info-card-header">
                  <div class="info-card-icon" style="background:<%= r.color || 'var(--accent)' %>;"><i class="fas <%= r.icon || 'fa-star' %>"></i></div>
                  <div class="info-card-body">
                    <div class="info-card-title"><%= r.title %></div>
                    <div class="info-card-desc"><%= r.desc||'---' %></div>
                    <div class="info-card-meta">
                      <% if (r.videos && r.videos.length > 0) { %><span><i class="fas fa-video"></i> <%= r.videos.length %></span><% } %>
                      <% if (r.pdfFiles && r.pdfFiles.length > 0) { %><span><i class="fas fa-file-pdf"></i> <%= r.pdfFiles.length %></span><% } %>
                      <% if (r.quiz && r.quiz.questions) { %><span style="color:var(--success);"><i class="fas fa-tasks"></i> <%= r.quiz.questions.length %></span><% } %>
                      <% if (r.isFree) { %><span style="color:var(--success);font-weight:600;">مجاني</span><% } %>
                    </div>
                  </div>
                </div>
                <div class="info-card-actions">
                  <button class="ica-edit" onclick='openCourseReviewModal("<%= course.id %>",<%= JSON.stringify(r) %>)'><i class="fas fa-edit"></i></button>
                  <% if (r.quiz) { %><button class="ica-quiz" onclick='openCourseReviewQuizModal(<%= JSON.stringify(r) %>)'><i class="fas fa-tasks"></i></button><% } %>
                  <button class="ica-delete" onclick="deleteReview('<%= r.id %>')"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state-modern">
              <i class="fas fa-star"></i>
              <h3>لا توجد مراجعات بعد</h3>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Tab: Question Banks -->
        <div class="tab-panel" id="tab-questionbanks-<%= course.id %>" style="display:none;">
          <div class="tab-content">
            <div class="tab-toolbar">
              <button class="btn btn-primary" onclick='openQuestionBankModal("<%= course.id %>")'><i class="fas fa-plus"></i> إضافة بنك أسئلة</button>
            </div>
            <% var courseBanks = (allQuestionBanks||[]).filter(function(b){return b.courseId===course.id;}); %>
            <% if (courseBanks.length > 0) { %>
            <% courseBanks.sort(function(a,b){return (a.order||0)-(b.order||0);}); %>
            <div class="info-grid">
              <% courseBanks.forEach(function(b, bi) { %>
              <div class="info-card">
                <div class="info-card-header">
                  <div class="info-card-icon" style="background:linear-gradient(135deg,var(--primary),var(--accent-light));"><i class="fas fa-question-circle"></i></div>
                  <div class="info-card-body">
                    <div class="info-card-title"><%= b.title %></div>
                    <div class="info-card-desc"><%= b.description||'---' %></div>
                    <div class="info-card-meta">
                      <span><i class="fas fa-list"></i> <%= (b.questions&&b.questions.length) ? b.questions.length+' سؤال' : '---' %></span>
                      <% if (b.timerMinutes) { %><span><i class="fas fa-clock"></i> <%= b.timerMinutes %> د</span><% } %>
                    </div>
                  </div>
                </div>
                <div class="info-card-actions">
                  <button class="ica-edit" onclick='openQuestionBankModal("<%= course.id %>",<%= JSON.stringify(b) %>)'><i class="fas fa-edit"></i></button>
                  <button class="ica-delete" onclick="deleteQuestionBank('<%= b.id %>')"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state-modern">
              <i class="fas fa-question-circle"></i>
              <h3>لا توجد بنوك أسئلة بعد</h3>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Tab: Main Quiz -->
        <div class="tab-panel" id="tab-quiz-<%= course.id %>" style="display:none;">
          <div class="tab-content">
            <div style="text-align:center;padding:30px 20px;">
              <% if (course.quiz && course.quiz.questions && course.quiz.questions.length > 0) { %>
              <i class="fas fa-tasks" style="font-size:36px;color:var(--border);display:block;margin-bottom:12px;"></i>
              <p style="color:var(--text-light);margin-bottom:14px;font-size:14px;">الاختبار الشامل — <%= course.quiz.questions.length %> سؤال</p>
              <button class="btn btn-sm" style="background:linear-gradient(135deg,var(--primary),var(--accent-hover));color:#fff;border:none;padding:10px 24px;border-radius:12px;cursor:pointer;font-weight:600;font-size:13px;font-family:inherit;" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-edit"></i> إدارة الاختبار الشامل</button>
              <% } else { %>
              <i class="fas fa-tasks" style="font-size:36px;color:var(--border);display:block;margin-bottom:12px;"></i>
              <p style="color:var(--text-muted);margin-bottom:14px;font-size:14px;">لا يوجد اختبار شامل لهذه المادة</p>
              <button class="btn btn-sm" style="background:linear-gradient(135deg,var(--primary),var(--accent-hover));color:#fff;border:none;padding:10px 24px;border-radius:12px;cursor:pointer;font-weight:600;font-size:13px;font-family:inherit;" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة اختبار شامل</button>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>
</main>

<!-- Course Modal -->
<div class="modal-overlay" id="courseModal">
  <div class="modal">
    <div class="modal-header">
      <h3 id="courseModalTitle">إضافة فرع جديد</h3>
      <button class="modal-close" onclick="closeModal('courseModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="courseId">
      <input type="hidden" id="courseStage" value="<%= stage %>">
      <input type="hidden" id="courseGrade" value="<%= grade %>">
      <div class="form-group"><label>اسم الفرع</label><input id="courseTitle" placeholder="مثال: النحو"></div>
      <div class="form-group"><label>العنوان الفرعي</label><input id="courseSubtitle" placeholder="مثال: قواعد اللغة العربية"></div>
      <div class="form-group"><label>الوصف</label><textarea id="courseDescription" rows="3" placeholder="وصف الفرع"></textarea></div>
      <div class="form-group"><label>أيقونة الفرع</label>
        <div style="display:flex;flex-wrap:wrap;gap:8px;" id="iconPicker">
          <% var icons = ['fa-book','fa-book-open','fa-pen','fa-pen-fancy','fa-feather','fa-quote-right','fa-scroll','fa-landmark','fa-mosque','fa-star','fa-star-and-crescent','fa-gem','fa-crown','fa-brain','fa-lightbulb','fa-flask','fa-calculator','fa-microscope','fa-globe','fa-earth-africa','fa-language','fa-font','fa-paragraph','fa-list','fa-layer-group','fa-shapes','fa-cube','fa-infinity','fa-square-root-variable','fa-chart-line','fa-music','fa-palette','fa-dragon','fa-leaf','fa-tree','fa-sun','fa-moon']; %>
          <% icons.forEach(function(ic) { %>
          <div class="icon-option" data-icon="<%= ic.replace('fa-','') %>" onclick="selectIcon(this,'<%= ic.replace('fa-','') %>')" style="width:44px;height:44px;border-radius:10px;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.2s;background:var(--card);font-size:18px;color:var(--text);"><i class="fas <%= ic %>"></i></div>
          <% }); %>
        </div>
        <input type="hidden" id="courseIcon" value="fa-book">
        <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">اختر الأيقونة المناسبة للفرع</div>
      </div>
      <div class="form-group"><label>اللون</label><input type="color" id="courseColor" value="#A07200"></div>
      <div class="form-group"><label>الفصل الدراسي</label><select id="courseSemester"><option value="all">الكل</option><option value="first">الفصل الدراسي الأول</option><option value="second">الفصل الدراسي الثاني</option></select></div>
      <button class="btn btn-primary" onclick="saveCourse()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
    </div>
  </div>
</div>

<!-- Section Modal (الأبواب) -->
<div class="modal-overlay" id="sectionModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3 id="sectionModalTitle">إدارة الأبواب</h3>
      <button class="modal-close" onclick="closeModal('sectionModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="sectionCourseId">
      <div id="sectionsContainer">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <label>أبواب الفرع</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addSection()"><i class="fas fa-plus"></i> إضافة باب</button>
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveSections()" style="width:100%;margin-top:16px;"><i class="fas fa-save"></i> حفظ الأبواب</button>
    </div>
  </div>
</div>

<!-- Lesson Modal -->
<div class="modal-overlay" id="lessonModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3 id="lessonModalTitle">إضافة درس</h3>
      <button class="modal-close" onclick="closeModal('lessonModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="lessonCourseId">
      <input type="hidden" id="lessonId">
      <div class="form-group"><label>عنوان الدرس</label><input id="lessonTitle" placeholder="مثال: المبتدأ والخبر"></div>
      <div class="form-group"><label>الوصف</label><textarea id="lessonDescription" rows="2" placeholder="وصف الدرس"></textarea></div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;">
          <input type="checkbox" id="lessonIsFree"> درس مجاني
        </label>
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;">
          <input type="checkbox" id="lessonGuestVisible"> مرئي للزوار
        </label>
      </div>
      <div id="videosSection">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <label style="font-size:13px;font-weight:600;color:var(--text-light);">الفيديوهات</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addVideoField()"><i class="fas fa-plus"></i> إضافة فيديو</button>
        </div>
        <div id="videosContainer"></div>
      </div>
      <div id="pdfsSection" style="margin-top:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <label style="font-size:13px;font-weight:600;color:var(--text-light);">ملفات PDF</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addPdfField()"><i class="fas fa-plus"></i> إضافة PDF</button>
        </div>
        <div id="pdfsContainer"></div>
      </div>
      <div class="form-group" style="margin-top:16px;">
        <label>الباب</label>
        <select id="lessonSectionId"><option value="">بدون باب</option></select>
      </div>

      <div style="margin-top:16px;padding:14px;background:var(--bg);border-radius:10px;border:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <input type="checkbox" id="lessonQuizEnabled" onchange="document.getElementById('lessonQuizSettings').style.display=this.checked?'':'none'">
          <label style="font-weight:600;font-size:13px;cursor:pointer;">تفعيل اختبار الدرس</label>
        </div>
        <div id="lessonQuizSettings" style="display:none;">
