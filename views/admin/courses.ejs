function saveNote() {
  var id = document.getElementById('noteId').value;
  var file = document.getElementById('noteFile').files[0];
  var existingPath = document.getElementById('noteFilePath').value;
  var fileReady = function(filePath) {
    var data = {
      courseId: document.getElementById('noteCourseId').value,
      title: document.getElementById('noteTitle').value,
      description: document.getElementById('noteDescription').value,
      filePath: filePath || '',
      stage: document.getElementById('noteStage').value,
      grade: document.getElementById('noteGrade').value,
      isFree: document.getElementById('noteIsFree').checked,
      order: 0
    };
    var url = id ? '/api/admin/notes/' + id : '/api/admin/notes';
    var method = id ? 'PUT' : 'POST';
    if (window.uploadStepSave) window.uploadStepSave();
    fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
      .then(function(r){ return r.json(); }).then(function(d){ if (d.success) { if (window.uploadDone) window.uploadDone(); location.reload(); } else { if (window.uploadError) window.uploadError(d.error); alert(d.error); } })
      .catch(function(e){ if (window.uploadError) window.uploadError((e && e.message) ? e.message : e); });
  };
