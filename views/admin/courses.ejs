function addQuestion(q, idx) {
  var container = document.getElementById('questionsContainer');
  var div = document.createElement('div');
  div.className = 'question-block';
  div.style.cssText = 'background:var(--bg);border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid var(--border);';
  var qi = idx !== undefined ? idx : container.querySelectorAll('.question-block').length;
  div.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><strong style="color:var(--primary);">السؤال ' + (qi + 1) + '</strong><button class="btn btn-sm" style="background:#ef4444;color:#fff;font-size:11px;padding:4px 10px;" onclick="this.closest(\'.question-block\').remove()">حذف</button></div><div class="form-group"><input class="q-text" placeholder="نص السؤال" value="' + escAttr(q ? q.question : '') + '"></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">' + ['أ','ب','ج','د'].map(function(letter, oi){ return '<div class="form-group" style="margin-bottom:4px;"><label style="font-size:11px;margin-bottom:2px;">الخيار ' + letter + '</label><input class="q-opt-' + oi + '" placeholder="الخيار ' + letter + '" value="' + escAttr(q && q.options && q.options[oi] ? q.options[oi] : '') + '"></div>'; }).join('') + '</div><div class="form-group" style="margin-bottom:0;"><label style="font-size:12px;">الإجابة الصحيحة</label><select class="q-correct" style="width:80px;padding:6px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:13px;">' + ['أ','ب','ج','د'].map(function(letter, oi){ return '<option value="' + oi + '"' + ((q ? q.correct + '' : '0') === '' + oi ? ' selected' : '') + '>' + letter + '</option>'; }).join('') + '</select></div><div class="form-group" style="margin-bottom:0;margin-top:8px;"><label style="font-size:12px;">الرسالة عند الإجابة الخاطئة (اختياري)</label><textarea class="q-wrong-msg" placeholder="رسالة تظهر للطالب عند اختيار إجابة خاطئة" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);font-size:12px;resize:vertical;" rows="2">' + escAttr(q && q.wrongAnswerMessage ? q.wrongAnswerMessage : '') + '</textarea></div>';
  container.appendChild(div);
}
function uploadWordFile() {
  document.getElementById('wordFilePopup').value = '';
  document.getElementById('wordUploadModal').classList.add('show');
}
function extractQuestionsFromPopup() {
  var btn = document.querySelector('#wordUploadModal .modal-body button');
  var fileInput = document.getElementById('wordFilePopup');
  if (!fileInput.files || !fileInput.files[0]) { alert('يرجى اختيار ملف Word أولاً'); return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الاستخراج...';
  var formData = new FormData();
  formData.append('file', fileInput.files[0]);
  fetch('/api/admin/upload-word-file', {
    method: 'POST',
    body: formData
  }).then(function(r){ return r.json(); }).then(function(d){
    if (d.success && d.questions) {
      d.questions.forEach(function(q){ addQuestion(q); });
      closeModal('wordUploadModal');
      fileInput.value = '';
      alert('تم استخراج ' + d.questions.length + ' سؤال');
    } else {
      alert(d.error || 'فشل استخراج الأسئلة');
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-magic"></i> استخراج';
    }
  }).catch(function(){
    alert('فشل الاتصال بالخادم');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-magic"></i> استخراج';
  });
}
function saveQuiz() {
  var courseId = document.getElementById('quizCourseId').value;
  var title = document.getElementById('quizTitle').value;
  var timerMinutes = document.getElementById('quizTimerEnabled').checked ? (parseInt(document.getElementById('quizTimer').value) || null) : null;
  var blocks = document.querySelectorAll('.question-block');
  var questions = [];
  blocks.forEach(function(b) {
    var q = b.querySelector('.q-text').value;
    var opts = [0,1,2,3].map(function(i){ return b.querySelector('.q-opt-' + i).value; });
    var c = parseInt(b.querySelector('.q-correct').value) || 0;
    var wm = b.querySelector('.q-wrong-msg').value;
    if (q && opts.some(function(o){ return o; })) questions.push({ question: q, options: opts, correct: c, wrongAnswerMessage: wm });
  });
  fetch('/api/admin/courses/' + courseId + '/quiz', {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ title: title, questions: questions, timerMinutes: timerMinutes })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

