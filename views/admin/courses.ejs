<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="admin-content">
  <div class="page-header">
    <div>
      <h1>المحاضرات</h1>
      <p>إدارة المحتوى حسب المرحلة والصف</p>
    </div>
  </div>

<% if (!stage) { %>
  <!-- ===== STEP 1: Select Stage ===== -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    <a href="/admin/courses?stage=%D8%A5%D8%B9%D8%AF%D8%A7%D8%AF%D9%8A%D8%A9" style="display:block;text-decoration:none;padding:40px 24px;background:linear-gradient(135deg,#059669,#34d399);border-radius:var(--radius-xl);color:#fff;text-align:center;transition:var(--transition);" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
      <i class="fas fa-school" style="font-size:48px;display:block;margin-bottom:16px;"></i>
      <h2 style="font-size:28px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;">المرحلة الإعدادية</h2>
      <p style="font-size:14px;opacity:0.9;margin-top:8px;"><%= allCourses.filter(function(c){return c.stage==='إعدادية';}).length %> فرع</p>
    </a>
    <a href="/admin/courses?stage=%D8%AB%D8%A7%D9%86%D9%88%D9%8A%D8%A9" style="display:block;text-decoration:none;padding:40px 24px;background:linear-gradient(135deg,#A07200,#F6C453);border-radius:var(--radius-xl);color:#fff;text-align:center;transition:var(--transition);" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
      <i class="fas fa-graduation-cap" style="font-size:48px;display:block;margin-bottom:16px;"></i>
      <h2 style="font-size:28px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;">المرحلة الثانوية</h2>
      <p style="font-size:14px;opacity:0.9;margin-top:8px;"><%= allCourses.filter(function(c){return c.stage==='ثانوية';}).length %> فرع</p>
    </a>
  </div>

<% } else if (!grade) { %>
  <!-- ===== STEP 2: Select Grade ===== -->
  <div style="margin-bottom:20px;">
    <a href="/admin/courses" style="color:var(--accent);text-decoration:none;font-size:14px;">
      <i class="fas fa-arrow-right"></i> العودة لاختيار المرحلة
    </a>
  </div>
  <div style="background:var(--card);border-radius:var(--radius-xl);padding:24px;border:1px solid var(--border);box-shadow:var(--shadow);margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:44px;height:44px;border-radius:12px;background:<%= stage === 'إعدادية' ? 'linear-gradient(135deg,#059669,#34d399)' : 'linear-gradient(135deg,#A07200,#F6C453)' %>;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;">
        <i class="fas <%= stage === 'إعدادية' ? 'fa-school' : 'fa-graduation-cap' %>"></i>
      </div>
      <h2 style="font-size:22px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;"><%= stage === 'إعدادية' ? 'المرحلة الإعدادية' : 'المرحلة الثانوية' %></h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;">
      <% var grades = stage === 'إعدادية' ? ['الأول الإعدادي','الثاني الإعدادي','الثالث الإعدادي'] : ['الأول الثانوي','الثاني الثانوي','الثالث الثانوي']; %>
      <% grades.forEach(function(g) { 
        var count = allCourses.filter(function(c){return c.stage===stage && c.grade===g;}).length;
        var encodedStage = encodeURIComponent(stage);
        var encodedGrade = encodeURIComponent(g);
      %>
      <a href="/admin/courses?stage=<%= encodedStage %>&grade=<%= encodedGrade %>" style="display:block;text-decoration:none;padding:24px 16px;background:var(--bg);border-radius:var(--radius-lg);border:2px solid var(--border);text-align:center;transition:var(--transition);" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
        <div style="font-size:36px;font-weight:700;color:var(--primary);margin-bottom:8px;"><%= g.split(' ')[0] %></div>
        <div style="font-size:14px;font-weight:600;color:var(--text);"><%= g.split(' ').slice(1).join(' ') %></div>
        <div style="font-size:12px;color:var(--text-light);margin-top:6px;"><%= count %> فرع</div>
      </a>
      <% }) %>
    </div>
  </div>

<% } else { %>
  <!-- ===== STEP 3: Course Management ===== -->
  <div style="margin-bottom:20px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
    <a href="/admin/courses" style="color:var(--text-light);text-decoration:none;font-size:13px;">
      <i class="fas fa-arrow-right"></i> المراحل
    </a>
    <span style="color:var(--text-muted);">/</span>
    <a href="/admin/courses?stage=<%= encodeURIComponent(stage) %>" style="color:var(--text-light);text-decoration:none;font-size:13px;">
      <%= stage === 'إعدادية' ? 'إعدادية' : 'ثانوية' %>
    </a>
    <span style="color:var(--text-muted);">/</span>
    <span style="font-size:13px;font-weight:600;color:var(--primary);"><%= grade %></span>
  </div>

  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding:16px 20px;background:var(--card);border-radius:var(--radius-lg);border:1px solid var(--border);">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:40px;height:40px;border-radius:10px;background:<%= stage === 'إعدادية' ? 'linear-gradient(135deg,#059669,#34d399)' : 'linear-gradient(135deg,#A07200,#F6C453)' %>;display:flex;align-items:center;justify-content:center;color:#fff;">
        <i class="fas <%= stage === 'إعدادية' ? 'fa-school' : 'fa-graduation-cap' %>"></i>
      </div>
      <div>
        <h2 style="font-size:18px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;"><%= grade %></h2>
        <p style="font-size:12px;color:var(--text-light);margin:2px 0 0;"><%= courses.length %> فرع</p>
      </div>
    </div>
    <button class="btn btn-primary" onclick="openCourseModal()"><i class="fas fa-plus"></i> إضافة فرع</button>
  </div>

  <div id="coursesContainer" style="display:flex;flex-direction:column;gap:20px;">
    <% if (courses.length === 0) { %>
    <div style="text-align:center;padding:60px 20px;background:var(--card);border-radius:var(--radius-xl);border:1px solid var(--border);">
      <i class="fas fa-folder-open" style="font-size:48px;color:var(--border);display:block;margin-bottom:16px;"></i>
      <h3 style="font-size:18px;color:var(--text-light);margin-bottom:8px;">لا توجد فروع بعد</h3>
      <p style="color:var(--text-muted);font-size:14px;">أضف أول فرع للصف <strong><%= grade %></strong></p>
      <button class="btn btn-primary" onclick="openCourseModal()" style="margin-top:12px;"><i class="fas fa-plus"></i> إضافة فرع</button>
    </div>
    <% } %>
    <% courses.forEach(function(course, ci) { %>
    <div class="admin-table">
      <div style="padding:16px 20px;background:var(--bg);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:40px;height:40px;background:<%= course.color %>;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;">
            <i class="fas <%= course.icon %>"></i>
          </div>
          <div>
            <h3 style="font-size:16px;font-weight:700;color:var(--primary);margin:0;"><%= course.title %></h3>
            <div style="display:flex;align-items:center;gap:8px;margin-top:2px;">
              <span style="font-size:12px;color:var(--text-light);"><%= (course.lessons || []).length %> درس</span>
              <% if (course.grade) { %>
              <span style="background:var(--accent-glow);color:var(--accent);font-size:11px;padding:2px 10px;border-radius:10px;font-weight:600;"><%= course.grade %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="admin-actions" style="flex-wrap:wrap;">
          <button class="edit" onclick='openLessonModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> درس</button>
          <% if (course.stage === 'إعدادية') { %>
          <button class="view" onclick='openUnitModal(<%= JSON.stringify(course) %>)'><i class="fas fa-layer-group"></i> وحدات</button>
          <% } else if (course.stage === 'ثانوية') { %>
          <button class="view" onclick='openSectionModal(<%= JSON.stringify(course) %>)'><i class="fas fa-sitemap"></i> أبواب</button>
          <% } %>
          <button class="view" onclick='openCourseModal(<%= JSON.stringify(course) %>)'><i class="fas fa-edit"></i></button>
          <button class="delete" onclick="deleteCourse('<%= course.id %>')"><i class="fas fa-trash"></i></button>
          <% if (course.quiz) { %>
          <button class="view" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-tasks"></i> الأسئلة</button>
          <% } else { %>
          <button class="edit" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> اختبار</button>
          <% } %>
        </div>
      </div>

      <% if (course.stage === 'إعدادية') { %>
        <%# PREP: Units view %>
        <% if (course.units && course.units.length > 0) { %>
        <div style="padding:12px 20px;background:var(--accent-glow);border-bottom:1px solid var(--border);font-size:13px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:8px;">
          <i class="fas fa-layer-group"></i> الوحدات
        </div>
        <div style="padding:12px 20px;display:flex;flex-direction:column;gap:16px;">
          <% course.units.sort(function(a,b){ return (a.order||0) - (b.order||0); }).forEach(function(unit, ui) { 
            var unitLessons = (course.lessons || []).filter(function(l){ return l.unitId === unit.id; }).sort(function(a,b){ return (a.order||0) - (b.order||0); });
          %>
          <div style="background:var(--bg);border-radius:10px;border:1px solid var(--border);overflow:hidden;">
            <div style="padding:10px 16px;display:flex;align-items:center;gap:10px;background:var(--card);border-bottom:1px solid var(--border);">
              <span style="font-weight:700;color:var(--accent);font-size:13px;"><%= unit.order || (ui+1) %></span>
              <span style="font-weight:600;color:var(--primary);flex:1;font-size:14px;"><%= unit.name %></span>
              <span style="font-size:11px;color:var(--text-light);"><%= unitLessons.length %> درس</span>
              <button class="btn btn-sm" style="background:var(--accent);color:#fff;padding:3px 10px;font-size:11px;" onclick="editUnitName('<%= course.id %>','<%= unit.id %>','<%= unit.name.replace(/'/g,"\\'") %>')"><i class="fas fa-edit"></i></button>
              <button class="btn btn-sm" style="background:#ef4444;color:#fff;padding:3px 10px;font-size:11px;" onclick="deleteUnit('<%= course.id %>','<%= unit.id %>')"><i class="fas fa-trash"></i></button>
              <% if (ui > 0) { %><button class="btn btn-sm" style="background:var(--text-muted);color:#fff;padding:3px 8px;font-size:11px;" onclick="moveUnit('<%= course.id %>','<%= unit.id %>','up')"><i class="fas fa-chevron-up"></i></button><% } %>
              <% if (ui < course.units.length - 1) { %><button class="btn btn-sm" style="background:var(--text-muted);color:#fff;padding:3px 8px;font-size:11px;" onclick="moveUnit('<%= course.id %>','<%= unit.id %>','down')"><i class="fas fa-chevron-down"></i></button><% } %>
            </div>
            <% if (unitLessons.length > 0) { %>
            <table>
              <thead><tr><th>#</th><th>عنوان الدرس</th><th>المدة</th><th>الفيديو</th><th>PDF</th><th>مجاني</th><th>الإجراءات</th></tr></thead>
              <tbody>
                <% unitLessons.forEach(function(l, li) { %>
                <tr>
                  <td><%= l.order || (li+1) %></td>
                  <td><%= l.title %></td>
                  <td><%= l.duration %></td>
                  <td>
                    <% if (l.videos && l.videos.length > 0) { %>
                      <% l.videos.forEach(function(v) { %>
                      <div style="display:flex;align-items:center;gap:4px;font-size:11px;">
                        <i class="fas fa-video" style="color:var(--accent);font-size:10px;"></i>
                        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;"><%= v.title %></span>
                        <a href="<%= v.url %>" target="_blank" style="color:var(--accent);font-size:10px;"><i class="fas fa-external-link-alt"></i></a>
                      </div>
                      <% }) %>
                    <% } else { %><span style="color:var(--text-muted);font-size:11px;">---</span><% } %>
                  </td>
                  <td>
                    <% if (l.pdfFiles && l.pdfFiles.length > 0) { %>
                      <% l.pdfFiles.forEach(function(p) { %>
                      <div style="display:flex;align-items:center;gap:4px;font-size:11px;">
                        <i class="fas fa-file-pdf" style="color:var(--danger);font-size:10px;"></i>
                        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;"><%= p.title %></span>
                        <a href="<%= p.url %>" target="_blank" style="color:var(--danger);font-size:10px;"><i class="fas fa-external-link-alt"></i></a>
                      </div>
                      <% }) %>
                    <% } else { %><span style="color:var(--text-muted);font-size:11px;">---</span><% } %>
                  </td>
                  <td style="font-size:12px;"><%- l.isFree ? '<span style="color:var(--success);font-weight:600;">مجاني</span>' : '---' %></td>
                  <td>
                    <div class="admin-actions">
                      <button class="edit" onclick='openLessonModal(<%= JSON.stringify(course) %>, <%= JSON.stringify(l) %>)'><i class="fas fa-edit"></i></button>
                      <button class="delete" onclick="deleteLesson('<%= course.id %>','<%= l.id %>')"><i class="fas fa-trash"></i></button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <% } else { %>
            <div style="padding:16px 20px;text-align:center;color:var(--text-muted);font-size:13px;">لا توجد دروس في هذه الوحدة</div>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <div style="padding:20px;text-align:center;color:var(--text-muted);font-size:13px;">
          لا توجد وحدات بعد. <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick='openUnitModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة وحدة</button>
        </div>
        <% } %>

      <% } else { %>
        <%# SECONDARY: Sections + Table (unchanged) %>
        <% if (course.sections && course.sections.length > 0) { %>
        <div style="padding:12px 20px;background:var(--accent-glow);border-bottom:1px solid var(--border);font-size:13px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:8px;">
          <i class="fas fa-sitemap"></i> الأبواب
        </div>
        <div style="padding:8px 20px;display:flex;flex-wrap:wrap;gap:8px;">
          <% course.sections.forEach(function(section) { %>
          <span style="background:var(--bg);padding:4px 12px;border-radius:6px;font-size:12px;display:flex;align-items:center;gap:6px;">
            <%= section.name %>
            <span style="color:var(--text-light);font-size:10px;">(<%= section.lessons.length %>)</span>
          </span>
          <% }) %>
        </div>
        <% } %>

        <table>
          <thead>
            <tr><th>#</th><th>عنوان الدرس</th><th>المدة</th><th>الفيديو</th><th>PDF</th><th>مجاني</th><th>الباب</th><th>الإجراءات</th></tr>
          </thead>
          <tbody>
            <% (course.lessons || []).forEach(function(l, li) { %>
            <tr>
              <td><%= li + 1 %></td>
              <td><%= l.title %></td>
              <td><%= l.duration %></td>
              <td>
                <% if (l.videos && l.videos.length > 0) { %>
                  <% l.videos.forEach(function(v, vi) { %>
                  <div style="display:flex;align-items:center;gap:4px;margin-bottom:2px;font-size:11px;">
                    <i class="fas fa-video" style="color:var(--accent);font-size:10px;flex-shrink:0;"></i>
                    <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;"><%= v.title %></span>
                    <a href="<%= v.url %>" target="_blank" style="color:var(--accent);font-size:10px;flex-shrink:0;"><i class="fas fa-external-link-alt"></i></a>
                  </div>
                  <% }) %>
                <% } else if (l.videoUrl) { %>
                  <div style="display:flex;align-items:center;gap:4px;font-size:11px;">
                    <i class="fas fa-video" style="color:var(--accent);font-size:10px;flex-shrink:0;"></i>
                    <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;">فيديو</span>
                    <a href="<%= l.videoUrl %>" target="_blank" style="color:var(--accent);font-size:10px;flex-shrink:0;"><i class="fas fa-external-link-alt"></i></a>
                  </div>
                <% } else { %>
                  <span style="color:var(--text-muted);font-size:11px;">---</span>
                <% } %>
              </td>
              <td>
                <% if (l.pdfFiles && l.pdfFiles.length > 0) { %>
                  <% l.pdfFiles.forEach(function(p, pi) { %>
                  <div style="display:flex;align-items:center;gap:4px;margin-bottom:2px;font-size:11px;">
                    <i class="fas fa-file-pdf" style="color:var(--danger);font-size:10px;flex-shrink:0;"></i>
                    <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;"><%= p.title %></span>
                    <a href="<%= p.url %>" target="_blank" style="color:var(--danger);font-size:10px;flex-shrink:0;"><i class="fas fa-external-link-alt"></i></a>
                  </div>
                  <% }) %>
                <% } else if (l.pdfUrl) { %>
                  <div style="display:flex;align-items:center;gap:4px;font-size:11px;">
                    <i class="fas fa-file-pdf" style="color:var(--danger);font-size:10px;flex-shrink:0;"></i>
                    <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;">مذكرة</span>
                    <a href="<%= l.pdfUrl %>" target="_blank" style="color:var(--danger);font-size:10px;flex-shrink:0;"><i class="fas fa-external-link-alt"></i></a>
                  </div>
                <% } else { %>
                  <span style="color:var(--text-muted);font-size:11px;">---</span>
                <% } %>
              </td>
              <td style="font-size:12px;"><%- l.isFree ? '<span style="color:var(--success);font-weight:600;">مجاني</span>' : '---' %> <% if (l.guestVisible) { %><span style="color:var(--accent);font-weight:600;font-size:11px;"><br>زائر</span><% } %></td>
              <td style="font-size:12px;"><%= l.sectionId ? (function(){ var s = (course.sections || []).find(function(s){ return s.id === l.sectionId; }); return s ? s.name : '---'; })() : '---' %></td>
              <td>
                <div class="admin-actions">
                  <button class="edit" onclick='openLessonModal(<%= JSON.stringify(course) %>, <%= JSON.stringify(l) %>)'><i class="fas fa-edit"></i></button>
                  <button class="delete" onclick="deleteLesson('<%= course.id %>','<%= l.id %>')"><i class="fas fa-trash"></i></button>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if (!course.lessons || course.lessons.length === 0) { %>
            <tr><td colspan="8" style="text-align:center;color:var(--text-light);">لا توجد دروس بعد</td></tr>
            <% } %>
        </tbody>
      </table>
    </div>
    <% } }) %>
  </div>
<% } %>
</main>

<!-- Course Modal -->
<div class="modal-overlay" id="courseModal">
  <div class="modal">
    <div class="modal-header">
      <h3 id="courseModalTitle">إضافة فرع جديد</h3>
      <button class="modal-close" onclick="closeModal('courseModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="courseId">
      <input type="hidden" id="courseStage" value="<%= stage %>">
      <input type="hidden" id="courseGrade" value="<%= grade %>">
      <div class="form-group"><label>اسم الفرع</label><input id="courseTitle" placeholder="مثال: النحو"></div>
      <div class="form-group"><label>العنوان الفرعي</label><input id="courseSubtitle" placeholder="مثال: قواعد اللغة العربية"></div>
      <div class="form-group"><label>الوصف</label><textarea id="courseDescription" rows="3" placeholder="وصف الفرع"></textarea></div>
      <div class="form-group"><label>أيقونة (FontAwesome)</label><input id="courseIcon" value="fa-book" placeholder="fa-book"></div>
      <div class="form-group"><label>اللون</label><input type="color" id="courseColor" value="#A07200"></div>
      <button class="btn btn-primary" onclick="saveCourse()" style="width:100%;"><i class="fas fa-save"></i> حفظ</button>
    </div>
  </div>
</div>

<!-- Section Modal (الأبواب) -->
<div class="modal-overlay" id="sectionModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3 id="sectionModalTitle">إدارة الأبواب</h3>
      <button class="modal-close" onclick="closeModal('sectionModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="sectionCourseId">
      <div id="sectionsContainer">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <label>أبواب الفرع</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addSection()"><i class="fas fa-plus"></i> إضافة باب</button>
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveSections()" style="width:100%;margin-top:16px;"><i class="fas fa-save"></i> حفظ الأبواب</button>
    </div>
  </div>
</div>

<!-- Unit Modal (for preparatory) -->
<div class="modal-overlay" id="unitModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3 id="unitModalTitle">إدارة الوحدات</h3>
      <button class="modal-close" onclick="closeModal('unitModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="unitCourseId">
      <div id="unitsContainer">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <label>وحدات المادة</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addUnit()"><i class="fas fa-plus"></i> إضافة وحدة</button>
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveUnits()" style="width:100%;margin-top:16px;"><i class="fas fa-save"></i> حفظ الوحدات</button>
    </div>
  </div>
</div>

<!-- Lesson Modal -->
<div class="modal-overlay" id="lessonModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3 id="lessonModalTitle">إضافة درس</h3>
      <button class="modal-close" onclick="closeModal('lessonModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="lessonCourseId">
      <input type="hidden" id="lessonId">
      <div class="form-group"><label>عنوان الدرس</label><input id="lessonTitle" placeholder="مثال: المبتدأ والخبر"></div>
      <div class="form-group"><label>الوصف</label><textarea id="lessonDescription" rows="2" placeholder="وصف الدرس"></textarea></div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;">
          <input type="checkbox" id="lessonIsFree"> درس مجاني
        </label>
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;">
          <input type="checkbox" id="lessonGuestVisible"> مرئي للزوار
        </label>
      </div>
      <div id="videosSection">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <label style="font-size:13px;font-weight:600;color:var(--text-light);">الفيديوهات</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addVideoField()"><i class="fas fa-plus"></i> إضافة فيديو</button>
        </div>
        <div id="videosContainer"></div>
      </div>
      <div id="pdfsSection" style="margin-top:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <label style="font-size:13px;font-weight:600;color:var(--text-light);">ملفات PDF</label>
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addPdfField()"><i class="fas fa-plus"></i> إضافة PDF</button>
        </div>
        <div id="pdfsContainer"></div>
      </div>
      <div class="form-group" style="margin-top:16px;">
        <label>المدة</label>
        <input id="lessonDuration" placeholder="مثال: 45:30">
      </div>
      <div id="lessonUnitGroup" class="form-group">
        <label>الوحدة</label>
        <select id="lessonUnitId"><option value="">بدون وحدة</option></select>
      </div>
      <div id="lessonSectionGroup" class="form-group">
        <label>الباب</label>
        <select id="lessonSectionId"><option value="">بدون باب</option></select>
      </div>
      <div class="form-group">
        <label>ترتيب الدرس</label>
        <input id="lessonOrder" type="number" min="1" placeholder="1">
      </div>
      <div class="form-group">
        <label>مؤقت الاختبار (بالدقائق)</label>
        <input id="lessonQuizTimer" type="number" min="0" placeholder="مثال: 15">
      </div>
      <input type="hidden" id="lessonVideoUrl">
      <input type="hidden" id="lessonPdfUrl">
      <button class="btn btn-primary" onclick="saveLesson()" style="width:100%;margin-top:8px;"><i class="fas fa-save"></i> حفظ</button>
    </div>
  </div>
</div>

<!-- Quiz Modal -->
<div class="modal-overlay" id="quizModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3 id="quizModalTitle">بنك الأسئلة</h3>
      <button class="modal-close" onclick="closeModal('quizModal')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="quizCourseId">
      <div class="form-group"><label>عنوان الاختبار</label><input id="quizTitle" placeholder="مثال: اختبار النحو الشامل"></div>
      <div class="form-group"><label>المدة (بالدقائق)</label><input id="quizTimer" type="number" min="0" placeholder="15"></div>
      <div id="questionsContainer">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <label>الأسئلة</label>
          <div style="display:flex;gap:8px;">
            <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick="addQuestion()"><i class="fas fa-plus"></i> إضافة سؤال</button>
            <button class="btn btn-sm" style="background:var(--primary);color:#fff;" onclick="uploadWordFile()"><i class="fas fa-file-word"></i> رفع Word</button>
          </div>
        </div>
      </div>
      <div id="wordUploadArea" style="display:none;margin-bottom:16px;">
        <div class="form-group">
          <label>لصق محتوى الأسئلة من Word</label>
          <textarea id="wordContent" rows="8" placeholder="الصق محتوى الأسئلة من ملف Word هنا"></textarea>
        </div>
        <button class="btn btn-sm" style="background:var(--success);color:#fff;" onclick="extractQuestions()"><i class="fas fa-magic"></i> استخراج</button>
      </div>
      <button class="btn btn-primary" onclick="saveQuiz()" style="width:100%;margin-top:16px;"><i class="fas fa-save"></i> حفظ الاختبار</button>
    </div>
  </div>
</div>

<script>
// ===== COURSE CRUD =====
function openCourseModal(course) {
  document.getElementById('courseModalTitle').textContent = course ? 'تعديل الفرع' : 'إضافة فرع جديد';
  document.getElementById('courseId').value = course ? course.id : '';
  document.getElementById('courseTitle').value = course ? course.title : '';
  document.getElementById('courseSubtitle').value = course ? (course.subtitle || '') : '';
  document.getElementById('courseDescription').value = course ? (course.description || '') : '';
  document.getElementById('courseIcon').value = course ? (course.icon || 'fa-book') : 'fa-book';
  document.getElementById('courseColor').value = course ? (course.color || '#A07200') : '#A07200';
  if (!course) {
    document.getElementById('courseStage').value = '<%= stage %>';
    document.getElementById('courseGrade').value = '<%= grade %>';
  }
  document.getElementById('courseModal').classList.add('show');
}
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
function saveCourse() {
  const id = document.getElementById('courseId').value;
  const data = {
    title: document.getElementById('courseTitle').value,
    subtitle: document.getElementById('courseSubtitle').value,
    description: document.getElementById('courseDescription').value,
    stage: document.getElementById('courseStage').value,
    grade: document.getElementById('courseGrade').value,
    icon: document.getElementById('courseIcon').value,
    color: document.getElementById('courseColor').value
  };
  const url = id ? '/api/admin/courses/' + id : '/api/admin/courses';
  const method = id ? 'PUT' : 'POST';
  fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
function deleteCourse(id) {
  if (!confirm('هل أنت متأكد من حذف هذا الفرع وجميع دروسه؟')) return;
  fetch('/api/admin/courses/' + id, { method: 'DELETE' })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

// ===== SECTION (باب) MANAGEMENT (Secondary only) =====
var currentSections = [];
function openSectionModal(course) {
  document.getElementById('sectionModalTitle').textContent = 'إدارة الأبواب - ' + course.title;
  document.getElementById('sectionCourseId').value = course.id;
  currentSections = (course.sections || []).map(function(s) { return { id: s.id, name: s.name, lessons: s.lessons || [] }; });
  renderSections();
  document.getElementById('sectionModal').classList.add('show');
}
function renderSections() {
  var container = document.getElementById('sectionsContainer');
  var existing = container.querySelectorAll('.section-block');
  existing.forEach(function(el) { el.remove(); });
  currentSections.forEach(function(s, i) {
    var div = document.createElement('div');
    div.className = 'section-block';
    div.style.cssText = 'background:var(--bg);border-radius:10px;padding:12px 16px;margin-bottom:8px;border:1px solid var(--border);display:flex;align-items:center;gap:10px;';
    div.innerHTML = '<span style="font-weight:600;color:var(--primary);flex:1;">' + s.name + '</span><span style="font-size:11px;color:var(--text-light);">' + s.lessons.length + ' درس</span><button class="btn btn-sm" style="background:#ef4444;color:#fff;font-size:10px;padding:3px 8px;" onclick="removeSection(' + i + ')"><i class="fas fa-times"></i></button>';
    container.appendChild(div);
  });
}
function addSection() {
  var name = prompt('اسم الباب الجديد:');
  if (!name || !name.trim()) return;
  currentSections.push({ id: 'sec-' + Date.now() + '-' + Math.random().toString(36).substr(2,4), name: name.trim(), lessons: [] });
  renderSections();
}
function removeSection(idx) {
  if (!confirm('حذف الباب "' + currentSections[idx].name + '"؟')) return;
  currentSections.splice(idx, 1);
  renderSections();
}
function saveSections() {
  var courseId = document.getElementById('sectionCourseId').value;
  fetch('/api/admin/courses/' + courseId, {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ sections: currentSections })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

// ===== UNIT MANAGEMENT (Preparatory only) =====
var currentUnits = [];
function openUnitModal(course) {
  document.getElementById('unitModalTitle').textContent = 'إدارة الوحدات - ' + course.title;
  document.getElementById('unitCourseId').value = course.id;
  currentUnits = (course.units || []).map(function(u) { return { id: u.id, name: u.name, order: u.order || 0 }; });
  renderUnits();
  document.getElementById('unitModal').classList.add('show');
}
function renderUnits() {
  var container = document.getElementById('unitsContainer');
  var existing = container.querySelectorAll('.unit-block');
  existing.forEach(function(el) { el.remove(); });
  currentUnits.sort(function(a,b){ return (a.order||0) - (b.order||0); });
  currentUnits.forEach(function(u, i) {
    var div = document.createElement('div');
    div.className = 'unit-block';
    div.style.cssText = 'background:var(--bg);border-radius:10px;padding:12px 16px;margin-bottom:8px;border:1px solid var(--border);display:flex;align-items:center;gap:10px;';
    div.innerHTML = '<span style="font-weight:700;color:var(--accent);font-size:13px;">' + (u.order || (i+1)) + '</span><span style="font-weight:600;color:var(--primary);flex:1;">' + u.name + '</span><button class="btn btn-sm" style="background:var(--accent);color:#fff;font-size:10px;padding:3px 8px;" onclick="editUnit(' + i + ')"><i class="fas fa-edit"></i></button><button class="btn btn-sm" style="background:#ef4444;color:#fff;font-size:10px;padding:3px 8px;" onclick="removeUnit(' + i + ')"><i class="fas fa-times"></i></button>';
    if (i > 0) div.innerHTML += '<button class="btn btn-sm" style="background:var(--text-muted);color:#fff;font-size:10px;padding:3px 6px;" onclick="moveUnitUp(' + i + ')"><i class="fas fa-chevron-up"></i></button>';
    if (i < currentUnits.length - 1) div.innerHTML += '<button class="btn btn-sm" style="background:var(--text-muted);color:#fff;font-size:10px;padding:3px 6px;" onclick="moveUnitDown(' + i + ')"><i class="fas fa-chevron-down"></i></button>';
    container.appendChild(div);
  });
}
function addUnit() {
  var name = prompt('اسم الوحدة الجديدة:');
  if (!name || !name.trim()) return;
  var maxOrder = currentUnits.reduce(function(m, u){ return Math.max(m, u.order || 0); }, 0);
  currentUnits.push({ id: 'u-' + Date.now() + '-' + Math.random().toString(36).substr(2,4), name: name.trim(), order: maxOrder + 1 });
  renderUnits();
}
function editUnit(idx) {
  var newName = prompt('تعديل اسم الوحدة:', currentUnits[idx].name);
  if (newName && newName.trim()) { currentUnits[idx].name = newName.trim(); renderUnits(); }
}
function removeUnit(idx) {
  if (!confirm('حذف الوحدة "' + currentUnits[idx].name + '"؟')) return;
  currentUnits.splice(idx, 1);
  renderUnits();
}
function moveUnitUp(idx) {
  if (idx <= 0) return;
  var tmp = currentUnits[idx]; currentUnits[idx] = currentUnits[idx-1]; currentUnits[idx-1] = tmp;
  currentUnits.forEach(function(u, i){ u.order = i + 1; });
  renderUnits();
}
function moveUnitDown(idx) {
  if (idx >= currentUnits.length - 1) return;
  var tmp = currentUnits[idx]; currentUnits[idx] = currentUnits[idx+1]; currentUnits[idx+1] = tmp;
  currentUnits.forEach(function(u, i){ u.order = i + 1; });
  renderUnits();
}
function saveUnits() {
  var courseId = document.getElementById('unitCourseId').value;
  currentUnits.forEach(function(u, i){ u.order = i + 1; });
  fetch('/api/admin/courses/' + courseId, {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ units: currentUnits })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
// Inline unit actions from course view
function editUnitName(courseId, unitId, currentName) {
  var newName = prompt('تعديل اسم الوحدة:', currentName);
  if (!newName || !newName.trim()) return;
  fetch('/api/admin/courses/' + courseId + '/units/' + unitId, {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ name: newName.trim() })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
function deleteUnit(courseId, unitId) {
  if (!confirm('حذف هذه الوحدة وجميع دروسها؟')) return;
  fetch('/api/admin/courses/' + courseId + '/units/' + unitId + '/delete', { method: 'DELETE' })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
function moveUnit(courseId, unitId, dir) {
  fetch('/api/admin/courses/' + courseId + '/units/' + unitId + '/move', {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ direction: dir })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

// ===== LESSON CRUD =====
function openLessonModal(course, lesson) {
  document.getElementById('lessonModalTitle').textContent = lesson ? 'تعديل الدرس' : 'إضافة درس - ' + course.title;
  document.getElementById('lessonCourseId').value = course.id;
  document.getElementById('lessonId').value = lesson ? lesson.id : '';
  document.getElementById('lessonTitle').value = lesson ? lesson.title : '';
  document.getElementById('lessonDescription').value = lesson ? (lesson.description || '') : '';
  document.getElementById('lessonIsFree').checked = lesson ? !!lesson.isFree : false;
  document.getElementById('lessonGuestVisible').checked = lesson ? !!lesson.guestVisible : false;
  document.getElementById('lessonDuration').value = lesson ? (lesson.duration || '') : '';
  document.getElementById('lessonQuizTimer').value = lesson ? (lesson.quizTimer || '') : '';
  document.getElementById('lessonOrder').value = lesson ? (lesson.order || '') : '';

  var isPrep = course.stage === 'إعدادية';
  document.getElementById('lessonUnitGroup').style.display = isPrep ? '' : 'none';
  document.getElementById('lessonSectionGroup').style.display = isPrep ? 'none' : '';

  if (isPrep) {
    // Populate unit selector
    var uSel = document.getElementById('lessonUnitId');
    uSel.innerHTML = '<option value="">اختر الوحدة</option>';
    (course.units || []).sort(function(a,b){ return (a.order||0) - (b.order||0); }).forEach(function(u) {
      var opt = document.createElement('option');
      opt.value = u.id;
      opt.textContent = u.name;
      if (lesson && lesson.unitId === u.id) opt.selected = true;
      uSel.appendChild(opt);
    });
    document.getElementById('lessonUnitId').value = lesson ? (lesson.unitId || '') : '';
  } else {
    // Populate section selector
    var sSel = document.getElementById('lessonSectionId');
    sSel.innerHTML = '<option value="">بدون باب</option>';
    if (course.sections) {
      course.sections.forEach(function(s) {
        var opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name;
        if (lesson && lesson.sectionId === s.id) opt.selected = true;
        sSel.appendChild(opt);
      });
    }
    document.getElementById('lessonSectionId').value = lesson ? (lesson.sectionId || '') : '';
  }

  var vc = document.getElementById('videosContainer');
  vc.innerHTML = '';
  var videos = (lesson && lesson.videos) || [];
  if (videos.length === 0) videos = [{ title: '', url: lesson ? (lesson.videoUrl || '') : '' }];
  videos.forEach(function(v){ addVideoField(v.title, v.url); });
  var pc = document.getElementById('pdfsContainer');
  pc.innerHTML = '';
  var pdfs = (lesson && lesson.pdfFiles) || [];
  if (pdfs.length === 0 && lesson && lesson.pdfUrl) pdfs = [{ title: 'مذكرة ' + (lesson.title || ''), url: lesson.pdfUrl }];
  pdfs.forEach(function(p){ addPdfField(p.title, p.url); });
  document.getElementById('lessonVideoUrl').value = lesson ? (lesson.videoUrl || '') : '';
  document.getElementById('lessonPdfUrl').value = lesson ? (lesson.pdfUrl || '') : '';
  document.getElementById('lessonModal').classList.add('show');
}
function addVideoField(title, url) {
  var container = document.getElementById('videosContainer');
  var div = document.createElement('div');
  div.style.cssText = 'display:flex;gap:8px;margin-bottom:8px;align-items:flex-end;';
  div.innerHTML = '<div class="form-group" style="flex:1;margin-bottom:0;"><label style="font-size:11px;">عنوان الفيديو</label><input class="video-title" placeholder="مثال: شرح الجزء الأول" value="' + (title || '') + '"></div><div class="form-group" style="flex:2;margin-bottom:0;"><label style="font-size:11px;">رابط YouTube Embed</label><input class="video-url" placeholder="https://www.youtube.com/embed/..." value="' + (url || '') + '"></div><button class="btn btn-sm" style="background:#ef4444;color:#fff;height:36px;width:36px;padding:0;display:flex;align-items:center;justify-content:center;flex-shrink:0;" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>';
  container.appendChild(div);
}
function addPdfField(title, url) {
  var container = document.getElementById('pdfsContainer');
  var div = document.createElement('div');
  div.style.cssText = 'display:flex;gap:8px;margin-bottom:8px;align-items:flex-end;';
  div.innerHTML = '<div class="form-group" style="flex:1;margin-bottom:0;"><label style="font-size:11px;">عنوان الملف</label><input class="pdf-title" placeholder="مثال: مذكرة الدرس" value="' + (title || '') + '"></div><div class="form-group" style="flex:2;margin-bottom:0;"><label style="font-size:11px;">رابط الملف</label><input class="pdf-url" placeholder="/files/lesson.pdf" value="' + (url || '') + '"></div><button class="btn btn-sm" style="background:#ef4444;color:#fff;height:36px;width:36px;padding:0;display:flex;align-items:center;justify-content:center;flex-shrink:0;" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>';
  container.appendChild(div);
}
function saveLesson() {
  var courseId = document.getElementById('lessonCourseId').value;
  var lessonId = document.getElementById('lessonId').value;
  var videoInputs = document.querySelectorAll('#videosContainer > div');
  var videos = [];
  videoInputs.forEach(function(v) {
    var title = v.querySelector('.video-title').value;
    var url = v.querySelector('.video-url').value;
    if (url) videos.push({ title: title || 'فيديو', url: url });
  });
  var pdfInputs = document.querySelectorAll('#pdfsContainer > div');
  var pdfFiles = [];
  pdfInputs.forEach(function(p) {
    var title = p.querySelector('.pdf-title').value;
    var url = p.querySelector('.pdf-url').value;
    if (url) pdfFiles.push({ title: title || 'ملف', url: url });
  });
  var isPrep = document.getElementById('lessonUnitGroup').style.display !== 'none';
  var data = {
    title: document.getElementById('lessonTitle').value,
    description: document.getElementById('lessonDescription').value,
    videos: videos,
    pdfFiles: pdfFiles,
    duration: document.getElementById('lessonDuration').value,
    isFree: document.getElementById('lessonIsFree').checked,
    guestVisible: document.getElementById('lessonGuestVisible').checked,
    sectionId: isPrep ? '' : document.getElementById('lessonSectionId').value,
    unitId: isPrep ? document.getElementById('lessonUnitId').value : '',
    order: parseInt(document.getElementById('lessonOrder').value) || 0,
    quizTimer: document.getElementById('lessonQuizTimer').value || null,
    videoUrl: videos.length > 0 ? videos[0].url : '',
    pdfUrl: pdfFiles.length > 0 ? pdfFiles[0].url : ''
  };
  var url = lessonId ? '/api/admin/courses/' + courseId + '/lessons/' + lessonId : '/api/admin/courses/' + courseId + '/lessons';
  var method = lessonId ? 'PUT' : 'POST';
  fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
function deleteLesson(courseId, lessonId) {
  if (!confirm('هل أنت متأكد من حذف هذا الدرس؟')) return;
  fetch('/api/admin/courses/' + courseId + '/lessons/' + lessonId, { method: 'DELETE' })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

// ===== QUIZ CRUD =====
function openQuizModal(course) {
  document.getElementById('quizModalTitle').textContent = 'بنك أسئلة - ' + course.title;
  document.getElementById('quizCourseId').value = course.id;
  document.getElementById('quizTitle').value = course.quiz ? course.quiz.title : 'اختبار شامل';
  document.getElementById('quizTimer').value = course.quiz ? (course.quiz.timerMinutes || '') : '';
  var container = document.getElementById('questionsContainer');
  var existing = container.querySelectorAll('.question-block');
  existing.forEach(function(el){ el.remove(); });
  if (course.quiz && course.quiz.questions) {
    course.quiz.questions.forEach(function(q, i){ addQuestion(q, i); });
  }
  document.getElementById('wordUploadArea').style.display = 'none';
  document.getElementById('quizModal').classList.add('show');
}
function addQuestion(q, idx) {
  var container = document.getElementById('questionsContainer');
  var div = document.createElement('div');
  div.className = 'question-block';
  div.style.cssText = 'background:var(--bg);border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid var(--border);';
  var qi = idx !== undefined ? idx : container.querySelectorAll('.question-block').length;
  div.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><strong style="color:var(--primary);">السؤال ' + (qi + 1) + '</strong><button class="btn btn-sm" style="background:#ef4444;color:#fff;font-size:11px;padding:4px 10px;" onclick="this.closest(\'.question-block\').remove()">حذف</button></div><div class="form-group"><input class="q-text" placeholder="نص السؤال" value="' + (q ? q.question : '') + '"></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">' + ['أ','ب','ج','د'].map(function(letter, oi){ return '<div class="form-group" style="margin-bottom:4px;"><label style="font-size:11px;margin-bottom:2px;">الخيار ' + letter + '</label><input class="q-opt-' + oi + '" placeholder="الخيار ' + letter + '" value="' + (q && q.options && q.options[oi] ? q.options[oi] : '') + '"></div>'; }).join('') + '</div><div class="form-group" style="margin-bottom:0;"><label style="font-size:12px;">الإجابة الصحيحة (0-3)</label><input class="q-correct" type="number" min="0" max="3" value="' + (q ? q.correct : 0) + '" style="width:80px;"></div>';
  container.appendChild(div);
}
function uploadWordFile() {
  var area = document.getElementById('wordUploadArea');
  area.style.display = area.style.display === 'none' ? 'block' : 'none';
}
function extractQuestions() {
  var content = document.getElementById('wordContent').value;
  if (!content.trim()) { alert('يرجى لصق محتوى الأسئلة أولاً'); return; }
  fetch('/api/admin/upload-questions', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ fileContent: content })
  }).then(function(r){ return r.json(); }).then(function(d){
    if (d.success && d.questions) {
      d.questions.forEach(function(q){ addQuestion(q); });
      document.getElementById('wordUploadArea').style.display = 'none';
      document.getElementById('wordContent').value = '';
      alert('تم استخراج ' + d.questions.length + ' سؤال');
    } else alert('فشل استخراج الأسئلة');
  });
}
function saveQuiz() {
  var courseId = document.getElementById('quizCourseId').value;
  var title = document.getElementById('quizTitle').value;
  var timerMinutes = parseInt(document.getElementById('quizTimer').value) || null;
  var blocks = document.querySelectorAll('.question-block');
  var questions = [];
  blocks.forEach(function(b) {
    var q = b.querySelector('.q-text').value;
    var opts = [0,1,2,3].map(function(i){ return b.querySelector('.q-opt-' + i).value; });
    var c = parseInt(b.querySelector('.q-correct').value) || 0;
    if (q && opts.some(function(o){ return o; })) questions.push({ question: q, options: opts, correct: c });
  });
  fetch('/api/admin/courses/' + courseId + '/quiz', {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ title: title, questions: questions, timerMinutes: timerMinutes })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

document.querySelectorAll('.modal-overlay').forEach(function(m) {
  m.addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });
});
</script>
</body>
</html>