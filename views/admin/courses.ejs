  document.getElementById('tab-'+tab+'-'+courseId).style.display = '';
  var btns = document.querySelectorAll('.tab-btn[data-course="'+courseId+'"]');
  btns.forEach(function(b){
    b.style.color = 'var(--text-light)';
    b.style.borderBottomColor = 'transparent';
  });
  var activeBtn = document.querySelector('.tab-btn[data-course="'+courseId+'"][data-tab="'+tab+'"]');
  if (activeBtn) {
    activeBtn.style.color = 'var(--text)';
    activeBtn.style.borderBottomColor = 'var(--accent)';
  }
}

