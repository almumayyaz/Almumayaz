function saveLesson() {
  var courseId = document.getElementById('lessonCourseId').value;
  var lessonId = document.getElementById('lessonId').value;
  var videoInputs = document.querySelectorAll('#videosContainer > div');
  var videos = [];
  videoInputs.forEach(function(v) {
    var title = v.querySelector('.video-title').value;
    var url = extractSrcFromIframe(v.querySelector('.video-url').value);
    if (url) videos.push({ title: title || 'فيديو', url: url });
  });
  var pdfInputs = document.querySelectorAll('#pdfsContainer > div');
  var pdfFiles = [];
  var chain = Promise.resolve();
  pdfInputs.forEach(function(p) {
    var title = p.querySelector('.pdf-title').value;
    var file = p.querySelector('.pdf-file').files[0];
    var existingPath = p.querySelector('.pdf-path').value;
    var existingUrl = p.querySelector('.pdf-url').value;
    if (file) {
      chain = chain.then(function() {
        return uploadPdfFile(file, 'lessons').then(function(path) {
          if (path) pdfFiles.push({ title: title || 'ملف', path: path });
        });
      });
    } else if (existingPath) {
      pdfFiles.push({ title: title || 'ملف', path: existingPath });
    } else if (existingUrl) {
      pdfFiles.push({ title: title || 'ملف', url: existingUrl });
    }
  });
  chain.then(function() {
    var quizEnabled = document.getElementById('lessonQuizEnabled').checked;
    var quizQuestions = [];
    if (quizEnabled) {
      var lqBlocks = document.querySelectorAll('#lessonQuizQuestions .question-block');
      lqBlocks.forEach(function(b) {
        var q = b.querySelector('.lq-text').value;
        var opts = [0,1,2,3].map(function(i){ return b.querySelector('.lq-opt-' + i).value; });
        var c = parseInt(b.querySelector('.lq-correct').value) || 0;
        if (q && opts.some(function(o){ return o; })) quizQuestions.push({ question: q, options: opts, correct: c });
      });
    }
    var data = {
      title: document.getElementById('lessonTitle').value,
      description: document.getElementById('lessonDescription').value,
      videos: videos,
      pdfFiles: pdfFiles,
      isFree: document.getElementById('lessonIsFree').checked,
      guestVisible: document.getElementById('lessonGuestVisible').checked,
      sectionId: document.getElementById('lessonSectionId').value,
      quiz: quizEnabled ? { enabled: true, passPercentage: parseInt(document.getElementById('lessonQuizPassPct').value) || 60, questions: quizQuestions } : null
    };
    var url = lessonId ? '/api/admin/courses/' + courseId + '/lessons/' + lessonId : '/api/admin/courses/' + courseId + '/lessons';
    var method = lessonId ? 'PUT' : 'POST';
    if (window.uploadStepSave) window.uploadStepSave();
    return fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) { if (window.uploadDone) window.uploadDone(); location.reload(); } else { if (window.uploadError) window.uploadError(d.error); alert(d.error); } })
    .catch(function(e){ if (window.uploadError) window.uploadError((e && e.message) ? e.message : e); });
}
function deleteLesson(courseId, lessonId) {
  if (!confirm('هل أنت متأكد من حذف هذا الدرس؟')) return;
  fetch('/api/admin/courses/' + courseId + '/lessons/' + lessonId, { method: 'DELETE' })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

