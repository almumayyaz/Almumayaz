<script>
function migrateSeed() {
  if (!confirm('هل أنت متأكد من ترحيل البيانات من الملفات المحلية إلى قاعدة البيانات؟')) return;
  var btn = event.target.closest('button');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  fetch('/api/admin/force-migrate', { method: 'POST' })
    .then(function(r){ return r.json(); })
    .then(function(d){ alert(d.success ? 'تم ترحيل البيانات بنجاح' : d.error); if (d.success) location.reload(); })
    .catch(function(e){ alert('خطأ: ' + e.message); })
    .finally(function(){ btn.disabled = false; btn.innerHTML = '<i class="fas fa-database"></i>'; });
}
</script><script>
function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escAttr(s) { return String(s).replace(/"/g,'&quot;').replace(/&/g,'&amp;'); }
function normalizeYouTube(src) {
  if (!src) return src;
  var m;
  if ((m = String(src).match(/youtube\.com\/embed\/([A-Za-z0-9_-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  if ((m = String(src).match(/youtu\.be\/([A-Za-z0-9_-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  if ((m = String(src).match(/youtube\.com\/watch\?(?:[^&]*&)*v=([A-Za-z0-9_-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  if ((m = String(src).match(/youtube\.com\/shorts\/([A-Za-z0-9_-]+)/))) return 'https://www.youtube.com/embed/' + m[1];
  return src;
}
function extractSrcFromIframe(v) { var m = String(v).match(/src=["']([^"']+)["']/); return normalizeYouTube(m ? m[1] : v); }
// ===== COURSE CRUD =====
function openCourseModal(course) {
  document.getElementById('courseModalTitle').textContent = course ? 'تعديل الفرع' : 'إضافة فرع جديد';
  document.getElementById('courseId').value = course ? course.id : '';
  document.getElementById('courseTitle').value = course ? course.title : '';
  document.getElementById('courseSubtitle').value = course ? (course.subtitle || '') : '';
  document.getElementById('courseDescription').value = course ? (course.description || '') : '';
  var icon = course ? (course.icon || 'fa-book') : 'fa-book';
  document.getElementById('courseIcon').value = icon;
  document.getElementById('courseColor').value = course ? (course.color || '#A07200') : '#A07200';
  document.getElementById('courseSemester').value = course ? (course.semester || 'all') : 'all';
  if (!course) {
    if ('<%= stage %>' && '<%= stage %>' !== 'all') document.getElementById('courseStage').value = '<%= stage %>';
    if ('<%= grade %>') document.getElementById('courseGrade').value = '<%= grade %>';
  }
  // Highlight selected icon
  document.querySelectorAll('.icon-option').forEach(function(o) { o.style.borderColor = 'var(--border)'; o.style.transform = ''; });
  var sel = document.querySelector('.icon-option[data-icon="' + icon.replace('fa-','') + '"]');
  if (sel) { sel.style.borderColor = 'var(--accent)'; sel.style.transform = 'scale(1.15)'; }
  document.getElementById('courseModal').classList.add('show');
}
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
function toggleCourse(id) {
  var body = document.getElementById('courseBody-' + id);
  var caret = document.getElementById('courseCaret-' + id);
  if (!body) return;
  if (body.style.display === 'none') { body.style.display = 'block'; if (caret) caret.className = 'fas fa-chevron-up'; }
  else { body.style.display = 'none'; if (caret) caret.className = 'fas fa-chevron-down'; }
}
function expandCourse(id) {
  var body = document.getElementById('courseBody-' + id);
  var caret = document.getElementById('courseCaret-' + id);
  if (body && body.style.display === 'none') { body.style.display = 'block'; if (caret) caret.className = 'fas fa-chevron-up'; }
}
function selectIcon(el, icon) {
  document.querySelectorAll('.icon-option').forEach(function(o) { o.style.borderColor = 'var(--border)'; o.style.transform = ''; });
  el.style.borderColor = 'var(--accent)'; el.style.transform = 'scale(1.15)';
  document.getElementById('courseIcon').value = 'fa-' + icon;
}
function saveCourse() {
  const id = document.getElementById('courseId').value;
  const data = {
    title: document.getElementById('courseTitle').value,
    subtitle: document.getElementById('courseSubtitle').value,
    description: document.getElementById('courseDescription').value,
    stage: document.getElementById('courseStage').value,
    grade: document.getElementById('courseGrade').value,
    semester: document.getElementById('courseSemester').value,
    icon: document.getElementById('courseIcon').value,
    color: document.getElementById('courseColor').value
  };
  const url = id ? '/api/admin/courses/' + id : '/api/admin/courses';
  const method = id ? 'PUT' : 'POST';
  fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}
function deleteCourse(id) {
  if (!confirm('هل أنت متأكد من حذف هذا الفرع وجميع دروسه؟')) return;
  fetch('/api/admin/courses/' + id, { method: 'DELETE' })
    .then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

// ===== SECTION (باب) MANAGEMENT =====
var currentSections = [];
function openSectionModal(course) {
  document.getElementById('sectionModalTitle').textContent = 'إدارة الأبواب - ' + course.title;
  document.getElementById('sectionCourseId').value = course.id;
  currentSections = (course.sections || []).map(function(s) { return { id: s.id, name: s.name, lessons: s.lessons || [] }; });
  renderSections();
  document.getElementById('sectionModal').classList.add('show');
}
function renderSections() {
  var container = document.getElementById('sectionsContainer');
  var existing = container.querySelectorAll('.section-block');
  existing.forEach(function(el) { el.remove(); });
  currentSections.forEach(function(s, i) {
    var div = document.createElement('div');
    div.className = 'section-block';
    div.style.cssText = 'background:var(--bg);border-radius:10px;padding:12px 16px;margin-bottom:8px;border:1px solid var(--border);display:flex;align-items:center;gap:10px;';
    div.innerHTML = '<span style="font-weight:600;color:var(--primary);flex:1;">' + s.name + '</span><span style="font-size:11px;color:var(--text-light);">' + (s.lessons||[]).length + ' درس</span><button class="btn btn-sm" style="background:#ef4444;color:#fff;font-size:10px;padding:3px 8px;" onclick="removeSection(' + i + ')"><i class="fas fa-times"></i></button>';
    container.appendChild(div);
  });
}
function addSection() {
  var name = prompt('اسم الباب الجديد:');
  if (!name || !name.trim()) return;
  currentSections.push({ id: 'sec-' + Date.now() + '-' + Math.random().toString(36).substr(2,4), name: name.trim(), lessons: [] });
  renderSections();
}
function removeSection(idx) {
  if (!confirm('حذف الباب "' + currentSections[idx].name + '"؟')) return;
  currentSections.splice(idx, 1);
  renderSections();
}
function saveSections() {
  var courseId = document.getElementById('sectionCourseId').value;
  fetch('/api/admin/courses/' + courseId, {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ sections: currentSections })
  }).then(function(r){ return r.json(); }).then(function(d){ if (d.success) location.reload(); else alert(d.error); });
}

// ===== LESSON CRUD =====
function openLessonModal(course, lesson) {
  document.getElementById('lessonModalTitle').textContent = lesson ? 'تعديل الدرس' : 'إضافة درس - ' + course.title;
  document.getElementById('lessonCourseId').value = course.id;
  document.getElementById('lessonId').value = lesson ? lesson.id : '';
  document.getElementById('lessonTitle').value = lesson ? lesson.title : '';
  document.getElementById('lessonDescription').value = lesson ? (lesson.description || '') : '';
  document.getElementById('lessonIsFree').checked = lesson ? !!lesson.isFree : false;
  document.getElementById('lessonGuestVisible').checked = lesson ? !!lesson.guestVisible : false;
  var sel = document.getElementById('lessonSectionId');
  sel.innerHTML = '<option value="">بدون باب</option>';
  if (course.sections) {
    course.sections.forEach(function(s) {
      var opt = document.createElement('option');
      opt.value = s.id;
      opt.textContent = s.name;
      if (lesson && lesson.sectionId === s.id) opt.selected = true;
      sel.appendChild(opt);
    });
  }
  document.getElementById('lessonSectionId').value = lesson ? (lesson.sectionId || '') : '';

  // Quiz fields
  var quiz = lesson && lesson.quiz;
  document.getElementById('lessonQuizEnabled').checked = quiz ? !!quiz.enabled : false;
  document.getElementById('lessonQuizPassPct').value = quiz ? (quiz.passPercentage || 60) : 60;
  document.getElementById('lessonQuizSettings').style.display = quiz && quiz.enabled ? '' : 'none';
  var lqContainer = document.getElementById('lessonQuizQuestions');
  var existing = lqContainer.querySelectorAll('.question-block');
  existing.forEach(function(el){ el.remove(); });
  if (quiz && quiz.questions) {
    quiz.questions.forEach(function(q, i){ addLessonQuestion(q, i); });
  }

  var vc = document.getElementById('videosContainer');
  vc.innerHTML = '';
  var videos = (lesson && lesson.videos) || [];
