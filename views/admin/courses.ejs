<%- include('../partials/header', { title: title, bodyClass: 'admin-body' }) %>
<%- include('../partials/admin-sidebar') %>
<main class="admin-content">
  <div class="page-header">
    <div>
      <h1>المحاضرات</h1>
      <p>إدارة المحتوى حسب المرحلة والصف</p>
    </div>
  </div>

<% if (!stage) { %>
  <!-- ===== STEP 1: Select Stage ===== -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    <a href="/admin/courses?stage=%D8%A5%D8%B9%D8%AF%D8%A7%D8%AF%D9%8A%D8%A9" style="display:block;text-decoration:none;padding:40px 24px;background:linear-gradient(135deg,#059669,#34d399);border-radius:var(--radius-xl);color:#fff;text-align:center;transition:var(--transition);" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
      <i class="fas fa-school" style="font-size:48px;display:block;margin-bottom:16px;"></i>
      <h2 style="font-size:28px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;">المرحلة الإعدادية</h2>
      <p style="font-size:14px;opacity:0.9;margin-top:8px;"><%= allCourses.filter(function(c){return c.stage==='إعدادية';}).length %> فرع</p>
    </a>
    <a href="/admin/courses?stage=%D8%AB%D8%A7%D9%86%D9%88%D9%8A%D8%A9" style="display:block;text-decoration:none;padding:40px 24px;background:linear-gradient(135deg,#A07200,#F6C453);border-radius:var(--radius-xl);color:#fff;text-align:center;transition:var(--transition);" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
      <i class="fas fa-graduation-cap" style="font-size:48px;display:block;margin-bottom:16px;"></i>
      <h2 style="font-size:28px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;">المرحلة الثانوية</h2>
      <p style="font-size:14px;opacity:0.9;margin-top:8px;"><%= allCourses.filter(function(c){return c.stage==='ثانوية';}).length %> فرع</p>
    </a>
  </div>

<% } else if (!grade) { %>
  <!-- ===== STEP 2: Select Grade ===== -->
  <div style="margin-bottom:20px;">
    <a href="/admin/courses" style="color:var(--accent);text-decoration:none;font-size:14px;">
      <i class="fas fa-arrow-right"></i> العودة لاختيار المرحلة
    </a>
  </div>
  <div style="background:var(--card);border-radius:var(--radius-xl);padding:24px;border:1px solid var(--border);box-shadow:var(--shadow);margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:44px;height:44px;border-radius:12px;background:<%= stage === 'إعدادية' ? 'linear-gradient(135deg,#059669,#34d399)' : 'linear-gradient(135deg,#A07200,#F6C453)' %>;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;">
        <i class="fas <%= stage === 'إعدادية' ? 'fa-school' : 'fa-graduation-cap' %>"></i>
      </div>
      <h2 style="font-size:22px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;"><%= stage === 'إعدادية' ? 'المرحلة الإعدادية' : 'المرحلة الثانوية' %></h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;">
      <% var grades = stage === 'إعدادية' ? ['الأول الإعدادي','الثاني الإعدادي','الثالث الإعدادي'] : ['الأول الثانوي','الثاني الثانوي','الثالث الثانوي']; %>
      <% grades.forEach(function(g) { 
        var count = allCourses.filter(function(c){return c.stage===stage && c.grade===g;}).length;
        var encodedStage = encodeURIComponent(stage);
        var encodedGrade = encodeURIComponent(g);
      %>
      <a href="/admin/courses?stage=<%= encodedStage %>&grade=<%= encodedGrade %>" style="display:block;text-decoration:none;padding:24px 16px;background:var(--bg);border-radius:var(--radius-lg);border:2px solid var(--border);text-align:center;transition:var(--transition);" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
        <div style="font-size:36px;font-weight:700;color:var(--primary);margin-bottom:8px;"><%= g.split(' ')[0] %></div>
        <div style="font-size:14px;font-weight:600;color:var(--text);"><%= g.split(' ').slice(1).join(' ') %></div>
        <div style="font-size:12px;color:var(--text-light);margin-top:6px;"><%= count %> فرع</div>
      </a>
      <% }) %>
    </div>
  </div>

<% } else { %>
  <!-- ===== STEP 3: Course Management with Tabs ===== -->
  <div style="margin-bottom:20px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
    <a href="/admin/courses" style="color:var(--text-light);text-decoration:none;font-size:13px;">
      <i class="fas fa-arrow-right"></i> المراحل
    </a>
    <span style="color:var(--text-muted);">/</span>
    <a href="/admin/courses?stage=<%= encodeURIComponent(stage) %>" style="color:var(--text-light);text-decoration:none;font-size:13px;">
      <%= stage === 'إعدادية' ? 'إعدادية' : 'ثانوية' %>
    </a>
    <span style="color:var(--text-muted);">/</span>
    <span style="font-size:13px;font-weight:600;color:var(--primary);"><%= grade %></span>
  </div>

  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding:16px 20px;background:var(--card);border-radius:var(--radius-lg);border:1px solid var(--border);">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:40px;height:40px;border-radius:10px;background:<%= stage === 'إعدادية' ? 'linear-gradient(135deg,#059669,#34d399)' : 'linear-gradient(135deg,#A07200,#F6C453)' %>;display:flex;align-items:center;justify-content:center;color:#fff;">
        <i class="fas <%= stage === 'إعدادية' ? 'fa-school' : 'fa-graduation-cap' %>"></i>
      </div>
      <div>
        <h2 style="font-size:18px;font-weight:700;margin:0;font-family:'Aref Ruqaa',serif;"><%= grade %></h2>
        <p style="font-size:12px;color:var(--text-light);margin:2px 0 0;"><%= courses.length %> فرع</p>
      </div>
    </div>
    <button class="btn btn-primary" onclick="openCourseModal()"><i class="fas fa-plus"></i> إضافة فرع</button>
  </div>

  <div id="coursesContainer" style="display:flex;flex-direction:column;gap:20px;">
    <% if (courses.length === 0) { %>
    <div style="text-align:center;padding:60px 20px;background:var(--card);border-radius:var(--radius-xl);border:1px solid var(--border);">
      <i class="fas fa-folder-open" style="font-size:48px;color:var(--border);display:block;margin-bottom:16px;"></i>
      <h3 style="font-size:18px;color:var(--text-light);margin-bottom:8px;">لا توجد فروع بعد</h3>
      <p style="color:var(--text-muted);font-size:14px;">أضف أول فرع للصف <strong><%= grade %></strong></p>
      <button class="btn btn-primary" onclick="openCourseModal()" style="margin-top:12px;"><i class="fas fa-plus"></i> إضافة فرع</button>
    </div>
    <% } %>
    <% courses.forEach(function(course, ci) { %>
    <div class="admin-table">
      <div style="padding:16px 20px;background:var(--bg);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:40px;height:40px;background:<%= course.color %>;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;">
            <i class="fas <%= course.icon %>"></i>
          </div>
          <div>
            <h3 style="font-size:16px;font-weight:700;color:var(--primary);margin:0;"><%= course.title %></h3>
            <div style="display:flex;align-items:center;gap:8px;margin-top:2px;">
              <span style="font-size:12px;color:var(--text-light);"><%= (course.lessons||[]).length %> درس</span>
              <% if (course.grade) { %>
              <span style="background:var(--accent-glow);color:var(--accent);font-size:11px;padding:2px 10px;border-radius:10px;font-weight:600;"><%= course.grade %></span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="admin-actions" style="flex-wrap:wrap;">
          <button class="edit" onclick="openCourseModal(<%= JSON.stringify(course) %>)"><i class="fas fa-edit"></i></button>
          <button class="delete" onclick="deleteCourse('<%= course.id %>')"><i class="fas fa-trash"></i></button>
        </div>
      </div>

      <!-- Tab Bar -->
      <div style="display:flex;border-bottom:2px solid var(--border);background:var(--card);overflow-x:auto;">
        <button class="tab-btn active" data-course="<%= course.id %>" data-tab="lessons" onclick="switchCourseTab('<%= course.id %>','lessons')" style="padding:10px 16px;font-size:13px;font-weight:600;border:none;background:none;cursor:pointer;color:var(--text);border-bottom:3px solid var(--accent);transition:var(--transition);white-space:nowrap;"><i class="fas fa-video"></i> الدروس</button>
        <button class="tab-btn" data-course="<%= course.id %>" data-tab="notes" onclick="switchCourseTab('<%= course.id %>','notes')" style="padding:10px 16px;font-size:13px;font-weight:600;border:none;background:none;cursor:pointer;color:var(--text-light);border-bottom:3px solid transparent;transition:var(--transition);white-space:nowrap;"><i class="fas fa-sticky-note"></i> المذكرات</button>
        <button class="tab-btn" data-course="<%= course.id %>" data-tab="reviews" onclick="switchCourseTab('<%= course.id %>','reviews')" style="padding:10px 16px;font-size:13px;font-weight:600;border:none;background:none;cursor:pointer;color:var(--text-light);border-bottom:3px solid transparent;transition:var(--transition);white-space:nowrap;"><i class="fas fa-star"></i> المراجعات</button>
        <button class="tab-btn" data-course="<%= course.id %>" data-tab="questionbanks" onclick="switchCourseTab('<%= course.id %>','questionbanks')" style="padding:10px 16px;font-size:13px;font-weight:600;border:none;background:none;cursor:pointer;color:var(--text-light);border-bottom:3px solid transparent;transition:var(--transition);white-space:nowrap;"><i class="fas fa-question-circle"></i> بنوك الأسئلة</button>
        <button class="tab-btn" data-course="<%= course.id %>" data-tab="quiz" onclick="switchCourseTab('<%= course.id %>','quiz')" style="padding:10px 16px;font-size:13px;font-weight:600;border:none;background:none;cursor:pointer;color:var(--text-light);border-bottom:3px solid transparent;transition:var(--transition);white-space:nowrap;"><i class="fas fa-tasks"></i> الاختبار الشامل</button>
      </div>

      <!-- Tab: Lessons -->
      <div class="tab-panel" id="tab-lessons-<%= course.id %>">
        <% if (course.sections && course.sections.length > 0) { %>
        <div style="padding:12px 20px;background:var(--accent-glow);border-bottom:1px solid var(--border);font-size:13px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:8px;">
          <i class="fas fa-sitemap"></i> <%= stage === 'إعدادية' ? 'الوحدات' : 'الأبواب' %>
          <button class="btn btn-sm" style="margin-right:auto;background:transparent;color:var(--accent);border:1px solid var(--accent);padding:2px 8px;font-size:11px;" onclick='openSectionModal(<%= JSON.stringify(course) %>)'><i class="fas fa-cog"></i> إدارة</button>
        </div>
        <div style="padding:8px 20px;display:flex;flex-wrap:wrap;gap:8px;">
          <% (course.sections||[]).forEach(function(section) { %>
          <span style="background:var(--bg);padding:4px 12px;border-radius:6px;font-size:12px;display:flex;align-items:center;gap:6px;">
            <%= section.name %>
            <span style="color:var(--text-light);font-size:10px;">(<%= (section.lessons||[]).length %>)</span>
          </span>
          <% }) %>
        </div>
        <% } else { %>
        <div style="padding:8px 20px;display:flex;gap:8px;">
          <button class="btn btn-sm" style="background:var(--accent);color:#fff;" onclick='openSectionModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة <%= stage === 'إعدادية' ? 'وحدات' : 'أبواب' %></button>
        </div>
        <% } %>
        <div style="padding:8px 20px;display:flex;gap:8px;">
          <button class="btn btn-sm" style="background:var(--primary);color:#fff;" onclick='openLessonModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة درس</button>
          <% if (course.quiz) { %>
          <button class="btn btn-sm" style="background:var(--accent-glow);color:var(--accent);border:1px solid var(--accent);" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-tasks"></i> اختبار شامل</button>
          <% } else { %>
          <button class="btn btn-sm" style="background:var(--accent-glow);color:var(--accent);border:1px solid var(--accent);" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة اختبار</button>
          <% } %>
        </div>
        <table>
          <thead>
            <tr><th>#</th><th>عنوان الدرس</th><th>المدة</th><th>الفيديو</th><th>PDF</th><th>مجاني</th><th><%= stage === 'إعدادية' ? 'الوحدة' : 'الباب' %></th><th>الإجراءات</th></tr>
          </thead>
          <tbody>
            <% (course.lessons||[]).forEach(function(l, li) { %>
            <tr>
              <td><%= li + 1 %></td>
              <td><%= l.title %></td>
              <td><%= l.duration %></td>
              <td>
                  <% if (l.videos && l.videos.length > 0) { %>
                    <% l.videos.forEach(function(v, vi) { %>
                    <div style="display:flex;align-items:center;gap:4px;margin-bottom:2px;font-size:11px;">
                      <i class="fas fa-video" style="color:var(--accent);font-size:10px;flex-shrink:0;"></i>
                      <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;"><%= v.title %></span>
                      <a href="<%= v.url %>" target="_blank" style="color:var(--accent);font-size:10px;flex-shrink:0;"><i class="fas fa-external-link-alt"></i></a>
                    </div>
                    <% }) %>
                  <% } else { %>
                    <span style="color:var(--text-muted);font-size:11px;">---</span>
                  <% } %>
              </td>
              <td>
                  <% if (l.pdfFiles && l.pdfFiles.length > 0) { %>
                    <% l.pdfFiles.forEach(function(p, pi) { %>
                    <div style="display:flex;align-items:center;gap:4px;margin-bottom:2px;font-size:11px;">
                      <i class="fas fa-file-pdf" style="color:var(--danger);font-size:10px;flex-shrink:0;"></i>
                      <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;"><%= p.title %></span>
                      <a href="<%= p.url %>" target="_blank" style="color:var(--danger);font-size:10px;flex-shrink:0;"><i class="fas fa-external-link-alt"></i></a>
                    </div>
                    <% }) %>
                  <% } else { %>
                    <span style="color:var(--text-muted);font-size:11px;">---</span>
                  <% } %>
              </td>
              <td style="font-size:12px;"><%- l.isFree ? '<span style="color:var(--success);font-weight:600;">مجاني</span>' : '---' %> <% if (l.guestVisible) { %><span style="color:var(--accent);font-weight:600;font-size:11px;"><br>زائر</span><% } %></td>
              <td style="font-size:12px;"><%= l.sectionId ? (function(){ var s = (course.sections || []).find(function(s){ return s.id === l.sectionId; }); return s ? s.name : '---'; })() : '---' %></td>
              <td>
                <div class="admin-actions">
                  <button class="edit" onclick='openLessonModal(<%= JSON.stringify(course) %>, <%= JSON.stringify(l) %>)'><i class="fas fa-edit"></i></button>
                  <button class="delete" onclick="deleteLesson('<%= course.id %>','<%= l.id %>')"><i class="fas fa-trash"></i></button>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if ((course.lessons||[]).length === 0) { %>
            <tr><td colspan="8" style="text-align:center;color:var(--text-light);">لا توجد دروس بعد</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Tab: Notes -->
      <div class="tab-panel" id="tab-notes-<%= course.id %>" style="display:none;">
        <div style="padding:12px 20px;display:flex;gap:8px;">
          <button class="btn btn-sm" style="background:var(--primary);color:#fff;" onclick='openNoteModal("<%= course.id %>")'><i class="fas fa-plus"></i> إضافة مذكرة</button>
        </div>
        <table>
          <thead>
            <tr><th>#</th><th>العنوان</th><th>الوصف</th><th>الملف</th><th>مجاني</th><th>الترتيب</th><th>الإجراءات</th></tr>
          </thead>
          <tbody id="notes-tbody-<%= course.id %>">
            <% var courseNotes = (allNotes||[]).filter(function(n){return n.courseId===course.id;}); %>
            <% courseNotes.sort(function(a,b){return (a.order||0)-(b.order||0);}); %>
            <% var ni = 0; %>
            <% courseNotes.forEach(function(n) { ni++; %>
            <tr>
              <td><%= ni %></td>
              <td><%= n.title %></td>
              <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= n.description||'---' %></td>
              <td><% if (n.fileUrl) { %><a href="<%= n.fileUrl %>" target="_blank" style="color:var(--accent);font-size:12px;"><i class="fas fa-file-pdf"></i> عرض</a><% } else { %><span style="color:var(--text-muted);">---</span><% } %></td>
              <td style="font-size:12px;"><%- n.isFree ? '<span style="color:var(--success);font-weight:600;">مجاني</span>' : '---' %></td>
              <td style="font-size:12px;"><%= n.order %></td>
              <td>
                <div class="admin-actions">
                  <button class="edit" onclick='openNoteModal("<%= course.id %>",<%= JSON.stringify(n) %>)'><i class="fas fa-edit"></i></button>
                  <button class="delete" onclick="deleteNote('<%= n.id %>')"><i class="fas fa-trash"></i></button>
                </div>
              </td>
            </tr>
            <% }); %>
            <% (course.lessons||[]).forEach(function(l) { ni++; %>
            <tr>
              <td><%= ni %></td>
              <td><%= l.title %></td>
              <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">مذكرة المحاضرة</td>
              <td><% if (l.pdfUrl) { %><a href="<%= l.pdfUrl %>" target="_blank" style="color:var(--accent);font-size:12px;"><i class="fas fa-file-pdf"></i> عرض</a><% } else { %><span style="color:var(--text-muted);">---</span><% } %></td>
              <td style="font-size:12px;"><%- l.isFree ? '<span style="color:var(--success);font-weight:600;">مجاني</span>' : '---' %></td>
              <td>
                <div class="admin-actions">
                  <span style="font-size:11px;color:var(--text-muted);"><i class="fas fa-lock"></i> تابع للدرس</span>
                </div>
              </td>
            </tr>
            <% }); %>
            <% if (ni === 0) { %>
            <tr><td colspan="7" style="text-align:center;color:var(--text-light);">لا توجد مذكرات بعد</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Tab: Reviews -->
      <div class="tab-panel" id="tab-reviews-<%= course.id %>" style="display:none;">
        <div style="padding:12px 20px;display:flex;gap:8px;">
          <button class="btn btn-sm" style="background:var(--primary);color:#fff;" onclick='openCourseReviewModal("<%= course.id %>")'><i class="fas fa-plus"></i> إضافة مراجعة</button>
        </div>
        <table>
          <thead>
            <tr><th>#</th><th>العنوان</th><th>الوصف</th><th>فيديو</th><th>PDF</th><th>اختبار</th><th>مجاني</th><th>الترتيب</th><th>الإجراءات</th></tr>
          </thead>
          <tbody id="reviews-tbody-<%= course.id %>">
            <% var courseReviews = (allReviews||[]).filter(function(r){return r.courseId===course.id || (!r.courseId && (r.stage===course.stage||r.stage==='all'||!r.stage) && r.grade===course.grade);}); %>
            <% if (courseReviews.length > 0) { %>
              <% courseReviews.sort(function(a,b){return (a.order||0)-(b.order||0);}); %>
              <% courseReviews.forEach(function(r, ri) { %>
              <tr>
                <td><%= ri+1 %></td>
                <td><%= r.title %></td>
                <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= r.desc||'---' %></td>
                <td style="font-size:12px;"><%= (r.videos&&r.videos.length>0) ? r.videos.length+' فيديو' : '---' %></td>
                <td style="font-size:12px;"><%= (r.pdfFiles&&r.pdfFiles.length>0) ? r.pdfFiles.length+' ملف' : '---' %></td>
                <td style="font-size:12px;"><%- r.quiz ? '<span style="color:var(--success);">'+r.quiz.questions.length+' سؤال</span>' : '---' %></td>
                <td style="font-size:12px;"><%- r.isFree ? '<span style="color:var(--success);font-weight:600;">مجاني</span>' : '---' %></td>
                <td style="font-size:12px;"><%= r.order||0 %></td>
                <td>
                  <div class="admin-actions">
                    <button class="edit" onclick='openCourseReviewModal("<%= course.id %>",<%= JSON.stringify(r) %>)'><i class="fas fa-edit"></i></button>
                    <button class="view" onclick='openCourseReviewQuizModal(<%= JSON.stringify(r) %>)'><i class="fas fa-tasks"></i></button>
                    <button class="delete" onclick="deleteReview('<%= r.id %>')"><i class="fas fa-trash"></i></button>
                  </div>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="9" style="text-align:center;color:var(--text-light);">لا توجد مراجعات بعد</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Tab: Question Banks -->
      <div class="tab-panel" id="tab-questionbanks-<%= course.id %>" style="display:none;">
        <div style="padding:12px 20px;display:flex;gap:8px;">
          <button class="btn btn-sm" style="background:var(--primary);color:#fff;" onclick='openQuestionBankModal("<%= course.id %>")'><i class="fas fa-plus"></i> إضافة بنك أسئلة</button>
        </div>
        <table>
          <thead>
            <tr><th>#</th><th>الاسم</th><th>الوصف</th><th>الأسئلة</th><th>المؤقت</th><th>الترتيب</th><th>الإجراءات</th></tr>
          </thead>
          <tbody id="qbanks-tbody-<%= course.id %>">
            <% var courseBanks = (allQuestionBanks||[]).filter(function(b){return b.courseId===course.id;}); %>
            <% if (courseBanks.length > 0) { %>
              <% courseBanks.sort(function(a,b){return (a.order||0)-(b.order||0);}); %>
              <% courseBanks.forEach(function(b, bi) { %>
              <tr>
                <td><%= bi+1 %></td>
                <td><%= b.title %></td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= b.description||'---' %></td>
                <td style="font-size:12px;"><%= (b.questions&&b.questions.length) ? b.questions.length+' سؤال' : '---' %></td>
                <td style="font-size:12px;"><%= b.timerMinutes ? b.timerMinutes+' د' : '---' %></td>
                <td style="font-size:12px;"><%= b.order||0 %></td>
                <td>
                  <div class="admin-actions">
                    <button class="edit" onclick='openQuestionBankModal("<%= course.id %>",<%= JSON.stringify(b) %>)'><i class="fas fa-edit"></i></button>
                    <button class="delete" onclick="deleteQuestionBank('<%= b.id %>')"><i class="fas fa-trash"></i></button>
                  </div>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="7" style="text-align:center;color:var(--text-light);">لا توجد بنوك أسئلة بعد</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Tab: Main Quiz -->
      <div class="tab-panel" id="tab-quiz-<%= course.id %>" style="display:none;">
        <div style="padding:16px 20px;text-align:center;">
          <% if (course.quiz) { %>
          <p style="color:var(--text-light);margin-bottom:12px;">الاختبار الشامل للمادة - <%= (course.quiz.questions||[]).length %> سؤال</p>
          <button class="btn btn-primary" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-edit"></i> إدارة الاختبار الشامل</button>
          <% } else { %>
          <p style="color:var(--text-muted);margin-bottom:12px;">لا يوجد اختبار شامل لهذه المادة</p>
          <button class="btn btn-primary" onclick='openQuizModal(<%= JSON.stringify(course) %>)'><i class="fas fa-plus"></i> إضافة اختبار شامل</button>
          <% } %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>
</main>

