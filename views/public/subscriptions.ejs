<%- include('../partials/header', { title: title }) %>

<section class="sub-section">
  <div class="container">
    <div class="section-header">
      <h2>خطط الاشتراك</h2>
      <p>اختر الخطة التي تناسب احتياجاتك وابدأ رحلة التفوق في اللغة العربية</p>
    </div>
    <div class="subscriptions-grid">
      <% if (subscriptions && subscriptions.length > 0) { %>
      <% subscriptions.forEach(function(sub) { %>
      <div class="sub-card <%= sub.popular ? 'popular' : '' %>">
        <% if (sub.popular) { %><div class="sub-badge">الأكثر طلباً</div><% } %>
        <div class="sub-header">
          <h3><%= sub.name %></h3>
          <div class="sub-price">
            <span class="amount"><%= sub.price %></span>
            <span class="currency"><%= sub.currency %></span>
          </div>
          <div class="sub-period"><%= sub.period %></div>
        </div>
        <ul class="sub-features">
          <% sub.features.forEach(function(f) { %>
          <li><i class="fas fa-check"></i> <%= f %></li>
          <% }) %>
        </ul>
        <a href="/register" class="btn <%= sub.popular ? 'btn-primary' : 'btn-primary' %>">اشترك الآن</a>
      </div>
      <% }) %>
      <% } else { %>
      <div style="text-align:center;padding:60px 20px;color:var(--text-muted);grid-column:1/-1;">
        <i class="fas fa-box-open" style="font-size:40px;display:block;margin-bottom:12px;opacity:0.4;"></i>
        <div style="font-size:16px;font-weight:600;">لا توجد خطط اشتراك متاحة حالياً</div>
        <p style="font-size:13px;margin-top:6px;">سيتم إضافة خطط قريباً</p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
