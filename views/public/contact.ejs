<%- include('../partials/header', { title: title }) %>

<section class="contact-section">
  <div class="container">
    <div class="section-header">
      <h2>تواصل معنا</h2>
      <p>نحن هنا للإجابة على جميع استفساراتك</p>
    </div>
    <div class="contact-grid">
      <div class="contact-info">
        <h2>معلومات الاتصال</h2>
        <p>يمكنك التواصل معنا عبر القنوات التالية وسنكون سعداء بخدمتك</p>
        <div class="contact-details">
          <div class="contact-item">
            <div class="icon"><i class="fas fa-phone"></i></div>
            <div>
              <h4>رقم الهاتف</h4>
              <span>0100 000 0000</span>
            </div>
          </div>
          <div class="contact-item">
            <div class="icon"><i class="fas fa-envelope"></i></div>
            <div>
              <h4>البريد الإلكتروني</h4>
              <span>info@lughati.com</span>
            </div>
          </div>
          <div class="contact-item">
            <div class="icon"><i class="fab fa-whatsapp"></i></div>
            <div>
              <h4>واتساب</h4>
              <span>0100 000 0000</span>
            </div>
          </div>
          <div class="contact-item">
            <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
            <div>
              <h4>العنوان</h4>
              <span>القاهرة، مصر</span>
            </div>
          </div>
        </div>
      </div>
      <form class="contact-form" method="POST" action="/contact">
        <h3>أرسل لنا رسالة</h3>
        <div style="display:none;" id="contactSuccess" style="background:rgba(22,163,74,0.1);border:1px solid rgba(22,163,74,0.2);border-radius:var(--radius);padding:16px;margin-bottom:16px;text-align:center;color:var(--success);font-weight:700;">
          <i class="fas fa-check-circle"></i> تم إرسال رسالتك بنجاح، سنتواصل معك قريباً
        </div>
        <div style="display:none;" id="contactError" style="background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.2);border-radius:var(--radius);padding:16px;margin-bottom:16px;text-align:center;color:var(--danger);font-weight:700;">
          <i class="fas fa-exclamation-circle"></i> <span id="contactErrorText"></span>
        </div>
        <div class="form-group">
          <label>الاسم بالكامل</label>
          <input type="text" id="contactName" placeholder="أدخل اسمك" required>
        </div>
        <div class="form-group">
          <label>رقم الهاتف</label>
          <input type="tel" id="contactPhone" placeholder="أدخل رقم الهاتف" required>
        </div>
        <div class="form-group">
          <label>البريد الإلكتروني</label>
          <input type="email" id="contactEmail" placeholder="أدخل البريد الإلكتروني">
        </div>
        <div class="form-group">
          <label>الرسالة</label>
          <textarea id="contactMessage" rows="4" placeholder="اكتب رسالتك هنا" required style="width:100%;padding:12px 16px;border:2px solid var(--border);border-radius:8px;font-size:14px;resize:vertical;background:var(--bg);"></textarea>
        </div>
        <button type="button" class="btn btn-primary" onclick="submitContact()">إرسال الرسالة</button>
      </form>
      <script>
      function submitContact() {
        var name = document.getElementById('contactName').value.trim();
        var phone = document.getElementById('contactPhone').value.trim();
        var email = document.getElementById('contactEmail').value.trim();
        var message = document.getElementById('contactMessage').value.trim();
        var errDiv = document.getElementById('contactError');
        var errText = document.getElementById('contactErrorText');
        errDiv.style.display = 'none';
        if (!name) { errDiv.style.display = 'block'; errText.textContent = 'يرجى إدخال الاسم'; return; }
        if (!phone) { errDiv.style.display = 'block'; errText.textContent = 'يرجى إدخال رقم الهاتف'; return; }
        if (!message) { errDiv.style.display = 'block'; errText.textContent = 'يرجى إدخال الرسالة'; return; }
        fetch('/api/contact', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({name,phone,email,message}) })
        .then(function(r){return r.json()})
        .then(function(d){
          if(d.success){ document.getElementById('contactSuccess').style.display='block'; document.querySelector('.contact-form').innerHTML='<div style="text-align:center;padding:40px 20px;"><i class="fas fa-check-circle" style="font-size:48px;color:var(--success);display:block;margin-bottom:12px;"></i><h3 style="font-weight:700;">تم الإرسال بنجاح</h3><p style="color:var(--text-light);">سنقوم بالرد عليك في أقرب وقت</p></div>'; }
          else { errDiv.style.display='block'; errText.textContent=d.error||'حدث خطأ'; }
        })
        .catch(function(){ errDiv.style.display='block'; errText.textContent='حدث خطأ في الاتصال'; });
      }
      </script>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
