<%- include('../partials/header', { title: title }) %>

<section class="section" style="padding-top: 120px;">
  <div class="container">
    <div class="section-header">
      <h2>المحاضرات</h2>
      <p>جميع محاضرات اللغة العربية للثانوية العامة في مكان واحد</p>
    </div>
    <div class="courses-grid">
      <% if (courses && courses.length > 0) { %>
      <% courses.forEach(function(course) { %>
      <a href="<%= user ? '/student/course/' + course.id : '/register' %>" class="course-card">
        <div class="course-card-header">
          <div class="icon"><i class="fas <%= course.icon %>"></i></div>
          <h3><%= course.title %></h3>
          <p><%= course.subtitle %></p>
        </div>
      </a>
      <% }) %>
      <% } else { %>
      <div style="text-align:center;padding:60px 20px;color:var(--text-muted);grid-column:1/-1;">
        <i class="fas fa-book-open" style="font-size:40px;display:block;margin-bottom:12px;opacity:0.4;"></i>
        <div style="font-size:16px;font-weight:600;">لا توجد محاضرات متاحة حالياً</div>
        <p style="font-size:13px;margin-top:6px;">سيتم إضافة المحاضرات قريباً</p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
