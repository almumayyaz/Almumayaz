  <script src="/js/main.js"></script>
  <script>
    document.querySelectorAll('.faq-question').forEach(q => {
      q.addEventListener('click', () => q.parentElement.classList.toggle('active'));
    });
    var lsTheme = localStorage.getItem('lughati-theme');
    if (lsTheme && document.documentElement.getAttribute('data-theme') !== lsTheme) {
      fetch('/api/toggle-dark-mode', { method: 'POST' }).then(r => r.json()).then(function(d) {
        setTheme(d.darkMode ? 'dark' : 'light');
      });
    }
    document.querySelectorAll('.btn-logout').forEach(btn => {
      btn.addEventListener('click', function(e) {
        if (!confirm('هل أنت متأكد من تسجيل الخروج؟')) e.preventDefault();
      });
    });
    if (typeof firebase !== 'undefined' && firebase.auth) {
      firebase.auth().onAuthStateChanged(function(user) {
        // Track Firebase auth state if needed
      });
    }
    // Firebase Cloud Messaging - push notifications
    window._initFCM = null;
    (function() {
      if (typeof firebase === 'undefined' || !firebase.messaging) return;
      if (!Notification) return;
      window._initFCM = initFCM;
      if (Notification.permission === 'granted') {
        initFCM(true);
      } else if (Notification.permission !== 'denied') {
        if (!/Android|iPhone|iPad|iPod|webOS/i.test(navigator.userAgent)) {
          Notification.requestPermission().then(function(p) {
            if (p === 'granted') initFCM(true);
          }).catch(function(e) { console.error('FCM permission error:', e); });
        }
      }
      function initFCM(silent) {
        function showToast(msg, type) {
          var t = document.createElement('div');
          t.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);background:' + (type === 'error' ? '#e74c3c' : '#2ecc71') + ';color:#fff;padding:10px 20px;border-radius:10px;font-size:13px;z-index:99999;box-shadow:0 4px 20px rgba(0,0,0,0.3);animation:slideUp 0.3s ease;text-align:center;max-width:90%;direction:rtl;';
          t.textContent = msg;
          document.body.appendChild(t);
          setTimeout(function(){ t.remove(); }, 4000);
        }
        try {
          var vapidKey = '<%= (typeof vapidKey !== 'undefined' && vapidKey) ? vapidKey : '' %>';
          // Wait for existing SW, then use it instead of firebase-messaging-sw.js
          navigator.serviceWorker.ready.then(function(reg) {
            var messaging = firebase.messaging();
            // Setup foreground handler - show toast instead of system notification
            messaging.onMessage(function(payload) {
              var title = payload.data?.title || payload.notification?.title || 'المُميز';
              var body = payload.data?.body || payload.notification?.body || '';
              // Only toast in foreground, no system notification (SW handles that)
              showToast('🔔 ' + title + (body ? ': ' + body : ''), '');
            });
            // Get token with existing SW registration
            var getTokenOpts = {serviceWorkerRegistration: reg};
            if (vapidKey) getTokenOpts.vapidKey = vapidKey;
            return messaging.getToken(getTokenOpts);
          }).then(function(token) {
              if (token) {
                fetch('/api/fcm/register', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({fcmToken: token}) })
                  .then(function(r) { return r.json(); })
                  .then(function(d) {
                    if (d.success) { if (!silent) showToast('✅ تم تفعيل الإشعارات بنجاح', ''); }
                    else { console.warn('FCM register failed:', d); if (!silent) showToast('❌ فشل تسجيل الإشعارات: ' + (d.error || 'error'), 'error'); }
                  })
                  .catch(function(e) { console.error('FCM register error:', e); if (!silent) showToast('❌ خطأ في تسجيل الإشعارات', 'error'); });
              } else {
                if (!silent) showToast('⚠️ لم يتم الحصول على رمز الإشعارات', 'error');
              }
            }).catch(function(e) {
              console.error('FCM getToken error:', e.code || e.message);
              if (e.code === 'messaging/permission-blocked') {
                if (!silent) showToast('⚠️ الإشعارات محظورة في المتصفح. اذهب للإعدادات > الإشعارات > اسمح للموقع', 'error');
              } else {
                if (!silent) showToast('❌ خطأ في تفعيل الإشعارات: ' + (e.message || e), 'error');
              }
            });
        } catch(e) { console.error('FCM init error:', e); }
      }
    })();

    // Notification enable banner (shows on mobile if permission not granted)
    (function() {
      if (!window._initFCM) return;
      if (!Notification || Notification.permission === 'granted' || Notification.permission === 'denied') return;
      var bar = document.createElement('div');
      bar.id = 'notif-bar';
      bar.style.cssText = 'position:fixed;bottom:0;left:0;right:0;background:var(--gold-gradient);color:#fff;padding:12px 20px;text-align:center;font-size:14px;z-index:9999;cursor:pointer;font-weight:700;display:flex;align-items:center;justify-content:center;gap:8px;animation:slideUp 0.3s ease;';
      bar.innerHTML = '<i class="fas fa-bell"></i> اضغط لتفعيل الإشعارات';
      var barClickHandler = function() {
        var bar = document.getElementById('notif-bar');
        if (!bar) return;
        bar.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تفعيل الإشعارات...';
        bar.onclick = null;
        if (window._initFCM) {
          window._initFCM(false);
          if (Notification.permission === 'default') {
            Notification.requestPermission().then(function(p) {
              if (p === 'granted') { window._initFCM(false); bar.remove(); }
            });
          }
        }
        setTimeout(barClickHandlerReset, 5000);
      };
      var barClickHandlerReset = function() {
        var bar = document.getElementById('notif-bar');
        if (!bar) return;
        bar.innerHTML = '<i class="fas fa-bell"></i> اضغط مرة أخرى لتفعيل الإشعارات';
        bar.onclick = barClickHandler;
      };
      bar.onclick = barClickHandler;
      document.body.appendChild(bar);
      var style = document.createElement('style');
      style.textContent = '@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}';
      document.head.appendChild(style);
    })();
  </script>
</body>
</html>
