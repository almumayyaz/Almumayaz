  <button class="sidebar-floating-toggle" id="sidebarFloatingToggle"><i class="fas fa-bars"></i></button>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/admin" class="sidebar-logo">المُميز</a>
      <button class="sidebar-close-btn" id="sidebarClose"><i class="fas fa-times"></i></button>
      <button class="sidebar-toggle-btn" id="sidebarToggle"><i class="fas fa-chevron-right"></i></button>
    </div>
    <div class="sidebar-user">
      <div class="sidebar-avatar"><%= user ? user.name.charAt(0) : 'م' %></div>
      <div class="sidebar-user-info">
        <h4><%= user ? user.name : 'محمد عفيفي' %></h4>
        <span>المدير</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">
        <i class="fas fa-tachometer-alt"></i> لوحة التحكم
      </a>
      <a href="/admin/students" class="<%= currentPath === '/admin/students' ? 'active' : '' %>">
        <i class="fas fa-users"></i> الطلاب
      </a>
      <a href="/admin/courses" class="<%= currentPath === '/admin/courses' ? 'active' : '' %>">
        <i class="fas fa-book"></i> المحاضرات
      </a>
      <a href="/admin/sub-requests" class="<%= currentPath === '/admin/sub-requests' ? 'active' : '' %>">
        <i class="fas fa-file-invoice"></i> طلبات الاشتراك
      </a>
      <a href="/admin/charge-codes" class="<%= currentPath === '/admin/charge-codes' ? 'active' : '' %>">
        <i class="fas fa-barcode"></i> أكواد الشحن
      </a>
      <a href="/admin/subscriptions" class="<%= currentPath === '/admin/subscriptions' ? 'active' : '' %>">
        <i class="fas fa-credit-card"></i> الاشتراكات
      </a>
      <a href="/admin/payments" class="<%= currentPath === '/admin/payments' ? 'active' : '' %>">
        <i class="fas fa-money-bill"></i> المدفوعات
      </a>
      <a href="/admin/announcements" class="<%= currentPath === '/admin/announcements' ? 'active' : '' %>">
        <i class="fas fa-bullhorn"></i> الإعلانات
      </a>
      <a href="/admin/quotes" class="<%= currentPath === '/admin/quotes' ? 'active' : '' %>">
        <i class="fas fa-quote-right"></i> جمل تحفيزية
      </a>
      <a href="/admin/send-notification" class="<%= currentPath === '/admin/send-notification' ? 'active' : '' %>">
        <i class="fas fa-bell"></i> إرسال إشعار
      </a>
      <a href="/admin/reviews" class="<%= currentPath === '/admin/reviews' ? 'active' : '' %>">
        <i class="fas fa-star"></i> المراجعات
      </a>
      <a href="/admin/settings" class="<%= currentPath === '/admin/settings' ? 'active' : '' %>">
        <i class="fas fa-cog"></i> الإعدادات
      </a>
      <a href="/admin/chat" class="<%= currentPath.startsWith('/admin/chat') ? 'active' : '' %>">
        <i class="fas fa-comments"></i> تواصل مع الطلاب
      </a>
      <a href="/">
        <i class="fas fa-globe"></i> الموقع العام
      </a>
      <a href="/logout" class="btn-logout">
        <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
      </a>
    </nav>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <style>
    .sidebar-floating-toggle {
      position: fixed;
      top: 80px;
      right: 0;
      z-index: 999;
      background: #D6A23D;
      color: #fff;
      border: 2px solid #fff;
      width: 40px;
      height: 40px;
      border-radius: 12px 0 0 12px;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 3px 3px 12px rgba(0,0,0,0.3);
      transition: 0.3s;
    }
    [data-theme="light"] .sidebar-floating-toggle {
      background: #C48A22;
    }
    .sidebar-floating-toggle:hover {
      transform: scale(1.05);
      box-shadow: 4px 4px 16px rgba(0,0,0,0.4);
    }
  </style>
  <script>
    (function() {
      var sidebar = document.getElementById('sidebar');
      var overlay = document.getElementById('sidebarOverlay');
      var closeBtn = document.getElementById('sidebarClose');
      var toggleBtn = document.getElementById('sidebarToggle');
      var floatingToggle = document.getElementById('sidebarFloatingToggle');

      var isMobile = function() { return window.innerWidth <= 768; };

      function openSidebar() {
        sidebar.classList.remove('collapsed');
        sidebar.classList.add('open');
        if (overlay) overlay.classList.add('show');
        document.body.style.overflow = 'hidden';
      }
      function closeSidebar() {
        sidebar.classList.remove('open');
        if (overlay) overlay.classList.remove('show');
        document.body.style.overflow = '';
      }
      function toggleCollapse() {
        sidebar.classList.toggle('collapsed');
        if (!sidebar.classList.contains('collapsed')) {
          localStorage.removeItem('admin-sidebar-toggle');
        } else {
          localStorage.setItem('admin-sidebar-toggle', 'collapsed');
        }
      }

      var toggleState = localStorage.getItem('admin-sidebar-toggle');
      if (toggleState === 'collapsed' && !isMobile()) {
        sidebar.classList.add('collapsed');
      }

      function handleToggle(e) {
        if (sidebar.classList.contains('open')) { closeSidebar(); return; }
        if (isMobile()) { openSidebar(); }
        else { toggleCollapse(); }
        e.stopPropagation();
      }

      if (toggleBtn) toggleBtn.addEventListener('click', handleToggle);
      if (floatingToggle) floatingToggle.addEventListener('click', handleToggle);

      if (closeBtn) closeBtn.addEventListener('click', function() {
        if (isMobile()) closeSidebar();
      });

      if (overlay) overlay.addEventListener('click', closeSidebar);

      sidebar.querySelectorAll('.sidebar-nav a').forEach(function(link) {
        link.addEventListener('click', function() {
          if (isMobile()) closeSidebar();
        });
      });

      window.addEventListener('resize', function() {
        if (!isMobile()) closeSidebar();
      });
    })();
  </script>
