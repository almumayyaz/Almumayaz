  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <style>
    .sidebar-floating-toggle {
      position: fixed; top: 80px; right: 0; z-index: 999;
      background: #F59E0B; color: #fff;
      border: 2px solid #fff; width: 40px; height: 40px;
      border-radius: 12px 0 0 12px; font-size: 18px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      box-shadow: 3px 3px 12px rgba(0,0,0,0.3); transition: 0.3s;
    }

    @media (max-width: 768px) { .sidebar-floating-toggle { z-index: 1002; } }
    [data-theme="dark"] .sidebar-floating-toggle { background: #D97706; border-color: rgba(255,255,255,0.2); }
    .sidebar-floating-toggle:hover { transform: scale(1.05); box-shadow: 4px 4px 16px rgba(0,0,0,0.4); }

    .sidebar-nav {
      display: flex; flex-direction: column; gap: 2px;
      padding: 8px 12px; flex: 1; overflow-y: auto;
    }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; font-size: 14px; font-weight: 500;
      color: var(--text); text-decoration: none;
      border-radius: var(--radius); transition: all 0.2s;
    }
    .sidebar-nav a i { width: 18px; text-align: center; font-size: 15px; color: var(--text-muted); transition: color 0.2s; }
    .sidebar-nav a:hover { background: var(--accent-glow); }
    [data-theme="light"] .sidebar-nav a:hover { color: #000; }
    [data-theme="dark"] .sidebar-nav a:hover { color: var(--accent); }
    .sidebar-nav a.active { background: var(--accent-glow); font-weight: 700; }
    [data-theme="dark"] .sidebar-nav a.active { color: var(--accent); }
    [data-theme="light"] .sidebar-nav a.active { color: #000; }
    .sidebar-nav a.active i { color: var(--accent); }
    .sidebar-nav a.btn-logout { color: #ef4444 !important; }
    .sidebar-nav a.btn-logout i { color: #ef4444 !important; }
    .sidebar-divider { height: 1px; background: var(--glass-border); margin: 6px 0; }
  </style>
  <script>
    (function() {
      var sidebar = document.getElementById('sidebar');
      var overlay = document.getElementById('sidebarOverlay');
      var toggle = document.getElementById('sidebarFloatingToggle');

      var isMobile = function() { return window.innerWidth <= 768; };

      function openSidebar() {
        sidebar.classList.add('open');
        if (overlay) overlay.classList.add('show');
        document.body.style.overflow = 'hidden';
      }
      function closeSidebar() {
        sidebar.classList.remove('open');
        if (overlay) overlay.classList.remove('show');
        document.body.style.overflow = '';
      }
      function toggleSidebar() {
        if (sidebar.classList.contains('open')) { closeSidebar(); return; }
        if (isMobile()) { openSidebar(); }
        else {
          sidebar.classList.toggle('collapsed');
          toggle.style.display = sidebar.classList.contains('collapsed') ? 'flex' : 'none';
          localStorage.setItem('admin-sidebar-toggle', sidebar.classList.contains('collapsed') ? 'collapsed' : '');
        }
      }

      if (!isMobile()) {
        var toggleState = localStorage.getItem('admin-sidebar-toggle');
        if (toggleState === '') { sidebar.classList.remove('collapsed'); }
        else if (toggleState === 'collapsed') { sidebar.classList.add('collapsed'); }
      }
      toggle.style.display = isMobile() ? 'flex' : (sidebar.classList.contains('collapsed') ? 'flex' : 'none');

      if (toggle) toggle.addEventListener('click', function(e) { toggleSidebar(); e.stopPropagation(); });
      if (overlay) overlay.addEventListener('click', closeSidebar);
      window.addEventListener('resize', function() {
        if (!isMobile()) closeSidebar();
        toggle.style.display = isMobile() ? 'flex' : (sidebar.classList.contains('collapsed') ? 'flex' : 'none');
      });
    })();
  </script>
