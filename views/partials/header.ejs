<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <script>document.documentElement.setAttribute('data-theme',localStorage.getItem('lughati-theme')||'<%= typeof darkMode !== 'undefined' && darkMode ? "dark" : "light" %>')</script>
  <script>if(sessionStorage.getItem('lughati-splash')==='1'){document.documentElement.classList.add('splash-hidden');}</script>
  <title><%= typeof title !== 'undefined' ? title : 'المُميز' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css">
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof themeStyle !== 'undefined' && themeStyle) { %><style id="theme-override"><%- themeStyle %></style><% } %>
  <style>
.plyr__video-embed{position:relative;overflow:hidden}
.plyr__poster{background-size:cover!important;background-position:center center!important;z-index:4!important;transition:opacity .2s ease}
.plyr--paused .plyr__poster{display:block!important;opacity:1!important;visibility:visible!important}
.plyr--youtube .plyr__controls{z-index:5;position:relative}
  </style>
  <link rel="icon" type="image/png" href="/icon.png">
  <link rel="apple-touch-icon" href="/icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" id="themeColor" content="#080B18">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="المُميز">
  <meta name="apple-mobile-web-app-orientation" content="default">
  <% if (typeof firebaseConfig !== 'undefined' && firebaseConfig.apiKey) { %>
  <script src="https://www.gstatic.com/firebasejs/11.0.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/11.0.1/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/11.0.1/firebase-messaging-compat.js"></script>
  <script>
var fbConfig = <%- JSON.stringify(firebaseConfig) %>;
firebase.initializeApp(fbConfig);
  </script>
  <% } %>
  <script>
if('serviceWorker' in navigator){
  // Clean up any stale/duplicate SW registrations (e.g. old /firebase-messaging-sw.js) so only /sw.js controls the page.
  navigator.serviceWorker.getRegistrations().then(function(regs){
    regs.forEach(function(r){
      if (r.active && r.active.scriptURL && r.active.scriptURL.indexOf('/sw.js') === -1) {
        r.unregister().catch(function(){});
      }
    });
  }).catch(function(){});
  navigator.serviceWorker.register('/sw.js').then(function(reg){try{reg.addEventListener('updatefound',function(){var nw=reg.installing;if(nw)nw.addEventListener('statechange',function(){if(nw.state==='activated'&&!sessionStorage.getItem('swRL')){sessionStorage.setItem('swRL','1');location.reload();}});});}catch(e){}});}
function toggleNav(){var sb=document.getElementById('sidebar');if(!sb){document.getElementById('navOverlay')?.classList.toggle('open');return}if(window.innerWidth>768){sb.classList.toggle('collapsed');var state=sb.classList.contains('collapsed')?'collapsed':'';localStorage.setItem('sidebar-toggle',state);localStorage.setItem('admin-sidebar-toggle',state)}else{sb.classList.toggle('open');var o=document.getElementById('sidebarOverlay');if(o)o.classList.toggle('show');document.body.style.overflow=sb.classList.contains('open')?'hidden':''}}
function setTheme(t){document.documentElement.setAttribute('data-theme',t);localStorage.setItem('lughati-theme',t);document.querySelectorAll('.theme-toggle i').forEach(i=>{i.className=t==='dark'?'fas fa-sun':'fas fa-moon'});const mb=document.querySelector('.nav-buttons-mobile .btn-outline');if(mb){mb.innerHTML=t==='dark'?'<i class="fas fa-sun"></i> الوضع النهاري':'<i class="fas fa-moon"></i> الوضع الليلي'}document.querySelectorAll('.sidebar-theme-toggle').forEach(function(e){e.innerHTML='<i class="fas '+(t==='dark'?'fa-sun':'fa-moon')+'" style="font-size:14px;"></i> '+(t==='dark'?'الوضع النهاري':'الوضع الليلي')})}
function spinTheme(el){el.classList.remove('spin');void el.offsetWidth;el.classList.add('spin')}
function toggleTheme(){fetch('/api/toggle-dark-mode',{method:'POST'}).then(r=>r.json()).then(d=>setTheme(d.darkMode?'dark':'light'))}

(function(){/* PWA install banner removed */})();</script>
</script>

<style>
.pd-wrap{display:inline-flex;direction:rtl}
.pd-trigger{width:36px;height:36px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit;font-size:13px;font-weight:800;transition:var(--transition);padding:0;line-height:1}
.pd-trigger:hover{border-color:var(--accent);background:var(--accent-glow);color:var(--accent)}
.pd-trigger:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:10px}
.pd-avatar{width:28px;height:28px;border-radius:8px;background:var(--accent-glow);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;line-height:1;flex-shrink:0;user-select:none}
.pd-avatar.lg{width:44px;height:44px;border-radius:12px;font-size:18px}
.pd-menu{position:fixed;min-width:300px;max-width:calc(100vw - 24px);background:color-mix(in srgb,var(--card) 92%,transparent);border:1px solid var(--border);border-radius:20px;box-shadow:var(--shadow-xl);padding:8px;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-6px) scale(0.97);transition:all 200ms cubic-bezier(0.22,1,0.36,1);z-index:9999;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.pd-menu.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0) scale(1)}
.pd-header{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:14px;cursor:pointer;transition:var(--transition);text-decoration:none;color:var(--text)}
.pd-header:hover{background:color-mix(in srgb,var(--accent) 10%,transparent)}
.pd-info{min-width:0;flex:1}
.pd-name{font-size:14px;font-weight:700;color:var(--text);line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pd-detail{font-size:12px;color:var(--text-light);line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:2px}
.pd-divider{height:1px;background:var(--border);margin:4px 8px}
.pd-item{display:flex;align-items:center;gap:12px;padding:9px 12px;border-radius:14px;text-decoration:none;color:var(--text);transition:var(--transition);cursor:pointer;border:none;background:none;width:100%;font-family:inherit;font-size:inherit;text-align:inherit}
.pd-item:hover{background:color-mix(in srgb,var(--accent) 10%,transparent)}
.pd-item:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:14px}
.pd-icon{width:34px;height:34px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px;color:var(--accent);transition:var(--transition)}
.pd-item:hover .pd-icon{background:var(--accent-glow)}
.pd-text{min-width:0;flex:1}
.pd-title{font-size:13px;font-weight:600;color:var(--text);line-height:1.3}
.pd-desc{font-size:11px;color:var(--text-light);line-height:1.3;margin-top:1px}
.pd-item.pd-danger{color:var(--danger)}
.pd-item.pd-danger .pd-icon{background:color-mix(in srgb,var(--danger) 12%,transparent);color:var(--danger)}
.pd-item.pd-danger:hover{background:color-mix(in srgb,var(--danger) 10%,transparent)}
.pd-item.pd-danger:hover .pd-icon{background:color-mix(in srgb,var(--danger) 20%,transparent)}
.pd-badge{font-size:10px;background:var(--danger);color:#fff;padding:1px 6px;border-radius:6px;font-weight:700;line-height:1.4}
@media(max-width:768px){.pd-menu{min-width:260px}}
</style>
<script>(function(){var m=document.getElementById('pdMenu'),t;function p(){if(!m||!t)return;var r=t.getBoundingClientRect();var l=r.left;var w=m.offsetWidth||300;var vw=window.innerWidth;l=Math.min(l,vw-w-12);l=Math.max(l,12);m.style.top=(r.bottom+8)+'px';m.style.left=l+'px'}function i(){m=document.getElementById('pdMenu');if(!m)return;var w=m.closest('.pd-wrap');t=w&&w.querySelector('.pd-trigger');document.addEventListener('keydown',function(e){if(e.key==='Escape'&&m.classList.contains('open'))c()});document.addEventListener('click',function(e){if(!m.classList.contains('open'))return;if(w&&(w===e.target||w.contains(e.target)))return;c()});window.addEventListener('scroll',function(){if(m.classList.contains('open'))p()},true);window.addEventListener('resize',function(){if(m.classList.contains('open'))p()})}function o_(){if(!m||!t)return;p();m.classList.add('open');t.setAttribute('aria-expanded','true')}function c(){if(!m)return;m.classList.remove('open');t&&t.setAttribute('aria-expanded','false')}document.readyState==='loading'?document.addEventListener('DOMContentLoaded',i):i();window.ProfileDD={toggle:function(){m&&(m.classList.contains('open')?c():o_())},open:o_,close:c}})();</script></head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <%- include('../partials/splash') %>

  <nav class="navbar">
    <div class="container">
      <div class="nav-right">
        <button class="nav-toggle" onclick="toggleNav()">
          <i class="fas fa-bars"></i>
        </button>
        <a href="/" class="nav-logo">المُميز</a>
      </div>
      <% if (user && user.role === 'admin') { %>
      <div class="nav-links">
        <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">الرئيسية</a>
        <a href="/admin/analytics" class="<%= currentPath === '/admin/analytics' ? 'active' : '' %>">تحليلات</a>
        <a href="/admin/students" class="<%= currentPath === '/admin/students' ? 'active' : '' %>">الطلاب</a>
        <a href="/admin/sub-requests" class="<%= currentPath === '/admin/sub-requests' ? 'active' : '' %>">طلبات الاشتراك</a>
        <a href="/admin/chat" class="<%= currentPath.startsWith('/admin/chat') ? 'active' : '' %>">تواصل مع الطلاب</a>
        <a href="/admin/live-sessions" class="<%= currentPath === '/admin/live-sessions' ? 'active' : '' %>">الحصص المباشرة</a>
      </div>
      <% } %>
      <div class="nav-left">
        <span class="nav-page-title<%= (typeof navPageTitle !== 'undefined' && navPageTitle === 'المُميز') ? ' brand-title' : '' %>"><%= typeof navPageTitle !== 'undefined' ? navPageTitle : '' %></span>
        <button class="theme-toggle" onclick="spinTheme(this);toggleTheme()" title="الوضع الليلي/النهاري">
          <i class="fas <%= darkMode ? 'fa-sun' : 'fa-moon' %>"></i>
        </button>
        <% if (user) { %><div class="pd-wrap">
  <button class="pd-trigger" onclick="ProfileDD.toggle()" aria-label="قائمة الحساب" aria-expanded="false"><span class="pd-avatar"><% if (user.avatar) { %><img src="<%= user.avatar %>" style="width:100%;height:100%;object-fit:cover;border-radius:8px;"><% } else { %><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %><% } %></span></button>
  <div class="pd-menu" id="pdMenu" role="menu">
    <a href="<%= user.role === 'admin' ? '/admin/settings' : '/student/profile' %>" class="pd-header" role="menuitem">
      <div class="pd-avatar lg"><% if (user.avatar) { %><img src="<%= user.avatar %>" style="width:100%;height:100%;object-fit:cover;border-radius:12px;"><% } else { %><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %><% } %></div>
      <div class="pd-info">
        <div class="pd-name"><%= user.name %></div>
        <div class="pd-detail"><%= user.grade || user.stage || user.email || '' %></div>
      </div>
    </a>
    <div class="pd-divider"></div>
    <a href="<%= user.role === 'admin' ? '/admin/settings' : '/student/profile' %>" class="pd-item" role="menuitem">
      <div class="pd-icon"><i class="fas fa-user"></i></div>
      <div class="pd-text"><div class="pd-title">الملف الشخصي</div><div class="pd-desc">عرض وتعديل بيانات الحساب</div></div>
    </a>
    <div class="pd-divider"></div>
    <a href="/support" class="pd-item" role="menuitem">
      <div class="pd-icon"><i class="fas fa-headset"></i></div>
      <div class="pd-text"><div class="pd-title">الدعم الفني</div><div class="pd-desc">تواصل مع الدعم الفني</div></div>
    </a>
    <% if (user.role === 'student') { %>
    <div class="pd-divider"></div>
    <a href="/student/notifications" class="pd-item" role="menuitem">
      <div class="pd-icon"><i class="fas fa-bell"></i></div>
      <div class="pd-text"><div class="pd-title">الإشعارات</div><div class="pd-desc">آخر الإشعارات والتنبيهات</div></div>
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><span class="pd-badge"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %>
    </a>
    <% } %>
    <div class="pd-divider"></div>
    <a href="/logout" class="pd-item pd-danger btn-logout" role="menuitem">
      <div class="pd-icon"><i class="fas fa-sign-out-alt"></i></div>
      <div class="pd-text"><div class="pd-title">تسجيل الخروج</div><div class="pd-desc">إنهاء الجلسة الحالية</div></div>
    </a>
  </div>
</div><% } %>

        <% if (!user) { %>
          <a href="/login" class="btn btn-outline">تسجيل الدخول</a>
        <% } %>
      </div>
    </div>
  </nav>
  <div class="nav-overlay" id="navOverlay">
    <a href="/admin" onclick="toggleNav()">الرئيسية</a>
    <a href="/admin/analytics" onclick="toggleNav()">تحليلات</a>
    <a href="/admin/students" onclick="toggleNav()">الطلاب</a>
    <a href="/admin/sub-requests" onclick="toggleNav()">طلبات الاشتراك</a>
    <a href="/admin/chat" onclick="toggleNav()">تواصل مع الطلاب</a>
    <a href="/admin/live-sessions" onclick="toggleNav()">الحصص المباشرة</a>
    <div class="nav-buttons-mobile">
      <button class="btn btn-outline" onclick="toggleTheme();toggleNav();" style="justify-content:center;">
        <i class="fas <%= darkMode ? 'fa-sun' : 'fa-moon' %>"></i> <%= darkMode ? 'الوضع النهاري' : 'الوضع الليلي' %>
      </button>
      <% if (user) { %>
        <a href="<%= user.role === 'admin' ? '/admin' : (user.role === 'parent' ? '/parent/dashboard' : '/student') %>" class="btn btn-primary" onclick="toggleNav()">
          <i class="fas fa-user"></i> <%= user.name %>
        </a>
        <a href="/logout" class="btn btn-outline btn-logout" onclick="toggleNav()">
          <i class="fas fa-sign-out-alt"></i> خروج
        </a>
      <% } else { %>
          <a href="/login" class="btn btn-outline" onclick="toggleNav()">تسجيل الدخول</a>
        <a href="/parent-login" class="btn btn-outline" onclick="toggleNav()" style="font-size:13px;"><i class="fas fa-user-friends"></i> دخول ولي الأمر</a>
      <% } %>
    </div>
  </div>
