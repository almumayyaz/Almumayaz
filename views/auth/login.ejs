<%- include('../partials/header', { title: title }) %>

<section class="auth-section">
  <div class="auth-card">
    <a href="/" class="nav-logo">المُميز</a>
    <h2><%= typeof parentLogin !== 'undefined' && parentLogin ? 'تسجيل دخول ولي الأمر' : 'تسجيل الدخول' %></h2>
    <p><%= typeof parentLogin !== 'undefined' && parentLogin ? 'لمتابعة أداء ابنك في المنصة' : 'أهلاً بك مرة أخرى في منصة المُميز' %></p>
    <% if (error) { %><div class="auth-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <% if (typeof firebaseConfig !== 'undefined' && firebaseConfig.apiKey) { %>
    <div id="firebaseAuthSection">
      <div class="form-group">
        <label>البريد الإلكتروني</label>
        <input type="email" id="firebaseEmail" placeholder="أدخل البريد الإلكتروني" class="form-input" dir="ltr">
      </div>
      <div class="form-group">
        <label>كلمة المرور</label>
        <input type="password" id="firebasePassword" placeholder="أدخل كلمة المرور" class="form-input" dir="ltr">
      </div>
      <button class="btn btn-primary" onclick="firebaseLogin()" style="width:100%;margin-bottom:8px;">
        <i class="fas fa-sign-in-alt"></i> <%= typeof parentLogin !== 'undefined' && parentLogin ? 'دخول ولي الأمر' : 'تسجيل الدخول' %>
      </button>
      <div style="text-align:center;margin-bottom:12px;">
        <a href="#" onclick="resetPassword();return false;" style="font-size:13px;color:var(--accent);text-decoration:none;">نسيت كلمة المرور؟</a>
      </div>
      <div id="firebaseLoginError" class="auth-error" style="display:none;"></div>
      <div id="resetMessage" style="display:none;padding:12px;border-radius:8px;text-align:center;font-size:13px;font-weight:600;"></div>
    </div>
    <% } %>
    <div class="auth-footer">
      <% if (typeof parentLogin !== 'undefined' && parentLogin) { %>
        طالب؟ <a href="/login">تسجيل دخول الطالب</a>
      <% } else { %>
        ليس لديك حساب؟ <a href="/register">إنشاء حساب جديد</a>
        <br>
        <span style="font-size:13px;">ولي أمر؟ <a href="/parent-login">دخول ولي الأمر</a></span>
      <% } %>
    </div>
  </div>
</section>

<!-- Password Reset Modal -->
<div class="modal-overlay" id="resetModal">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <h3><i class="fas fa-key"></i> إعادة تعيين كلمة المرور</h3>
      <button class="modal-close" onclick="closeResetModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div id="resetModalBody">
        <p style="font-size:14px;color:var(--text-light);margin-bottom:16px;">أدخل بريدك الإلكتروني المسجل وسنرسل لك رابطاً لإعادة تعيين كلمة المرور.</p>
        <div class="form-group">
          <label>البريد الإلكتروني</label>
          <input type="email" id="resetEmail" class="form-input" placeholder="example@email.com" dir="ltr">
        </div>
        <div id="resetModalError" style="display:none;background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.2);border-radius:8px;padding:12px;margin-bottom:12px;text-align:center;font-size:13px;color:var(--danger);"></div>
        <button class="btn btn-primary" onclick="sendResetEmail()" id="resetBtn" style="width:100%;"><i class="fas fa-paper-plane"></i> إرسال رابط التعيين</button>
      </div>
      <div id="resetSentBody" style="display:none;text-align:center;padding:24px 12px;">
        <i class="fas fa-envelope" style="font-size:48px;color:var(--success);display:block;margin-bottom:12px;"></i>
        <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;">تم الإرسال ✅</h3>
        <p style="font-size:14px;color:var(--text-light);margin-bottom:12px;">تم إرسال رابط إعادة تعيين كلمة المرور إلى بريدك الإلكتروني.</p>
        <p style="font-size:13px;background:rgba(234,179,8,0.1);border:1px solid rgba(234,179,8,0.2);border-radius:8px;padding:12px;color:#a16207;">
          <i class="fas fa-exclamation-triangle"></i> <strong>تنبيه:</strong> إذا لم تجد الرسالة في صندوق الوارد، يرجى التحقق من <strong>البريد المزعج (Spam)</strong>.
        </p>
        <button class="btn btn-primary" onclick="closeResetModal()" style="margin-top:12px;"><i class="fas fa-check"></i> تم</button>
      </div>
    </div>
  </div>
</div>

<% if (typeof firebaseConfig !== 'undefined' && firebaseConfig.apiKey) { %>
<script>
function firebaseLogin() {
  const email = document.getElementById('firebaseEmail').value.trim();
  const password = document.getElementById('firebasePassword').value;
  const errorDiv = document.getElementById('firebaseLoginError');

  if (!email || !password) { errorDiv.style.display = 'block'; errorDiv.textContent = 'يرجى إدخال البريد الإلكتروني وكلمة المرور'; return; }

  const btn = document.querySelector('#firebaseAuthSection .btn-primary');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تسجيل الدخول...';

  firebase.auth().signInWithEmailAndPassword(email, password)
    .then(function(result) {
      if (!result.user.emailVerified) {
        firebase.auth().signOut();
        result.user.sendEmailVerification().catch(function(){});
        throw new Error('verify-email');
      }
      return result.user.getIdToken();
    })
    .then(function(idToken) {
      return fetch('/api/auth/firebase-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idToken })
      });
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) { window.location.href = data.redirect; }
      else { errorDiv.style.display = 'block'; errorDiv.textContent = 'فشل تسجيل الدخول'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> تسجيل الدخول'; }
    })
    .catch(function(error) {
      console.error(error);
      errorDiv.style.display = 'block';
      if (error.message === 'verify-email') {
        errorDiv.innerHTML = 'البريد الإلكتروني غير مؤكد. تم إعادة إرسال رابط التأكيد، يرجى التحقق من بريدك (أو البريد المزعج).';
      } else if (error.code === 'auth/user-not-found') errorDiv.textContent = 'لا يوجد حساب بهذا البريد الإلكتروني';
      else if (error.code === 'auth/wrong-password') errorDiv.textContent = 'كلمة المرور غير صحيحة';
      else if (error.code === 'auth/invalid-email') errorDiv.textContent = 'البريد الإلكتروني غير صحيح';
      else if (error.code === 'auth/too-many-requests') errorDiv.textContent = 'تم حظر تسجيل الدخول مؤقتاً، حاول لاحقاً';
      else errorDiv.textContent = 'فشل تسجيل الدخول: ' + error.message;
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> تسجيل الدخول';
    });
}

function resetPassword() {
  document.getElementById('resetEmail').value = '';
  document.getElementById('resetModalError').style.display = 'none';
  document.getElementById('resetModalBody').style.display = 'block';
  document.getElementById('resetSentBody').style.display = 'none';
  document.getElementById('resetModal').classList.add('show');
  setTimeout(function(){ document.getElementById('resetEmail').focus(); }, 300);
}

function closeResetModal() {
  document.getElementById('resetModal').classList.remove('show');
}

function sendResetEmail() {
  var email = document.getElementById('resetEmail').value.trim();
  var errDiv = document.getElementById('resetModalError');
  var btn = document.getElementById('resetBtn');
  errDiv.style.display = 'none';
  if (!email) { errDiv.style.display = 'block'; errDiv.textContent = 'يرجى إدخال البريد الإلكتروني'; return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإرسال...';
  firebase.auth().sendPasswordResetEmail(email)
    .then(function() {
      document.getElementById('resetModalBody').style.display = 'none';
      document.getElementById('resetSentBody').style.display = 'block';
    })
    .catch(function(error) {
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال رابط التعيين';
      errDiv.style.display = 'block';
      if (error.code === 'auth/user-not-found') errDiv.textContent = 'لا يوجد حساب بهذا البريد الإلكتروني';
      else if (error.code === 'auth/invalid-email') errDiv.textContent = 'البريد الإلكتروني غير صحيح';
      else errDiv.textContent = 'فشل إرسال الرابط: ' + error.message;
    });
}
</script>
<% } %>

<%- include('../partials/footer') %>
