<%- include('../partials/header', { title: title }) %>

<section class="auth-section">
  <div class="auth-card">
    <a href="/" class="nav-logo">المُميز</a>
    <h2><%= typeof parentLogin !== 'undefined' && parentLogin ? 'تسجيل دخول ولي الأمر' : 'تسجيل الدخول' %></h2>
    <p><%= typeof parentLogin !== 'undefined' && parentLogin ? 'لمتابعة أداء ابنك في المنصة' : 'أهلاً بك مرة أخرى في منصة المُميز' %></p>
    <% if (error) { %><div class="auth-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <% if (typeof parentLogin !== 'undefined' && parentLogin) { %>
    <!-- Parent Login (phone + password) -->
    <div id="parentLoginSection">
      <div class="form-group">
        <label>رقم الهاتف</label>
        <input type="tel" id="parentLoginPhone" placeholder="أدخل رقم الهاتف" class="form-input" dir="ltr">
      </div>
      <div class="form-group">
        <label>كلمة المرور</label>
        <input type="password" id="parentLoginPassword" placeholder="أدخل كلمة المرور" class="form-input" dir="ltr">
      </div>
      <button class="btn btn-primary" onclick="parentLogin()" style="width:100%;margin-bottom:8px;">
        <i class="fas fa-sign-in-alt"></i> دخول ولي الأمر
      </button>
      <div id="parentLoginError" class="auth-error" style="display:none;"></div>
    </div>
    <% } else if (typeof firebaseConfig !== 'undefined' && firebaseConfig.apiKey) { %>
    <div id="firebaseAuthSection">
      <div class="form-group">
        <label>البريد الإلكتروني</label>
        <input type="email" id="firebaseEmail" placeholder="أدخل البريد الإلكتروني" class="form-input" dir="ltr">
      </div>
      <div class="form-group">
        <label>كلمة المرور</label>
        <input type="password" id="firebasePassword" placeholder="أدخل كلمة المرور" class="form-input" dir="ltr">
      </div>
      <button class="btn btn-primary" onclick="firebaseLogin()" style="width:100%;margin-bottom:8px;">
        <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
      </button>
      <div style="text-align:center;margin-bottom:12px;">
        <a href="#" onclick="resetPassword();return false;" style="font-size:13px;color:var(--accent);text-decoration:none;">نسيت كلمة المرور؟</a>
      </div>
      <div id="firebaseLoginError" class="auth-error" style="display:none;"></div>
      <div id="resetMessage" style="display:none;padding:12px;border-radius:8px;text-align:center;font-size:13px;font-weight:600;"></div>
      <div id="loginVerifyBox" style="display:none;margin-top:10px;padding:14px;border:1px dashed var(--border);border-radius:10px;">
        <p style="font-size:13px;color:var(--text-light);margin-bottom:10px;">بريدك غير مؤكد. أدخل كود التأكيد المرسل إلى إيميلك:</p>
        <div class="form-group">
          <input type="text" id="loginVerifyCode" class="form-input" placeholder="الكود المكوّن من 6 أرقام" dir="ltr" style="text-align:center;letter-spacing:6px;font-size:18px;">
        </div>
        <button class="btn btn-primary" onclick="verifyLoginEmail()" id="loginVerifyBtn" style="width:100%;"><i class="fas fa-check"></i> تأكيد البريد</button>
        <div id="loginVerifyError" class="auth-error" style="display:none;"></div>
      </div>
    </div>
    <% } %>
    <div class="auth-footer">
      <% if (typeof parentLogin !== 'undefined' && parentLogin) { %>
        طالب؟ <a href="/login">تسجيل دخول الطالب</a>
      <% } else { %>
        ليس لديك حساب؟ <a href="/register">إنشاء حساب جديد</a>
        <br>
        <span style="font-size:13px;">ولي أمر؟ <a href="/parent-login">دخول ولي الأمر</a></span>
      <% } %>
    </div>
  </div>
</section>

<!-- Password Reset Modal -->
<div class="modal-overlay" id="resetModal">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <h3><i class="fas fa-key"></i> إعادة تعيين كلمة المرور</h3>
      <button class="modal-close" onclick="closeResetModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div id="resetModalBody">
        <p style="font-size:14px;color:var(--text-light);margin-bottom:16px;">أدخل بريدك الإلكتروني المسجل وسنرسل لك كوداً لإعادة تعيين كلمة المرور.</p>
        <div class="form-group">
          <label>البريد الإلكتروني</label>
          <input type="email" id="resetEmail" class="form-input" placeholder="example@email.com" dir="ltr">
        </div>
        <div id="resetModalError" style="display:none;background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.2);border-radius:8px;padding:12px;margin-bottom:12px;text-align:center;font-size:13px;color:var(--danger);"></div>
        <button class="btn btn-primary" onclick="sendResetCode()" id="resetBtn" style="width:100%;"><i class="fas fa-paper-plane"></i> إرسال الكود</button>
      </div>
      <div id="resetCodeBody" style="display:none;">
        <p style="font-size:14px;color:var(--text-light);margin-bottom:14px;">أدخل الكود المرسل وكلمة المرور الجديدة:</p>
        <div class="form-group">
          <label>كود التأكيد</label>
          <input type="text" id="resetCodeInput" class="form-input" placeholder="الكود المكوّن من 6 أرقام" dir="ltr" style="text-align:center;letter-spacing:6px;font-size:18px;">
        </div>
        <div class="form-group">
          <label>كلمة المرور الجديدة</label>
          <input type="password" id="resetNewPassword" class="form-input" placeholder="كلمة المرور الجديدة" minlength="6">
        </div>
        <div id="resetCodeError" style="display:none;background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.2);border-radius:8px;padding:12px;margin-bottom:12px;text-align:center;font-size:13px;color:var(--danger);"></div>
        <button class="btn btn-primary" onclick="confirmReset()" id="resetConfirmBtn" style="width:100%;"><i class="fas fa-key"></i> تعيين كلمة المرور</button>
      </div>
      <div id="resetSentBody" style="display:none;text-align:center;padding:24px 12px;">
        <i class="fas fa-check-circle" style="font-size:48px;color:var(--success);display:block;margin-bottom:12px;"></i>
        <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;">تم تغيير كلمة المرور ✅</h3>
        <p style="font-size:14px;color:var(--text-light);margin-bottom:12px;">يمكنك الآن تسجيل الدخول بكلمة المرور الجديدة.</p>
        <p style="font-size:13px;background:rgba(234,179,8,0.1);border:1px solid rgba(234,179,8,0.2);border-radius:8px;padding:12px;color:#a16207;">
          <i class="fas fa-exclamation-triangle"></i> <strong>تنبيه:</strong> إذا لم تجد الرسالة في صندوق الوارد، يرجى التحقق من <strong>البريد المزعج (Spam)</strong>.
        </p>
        <a href="/login" class="btn btn-primary" style="margin-top:12px;"><i class="fas fa-sign-in-alt"></i> تسجيل الدخول</a>
      </div>
    </div>
  </div>
</div>

<% if (typeof parentLogin !== 'undefined' && parentLogin) { %>
<script>
function parentLogin() {
  var phone = document.getElementById('parentLoginPhone').value.trim();
  var password = document.getElementById('parentLoginPassword').value;
  var errorDiv = document.getElementById('parentLoginError');
  if (!phone || !password) { errorDiv.style.display = 'block'; errorDiv.textContent = 'يرجى إدخال رقم الهاتف وكلمة المرور'; return; }
  var btn = document.querySelector('#parentLoginSection .btn-primary');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تسجيل الدخول...';
  fetch('/api/auth/parent-login', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ phone: phone, password: password })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) { window.location.href = d.redirect; }
    else { errorDiv.style.display = 'block'; errorDiv.textContent = d.error || 'فشل تسجيل الدخول'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> دخول ولي الأمر'; }
  }).catch(function() {
    errorDiv.style.display = 'block'; errorDiv.textContent = 'فشل الاتصال بالخادم'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> دخول ولي الأمر';
  });
}
</script>
<% } else if (typeof firebaseConfig !== 'undefined' && firebaseConfig.apiKey) { %>
<script>
function firebaseLogin() {
  const email = document.getElementById('firebaseEmail').value.trim();
  const password = document.getElementById('firebasePassword').value;
  const errorDiv = document.getElementById('firebaseLoginError');

  if (!email || !password) { errorDiv.style.display = 'block'; errorDiv.textContent = 'يرجى إدخال البريد الإلكتروني وكلمة المرور'; return; }

  const btn = document.querySelector('#firebaseAuthSection .btn-primary');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تسجيل الدخول...';

  firebase.auth().signInWithEmailAndPassword(email, password)
    .then(function(result) {
      // Verification is optional (confirmation code sent at registration); do not block login.
      return result.user.getIdToken();
    })
    .then(function(idToken) {
      return fetch('/api/auth/firebase-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idToken })
      });
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) { window.location.href = data.redirect; }
      else if (data.error === 'email_not_verified') {
        btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> تسجيل الدخول';
        errorDiv.style.display = 'none';
        showLoginVerify(data.email);
      }
      else { errorDiv.style.display = 'block'; errorDiv.textContent = (data && data.error) || 'فشل تسجيل الدخول'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> تسجيل الدخول'; }
    })
    .catch(function(error) {
      console.error(error);
      if (error && error.verifyShown) return;
      errorDiv.style.display = 'block';
      if (error.code === 'auth/user-not-found') errorDiv.textContent = 'لا يوجد حساب بهذا البريد الإلكتروني';
      else if (error.code === 'auth/wrong-password') errorDiv.textContent = 'كلمة المرور غير صحيحة';
      else if (error.code === 'auth/invalid-email') errorDiv.textContent = 'البريد الإلكتروني غير صحيح';
      else if (error.code === 'auth/too-many-requests') errorDiv.textContent = 'تم حظر تسجيل الدخول مؤقتاً، حاول لاحقاً';
      else errorDiv.textContent = 'فشل تسجيل الدخول: ' + error.message;
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> تسجيل الدخول';
    });
}

function showLoginVerify(email) {
  var errorDiv = document.getElementById('firebaseLoginError');
  errorDiv.style.display = 'none';
  document.getElementById('loginVerifyBox').style.display = 'block';
  document.getElementById('loginVerifyBtn').disabled = true;
  document.getElementById('loginVerifyBtn').innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري إرسال الكود...';
  fetch('/api/auth/send-verify-code', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: email })
  }).then(function(r) { return r.json(); }).then(function(d) {
    document.getElementById('loginVerifyBtn').disabled = false;
    document.getElementById('loginVerifyBtn').innerHTML = '<i class="fas fa-check"></i> تأكيد البريد';
    if (!d.success) {
      document.getElementById('loginVerifyError').style.display = 'block';
      document.getElementById('loginVerifyError').textContent = d.error || 'فشل إرسال الكود';
    }
  }).catch(function() {
    document.getElementById('loginVerifyBtn').disabled = false;
    document.getElementById('loginVerifyBtn').innerHTML = '<i class="fas fa-check"></i> تأكيد البريد';
    document.getElementById('loginVerifyError').style.display = 'block';
    document.getElementById('loginVerifyError').textContent = 'فشل الاتصال بالخادم';
  });
  setTimeout(function(){ document.getElementById('loginVerifyCode').focus(); }, 200);
}

function verifyLoginEmail() {
  var email = document.getElementById('firebaseEmail').value.trim();
  var code = document.getElementById('loginVerifyCode').value.trim();
  var err = document.getElementById('loginVerifyError');
  var btn = document.getElementById('loginVerifyBtn');
  err.style.display = 'none';
  if (!code) { err.style.display = 'block'; err.textContent = 'يرجى إدخال الكود'; return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التأكيد...';
  fetch('/api/auth/verify-email', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: email, code: code })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) { window.location.href = '/student'; }
    else { err.style.display = 'block'; err.textContent = d.error || 'فشل التأكيد'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> تأكيد البريد'; }
  }).catch(function() {
    err.style.display = 'block'; err.textContent = 'فشل الاتصال بالخادم'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> تأكيد البريد';
  });
}

function resetPassword() {
  document.getElementById('resetEmail').value = '';
  document.getElementById('resetModalError').style.display = 'none';
  document.getElementById('resetModalBody').style.display = 'block';
  document.getElementById('resetCodeBody').style.display = 'none';
  document.getElementById('resetSentBody').style.display = 'none';
  document.getElementById('resetModal').classList.add('show');
  setTimeout(function(){ document.getElementById('resetEmail').focus(); }, 300);
}

function closeResetModal() {
  document.getElementById('resetModal').classList.remove('show');
}

function sendResetCode() {
  var email = document.getElementById('resetEmail').value.trim();
  var errDiv = document.getElementById('resetModalError');
  var btn = document.getElementById('resetBtn');
  errDiv.style.display = 'none';
  if (!email) { errDiv.style.display = 'block'; errDiv.textContent = 'يرجى إدخال البريد الإلكتروني'; return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإرسال...';
  fetch('/api/auth/forgot-password', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: email })
  }).then(function(r) { return r.json().then(function(d){ return { r:r, d:d }; }); }).then(function(o) {
    if (o.r.ok) {
      document.getElementById('resetModalBody').style.display = 'none';
      document.getElementById('resetCodeBody').style.display = 'block';
    } else {
      errDiv.style.display = 'block';
      errDiv.textContent = (o.d && o.d.error) || 'فشل إرسال الكود';
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال الكود';
    }
  }).catch(function() {
    errDiv.style.display = 'block'; errDiv.textContent = 'فشل الاتصال بالخادم';
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> إرسال الكود';
  });
}

function confirmReset() {
  var email = document.getElementById('resetEmail').value.trim();
  var code = document.getElementById('resetCodeInput').value.trim();
  var newPassword = document.getElementById('resetNewPassword').value;
  var errDiv = document.getElementById('resetCodeError');
  var btn = document.getElementById('resetConfirmBtn');
  errDiv.style.display = 'none';
  if (!code || !newPassword) { errDiv.style.display = 'block'; errDiv.textContent = 'يرجى إدخال الكود وكلمة المرور الجديدة'; return; }
  if (newPassword.length < 6) { errDiv.style.display = 'block'; errDiv.textContent = 'كلمة المرور يجب ألا تقل عن 6 أحرف'; return; }
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التعيين...';
  fetch('/api/auth/reset-password', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: email, code: code, newPassword: newPassword })
  }).then(function(r) { return r.json().then(function(d){ return { r:r, d:d }; }); }).then(function(o) {
    if (o.r.ok) {
      document.getElementById('resetCodeBody').style.display = 'none';
      document.getElementById('resetSentBody').style.display = 'block';
    } else {
      errDiv.style.display = 'block';
      errDiv.textContent = (o.d && o.d.error) || 'فشل تغيير كلمة المرور';
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-key"></i> تعيين كلمة المرور';
    }
  }).catch(function() {
    errDiv.style.display = 'block'; errDiv.textContent = 'فشل الاتصال بالخادم';
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-key"></i> تعيين كلمة المرور';
  });
}
</script>
<% } %>

<%- include('../partials/footer') %>
