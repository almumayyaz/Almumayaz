<%- include('../partials/header', { title: title }) %>

<section class="auth-section">
  <div class="auth-card">
    <a href="/" class="nav-logo">المُميز</a>
    <div class="auth-tabs">
      <button class="auth-tab <%= defaultTab === 'login' ? 'active' : '' %>" onclick="switchTab('login')" id="tabLogin">تسجيل الدخول</button>
      <button class="auth-tab <%= defaultTab === 'register' ? 'active' : '' %>" onclick="switchTab('register')" id="tabRegister">إنشاء حساب</button>
    </div>

    <% if (error) { %><div class="auth-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

    <div class="form-group">
      <label>البريد الإلكتروني</label>
      <input type="email" id="authEmail" placeholder="أدخل البريد الإلكتروني" class="form-input" dir="ltr">
    </div>
    <div class="form-group">
      <label>كلمة المرور</label>
      <input type="password" id="authPassword" placeholder="أدخل كلمة المرور" class="form-input" dir="ltr">
    </div>

    <div id="registerFields" style="display:none;">
      <div class="form-group">
        <label>اسم الطالب</label>
        <input type="text" id="regName" placeholder="أدخل اسمك بالكامل" class="form-input">
      </div>
      <div class="form-group">
        <label>رقم الهاتف (اختياري)</label>
        <input type="tel" id="regPhone" placeholder="أدخل رقم الهاتف" class="form-input">
      </div>
      <div class="form-group">
        <label>رقم ولي الأمر</label>
        <input type="tel" id="regParentPhone" placeholder="أدخل رقم ولي الأمر" class="form-input">
      </div>
      <div class="form-group">
        <label>الصف الدراسي</label>
        <select id="regGrade" class="form-input">
          <option value="">اختر الصف الدراسي</option>
          <option value="الأول الثانوي">الأول الثانوي</option>
          <option value="الثاني الثانوي">الثاني الثانوي</option>
          <option value="الثالث الثانوي">الثالث الثانوي</option>
        </select>
      </div>
    </div>

    <button class="btn btn-primary" onclick="handleAuth()" id="authBtn" style="width:100%;margin-bottom:12px;">
      <i class="fas fa-sign-in-alt"></i> <span id="authBtnText">تسجيل الدخول</span>
    </button>
    <div id="authError" class="auth-error" style="display:none;"></div>
  </div>
</section>

<script>
let currentTab = '<%= defaultTab %>' || 'login';

function switchTab(tab) {
  currentTab = tab;
  document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
  document.getElementById('registerFields').style.display = tab === 'register' ? 'block' : 'none';
  const btn = document.getElementById('authBtn');
  const txt = document.getElementById('authBtnText');
  if (tab === 'login') {
    btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> <span id="authBtnText">تسجيل الدخول</span>';
  } else {
    btn.innerHTML = '<i class="fas fa-user-plus"></i> <span id="authBtnText">إنشاء الحساب</span>';
  }
  document.getElementById('authError').style.display = 'none';
}

function handleAuth() {
  const email = document.getElementById('authEmail').value.trim();
  const password = document.getElementById('authPassword').value;
  const errorDiv = document.getElementById('authError');

  if (!email || !password) {
    errorDiv.style.display = 'block';
    errorDiv.textContent = 'يرجى إدخال البريد الإلكتروني وكلمة المرور';
    return;
  }

  const btn = document.getElementById('authBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري المعالجة...';

  if (currentTab === 'login') {
    firebase.auth().signInWithEmailAndPassword(email, password)
      .then(function(result) {
        return result.user.getIdToken().then(function(idToken) {
          return fetch('/api/auth/firebase-login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idToken })
          });
        });
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) { window.location.href = data.redirect; }
        else { errorDiv.style.display = 'block'; errorDiv.textContent = 'فشل تسجيل الدخول'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> <span>تسجيل الدخول</span>'; }
      })
      .catch(function(error) {
        errorDiv.style.display = 'block';
        if (error.code === 'auth/user-not-found') errorDiv.textContent = 'لا يوجد حساب بهذا البريد الإلكتروني';
        else if (error.code === 'auth/wrong-password') errorDiv.textContent = 'كلمة المرور غير صحيحة';
        else if (error.code === 'auth/invalid-email') errorDiv.textContent = 'البريد الإلكتروني غير صحيح';
        else if (error.code === 'auth/too-many-requests') errorDiv.textContent = 'تم حظر تسجيل الدخول مؤقتاً، حاول لاحقاً';
        else errorDiv.textContent = 'فشل تسجيل الدخول: ' + error.message;
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> <span>تسجيل الدخول</span>';
      });
  } else {
    const name = document.getElementById('regName').value.trim();
    const phone = document.getElementById('regPhone').value.trim();
    const parentPhone = document.getElementById('regParentPhone').value.trim();
    const grade = document.getElementById('regGrade').value;

    if (!name || !parentPhone || !grade) {
      errorDiv.style.display = 'block';
      errorDiv.textContent = 'يرجى ملء جميع الحقول المطلوبة';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-user-plus"></i> <span>إنشاء الحساب</span>';
      return;
    }
    if (password.length < 6) {
      errorDiv.style.display = 'block';
      errorDiv.textContent = 'كلمة المرور يجب أن تكون 6 أحرف على الأقل';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-user-plus"></i> <span>إنشاء الحساب</span>';
      return;
    }

    firebase.auth().createUserWithEmailAndPassword(email, password)
      .then(function(result) {
        return result.user.getIdToken().then(function(idToken) {
          return fetch('/api/auth/firebase-register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idToken, name, email, phone, parentPhone, grade })
          });
        });
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.success) { window.location.href = data.redirect; }
        else { errorDiv.style.display = 'block'; errorDiv.textContent = data.error || 'فشل إنشاء الحساب'; btn.disabled = false; btn.innerHTML = '<i class="fas fa-user-plus"></i> <span>إنشاء الحساب</span>'; }
      })
      .catch(function(error) {
        errorDiv.style.display = 'block';
        if (error.code === 'auth/email-already-in-use') errorDiv.textContent = 'البريد الإلكتروني مستخدم بالفعل';
        else if (error.code === 'auth/weak-password') errorDiv.textContent = 'كلمة المرور ضعيفة جداً';
        else if (error.code === 'auth/invalid-email') errorDiv.textContent = 'البريد الإلكتروني غير صحيح';
        else errorDiv.textContent = 'فشل إنشاء الحساب: ' + error.message;
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-user-plus"></i> <span>إنشاء الحساب</span>';
      });
  }
}
</script>

<%- include('../partials/footer') %>
