{
  "name": "lughati-platform",
  "version": "1.0.0",
  "description": "المُميز - منصة محمد عفيفي التعليمية",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node scripts/seed-firebase.js",
    "migrate": "node src/migrations/index.js run",
    "migrate:validate": "node src/migrations/index.js validate",
    "migrate:rollback": "node src/migrations/index.js rollback",
    "migrate:data": "node scripts/migrate-data.js",
    "migrate:dry-run": "node scripts/migrate-data.js --dry-run",
    "migrate:data:force": "node scripts/migrate-data.js --force",
    "migrate:preflight": "node scripts/preflight.js",
    "verify:migration": "node scripts/verify-migration.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@getbrevo/brevo": "^6.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.45.0",
    "argon2": "^0.45.1",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "ejs": "3.1.9",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1"
  }
}
